 AGENTS.md                     |  48 ++++++++
 CLAUDE.md                     |   1 +
 LICENSE                       | 201 ++++++++++++++++++++++++++++++++++
 README.md                     |  39 +++++++
 docs/README-claude-current.md |   4 +-
 6 files changed, 301 insertions(+), 2 deletions(-)
 create mode 100644 .gitattributes
