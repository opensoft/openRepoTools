From acf1a5ed302758c8d354ab7a70f726887bf87dca Mon Sep 17 00:00:00 2001
From: Brett Heap <1513478+brettheap@users.noreply.github.com>
Date: Mon, 19 Oct 2026 17:40:00 +0000
Subject: [PATCH] The assembly root's two length caps are the re-cut
 assembly-0001's own counts, AGENTS.md 354 and README.md 529, each set in a
 dated entry, and tests/test_test_roots.py holds them.

Code-leg patch for opensoft/openRepoTools#186, task T009 of
specs/004-migrate-to-triad/tasks.md, against the test files #228's series
leaves: 006-release-pypi-t025 b3aab89 with 006-release-pypi-pr3fix c6cea2a
merged in. It pairs with the re-cut assembly-0001 of the same day, and it
goes on the code leg after T006's code-0001 and the T010 code-leg patch.

- tests/test_repo_hygiene.py: `cap = 330 if ROOTS.assembly is None else
  347` becomes `else 354`, and `cap = 505 if ROOTS.assembly is None else
  510` becomes `else 529`. Each is this repository's own count plus the
  twenty-four lines the re-cut adds, measured on the re-cut applied by `git
  am --3way` to a root built from the split's root files. A dated entry in
  each docstring says so, under the 2026-10-18 entries that said the re-cut
  would set them again.
- tests/test_test_roots.py: the at-cap and one-over fixtures and the two
  failure messages move with them, 354/355 and 529/530, and the docstring
  names the new caps.

The standalone caps, 330 and 505, do not move.

Lane: openRepoTools-1
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tests/test_repo_hygiene.py | 26 ++++++++++++++++++++++++--
 tests/test_test_roots.py   | 29 ++++++++++++++---------------
 2 files changed, 38 insertions(+), 17 deletions(-)

diff --git a/tests/test_repo_hygiene.py b/tests/test_repo_hygiene.py
index a97f5a8..832998f 100644
--- a/tests/test_repo_hygiene.py
+++ b/tests/test_repo_hygiene.py
@@ -1976,9 +1976,19 @@ def test_agents_md_is_short_enough_to_be_read():
     at offsets seven lines further on. The re-cut that makes the assembly's
     file again sets its cap, and `tests/test_test_roots.py` holds 347 until
     then.
+
+    330 HERE AND 347 -> 354 AT AN ASSEMBLY ROOT, on 2026-10-19 (#186, T009):
+    the re-cut again sets its cap, as the entry above says it does.
+    `assembly-0001`, re-cut against the AGENTS.md #228's series leaves, keeps
+    the twenty-four lines the 316 entry names — the shape's first-line pointer
+    and the triad map — and adds none: each hunk that had stopped applying
+    makes its own path repair on the text that moved under it, one line for
+    one. So the assembly's file is this one's 330 plus those twenty-four, 354,
+    measured with the re-cut applied by `git am --3way` to a root built from
+    the split's root files, and `tests/test_test_roots.py` holds 354.
     """
     lines = doc("AGENTS.md").read_text().splitlines()
-    cap = 330 if ROOTS.assembly is None else 347
+    cap = 330 if ROOTS.assembly is None else 354
     assert len(lines) <= cap, f"AGENTS.md is {len(lines)} lines; the cap is {cap}"
 
 
@@ -2511,9 +2521,21 @@ def test_readme_is_short_enough_to_be_read():
     makes the assembly's file again sets its cap, as the 2026-10-18 AGENTS.md
     entry above says for its 347, and `tests/test_test_roots.py` holds 510
     until then.
+
+    505 HERE AND 510 -> 529 AT AN ASSEMBLY ROOT, on 2026-10-19 (#186, T009):
+    the re-cut again sets its cap, as the entry above says it does.
+    `assembly-0001`, re-cut against this README, keeps the twenty-four lines
+    the 2026-10-08 entry names and adds none: the three-repository section
+    with the lockstep invariant, nineteen; the assembly's install sentence,
+    four, still straight after the two install lines and so now above T024's
+    one-route paragraph; and the `cd code` of the pin-bump block, one. The
+    three hunks the entry above names keep their own lines, one for one. So
+    the assembly's README is this one's 505 plus twenty-four, 529, measured on
+    the re-cut as the AGENTS.md entry of this day measures 354, and
+    `tests/test_test_roots.py` holds 529.
     """
     lines = doc("README.md").read_text().splitlines()
-    cap = 505 if ROOTS.assembly is None else 510
+    cap = 505 if ROOTS.assembly is None else 529
     assert len(lines) <= cap, f"README.md is {len(lines)} lines; the cap is {cap}"
 
 
diff --git a/tests/test_test_roots.py b/tests/test_test_roots.py
index f9c0dca..9c784ed 100644
--- a/tests/test_test_roots.py
+++ b/tests/test_test_roots.py
@@ -360,21 +360,20 @@ def test_the_pin_rules_are_read_with_the_assemblys_code_prefix(tmp_path, prefixe
 
 
 def test_the_length_caps_are_the_assembly_roots_where_one_is_named(tmp_path):
-    """At an assembly root the two caps are 347 and 510. The dated entries in
-    `tests/test_repo_hygiene.py` made them from this repository's then caps,
-    323 and 486, and the twenty-four lines each that T006's root guidance adds
-    there, and they stand there while this repository's own are 330 and 505 at
-    this head: `assembly-0001` no longer applies to today's AGENTS.md or
-    README, so the re-cut that makes the assembly's files again sets them. And
-    they are asked of the ASSEMBLY's files: one line over FAILS, the cap itself
-    passes. Red at `origin/main`, which counted this checkout's own README and
-    AGENTS.md whatever was named."""
+    """At an assembly root the two caps are 354 and 529: this repository's 330
+    and 505 and the twenty-four lines each that T006's root guidance adds
+    there, set again on 2026-10-19 by the re-cut of `assembly-0001` (the
+    dated entries in `tests/test_repo_hygiene.py`; they were 347 and 510, from
+    the 323 and 486 of 2026-10-09, and stood while the old patch no longer
+    applied). And they are asked of the ASSEMBLY's files: one line over FAILS,
+    the cap itself passes. Red at `origin/main`, which counted this checkout's
+    own README and AGENTS.md whatever was named."""
     def lines(n: int) -> str:
         return "".join(f"line {i}\n" for i in range(n))
-    at_cap = assembly(tmp_path / "at", readme=lines(510))
-    (at_cap / "AGENTS.md").write_text(lines(347), encoding="utf-8")
-    over = assembly(tmp_path / "over", readme=lines(511))
-    (over / "AGENTS.md").write_text(lines(348), encoding="utf-8")
+    at_cap = assembly(tmp_path / "at", readme=lines(529))
+    (at_cap / "AGENTS.md").write_text(lines(354), encoding="utf-8")
+    over = assembly(tmp_path / "over", readme=lines(530))
+    (over / "AGENTS.md").write_text(lines(355), encoding="utf-8")
     select = f"{AGENTS_CAP_TEST} or {README_CAP_TEST}"
     green = nested(tmp_path, {"OPENREPOTOOLS_ASSEMBLY_ROOT": str(at_cap)},
                    select, "test_repo_hygiene.py")
@@ -382,8 +381,8 @@ def test_the_length_caps_are_the_assembly_roots_where_one_is_named(tmp_path):
         assert green.outcome(name)[0] == "passed", green.output[-3000:]
     red = nested(tmp_path, {"OPENREPOTOOLS_ASSEMBLY_ROOT": str(over)},
                  select, "test_repo_hygiene.py")
-    for name, said in ((AGENTS_CAP_TEST, "AGENTS.md is 348 lines; the cap is 347"),
-                       (README_CAP_TEST, "README.md is 511 lines; the cap is 510")):
+    for name, said in ((AGENTS_CAP_TEST, "AGENTS.md is 355 lines; the cap is 354"),
+                       (README_CAP_TEST, "README.md is 530 lines; the cap is 529")):
         outcome, message = red.outcome(name)
         assert outcome == "failure" and said in message, (
             f"{name} {outcome} on an assembly file one line over its cap:\n"
-- 
