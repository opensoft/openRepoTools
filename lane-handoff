#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
#
# lane-handoff — the swap, the context clear and the handoff, under one name.
#
#   lane-handoff [why]             hand this lane off: fix the identity triple,
#                                  refresh the handoff, poll the writers, write
#                                  the PAUSED record, print the restart line
#   lane-handoff --restart [why]   the same, and then RESPAWN this lane's own
#                                  pane through the launcher with the handoff's
#                                  top block as the new session's first prompt
#                                  (`/ctx`, Amendment 17(f))
#   lane-handoff --exit [why]      the same, and then type `/exit` into this
#                                  lane's own pane (Amendment 18(d), for a
#                                  handoff another place REQUESTED)
#   lane-handoff --in-process [why]
#                                  the same, for a clear that keeps THIS PROCESS
#                                  running: the record says `kind in-process`
#                                  and the top block tells the next session that
#                                  every writer SURVIVED and to relaunch none
#   lane-handoff --late --at <UTC> [why]
#                                  the record written AFTER THE FACT for a swap
#                                  that never ran, BEFORE the relaunch
#
# lane-collision-protocol **Amendment 17**, ratified 2026-09-14T09:45:33Z,
# clause (a): *"the act Amendment 8(a) calls the swap is the HANDOFF:
# `lane-handoff` on `PATH` (placed by `openRepoTools --install`) from a shell,
# `/handoff` from inside a session; `/lane-swap` and `/swap` remain as aliases"*.
# The steps are the `handoff` skill's, which are Amendment 8(a)'s and Amendment
# 11's as they stand — THIS FILE AND THAT SKILL ARE ONE ACT IN TWO SURFACES, and
# the skill is the one a session runs, because a session can send a subagent a
# message and a shell cannot.
#
# WHAT IS NEW HERE, AND WHAT IS NOT. Nothing about the record changes but two
# sub-fields: clause (b) gives the `PAUSED` payload `agent <name>` and
# `transcript <id|none>` beside Amendment 11(c)'s `window`, `dir` and `profile`,
# so that the next session can be started by whatever agent can read the lane
# (`lane-start --agent`, clause (c)). The free text still says WHY — `clear`,
# `reset`, `switch`, `handoff to <who>`, `requested by <uuid>@<host>/<container>`
# — and nothing else changes with the why. That is the whole of clause (a):
# *"The word has been wrong, not the act."*
#
# THE FLAGS, and each is one act after the record rather than a second kind of
# record — except `--in-process`, which is the one fact about the act that
# FOLLOWS the record and which the record therefore carries:
#
#   --restart  Amendment 17(f), `/ctx`: *"a `/ctx` whose record could not be
#              written REFUSES before it kills anything (a pane is never
#              respawned over an unrecorded lane)"*. So the pane is respawned
#              ONLY after the PAUSED line is written, and a refused write is a
#              refusal of the whole act with the pane untouched.
#   --exit     Amendment 18(d): a handoff to ANOTHER PLACE ends the session,
#              because 17(f)'s respawn is for the lane that stays where it is.
#              The `why` a requester gives is `requested by <uuid>@<host>/<c>`.
#   --late     Amendment 17 adoption act 7: the swap that never ran, recorded
#              after the fact. It is written BEFORE the relaunch — see THE LATE
#              RULE below, which is the whole of why it takes `--at`.
#   --in-process
#              THE WRITERS SURVIVE THIS ONE. Measured in this lane on
#              2026-09-14: a harness `/clear` mints a new transcript id IN THE
#              SAME PROCESS, so every subagent the lane has running lives
#              through it and only its in-flight tool calls die. The record then
#              says `kind in-process` and the top block tells the next session
#              to EXPECT EVERY WRITER BELOW LIVE — an expectation and never an
#              instruction, which is Addendum 1 (j): what to DO is clause (i)'s
#              count, the same in every kind. Relaunching a writer that is still
#              live puts two of them on one worktree (k). `--restart`, `--exit`
#              and `--late` are `kind respawn`: a new process, and its writers
#              are gone. A PLAIN handoff is `kind unknown`, because the act that
#              follows it is not this command's to know.
#
# THE LATE RULE, stated here because it is the one rule of this command a
# reader cannot derive from the amendment. A lane's state is its log's LAST
# lane-kind line IN FILE ORDER (Amendment 7's rule, R14, and every reader in
# `lanes-edit.sh` implements it that way — `swapped_candidates`, `lane_row_facts`,
# `lane_payload_field`). The log is APPEND-ONLY. So a late `PAUSED` appended
# after the `RESUMED` that `lane-start` wrote at the relaunch would make a lane
# that is running read as paused, in a file nothing rewrites — the one thing the
# record must never say. Two ways out were available: teach every reader to skip
# a `PAUSED` whose `late` sub-field predates a later `RESUMED`, or refuse to
# write the line where it can no longer be the last one. This command takes the
# second, because it is the only one that keeps `binding` and every state read
# correct WITHOUT editing readers this amendment does not touch:
#
#   * `--late` REQUIRES `--at <UTC>` — the moment the old session ended. A late
#     line is dated by its own field, not by the clock of the shell writing it.
#   * it is written only where the lane's last lane-kind line is a `STARTED` or
#     `RESUMED` OLDER than that instant — the dead session's own start. That is
#     the state of a lane whose swap never ran, and it is the state that exists
#     only BEFORE the relaunch.
#   * a last line that is already a `PAUSED` (the record exists), an `ENDED` or
#     `RETIRED` (the lane is closed), or a `STARTED`/`RESUMED` at or after that
#     instant (the relaunch is already recorded) is a REFUSAL that writes
#     nothing and names the act to take instead.
#
# So the documented act is: run `lane-handoff --late --at <UTC>` FROM THE SHELL,
# then `pclaude <profile>`. Run from inside the session that has already been
# resumed, it refuses — and the honest record of the state that session now
# holds is its own next handoff.
#
# EXIT CODES, this toolset's and the family's:
#
#   0  the handoff was written (and the pane respawned or exited, where asked)
#   2  REFUSED — nothing was written, or the record was written and the act
#      that follows it was refused before touching the pane
#   1  a read failed, which is never "nothing to report" (Amendment 7(d))
#
#   $LANES_EDIT       the register's reader/writer (default: beside this file)
#   $LANES_AGENT      this agent's name for the record (default: claude)
#   $PCLAUDE          the launcher                 (default: pclaude, else claude-profile)
#   $LANE_HANDOFF_NO_TMUX=1   never touch tmux (the identity fix, --exit, --restart)
#
# lane-collision-protocol Amendment 17 (in force 2026-09-14T09:45:33Z),
# Amendment 18(d) and Addendum 2 (in force 2026-09-14T16:50:32Z).

set -uo pipefail

prog="${0##*/}"
SELF="${BASH_SOURCE[0]:-$0}"
selfdir="$(cd -- "$(dirname -- "$SELF")" && pwd)"

say()  { printf '%s\n' "$*"; }
note() { printf '%s: %s\n' "$prog" "$*" >&2; }
step() { printf '%s: %s\n' "$prog" "$*" >&2; }
die()  { printf '\n%s: REFUSED: %s\n' "$prog" "$1" >&2; exit "${2:-2}"; }
# EVERY ARGUMENT AS ONE SHELL WORD, WITHOUT `printf %q` AND WITHOUT A PIPE —
# measured on the macOS job at `db206db` and `ac0c697`, where three cases of
# this branch's own went red and no other platform could see it. One line, two
# defects:
#
#   * `printf '%q '` RENDERS DIFFERENTLY UNDER BASH 3.2, which is what Apple
#     ships and what that job runs (`/bin/bash` 3.2.57). Bash 4.4 and later
#     give a multi-line argument back as `$'…\n…'` — one readable, runnable
#     word; 3.2 has no such form and escapes every space and every byte of
#     every multi-byte character with a backslash of its own. The one caller
#     that passes a multi-line argument is the `--no-launch` print of a launch
#     carrying the handoff's top block as its first prompt (Amendment 17(c)),
#     and it got back neither a readable line nor a runnable one.
#   * AND THE PIPE THROUGH `sed` MADE THAT FATAL RATHER THAN UGLY. Under
#     `set -o pipefail` this function's status IS the pipeline's, and BSD `sed`
#     in a UTF-8 locale (`LC_ALL=en_US.UTF-8` on that runner) refuses bytes
#     that are not a valid sequence — `RE error: illegal byte sequence` — which
#     is what 3.2's `%q` makes of the em dash every one of these documents is
#     written with. `quoted` is a BARE command in the `--no-launch` branch, so
#     `set -e` ended the command there: exit 1, and an empty stdout.
#
# So the quoting is this file's own, and it is the POSIX one every shell reads
# the same way: a word of safe characters bare, anything else in single quotes
# with its own single quotes spelled `'\''`. A newline inside single quotes IS
# a newline, so the line stays readable as well as runnable, on either bash.
quoted() {
	q_sep=""
	for q_a in "$@"; do
		case "$q_a" in
		'' | *[!A-Za-z0-9._/:=@%+,-]*)
			printf "%s'%s'" "$q_sep" "${q_a//\'/\'\\\'\'}" ;;
		*) printf '%s%s' "$q_sep" "$q_a" ;;
		esac
		q_sep=' '
	done
	return 0
}

usage() {
	cat <<'USAGE'
lane-handoff [--restart | --exit | --in-process] [--late --at <UTC>]
             [--lane <lane>] [--agent <name>] [--transcript <id|none>]
             [--writers-file <path>] [--dir <path>] [why …]

  lane-handoff [why]      hand this lane off — the act /handoff, /swap and
                          /lane-swap all name. The identity triple is fixed,
                          the handoff file gains a fresh Rule 3 top block with
                          a WRITERS section, every running writer is polled,
                          the lane's PAUSED record is written with Amendment
                          11(c)'s sub-fields plus `agent` and `transcript`,
                          and the one restart command is printed.
  --restart               /ctx: after the record, respawn THIS lane's own pane
                          through the launcher, the new session's first prompt
                          being the handoff's top block. A record that cannot
                          be written refuses before anything is killed.
  --exit                  after the record, type /exit into this lane's own
                          pane (Amendment 18(d): a handoff to another place).
  --in-process            the clear that follows keeps THIS PROCESS running (a
                          harness /clear), so every writer this lane has running
                          survives it: the record says `kind in-process` and the
                          top block tells the next session to EXPECT every
                          writer below live — an expectation, never an
                          instruction (Addendum 1 (j)). Refused with --restart,
                          --exit and --late, which each mean the process ended.
                          With none of the four the kind is `unknown`.
  --supervise             THE PANE SUPERVISOR, started by --restart's respawn
                          and not typed by a person: it claims the lane's
                          restart intent, launches the replacement as its own
                          CHILD, confirms readiness before anything is called
                          running, and STAYS IN THE PANE with the diagnostic and
                          a retry when the launch fails. Needs --lane and
                          --operation.
  --restart-status        read the lane's restart intent — its operation,
                          generation, attempt, state, handoff, digest,
                          transcripts and bounded failure reason — and print the
                          act that is open on it. Reads only. Needs --lane.
  --operation <id>        the restart operation --supervise was started for. An
                          id that is not the lane's current one is a refusal.
  --late --at <UTC>       write the record a swap never left, dated by the
                          moment the old session ended. Run it from a shell
                          BEFORE the relaunch; see --help's LATE RULE.
  --lane <lane>           the lane, where this window does not name it.
  --agent <name>          the agent for the record (default: $LANES_AGENT, else
                          claude). Letters, digits, `.`, `_`, `-`.
  --transcript <id|none>  its resumable id (default: this session's, else none)
  --writers-file <path>   lines of `<worktree><TAB><brief>` — the brief each
                          writer was given, for the WRITERS section.
  --dir <path>            the lane's checkout, where its record names none.
  why …                   the free text: clear, reset, switch, handoff to <who>,
                          requested by <uuid>@<host>/<container>.

Exit: 0 written · 2 refused · 1 a read failed.
      --supervise adds: 3 the launch failed and there was no terminal here to
      offer the retry on · 4 indeterminate (a live child, readiness unconfirmed).
USAGE
}

# ------------------------------------------------------------------ arguments

do_restart=0; do_exit=0; do_late=0; do_in_process=0; do_supervise=0; do_status=0
late_at=""; lane=""; agent=""; transcript=""; writers_file=""; dir_flag=""
operation=""
why=""

# A FLAG WHERE A VALUE BELONGS IS REFUSED, in this command as in `park`,
# `resume` and `status` (`92eab6c`): `--lane --restart` must not hand off a lane
# called `--restart`, and `--flag=value` is the spelling that gives a `-`-led
# value back. One reader, byte-identical to theirs.
flag_value() {   # <flag> <the next argument, if any>
	case "${2-}" in
	'') die "$1 needs a value" 2 ;;
	-*) die "$1 needs a value and '$2' is a flag. Use $1=$2 where that really is the value." 2 ;;
	esac
	printf '%s' "$2"
}

while [ $# -gt 0 ]; do
	case "$1" in
	-h | --help) usage; exit 0 ;;
	--restart) do_restart=1; shift ;;
	--exit) do_exit=1; shift ;;
	--late) do_late=1; shift ;;
	# THE PROCESS SURVIVES THIS ONE, AND THAT CHANGES WHAT THE NEXT SESSION IS
	# TOLD (measured in this lane on 2026-09-14): a harness `/clear` mints a new
	# transcript id IN THE SAME PROCESS, so every subagent this lane has running
	# lives through it and only its in-flight tool calls die. A block that then
	# says *relaunch every writer* puts a second writer on a worktree the first
	# one still holds.
	--in-process) do_in_process=1; shift ;;
	# THE OTHER HALF OF `--restart`, AND THE SAME COMMAND ON PURPOSE
	# (openRepoTools#94). `--supervise` is what tmux starts in the respawned
	# pane: it claims the restart intent `--restart` wrote, launches the
	# replacement as a CHILD, confirms readiness and stays in the pane when
	# anything goes wrong. It is a MODE and not a thirteenth installed word,
	# because Amendment 18 Addendum 2 (i-8) is explicit that *"no word is kept
	# on `PATH` for it alone"* — which is the ground on which `restart` was
	# taken off it. `--restart-status` is the read-only surface over the same
	# record.
	--supervise) do_supervise=1; shift ;;
	--restart-status) do_status=1; shift ;;
	--operation) operation="$(flag_value --operation "${2-}")"; shift 2 ;;
	--operation=*) operation="${1#--operation=}"; shift ;;
	--at) late_at="$(flag_value --at "${2-}")"; shift 2 ;;
	--at=*) late_at="${1#--at=}"; shift ;;
	--lane) lane="$(flag_value --lane "${2-}")"; shift 2 ;;
	--lane=*) lane="${1#--lane=}"; shift ;;
	--agent) agent="$(flag_value --agent "${2-}")"; shift 2 ;;
	--agent=*) agent="${1#--agent=}"; shift ;;
	--transcript) transcript="$(flag_value --transcript "${2-}")"; shift 2 ;;
	--transcript=*) transcript="${1#--transcript=}"; shift ;;
	--writers-file) writers_file="$(flag_value --writers-file "${2-}")"; shift 2 ;;
	--writers-file=*) writers_file="${1#--writers-file=}"; shift ;;
	--dir) dir_flag="$(flag_value --dir "${2-}")"; shift 2 ;;
	--dir=*) dir_flag="${1#--dir=}"; shift ;;
	--) shift; while [ $# -gt 0 ]; do why="${why:+$why }$1"; shift; done ;;
	-*) die "unknown option '$1' — see $prog --help" 2 ;;
	*) why="${why:+$why }$1"; shift ;;
	esac
done

# ONE ACT AT A TIME AFTER THE RECORD. `--restart` respawns the pane for a lane
# that STAYS HERE and `--exit` ends the session for a lane going somewhere else
# (Amendment 18(d)); asking for both is asking the same pane to do two opposite
# things, and whichever ran second would run against a pane the first had
# already replaced.
# AND THE TWO MODES THAT ARE NOT HANDOFFS AT ALL ARE ASKED FOR ALONE
# (openRepoTools#94). `--supervise` is the pane's own root process after a
# `/ctx` and `--restart-status` is a read; neither writes a PAUSED record, and a
# caller that asked for one of them beside `--restart` is asking this command to
# hand off a lane and to be the thing that catches the handoff, in one process.
for lh_mode_a in supervise:$do_supervise status:$do_status; do
	[ "${lh_mode_a#*:}" = 1 ] || continue
	for lh_mode_b in restart:$do_restart exit:$do_exit late:$do_late in-process:$do_in_process; do
		[ "${lh_mode_b#*:}" = 1 ] || continue
		die "--${lh_mode_a%%:*} is not a handoff and --${lh_mode_b%%:*} is: the first is the pane's own process after a /ctx (or a read of what that /ctx left), and the second writes the record. Ask for one." 2
	done
done
[ "$do_supervise" = 1 ] && [ "$do_status" = 1 ] &&
	die "--supervise launches and --restart-status reads; ask for one." 2
# AND `--operation` NAMES THE ACT `--supervise` WAS STARTED FOR, so it is
# meaningless anywhere else — and worse than meaningless on `--restart`, whose
# own tail MINTS an operation: a value given there would be silently discarded,
# which is the shape of thing a person only finds out about from a record that
# does not say what they typed.
[ -n "$operation" ] && [ "$do_supervise" != 1 ] &&
	die "--operation names the restart operation a supervisor was started for, and only --supervise reads it. --restart MINTS its own operation and would discard this one silently; every other mode has none. Drop it, or run:  $prog --supervise --lane <lane> --operation $operation" 2

[ "$do_restart" = 1 ] && [ "$do_exit" = 1 ] &&
	die "--restart and --exit are two different ends for one act: --restart respawns this lane's own pane (Amendment 17(f), the lane stays here) and --exit ends the session (Amendment 18(d), the lane goes elsewhere). Pick one." 2
# AND `--late` IS NEITHER OF THEM. It is written BEFORE the relaunch by a shell
# that is not in the lane's session at all — there is no pane of this lane's to
# respawn or to type into, and the relaunch it precedes is the operator's own
# `pclaude`.
[ "$do_late" = 1 ] && { [ "$do_restart" = 1 ] || [ "$do_exit" = 1 ]; } &&
	die "--late is the record a swap never left, written from a shell BEFORE the relaunch: there is no session of this lane's to restart or exit. Write the late record first, then start the lane." 2
# AND `--late --in-process` IS A CONTRADICTION IN ITS OWN TERMS (Copilot round 4
# on openRepoTools#47). A late record is written for a session that has ALREADY
# ENDED — that is what makes it late — and `--in-process` says THIS PROCESS KEPT
# RUNNING. Taken together the kind block below would take the `in-process` arm
# first and write a record telling the next session to expect writers live that
# died with the process the record is about.
[ "$do_late" = 1 ] && [ "$do_in_process" = 1 ] &&
	die "--late and --in-process cannot both be true: a late record is written for a session that has ALREADY ENDED (that is what makes it late, and its writers went with it), while --in-process says THIS PROCESS KEPT RUNNING. A late record is \`kind respawn\`. Drop --in-process." 2

# ------------------------------------------- THE KIND OF CLEAR THIS RECORDS
#
# MEASURED IN THIS LANE ON 2026-09-14, and it is the difference between a
# handoff a session can act on and one that costs it a worktree:
#
#   in-process  a harness `/clear` — and any `/ctx` that clears IN PLACE rather
#               than respawning the pane — mints a NEW TRANSCRIPT ID IN THE SAME
#               PROCESS. Every subagent this lane has running SURVIVES it; only
#               the tool calls they had in flight die (a `Bash` killed at the
#               clear exits 137). A top block that then says *relaunch every
#               writer below* puts a SECOND writer on a worktree the first one
#               still holds, and the two of them lose each other's work.
#   respawn     the pane is respawned (`--restart`) or the session is ended
#               (`--exit`) — a NEW PROCESS either way, and every writer of the
#               old one is gone with it. A profile switch and a usage-reset
#               relaunch are the same kind by the same argument (Addendum 1
#               (h)), and each is this command with one of those two flags.
#
#   unknown     a PLAIN handoff — `/handoff` with none of the three flags —
#               after which the person may type `/clear` or may relaunch. The
#               act that follows is not this command's to know, and Addendum 1
#               (h) is explicit that such a record writes `kind unknown` rather
#               than guessing: the top block then treats it as (i) treats every
#               kind, which is to COUNT the live writers first.
#
# THE KIND SAYS WHAT TO EXPECT AND NEVER WHAT TO DO (Amendment 17 Addendum 1,
# ratified 2026-09-14T20:59:31Z, clause (j)). Clause (i) is what says what to
# do, it is the same in all three cases, and it is the WRITERS section's first
# line below.
[ "$do_in_process" = 1 ] && { [ "$do_restart" = 1 ] || [ "$do_exit" = 1 ]; } &&
	die "--in-process says THIS PROCESS KEEPS RUNNING, and --restart respawns this lane's pane while --exit ends the session: each of those replaces the process every writer of this lane is a child of. Pick one — the flag is for a clear that happens inside the session that is running." 2
if [ "$do_in_process" = 1 ]; then
	handoff_kind=in-process
	kind_headline='expect every writer below live — count them before you touch any of them'
	kind_act='THIS HANDOFF WAS WRITTEN FOR AN IN-PROCESS CLEAR: the process was not replaced, so expect every writer below live and the count to name them all.'
	kind_state='the process was not replaced, so every writer above kept running through the clear and only its in-flight tool calls died'
elif [ "$do_restart" = 1 ] || [ "$do_exit" = 1 ] || [ "$do_late" = 1 ]; then
	# `--late` IS A RESPAWN AND NEVER AN UNKNOWN: the record a swap never left
	# is written for a session that has ALREADY ended — that is why it is late —
	# so the process is gone and every writer with it, which is what the word
	# names (Addendum 1 (h): "a usage-reset relaunch").
	handoff_kind=respawn
	kind_headline='expect none of the writers below live — count them, then relaunch from where each stands'
	kind_act='THIS HANDOFF WAS WRITTEN FOR A RESPAWN: the process that ran the writers is gone, so expect the count to name none of them.'
	kind_state='a NEW PROCESS takes this lane on — the pane respawned or the session ended — so every writer of the old one is gone with it'
else
	handoff_kind=unknown
	kind_headline='the count decides: this handoff cannot know whether the process survived'
	kind_act='THIS HANDOFF CANNOT KNOW WHICH KIND FOLLOWED IT: a plain handoff may be followed by a `/clear` in this process or by a relaunch, so nothing below assumes either — the count is the answer.'
	kind_state='the act that follows this record was not this command'"'"'s to know (`kind unknown`, Addendum 1 (h)) — the restart line below is one of the two, and a `/clear` typed here is the other'
fi

# ---------------------------------------------------------------- the helper
#
# Beside this command first — `--install` places both in one directory — then on
# PATH. One resolution, so a workstation with two copies never reads one and
# writes the other.
LANES_EDIT="${LANES_EDIT:-}"
if [ -z "$LANES_EDIT" ]; then
	if [ -x "$selfdir/lanes-edit.sh" ]; then LANES_EDIT="$selfdir/lanes-edit.sh"
	else LANES_EDIT="$(command -v lanes-edit.sh 2>/dev/null || printf '')"
	fi
fi
[ -n "$LANES_EDIT" ] && [ -x "$LANES_EDIT" ] || die "no register reader at ${LANES_EDIT:-lanes-edit.sh} — it is installed beside this
    command by \`openRepoTools --install\`. Run that, or set \$LANES_EDIT." 2

utc_now() { date -u +%Y-%m-%dT%H:%M:%SZ; }
UTC="$(utc_now)"

have_tmux() {
	[ "${LANE_HANDOFF_NO_TMUX:-0}" = 1 ] && return 1
	command -v tmux >/dev/null 2>&1
}

# THIS COMMAND'S OWN ABSOLUTE PATH, because tmux starts the supervisor and a
# respawned pane's `PATH` is whatever the person's shell profile makes of it —
# which is one of the ways a respawn comes up with a word that is not this
# estate's.
SELF_ABS="$selfdir/${SELF##*/}"

# THE HANDOFF'S DIGEST, spelled as `lanes-edit.sh` and `lane-start` spell it:
# all three compare the same number, so there is ONE implementation of it and
# not three. `none` is an ANSWER — this workstation has neither tool — and it
# means *not checked here*, never *unchanged*.
handoff_digest() {   # <file>
	[ -r "${1-}" ] || { printf 'none\n'; return 0; }
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum -- "$1" 2>/dev/null | awk '{print $1; exit}'
	elif command -v shasum >/dev/null 2>&1; then
		shasum -a 256 -- "$1" 2>/dev/null | awk '{print $1; exit}'
	else
		printf 'none\n'
	fi
}

# A PANE REF IS COMPARED COMPONENT-WISE, NEVER AS A SUFFIX OR A PREFIX. The
# three spellings are `<session>:<@id>`, `<session>:<@id>.%<pane>` and, in
# `$TMUX_PANE`, the bare `%<pane>` — and a `case` on `*"$x"` accepts `%16` for
# `%6` and a `case` on `"$x"*` accepts `@331` for `@33`. Both are the wrong
# window, and this comparison decides whether a second session of a lane gets
# started in one. Empty on either side is NOT a disagreement: a comparison that
# cannot be made is said rather than failed shut, which is what the callers do
# with it.
pane_agrees() {   # <a> <b>
	pa_a="${1-}"; pa_b="${2-}"
	[ -n "$pa_a" ] && [ -n "$pa_b" ] || return 0
	[ "$pa_a" != none ] && [ "$pa_b" != none ] || return 0
	[ "$pa_a" = "$pa_b" ] && return 0
	# A BARE `%<pane>` on either side is compared against the other's pane
	# component and against nothing else.
	case "$pa_a" in
	%*) case "$pa_b" in *.%*) [ "$pa_a" = "${pa_b##*.}" ] && return 0 ;; esac; return 1 ;;
	esac
	case "$pa_b" in
	%*) case "$pa_a" in *.%*) [ "$pa_b" = "${pa_a##*.}" ] && return 0 ;; esac; return 1 ;;
	esac
	# Otherwise both name a window; one may also name a pane, and a record that
	# names only the window agrees with an intent that names the pane inside it.
	case "$pa_a" in *.%*) pa_aw="${pa_a%.*}" ;; *) pa_aw="$pa_a" ;; esac
	case "$pa_b" in *.%*) pa_bw="${pa_b%.*}" ;; *) pa_bw="$pa_b" ;; esac
	[ "$pa_aw" = "$pa_bw" ]
}

# ---------------------------------------------------- the readiness predicate
#
# READ-ONLY, AND POSITIVE. It asks five things and every one of them must
# answer, because the failure this exists to stop is a launch that was ACCEPTED
# and never happened:
#
#   1. the child this supervisor started is still alive;
#   2. this workstation's session records name a LIVE HOLDER of the lane;
#   3. exactly ONE of them — a second is Amendment 18(h)'s collision, and a
#      restart that confirmed itself while two processes answered for one lane
#      would be the tooling making the very thing the protocol refuses;
#   4. that holder's transcript is the one `lane-start` said it was about to
#      make — and, where it said nothing, at least one that is NOT the
#      transcript the `/ctx` paused, which is the spec's *a transcript distinct
#      from the old transcript*;
#   5. it is in the pane the intent was written for, where both are knowable.
#
# IT WRITES NOTHING, AND IT NEEDS NOTHING FROM THE `SessionStart` HOOK, whose
# read-only, network-free, always-zero contract is load-bearing (`R-A8-1`,
# ratified) and is untouched by any of this.
#
# THE CHILD'S PID COMES OUT OF A FILE and not out of a variable, because the
# child is started in the FOREGROUND (below) and this predicate runs in a
# background observer that has no way to be told it otherwise. An empty file is
# *the child has not got as far as recording itself*, which is not the same as
# *the child is gone*.
#
# 0 ready · 1 not yet (the reason is on `READY_WHY`) · 2 the child is gone.
ready_check() {   # <lane> <pid file> <expected new transcript|""> <old transcript|""> <pane|"">
	rc_lane="$1"; rc_pidf="$2"; rc_new="$3"; rc_old="$4"; rc_pane="$5"
	READY_WHY=""; READY_SID=""
	rc_pid=""
	[ -r "$rc_pidf" ] && rc_pid="$(head -n 1 -- "$rc_pidf" 2>/dev/null | tr -dc '0-9')"
	if [ -z "$rc_pid" ]; then
		READY_WHY="the child has not recorded its pid yet"
		return 1
	fi
	kill -0 "$rc_pid" 2>/dev/null || { READY_WHY="the child (pid $rc_pid) is gone"; return 2; }
	rc_out=""; rc_rc=0
	rc_out="$(LANES_NO_FETCH=1 "$LANES_EDIT" live-holder "$rc_lane" 2>/dev/null)" || rc_rc=$?
	case "$rc_rc" in
	0) : ;;
	8) READY_WHY="no live session record names lane $rc_lane yet"; return 1 ;;
	*) READY_WHY="this workstation's session records could not be read (live-holder exited $rc_rc), which is NOT 'nothing is live'"; return 1 ;;
	esac
	rc_n="$(printf '%s\n' "$rc_out" | grep -c . || :)"
	if [ "${rc_n:-0}" != 1 ]; then
		READY_WHY="$rc_n live holders answer for lane $rc_lane and readiness needs exactly one (Amendment 18(h))"
		return 1
	fi
	rc_sid="$(printf '%s\n' "$rc_out" | awk -F'\037' '{print $1; exit}')"
	rc_tgt="$(printf '%s\n' "$rc_out" | awk -F'\037' '{print $2; exit}')"
	READY_SID="$rc_sid"
	if [ -n "$rc_new" ] && [ "$rc_new" != none ]; then
		if [ "$rc_sid" != "$rc_new" ]; then
			READY_WHY="the live holder's transcript is $rc_sid and this launch was preparing $rc_new"
			return 1
		fi
	elif [ -n "$rc_old" ] && [ "$rc_old" != none ] && [ "$rc_sid" = "$rc_old" ]; then
		READY_WHY="the live holder's transcript is $rc_sid, which is the one this /ctx paused — that is a resume and not a fresh session"
		return 1
	fi
	if ! pane_agrees "$rc_pane" "$rc_tgt"; then
		READY_WHY="the live holder is in $rc_tgt and the intent names pane $rc_pane"
		return 1
	fi
	return 0
}

# ------------------------------------------------- the observer, and the wait
#
# THE CHILD RUNS IN THE FOREGROUND AND THIS PROCESS WAITS ON IT. That order is
# not a preference: the child is an interactive terminal program, and a
# background child in a shell with no job control cannot read the terminal at
# all. So the OBSERVATION goes into the background instead — one subshell that
# polls the read-only predicate above and, the moment it answers, makes the one
# fenced write that turns this restart into a confirmed one. That is the
# design's *separate observation path*, and it is why nothing is printed over a
# running Claude's screen: the observer WRITES its verdict, and
# `--restart-status` from any other window is where it is read.
#
# EVERY TWO SECONDS AND NOT EVERY ONE: the predicate's middle question goes
# through `lanes-edit.sh live-holder`, which reads the register, and sixty of
# those in a minute is sixty git processes behind a session that is trying to
# start.
supervise_watch() {   # <lane> <operation> <generation> <pid file> <new> <old> <pane>
	sw_lane="$1"; sw_op="$2"; sw_gen="$3"; sw_pidf="$4"; sw_new="$5"; sw_old="$6"; sw_pane="$7"
	sw_waited=0
	while [ "$sw_waited" -lt "$SUPERVISE_READY_SECONDS" ]; do
		sleep 2
		sw_waited=$((sw_waited + 2))
		sw_rc=0
		ready_check "$sw_lane" "$sw_pidf" "$sw_new" "$sw_old" "$sw_pane" || sw_rc=$?
		case "$sw_rc" in
		2) return 3 ;;          # the child is gone; the supervisor has its status
		0)
			# THE FINALIZER, FENCED ON THIS OPERATION AND THIS GENERATION. A
			# stale observer of a superseded operation writes nothing: exit 7
			# is the intent refusing it, and that refusal is the whole point of
			# the fence.
			sw_frc=0
			LANES_NO_FETCH=1 "$LANES_EDIT" set-restart-intent "$sw_lane" ready \
				--expect starting --expect-operation "$sw_op" --expect-generation "$sw_gen" \
				--new-transcript "${READY_SID:-$sw_new}" \
				--reason "readiness confirmed after ${sw_waited}s" >/dev/null 2>&1 || sw_frc=$?
			if [ "$sw_frc" != 0 ]; then
				note "lane $sw_lane came up and the restart intent could NOT be marked ready (exit $sw_frc): the session is running and the record does not say so. Read it:  $prog --restart-status --lane $sw_lane"
				return 5
			fi
			# AND THE LANE'S OWN LIFECYCLE WHERE THIS WORKSTATION HAS ONE
			# (openRepoTools#91): `SWAPPED -> RUNNING`, on the same act. A
			# `lanes-edit.sh` without `lane-state` answers 2 from its
			# unknown-subcommand arm and this is SILENT — the lane simply has
			# no lifecycle snapshot to move, which is the pre-cutover case and
			# not a failure.
			sw_lrc=0
			LANES_NO_FETCH=1 "$LANES_EDIT" set-lane-state "$sw_lane" RUNNING \
				--expect SWAPPED >/dev/null 2>&1 || sw_lrc=$?
			case "$sw_lrc" in
			0 | 1 | 2) : ;;
			7) note "lane $sw_lane's lifecycle moved under this restart, so the SWAPPED -> RUNNING transition was refused: the restart intent is ready and the lifecycle is somebody else's now. Read it:  $LANES_EDIT lane-reconcile $sw_lane" ;;
			*) note "lane $sw_lane came up and its lifecycle could not be moved to RUNNING (set-lane-state exited $sw_lrc). The restart intent IS ready; the lifecycle snapshot is behind it." ;;
			esac
			return 0 ;;
		esac
	done
	# THE DEADLINE, WITH THE CHILD STILL ALIVE — INDETERMINATE, which is a THIRD
	# answer and not a failure. Nothing is killed (Amendment 8(f): ending
	# somebody's process is not a boundary script's act), nothing is retried,
	# and the lane is NOT marked running.
	LANES_NO_FETCH=1 "$LANES_EDIT" set-restart-intent "$sw_lane" starting \
		--expect starting --expect-operation "$sw_op" \
		--reason "INDETERMINATE: ${SUPERVISE_READY_SECONDS}s elapsed with the child alive and readiness unconfirmed; ${READY_WHY:-no evidence}" >/dev/null 2>&1 || :
	return 4
}

# THE CHILD'S ARGV, out of the intent and out of nothing else — the spec's *no
# picker, attach, select, current-directory, title, or default-profile
# resolution*, and never the human-facing `lane` dispatcher, whose valid
# outcomes include attaching to something instead of launching.
#
# THE LAUNCHER FIRST, because it is what configures the ACCOUNT: `pclaude
# --lane <lane> <profile>` is the same act `lane`'s available branch makes, one
# door along, and `lane-start` is what it runs. Where this workstation has no
# launcher, or the intent records no profile to hand one, the supervisor runs
# `lane-start` itself with the fresh mode as an ARGUMENT — the narrow operation
# launch, and the only path on which `--operation` can be passed at all, since
# the launcher forwards no argument of its own.
#
# EITHER WAY THE FRESH SESSION IS THE INTENT'S TO DECIDE AND NOT THIS ARGV'S:
# `lane-start` reads the same file and goes fresh with no flag and no variable
# set. The flag and the variable are set here anyway, because a launch that
# says what it is in three places is a launch whose defect capture can be read
# — and because on the launcher path they are the only two that even reach it.
supervise_argv() {   # <lane> <operation>
	sa_lane="$1"; sa_op="$2"
	SUPERVISE_CMD=(); SUPERVISE_VIA=""
	sa_launcher="${PCLAUDE:-}"
	if [ -z "$sa_launcher" ]; then
		sa_launcher="$(command -v pclaude 2>/dev/null || command -v claude-profile 2>/dev/null || printf '')"
	fi
	if [ -n "$sa_launcher" ] && [ -n "$RI_PROFILE" ] && [ "$RI_PROFILE" != none ]; then
		SUPERVISE_CMD=("$sa_launcher" --lane "$sa_lane" "$RI_PROFILE")
		SUPERVISE_VIA="the launcher ($sa_launcher), which configures the account and runs lane-start"
		return 0
	fi
	sa_start=""
	if [ -x "$selfdir/lane-start" ]; then sa_start="$selfdir/lane-start"
	else sa_start="$(command -v lane-start 2>/dev/null || printf '')"
	fi
	[ -n "$sa_start" ] || return 1
	SUPERVISE_CMD=("$sa_start" --fresh --operation "$sa_op")
	[ -n "$RI_DIR" ] && [ "$RI_DIR" != none ] && SUPERVISE_CMD+=(--dir "$RI_DIR")
	SUPERVISE_CMD+=("$sa_lane")
	if [ -n "$sa_launcher" ]; then
		SUPERVISE_VIA="lane-start directly ($sa_start) — this lane's record names no profile, so there is nothing to tell the launcher which account to come up in"
	else
		SUPERVISE_VIA="lane-start directly ($sa_start) — there is no launcher on PATH here"
	fi
	return 0
}

# THE FAILURE SURFACE. The supervisor is STILL IN THE PANE, which is the whole
# of what this change is for, and what it offers is one line to retry and one
# to walk away with. A pane with no terminal — the suite, a `--supervise` run
# from a script — is told the same thing and gets exit 3 rather than a read
# nobody will answer.
#
# 3 = reported, no terminal · 10 = reported, ask the person.
supervise_failed() {   # <lane> <operation> <reason>
	sf_lane="$1"; sf_op="$2"; sf_why="$3"
	LANES_NO_FETCH=1 "$LANES_EDIT" set-restart-intent "$sf_lane" failed \
		--expect 'starting|pending' --expect-operation "$sf_op" \
		--reason "$sf_why" >/dev/null 2>&1 ||
		note "the restart intent could not be marked failed (another operation may hold this lane now). Read it:  $prog --restart-status --lane $sf_lane"
	say ""
	say "RESTART FAILED — lane $sf_lane, operation $sf_op"
	say "  $sf_why"
	say ""
	say "  The old session is gone (this pane was respawned for the restart) and the"
	say "  handoff it wrote is intact: its top block is still the first prompt the next"
	say "  session gets, and nothing of the lane has been lost."
	say ""
	say "  retry:   $(quoted "$SELF_ABS") --supervise --lane $sf_lane --operation $sf_op"
	say "  read it: $(quoted "$SELF_ABS") --restart-status --lane $sf_lane"
	say "  by hand: lane $sf_lane"
	say ""
	if [ "${LANE_SUPERVISOR_NO_PROMPT:-0}" = 1 ] || [ ! -t 0 ]; then
		note "there is no terminal here to offer the retry on, so this supervisor exits 3 rather than blocking on a read nobody will answer. The intent is \`failed\` and carries the reason; the three lines above are the whole of what to do next."
		return 3
	fi
	return 10
}

# THE ONE QUESTION THIS COMMAND EVER ASKS, and it asks it only where a person is
# looking at the pane. `r` retries the SAME operation; anything else leaves the
# pane to the person, with the intent `failed` and every line above still on
# screen.
supervise_prompt() {   # <lane> <operation>
	printf '%s: retry this restart? [r = retry, q = leave it] ' "$prog" >&2
	sp_ans=""
	IFS= read -r sp_ans || { printf '\n' >&2; return 3; }
	case "$sp_ans" in
	r | R | retry) return 0 ;;
	*)
		say ""
		say "left as it is. The intent stays \`failed\` and this pane is yours:"
		say "  retry:   $(quoted "$SELF_ABS") --supervise --lane $1 --operation $2"
		return 3 ;;
	esac
}

# THE SUPERVISOR PROPER. It loops only because a RETRY is the same launch made
# again under the same operation, generation, digest, directory and mode — the
# spec's idempotent retry — and never because a child that ended is relaunched
# on its own.
supervise_run() {   # <lane> <operation>
	sr_lane="$1"; sr_op="$2"
	sr_pidf="$(mktemp "${TMPDIR:-/tmp}/lane-supervisor.XXXXXX" 2>/dev/null || printf '')"
	[ -n "$sr_pidf" ] || die "no temporary file could be made to record the launch's pid, and without it this supervisor cannot tell a child that died from one that is starting. Nothing was started." 2
	SV_PIDFILE="$sr_pidf"
	while : ; do
		# ---- the claim: `pending`/`failed` -> `starting`, fenced on the
		# operation AND the generation. It is INSIDE the loop because a retry
		# is a second claim of the same operation and must take the fence
		# again: between the failure and the `r` a person may have started the
		# lane by hand, and the retry must lose that race rather than win it.
		ri_load "$sr_lane" >/dev/null 2>&1 || :
		case "$RI_STATE" in
		pending) sr_att=(--attempt=1) ;;
		failed)  sr_att=(--bump-attempt) ;;
		*) die "lane $sr_lane's restart intent is '${RI_STATE:-none}' and this supervisor can only launch from \`pending\` or \`failed\`. Nothing was started. Read it:  $prog --restart-status --lane $sr_lane" 2 ;;
		esac
		sr_crc=0
		LANES_NO_FETCH=1 "$LANES_EDIT" set-restart-intent "$sr_lane" starting \
			--expect "$RI_STATE" --expect-operation "$sr_op" --expect-generation "${RI_GEN:-0}" \
			"${sr_att[@]}" --reason "supervisor claimed the operation" >/dev/null 2>&1 || sr_crc=$?
		case "$sr_crc" in
		0) : ;;
		7) die "lane $sr_lane's restart intent moved between reading it and claiming it: another act owns operation $sr_op now. Nothing was started. Read it:  $prog --restart-status --lane $sr_lane" 2 ;;
		*) die "lane $sr_lane's restart intent could not be claimed (\`set-restart-intent\` exited $sr_crc), and this supervisor will not launch without a fenced hold on operation $sr_op. Nothing was started." 2 ;;
		esac
		ri_load "$sr_lane" >/dev/null 2>&1 || :

		if ! supervise_argv "$sr_lane" "$sr_op"; then
			supervise_failed "$sr_lane" "$sr_op" "there is no launcher and no lane-start on PATH here, so nothing could be started"
			sr_fs=$?
			[ "$sr_fs" = 10 ] || return "$sr_fs"
			supervise_prompt "$sr_lane" "$sr_op" || return $?
			continue
		fi
		sr_dir="$RI_DIR"
		if [ -n "$sr_dir" ] && [ "$sr_dir" != none ] && [ ! -d "$sr_dir" ]; then
			supervise_failed "$sr_lane" "$sr_op" "the intent's checkout $sr_dir does not exist here, so the launch was not made"
			sr_fs=$?
			[ "$sr_fs" = 10 ] || return "$sr_fs"
			supervise_prompt "$sr_lane" "$sr_op" || return $?
			continue
		fi
		say "lane $sr_lane — restarting (operation $sr_op, attempt ${RI_ATTEMPT:-1})"
		say "  through $SUPERVISE_VIA"
		say "  first prompt: the top block of ${RI_HANDOFF:-the handoff this lane names}"
		say "  this supervisor stays in the pane: whatever the launch does, it will say so here."
		say ""
		: > "$sr_pidf"
		supervise_watch "$sr_lane" "$sr_op" "${RI_GEN:-0}" "$sr_pidf" "$RI_NEW" "$RI_OLD" "$RI_PANE" &
		sr_watch=$!
		sr_status=0
		# THE PID IS WRITTEN BY THE PROCESS THAT BECOMES THE CHILD, and `sh -c`
		# is how, on bash 3.2 as well as on a modern one: `$$` inside it is
		# that shell's pid, and the `exec` on the next word makes that pid the
		# launch's own. `$BASHPID` would be the one-liner and macOS ships bash
		# 3.2, which does not have it.
		if [ -n "$sr_dir" ] && [ "$sr_dir" != none ]; then
			( cd -- "$sr_dir" && LANE_START_FRESH=1 LANE_RESTART_OPERATION="$sr_op" \
				exec sh -c 'printf "%s\n" "$$" > "$1"; shift; exec "$@"' _ "$sr_pidf" "${SUPERVISE_CMD[@]}" ) || sr_status=$?
		else
			LANE_START_FRESH=1 LANE_RESTART_OPERATION="$sr_op" \
				sh -c 'printf "%s\n" "$$" > "$1"; shift; exec "$@"' _ "$sr_pidf" "${SUPERVISE_CMD[@]}" || sr_status=$?
		fi
		kill "$sr_watch" 2>/dev/null
		wait "$sr_watch" 2>/dev/null
		# WHAT THE RECORD SAYS NOW IS WHAT DECIDES, and never this process's
		# memory of what it started: the observer is the only thing that ever
		# had positive evidence, and it wrote that evidence down.
		ri_load "$sr_lane" >/dev/null 2>&1 || :
		if [ "$RI_STATE" = ready ]; then
			say ""
			say "lane $sr_lane: the replacement session was CONFIRMED (operation $sr_op, transcript ${RI_NEW:-unrecorded}) and has now exited."
			say "  A session that exited on purpose is not relaunched here — that is \`lane $sr_lane\`."
			return 0
		fi
		sr_why="the launch ended with status $sr_status before readiness was confirmed"
		case "$RI_REASON" in
		INDETERMINATE:*) sr_why="the launch ran without readiness evidence and then ended with status $sr_status; $RI_REASON" ;;
		esac
		supervise_failed "$sr_lane" "$sr_op" "$sr_why"
		sr_fs=$?
		[ "$sr_fs" = 10 ] || return "$sr_fs"
		supervise_prompt "$sr_lane" "$sr_op" || return $?
	done
}

# ============ THE PANE SUPERVISOR AND THE RESTART STATUS (openRepoTools#94)
#
# WHY A PROCESS STAYS IN THE PANE. `/ctx` respawned its own pane and treated
# tmux ACCEPTING the command as proof a session had started. Tmux accepting a
# command says nothing about whether the child resolved a profile, executed
# Claude, stayed alive, or consumed the handoff it was supposed to. On
# 2026-09-15 the preservation side completed, the old process was killed, and
# what came back was not the act the record says — with nothing in the pane to
# notice, because the thing tmux started was the launch itself and a launch
# that ends takes the pane with it.
#
# THE PROTOCOL ALREADY ASKS FOR THIS IN SO MANY WORDS. Amendment 11's own
# invariant is **"No path the launcher opened exits the pane"** (clause (b),
# with its width, closed under `R-A11-16`); `/ctx` opened a path that did. The
# supervisor is that invariant kept for the one act that had no one keeping it:
# it is the pane's root process, it launches the real thing as a CHILD, and
# whatever the child does the pane still has a process in it that can say what
# happened and offer the retry.
#
# AND IT IS NOT A NEW WORD ON `PATH` (Amendment 18 Addendum 2 (i-8): *"no word
# is kept on `PATH` for it alone"*, which is the ground on which `restart` was
# removed from the installed set). It is a MODE of the command that already
# owns the `/ctx` transaction, invoked by absolute path — tmux must not depend
# on the respawned pane's `PATH` — and a person still has exactly one word,
# `lane`.
#
# WHAT IT NEVER DOES: it never kills the child (Amendment 8(f): ending
# somebody's process is not a boundary script's act), it never relaunches a
# child that exited AFTER readiness, it never runs a picker, it never
# rediscovers a launch choice from the current directory, the window title or a
# rotating default, and it never marks a lane running on anything but positive
# evidence.
#
# SUPERVISOR EXIT CODES, and they are contract:
#   0  the child became ready and has since exited normally, or the operator
#      ended the supervisor after a reported outcome
#   2  REFUSED before launching anything — a stale operation, a mismatched
#      pane, an intent that is not this lane's, an ambiguous live holder
#   3  the launch FAILED before readiness and there was no terminal here to
#      offer the retry on (the intent is `failed` and carries the reason)
#   4  the launch was INDETERMINATE: the child is alive and readiness could not
#      be confirmed inside the deadline. Nothing was killed and nothing was
#      marked running

# HOW LONG READINESS IS WAITED FOR. Sixty seconds is the design's number and a
# slow workstation's transcript can take a few of them; the seam is for the
# suite, which must not spend a minute proving a timeout.
SUPERVISE_READY_SECONDS="${LANE_SUPERVISOR_READY_SECONDS:-60}"
case "$SUPERVISE_READY_SECONDS" in '' | *[!0-9]*) SUPERVISE_READY_SECONDS=60 ;; esac

# ONE FIELD OF THE LANE'S RESTART INTENT. Empty where there is none, which
# every caller below tests for rather than guessing at.
ri_field() {   # <lane> <key>
	LANES_NO_FETCH=1 "$LANES_EDIT" restart-intent "$1" 2>/dev/null \
		| awk -F'\t' -v k="$2" '$1 == k { print $2; exit }'
}

# THE WHOLE INTENT ONCE, into `RI_*`. 0 where there is one, 8 where there is
# not, 1 where the read FAILED — which is never the same as "there is none"
# (Amendment 7(d)).
ri_load() {   # <lane>
	RI_STATE=""; RI_OP=""; RI_GEN=""; RI_MODE=""; RI_AGENT=""; RI_PROFILE=""
	RI_DIR=""; RI_PANE=""; RI_WINDOW=""; RI_HANDOFF=""; RI_DIGEST=""
	RI_OLD=""; RI_NEW=""; RI_ATTEMPT=""; RI_REASON=""; RI_FILE=""
	ril_out=""; ril_rc=0
	ril_out="$(LANES_NO_FETCH=1 "$LANES_EDIT" restart-intent "$1" 2>/dev/null)" || ril_rc=$?
	case "$ril_rc" in
	0) : ;;
	8) return 8 ;;
	*) return 1 ;;
	esac
	RI_STATE="$(printf '%s\n' "$ril_out"   | awk -F'\t' '$1 == "state" { print $2; exit }')"
	RI_OP="$(printf '%s\n' "$ril_out"      | awk -F'\t' '$1 == "operation" { print $2; exit }')"
	RI_GEN="$(printf '%s\n' "$ril_out"     | awk -F'\t' '$1 == "generation" { print $2; exit }')"
	RI_MODE="$(printf '%s\n' "$ril_out"    | awk -F'\t' '$1 == "mode" { print $2; exit }')"
	RI_AGENT="$(printf '%s\n' "$ril_out"   | awk -F'\t' '$1 == "agent" { print $2; exit }')"
	RI_PROFILE="$(printf '%s\n' "$ril_out" | awk -F'\t' '$1 == "profile" { print $2; exit }')"
	RI_DIR="$(printf '%s\n' "$ril_out"     | awk -F'\t' '$1 == "dir" { print $2; exit }')"
	RI_PANE="$(printf '%s\n' "$ril_out"    | awk -F'\t' '$1 == "pane" { print $2; exit }')"
	RI_WINDOW="$(printf '%s\n' "$ril_out"  | awk -F'\t' '$1 == "window" { print $2; exit }')"
	RI_HANDOFF="$(printf '%s\n' "$ril_out" | awk -F'\t' '$1 == "handoff" { print $2; exit }')"
	RI_DIGEST="$(printf '%s\n' "$ril_out"  | awk -F'\t' '$1 == "digest" { print $2; exit }')"
	RI_OLD="$(printf '%s\n' "$ril_out"     | awk -F'\t' '$1 == "old_transcript" { print $2; exit }')"
	RI_NEW="$(printf '%s\n' "$ril_out"     | awk -F'\t' '$1 == "new_transcript" { print $2; exit }')"
	RI_ATTEMPT="$(printf '%s\n' "$ril_out" | awk -F'\t' '$1 == "attempt" { print $2; exit }')"
	RI_REASON="$(printf '%s\n' "$ril_out"  | awk -F'\t' '$1 == "reason" { print $2; exit }')"
	RI_FILE="$(printf '%s\n' "$ril_out"    | awk -F'\t' '$1 == "file" { print $2; exit }')"
	return 0
}

# THE STATUS SURFACE — read-only, and the whole of what an operator needs to
# tell a preservation failure, a tmux refusal, a launcher failure, an immediate
# child exit, an indeterminate readiness and a confirmed run apart.
if [ "$do_status" = 1 ]; then
	[ -n "$lane" ] || die "--restart-status needs the lane: $prog --restart-status --lane <lane>" 2
	rst_rc=0
	ri_load "$lane" || rst_rc=$?
	case "$rst_rc" in
	8) say "lane $lane has no restart intent: no /ctx is in flight for it."; exit 0 ;;
	1) die "lane $lane's restart intent could not be read (\`$LANES_EDIT restart-intent $lane\` failed). That is NOT 'there is none' — a read that failed is never an answer (Amendment 7(d))." 1 ;;
	esac
	say "lane        $lane"
	say "intent      $RI_STATE (attempt ${RI_ATTEMPT:-0})"
	say "operation   ${RI_OP:-none}   generation ${RI_GEN:-0}"
	say "mode        ${RI_MODE:-none}"
	say "agent       ${RI_AGENT:-none}   profile ${RI_PROFILE:-none}"
	say "dir         ${RI_DIR:-none}"
	say "pane        ${RI_PANE:-none}   window ${RI_WINDOW:-none}"
	say "handoff     ${RI_HANDOFF:-none}"
	say "digest      ${RI_DIGEST:-none}"
	say "transcript  old ${RI_OLD:-none} → new ${RI_NEW:-none}"
	say "reason      ${RI_REASON:-none}"
	say "file        ${RI_FILE:-none}"
	# THE LANE'S OWN LIFECYCLE BESIDE IT WHERE THE HELPER HAS ONE
	# (openRepoTools#91). Where it does not, the line says so rather than
	# leaving a reader to wonder which of the two they are looking at.
	rst_ls=""; rst_lrc=0
	rst_ls="$(LANES_NO_FETCH=1 "$LANES_EDIT" lane-state "$lane" 2>/dev/null \
		| awk -F'\t' '$1 == "state" { print $2; exit }')" || rst_lrc=$?
	case "$rst_lrc" in
	0) say "lifecycle   ${rst_ls:-none} (lanes-edit.sh lane-state $lane)" ;;
	# 8 IS THIS LANE HAVING NO SNAPSHOT and 2 IS THE HELPER HAVING NO WORD FOR
	# ONE, and telling the two apart matters the day #91 lands: a reader shown
	# "this lanes-edit.sh has no lane-state" about a helper that has one would
	# go looking for an installation problem that is not there.
	8) say "lifecycle   no snapshot for this lane yet (\`$LANES_EDIT lane-state $lane\` answers 8)" ;;
	2) say "lifecycle   not recorded here — this lanes-edit.sh has no \`lane-state\` (opensoft/openRepoTools#91 has not landed on this workstation)" ;;
	*) say "lifecycle   could not be read (\`$LANES_EDIT lane-state $lane\` exited $rst_lrc), which is NOT 'there is none' (Amendment 7(d))" ;;
	esac
	case "$RI_STATE" in
	failed)   say ""; say "RETRY:   $(quoted "$SELF_ABS") --supervise --lane $lane --operation ${RI_OP:-<id>}" ;;
	pending)  say ""; say "NOT YET CLAIMED: no supervisor has taken this operation. The pane it was written for may never have been respawned." ;;
	starting) say ""; say "IN FLIGHT: a supervisor holds this operation. Do not start a second one — read the pane it is in (${RI_PANE:-pane not recorded})." ;;
	ready)    say ""; say "DONE: this restart was confirmed. It authorises no further launch; an ordinary \`lane $lane\` resumes the lane." ;;
	esac
	exit 0
fi

# THE PANE IS HELD OPEN ON EVERY NON-ZERO EXIT OF THIS MODE, refusals
# included. Amendment 11's invariant is *"No path the launcher opened exits the
# pane"*, and a supervisor that refused before launching and then returned would
# leave tmux printing `[exited]` over the one message that says why — which is
# the shape of the defect this whole mode exists to close, reached through its
# own front door. Where there is no terminal there is nobody to hold it for, and
# the status is simply returned.
SV_PIDFILE=""
sv_on_exit() {
	sv_hs=$?
	[ -z "$SV_PIDFILE" ] || rm -f -- "$SV_PIDFILE" 2>/dev/null
	[ "$sv_hs" = 0 ] && return 0
	[ "${LANE_SUPERVISOR_NO_PROMPT:-0}" = 1 ] && return 0
	[ -t 0 ] || return 0
	printf '\n%s: this pane is held open so the lines above can be read (exit %s). Press Enter to close it. ' "$prog" "$sv_hs" >&2
	IFS= read -r sv_ignored || :
	return 0
}

if [ "$do_supervise" = 1 ]; then
	trap sv_on_exit EXIT
	[ -n "$lane" ] || die "--supervise needs the lane: $prog --supervise --lane <lane> --operation <id>" 2
	[ -n "$operation" ] || die "--supervise needs the operation it was started for: $prog --supervise --lane $lane --operation <id>. A supervisor that took whatever intent it found would be a supervisor that launches a lane for an act somebody else is in the middle of." 2

	# ---- the operation this supervisor was started for, and no other
	sv_rc=0
	ri_load "$lane" || sv_rc=$?
	case "$sv_rc" in
	8) die "lane $lane has no restart intent, so there is nothing for operation $operation to launch. Nothing was started. A /ctx whose intent could not be written should have refused before it killed anything — read the lane:  $prog --restart-status --lane $lane" 2 ;;
	1) die "lane $lane's restart intent could not be read (\`$LANES_EDIT restart-intent $lane\` failed). That is NOT 'there is none', and this supervisor will not launch a session for an operation it could not verify (Amendment 7(d)). Nothing was started." 1 ;;
	esac
	[ "$RI_OP" = "$operation" ] ||
		die "operation $operation is not lane $lane's current restart operation, which is ${RI_OP:-none} (intent ${RI_STATE:-none}, generation ${RI_GEN:-0}). A stale supervisor never launches against a newer operation: nothing was started. Read it:  $prog --restart-status --lane $lane" 2
	case "$RI_STATE" in
	pending | failed) : ;;
	starting) die "lane $lane's restart operation $operation is already \`starting\` — a supervisor holds it, in ${RI_PANE:-a pane this record does not name}. A second one would launch a second session of one lane, which is the collision this whole protocol is about (Amendment 18(h)). Nothing was started." 2 ;;
	ready)    die "lane $lane's restart operation $operation is already \`ready\`: that restart was confirmed and this record authorises no further launch. Nothing was started. To open the lane:  lane $lane" 2 ;;
	*)        die "lane $lane's restart intent is in state '${RI_STATE:-none}', which this supervisor does not know how to launch from. Nothing was started." 2 ;;
	esac
	[ "$RI_MODE" = fresh-from-handoff ] ||
		die "lane $lane's restart intent names launch mode '${RI_MODE:-none}' and this supervisor makes only 'fresh-from-handoff' launches. Nothing was started." 2

	# ---- the pane: this supervisor is IN the pane the intent was written for
	#
	# A SUPERVISOR IN THE WRONG PANE WOULD PUT A SECOND SESSION OF THIS LANE
	# SOMEWHERE THE LANE IS NOT. The intent records the pane `/ctx` respawned;
	# `$TMUX_PANE` is where this process actually is. They are compared where
	# both are knowable, and a comparison that CANNOT be made is said rather than
	# assumed — this runs under a fake tmux in the suite and under none at all
	# where a person invoked it by hand.
	sv_pane_here="${TMUX_PANE:-}"
	pane_agrees "$RI_PANE" "$sv_pane_here" ||
		die "lane $lane's restart intent was written for pane $RI_PANE and this supervisor is in $sv_pane_here. Nothing was started: a launch here would put this lane's session in a pane the lane's own record does not name, and that record is what every other reader goes by." 2

	# ---- the handoff's digest: the first prompt is that file, and only that file
	if [ -n "$RI_HANDOFF" ] && [ "$RI_HANDOFF" != none ] && [ -n "$RI_DIGEST" ] && [ "$RI_DIGEST" != none ]; then
		sv_now="$(handoff_digest "$RI_HANDOFF")"
		[ "$sv_now" = "$RI_DIGEST" ] ||
			die "lane $lane's handoff has changed since operation $operation was written: the intent records $RI_DIGEST for $RI_HANDOFF and it now digests $sv_now. The top block of that file is the new session's FIRST PROMPT, so launching now would deliver a block this /ctx did not write. Nothing was started. Take the handoff again:  $prog --restart" 2
	fi

	# ---- a live holder makes this ambiguous, and ambiguity refuses
	#
	# `live-holder` answers who is running this lane NOW. A supervisor that
	# launched behind one would be Amendment 18(h)'s second binding, made by the
	# tooling itself. A read that FAILED is not "nobody is": it refuses too,
	# because this is the one moment a second process gets created.
	sv_hold=""; sv_hrc=0
	sv_hold="$(LANES_NO_FETCH=1 "$LANES_EDIT" live-holder "$lane" 2>/dev/null)" || sv_hrc=$?
	case "$sv_hrc" in
	0) [ -z "$sv_hold" ] ||
		die "lane $lane already has a live holder, so this supervisor will not start a second session of it (Amendment 18(h)):
$sv_hold
Nothing was started. If that process is a leftover of an earlier attempt, retire it first — \`lane-end $lane --retire <pid>\` — then retry:  $prog --supervise --lane $lane --operation $operation" 2 ;;
	8 | 2) : ;;
	*) die "lane $lane's live holders could not be read (\`$LANES_EDIT live-holder $lane\` exited $sv_hrc), so whether this lane is already running is UNKNOWN from here — and a read that failed is never an answer (Amendment 7(d)). This supervisor will not create a second process on a lane that may be live. Nothing was started." 1 ;;
	esac

	supervise_run "$lane" "$operation"
	exit $?
fi


# EVERY READ OF THE REGISTER GOES THROUGH ONE FENCE, and Amendment 7(d) is the
# whole of it: `0` an answer, `8` NO ANSWER and `2` a helper predating the read
# — both of those fall to the next rung — and ANYTHING ELSE is a read that
# FAILED, which is neither. A register that could not be read is not "this
# window is not a lane", and the steps below would then write a PAUSED record,
# a stamp and a restart command for a lane this window is not.
#
# IT SETS A VARIABLE RATHER THAN PRINTING ITS ANSWER, and that is load-bearing:
# a refusal inside `$( )` kills only the substitution's subshell, and this
# command would carry on with an empty answer.
#
# AND `2` IS TWO ANSWERS (Amendment 15; Copilot round 2 on openRepoTools#47).
# It is what a helper predating a subcommand spends on an unknown one — the
# rung this fence falls through for, and every workstation until adoption
# reaches it — and it is ALSO `canon_lane`'s refusal of a register holding two
# rows that differ only by case, which every read through `check_lane_name` now
# carries. Falling through THAT is binding this window to whichever lane the
# next rung happens to answer with, and then renaming the window, writing a
# PAUSED record and respawning a pane for it. So the refusal is asked for BY
# ITS OWN WORDS — no old helper emits them from an unknown subcommand, which is
# how `lane-start:755-767`, `lane-end` and `restart` tell the two apart — and
# relayed, with the fall-through for a genuinely old helper left as it was.
sread() {   # sread <var> "<what the failure is NOT>" <verb> [args…]
	sr_var="$1"; sr_not="$2"; shift 2
	sr_out=""; sr_rc=0
	sr_out="$(LANES_NO_FETCH=1 "$LANES_EDIT" "$@" 2>/dev/null)" || sr_rc=$?
	case "$sr_rc" in
	0) : ;;
	2)
		sr_why="$(LANES_NO_FETCH=1 "$LANES_EDIT" "$@" 2>&1 >/dev/null || :)"
		case "$sr_why" in
		*"Amendment 15(d)"*)
			die "the register holds two rows for this lane that differ only by case, so no read of it is unambiguous and this command will not pick one (Amendment 15(d)). Nothing was written and nothing was renamed. The helper's own words:
$sr_why" 2 ;;
		esac
		sr_out="" ;;
	8) sr_out="" ;;
	*) die "\`$LANES_EDIT $1\` failed (exit $sr_rc). That is NOT $sr_not — a read that failed is never an answer (Amendment 7(d)), and this command will not bind a lane, write a PAUSED record or print a restart command on one. Run it by hand to see what it says." 1 ;;
	esac
	eval "$sr_var=\$sr_out"
}

# ------------------------------------------------- 1. the identity triple
#
# THE WORKSTATION COMES FROM CONFIGURATION, NEVER FROM `hostname` (Amendment 11,
# ratified decision 8(d)): the helper's own `workstation` read is the one
# implementation, and its second tab-separated field says which rung answered.
ws_pair=""; ws_rc=0
ws_pair="$("$LANES_EDIT" workstation 2>/dev/null)" || ws_rc=$?
ws="${ws_pair%%	*}"
ws_src="${ws_pair##*	}"
# AND IT NEVER WRITES A PLACEHOLDER (`R-A11-14`). Inside a container with no
# `LANES_WORKSTATION` the register and object-log writes STOP — they are filed
# under the workstation, and a record filed under a container id is a record no
# restart of any workstation will ever find — while the SWAP ITSELF GOES ON
# (A11 Addendum 4 ruling 11, `R-A11-11`: *a swap is never left unwritten*). The
# handoff file is refreshed, it NAMES the gap, and the restart line is printed
# with `--lane`, because the row is not flipped either.
ws_missing=""
if [ "$ws_rc" != 0 ] && [ "$ws_rc" != 8 ] && [ -z "$ws" ]; then
	ws_missing=1
	note "NO WORKSTATION READ: \`$LANES_EDIT workstation\` exited $ws_rc and named none. Exit 2 is a lanes-edit.sh predating Amendment 11 (\`R-A11-8\`); anything else is a read that failed. Either way no record is filed under no workstation (\`R-A11-14\`): the register and object-log writes below are NOT made. The handoff is still refreshed and NAMES this gap, and the restart line is still printed, with --lane."
elif [ "$ws_src" = container-unset ] || [ -z "$ws" ]; then
	ws_missing=1
	note "NO WORKSTATION: this is a container and \$LANES_WORKSTATION is not set. The register and object-log writes below are NOT made — both logs are append-only and a record filed under a container id is unfindable (\`R-A11-14\`). The handoff is refreshed and NAMES the gap, and the restart line is printed with --lane. The launcher exports the value into every session and container it starts; to close it now: export LANES_WORKSTATION=<this host name> and re-run."
fi

# THE WINDOW, its `<@id>`, and the lane — the launcher's own order, with
# Amendment 11 clause (b)'s zero-question step in the middle, so this command
# and the launcher never disagree about which lane this window is.
# THREE TMUX SPELLINGS OF ONE WINDOW, AND NEITHER IS DERIVED FROM ANOTHER
# (Amendment 11 clause (c), as `lane-start:975-984` states it): the record's
# `window` sub-field is `<session>:<index> <@id>`, two space-separated refs, and
# the HARNESS's own `tmux` field — which `window-session` matches a session
# record on, and which is where the PANE comes from — is `<session>:<@id>`.
# Reading one for the other is how a record names a window nothing can resolve.
win=""; wid=""; window_name=""; win_harness=""
if have_tmux; then
	win="$(tmux display-message -p '#S:#I' 2>/dev/null || :)"
	case "$win" in *:[0-9]*) : ;; *) win="" ;; esac
	wid="$(tmux display-message -p '#{window_id}' 2>/dev/null || :)"
	case "$wid" in @[0-9]*) : ;; *) wid="" ;; esac
	window_name="$(tmux display-message -p '#W' 2>/dev/null || :)"
	win_harness="$(tmux display-message -p '#{session_name}:#{window_id}' 2>/dev/null || :)"
fi
[ -n "$win" ] || win="${WORKBENCHES_CLAUDE_WINDOW_REF:-}"
case "$win" in *:[0-9]*) : ;; *) win="" ;; esac
[ -n "$wid" ] || wid="${WORKBENCHES_CLAUDE_WINDOW_ID:-}"
case "$wid" in @[0-9]*) : ;; *) wid="" ;; esac
window_ref="${win}${wid:+ $wid}"

if [ -z "$lane" ] && [ -n "$window_name" ]; then
	sread row_probe "'this window is not a lane'" register-row "$window_name"
	[ -n "$row_probe" ] && lane="$window_name"
fi
if [ -z "$lane" ]; then
	wl_ref="${wid:-$win}"
	if [ -n "$wl_ref" ] && [ -n "$ws" ]; then
		sread candidate "'no lane is bound to this window'" window-lane "$ws" "$wl_ref"
		case "$candidate" in
		[A-Za-z0-9_]*) lane="$candidate" ;;
		esac
	fi
fi
if [ -z "$lane" ] && [ -n "$ws" ]; then
	# The swap record, read exactly as the launcher reads it: the tab is the
	# contract. A row that printed before a failed read, or one with no tab, is
	# not a record row — `cut -f 1` would hand back the whole line, lane-shaped
	# and wrong.
	sread rows "'this workstation has no swap record'" swapped "$ws"
	first="$(printf '%s\n' "$rows" | head -n 1)"
	case "$first" in
	*"	"*)
		candidate="${first%%	*}"
		case "$candidate" in
		[A-Za-z0-9_]*) lane="$candidate" ;;
		esac ;;
	esac
fi
if [ -z "$lane" ]; then
	case "$window_name" in
	*-[0-9]*) die "nothing binds this window: it is named '$window_name', the register has no row for that name, no record of this workstation names this window, and this workstation has no swap record to fall back to. Bind it first, then hand off:
    lane-start --no-launch ${window_name%-*} ${window_name##*-}" 2 ;;
	*) die "nothing binds this window${window_name:+ (it is named '$window_name', which is not a lane name)}, so there is no lane to hand off. Bind it first — the repository and the position are the operator's to name:
    lane-start --no-launch <repo> <n>
    or name the lane here: $prog --lane <lane>" 2 ;;
	esac
fi
# ONE NAME UNDER ANY CASE, AND BEFORE ANYTHING IS RENAMED OR WRITTEN
# (Amendment 15; Copilot round 2 on openRepoTools#47). Every rung above answers
# with a spelling of its own — the tmux window's name, a record's lane field,
# the swap row's first cell — and `--lane` answers with whatever was typed,
# validated by nothing until the record write far below. The REGISTER ROW's
# spelling is the canonical one, and it is what the window rename, the top
# block, the payload, the object log's lane field and the restart line must all
# carry; so it is taken ONCE, here, through the resolver `lane-start`,
# `lane-end`, `lanes` and `restart` share. It is also where an AMBIGUOUS
# register is refused (15(d), through the fence above) and where a `--lane`
# that is not a lane NAME at all is refused — both before the rename, so that a
# refusal leaves the window exactly as it found it.
#
# WHAT IT IS NOT IS A CHECK THAT THE LANE HAS A ROW (Copilot round 4 on
# openRepoTools#47). `canon_lane` answers with the TYPED spelling where no row
# matches, deliberately — `lane-start` uses the same resolver for a lane it is
# about to create — so a well-formed `--lane` this register has never carried
# reaches the writes below and is named there, by the row read that cannot find
# a handoff and by the row flip that finds no state cell to replace.
sread lane_canon "'this lane has no row'" canon-lane "$lane"
if [ -n "$lane_canon" ] && [ "$lane_canon" != "$lane" ]; then
	step "lane $lane → $lane_canon (Amendment 15: the register row's spelling is canonical)"
	lane="$lane_canon"
fi
case "$lane" in
*[!A-Za-z0-9._-]* | .* | -* | '')
	die "'$lane' is not a lane name (letters, digits, . _ -, not opening with . or -). Nothing was renamed and nothing was written: a name the register cannot hold is one every write below would refuse anyway, and the window would already have been renamed to it." 2 ;;
esac
step "lane=$lane${window_ref:+ window=$window_ref} workstation=${ws:-<none>}"

# THE OTHER TWO NAMES MADE TO MATCH IT, mechanically. The window is renamed
# here; the SESSION's name is the lane's messaging address (Amendment 2) and
# there is no API to rename a running session from outside it, so where the
# live record's name is not the lane the act is PRINTED — it is the operator's
# `/rename`, and it is not a question.
if have_tmux && [ -n "$window_name" ] && [ "$window_name" != "$lane" ]; then
	tmux rename-window "$lane" 2>/dev/null &&
		step "window renamed '$window_name' → '$lane' (Amendment 8(b): the window IS the lane)"
fi

# THE LIVE RECORD OF THIS WINDOW — the session's uuid, the PANE `--exit` and
# `--restart` type into, and the name `/rename` may be owed. `window-session`
# is the one implementation of this read (Amendment 11 clause (h)).
sess_uuid=""; pane=""; sess_name=""; sess_profile=""
if [ -n "$win_harness" ]; then
	ws_ref="$win_harness"
	if [ -n "$ws_ref" ]; then
		sread wsess "'no live session is in this window'" window-session "$ws_ref"
		if [ -n "$wsess" ]; then
			# `<sid><US><tmux><US><name><US><pid><US><profile>`, the record's own fields.
			sess_uuid="$(printf '%s' "$wsess" | awk -F'\037' '{print $1}')"
			pane="$(printf '%s' "$wsess" | awk -F'\037' '{print $2}')"
			sess_name="$(printf '%s' "$wsess" | awk -F'\037' '{print $3}')"
			sess_profile="$(printf '%s' "$wsess" | awk -F'\037' '{print $5}')"
		fi
	fi
fi
# THE SHELL'S OWN SESSION BEATS THE RECORD. The harness exports
# `CLAUDE_CODE_SESSION_ID` into every shell a session runs, and a session naming
# itself is the one fact no record can be more current than.
[ -n "${CLAUDE_CODE_SESSION_ID:-}" ] && sess_uuid="$CLAUDE_CODE_SESSION_ID"
if [ -n "$sess_name" ] && [ "$sess_name" != "$lane" ] && [ "$sess_name" != none ]; then
	note "the session in this window is named '$sess_name', not '$lane' — the session name is the lane's messaging address (Amendment 2) and no API renames a running one from outside it. In the session, type:  /rename $lane"
fi

# The uuid the record's `session` field carries. `write_event` refuses anything
# that is not a transcript uuid — including the literal `unknown` — so the id is
# taken from the shell, then from the row, and a lane with neither is named
# rather than written wrong (Amendment 11 clause (e)).
uuid="$sess_uuid"
if [ -z "$uuid" ]; then
	sread row_uuid "'this lane has no recorded session'" last-session "$lane"
	uuid="$row_uuid"
fi

# ---------------------------------------------- Amendment 17(b): the agent
#
# A MANIFEST KEY — letters, digits, `.`, `_`, `-` — and the shape check is also
# how this sub-field gets SPEC rev 6 §5's `; ` rule without a token of its own:
# the pattern admits neither a `;` nor a space. The writer refuses a bad one
# too (`lanes-edit.sh`'s `pause_subfields_check`); this is the caller-side half,
# so the refusal names the flag rather than the grammar.
[ -n "$agent" ] || agent="${LANES_AGENT:-claude}"
case "$agent" in
*[!A-Za-z0-9._-]* | '') die "--agent takes a manifest key — letters, digits, '.', '_', '-' — and '$agent' is not one. The record's \`agent\` sub-field is what \`lane-start --agent\` reads back to know which launcher to use (Amendment 17(b))." 2 ;;
esac
# `transcript <id|none>`: the agent's own resumable id where it has one. For
# `claude` that is this lane's transcript uuid; an agent with none writes
# `none`, which is an answer and not a gap.
#
# IT IS THE RESOLVED `$uuid` AND NOT `$sess_uuid` (Copilot round 1 on
# openRepoTools#47). Run from a shell with no `CLAUDE_CODE_SESSION_ID` and no
# live record for this window — `lane-handoff --lane <lane>` from a bare
# terminal, which is the `--late` case and every scripted one — `$sess_uuid` is
# empty while `$uuid` has already fallen back to the ROW's recorded session,
# which is the id `lane-start` resumes this lane by. Writing `transcript none`
# there records *this agent has no resumable id* about a conversation whose id
# the same line carries in its `session` field.
if [ -z "$transcript" ]; then
	if [ "$agent" = claude ] && [ -n "$uuid" ]; then transcript="$uuid"
	else transcript=none
	fi
fi
case "$transcript" in
*[!A-Za-z0-9._-]* | '') die "--transcript takes the agent's own resumable id, or the word 'none' — '$transcript' is neither (Amendment 17(b))." 2 ;;
esac

# --------------------------------------------- the lane's checkout and profile
#
# `dir` IS THE LANE'S CHECKOUT AND NEVER A WORKTREE (`R-A11-11`, Evidence 3):
# restarting into a worktree loses the repository's CLAUDE.md and the lane's
# memory. Three sources, every one of them a RECORD rather than a derivation —
# and a read that FAILED takes no substitute, because a swap typed in one
# checkout for a lane that lives in another would otherwise record this
# session's directory as that lane's, in a log nothing rewrites.
dir="$dir_flag"; dir_read_failed=""
if [ -z "$dir" ]; then
	dir_rc=0
	dir="$(LANES_NO_FETCH=1 "$LANES_EDIT" lane-dir "$lane" 2>/dev/null)" || dir_rc=$?
	case "$dir_rc" in
	0) : ;;
	8 | 2) dir="" ;;
	*) dir=""; dir_read_failed="\`$LANES_EDIT lane-dir $lane\` failed (exit $dir_rc)" ;;
	esac
	if [ -z "$dir" ] && [ -z "$dir_read_failed" ]; then
		dir="${WORKBENCHES_CLAUDE_LANE_DIR:-}"
		if [ -z "$dir" ] && [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] && [ -n "${CLAUDE_CONFIG_DIR:-}" ] && command -v jq >/dev/null 2>&1; then
			dir="$(jq -r --arg id "$CLAUDE_CODE_SESSION_ID" \
				'select((.sessionId // "") == $id) | .cwd // empty' \
				"$CLAUDE_CONFIG_DIR"/sessions/*.json 2>/dev/null | head -n 1)"
		fi
	fi
fi
# AN ABSOLUTE PATH OR NOTHING AT ALL: a relative one has no meaning without the
# writer's cwd, which no reader of this log has.
case "$dir" in /*) : ;; *) dir="" ;; esac
[ -n "$dir" ] || note "NO dir sub-field: ${dir_read_failed:-neither the lane log, the launcher nor this session record names the lane checkout}, so the record is written without one (Amendment 11 clause (c))."

profile_name="${CLAUDE_PROFILE_NAME:-$sess_profile}"
case "$profile_name" in
*[!A-Za-z0-9._-]* | '') profile_name="" ;;
esac

# ---------------------------- the LATE record's preconditions, read FIRST
#
# BEFORE THE POLL AND BEFORE THE REFRESH, because a refusal must leave the lane
# exactly as it found it — the handoff file included. Everything this block
# needs is the lane's own published log, and the rule it enforces is THE LATE
# RULE at the head of this file: a late `PAUSED` is written only where it can
# still be the lane's LAST lane-kind line in file order.
if [ "$do_late" = 1 ]; then
	[ -n "$late_at" ] || die "--late needs --at <UTC>: a late record is dated by the moment the OLD SESSION ENDED and not by the clock of the shell writing it, and that instant is also what decides whether the line can still be the lane's last one. Pass --at 2026-09-14T12:02:27Z (the time of the last thing that session did)." 2
	case "$late_at" in
	[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z) : ;;
	*) die "--at takes a UTC instant spelled as the log spells it, YYYY-MM-DDTHH:MM:SSZ — '$late_at' is not one." 2 ;;
	esac
	if [ -n "$ws_missing" ]; then
		die "the late record cannot be filed under a workstation this command could not read (\`R-A11-14\`), and a late PAUSED is the one line that has no second chance: nothing was written. Export LANES_WORKSTATION and re-run." 2
	fi
	# THE LANE'S LAST LANE-KIND LINE, read from the published log exactly as
	# every state reader reads it: FILE ORDER decides which is last.
	last_line=""; ll_rc=0
	last_line="$("$LANES_EDIT" lane-last "$lane" 2>/dev/null)" || ll_rc=$?
	case "$ll_rc" in
	0) : ;;
	8) last_line="" ;;
	*) die "\`$LANES_EDIT lane-last $lane\` failed (exit $ll_rc). That is NOT 'this lane has no lane-kind line', and a late PAUSED written on an answer nobody got could pause a lane that is running (Amendment 7(d))." 1 ;;
	esac
	last_verb="$(printf '%s' "$last_line" | awk -F'\t' '{print $1}')"
	last_utc="$(printf '%s' "$last_line" | awk -F'\t' '{print $2}')"
	case "$last_verb" in
	'')
		die "lane $lane has no STARTED or RESUMED in its object log, so there is no binding for a late PAUSED to close. A lane that never started is not a lane that failed to swap." 2 ;;
	PAUSED)
		die "lane $lane's last lane-kind line is already a PAUSED (at $last_utc): the record this act writes is already there, and a second one records nothing. If that PAUSED is wrong, the log is append-only and no later line corrects it — say so in the handoff instead." 2 ;;
	ENDED | RETIRED)
		die "lane $lane's last lane-kind line is $last_verb (at $last_utc): the lane is closed, and a PAUSED after it would reopen a lane nobody is in." 2 ;;
	esac
	if ! [ "$last_utc" '<' "$late_at" ]; then
		die "lane $lane's last lane-kind line is $last_verb at $last_utc, which is AT OR AFTER the $late_at this late record claims: the relaunch is already recorded, and this log is APPEND-ONLY, so a PAUSED appended now would be the lane's last line and would make a lane that is RUNNING read as paused. Nothing was written.
    The act, in order: run \`$prog --late --at <when the old session ended>\` from a SHELL, and only then start the lane (\`pclaude <profile>\`).
    Where the relaunch has already happened — which is this case — the honest record of the state that session now holds is its own next \`$prog\`." 2
	fi
fi

# ------------------------------------------------ 3. poll the running writers
#
# Amendment 17(f): the top block *"LISTS EVERY WRITER THE LANE HAS RUNNING (its
# worktree, its branch, its brief, what it had committed)"*, and the next
# session *"RELAUNCHES EVERY WRITER IT LISTS from where each stood"*. A shell
# cannot message a subagent — that is the skill's step 3, and the one question
# this act ever asks belongs there — so what a shell CAN do is read every
# worktree the lane has and report it exactly: `git status --short` and
# `git log @{u}..`, per worktree, printed here and summarised into the section.
#
# TWO PLACES, because the estate uses both: `<checkout>/.claude/worktrees/<name>`
# for a writer working inside the lane's own repository, and
# `<projects>/.lane-worktrees/<lane>/<name>` for the ones a lane keeps beside it.
#
# THE SNAPSHOT FILE IS A PRECONDITION, NOT A CONVENIENCE (Copilot round 1 on
# openRepoTools#47). With no temporary file the count below still rises and
# every line written to it goes nowhere: the block would then say *WRITERS: 3
# found* and list none, and a `/ctx` on that block relaunches nothing while
# telling the next session there were three. A section that cannot be filled is
# refused here, before the handoff is touched and before the record is written,
# which is the one point at which nothing has happened yet.
writers_tmp="$(mktemp "${TMPDIR:-/tmp}/lane-handoff-writers.XXXXXX" 2>/dev/null || printf '')"
[ -n "$writers_tmp" ] ||
	die "could not create a temporary file under ${TMPDIR:-/tmp} to snapshot this lane's writers into, and the WRITERS section is what the next session counts against \`ListAgents\` (Amendment 17 Addendum 1 (i)). Nothing was written, nothing was renamed and no pane was touched. Free some space, or set TMPDIR to somewhere writable, and re-run." 2
cleanup() { [ -n "${writers_tmp:-}" ] && rm -f -- "$writers_tmp"; return 0; }
trap cleanup EXIT INT TERM

brief_for() {   # <worktree path>
	[ -n "$writers_file" ] && [ -r "$writers_file" ] || return 1
	awk -F'\t' -v p="$1" '$1 == p { sub(/^[^\t]*\t/, ""); print; exit }' "$writers_file"
}

writer_count=0
poll_writer() {   # <path>
	pw_d="$1"
	[ -d "$pw_d" ] || return 0
	git -C "$pw_d" rev-parse --git-dir >/dev/null 2>&1 || return 0
	pw_branch="$(git -C "$pw_d" rev-parse --abbrev-ref HEAD 2>/dev/null || printf '?')"
	pw_last="$(git -C "$pw_d" log -1 --format='%h %s' 2>/dev/null || :)"
	pw_status="$(git -C "$pw_d" status --short 2>/dev/null || :)"
	pw_unpushed="$(git -C "$pw_d" log '@{u}..' --oneline 2>/dev/null || :)"
	pw_dirty="$(printf '%s' "$pw_status" | grep -c . || :)"
	pw_ahead="$(printf '%s' "$pw_unpushed" | grep -c . || :)"
	pw_brief="$(brief_for "$pw_d" || printf '')"
	writer_count=$((writer_count + 1))
	say ""
	say "WRITER $pw_d — branch $pw_branch, last commit ${pw_last:-<none>}"
	say "  git status --short: ${pw_dirty} dirty"
	[ -n "$pw_status" ] && printf '%s\n' "$pw_status" | sed 's/^/    /'
	say "  git log @{u}..: ${pw_ahead} unpushed"
	[ -n "$pw_unpushed" ] && printf '%s\n' "$pw_unpushed" | sed 's/^/    /'
	printf -- '- `%s` — branch `%s`, last commit `%s`, %s dirty, %s unpushed; brief: %s\n' \
		"$pw_d" "$pw_branch" "${pw_last:-<none>}" "$pw_dirty" "$pw_ahead" \
		"${pw_brief:-(fill in: the brief this writer was given)}" >> "$writers_tmp"
	return 0
}

: > "$writers_tmp"
if [ -n "$dir" ]; then
	for w in "$dir"/.claude/worktrees/*; do poll_writer "$w"; done
	parent="${dir%/*}"
	for w in "$parent"/.lane-worktrees/"$lane"/*; do poll_writer "$w"; done
fi
step "writers polled: $writer_count under ${dir:-<no recorded checkout>}"

# ------------------------------------------------------ 2. refresh the handoff
#
# The handoff path is the row's SIXTH column: awk field 7, because `$1` is the
# empty string before the leading pipe — `lanes-edit.sh`'s own `row_cell` /
# `handoff_of_lane` convention. NEVER count back from `NF`: a lane's row carries
# every state line to the RIGHT of the handoff column, so `$(NF-2)` lands on the
# empty string and the commit below would `git add ""` — silently, in the one
# step Amendment 6(e) exists for.
sread row "'this lane has no row'" register-row "$lane"
row_line="$(printf '%s\n' "$row" | grep '^|' | tail -n 1)"
handoff_cell="$(printf '%s' "$row_line" | awk -F'|' '{print $7}' | awk '{$1=$1};1')"

handoff_file=""
if [ -n "$handoff_cell" ]; then
	case "$handoff_cell" in
	'~/'*) [ -f "$HOME/${handoff_cell#'~/'}" ] && handoff_file="$HOME/${handoff_cell#'~/'}" ;;
	/*) [ -f "$handoff_cell" ] && handoff_file="$handoff_cell" ;;
	*)
		# THE WORKSPACE REPOSITORY, THROUGH THE HELPER'S OWN RESOLVER and never
		# through a second reading of `workspace.yaml` — Amendment 9(a) is
		# explicit that a second way to find one thing is a second answer.
		hs_root="$("$LANES_EDIT" workspace-root 2>/dev/null || :)"
		for hs_base in "${LANES_REPO:-}" "$hs_root"; do
			[ -n "$hs_base" ] || continue
			if [ -f "$hs_base/$handoff_cell" ]; then handoff_file="$hs_base/$handoff_cell"; break; fi
		done ;;
	esac
fi

# THE FRESH RULE 3 TOP BLOCK. It is PREPENDED and the file is never rewritten:
# a handoff is the one document in this protocol whose whole purpose is to be
# read by a later session, and the act that deleted two lanes' rows on
# 2026-09-08 was a file written whole out of what somebody remembered of it.
# Everything that was in the file stays below the marker, as history.
#
# LINE 1 AND THE BLANK AFTER IT ARE STRUCTURAL: `lane-start` splices its Rule 3
# stamp at *"the line immediately after the first blank line that follows line
# 1"*, so a top block that does not open that way is a block the RESUMED stamps
# land in the middle of.
top_block() {
	printf 'Lane: %s (%s, session %s) — single-use resume prompt: stamp RESUMED-by before acting (lane-collision-protocol rule 3)\n' \
		"$lane" "${profile_name:-profile unknown}" "${uuid:-unknown}"
	printf '\n'
	printf '## RESUME PROMPT — PAUSED %s (%s), agent %s, transcript %s, kind %s — %s\n\n' \
		"$UTC" "${why:-handoff}" "$agent" "$transcript" "$handoff_kind" "$kind_headline"
	printf '**FIRST ACTS, in order.** (1) You are lane `%s`%s%s. Stamp this block RESUMED before anything else (Rule 3, single use) — `lane-start --no-launch <repo> <n>` in this window writes it. (2) Read AGENTS.md, then this block. (3) COUNT THE LIVE WRITERS before relaunching anything — the WRITERS section below is a list to COUNT, not a list to relaunch (Amendment 17 Addendum 1 (i)). ONE WORKTREE, ONE WRITER (k): a worktree is one writer'"'"'s for as long as that writer is live, a relaunch onto a live writer'"'"'s worktree is the writers'"'"' form of Amendment 18(h)'"'"'s second binding, and where you find one made you retire the newer before either commits. %s Older sections below are history.\n\n' \
		"$lane" "${window_ref:+ in tmux window \`$window_ref\`}" "${dir:+, checkout \`$dir\`}" "$kind_act"
	printf '**STATE at %s.** Handed off by `%s` on %s: %s. Agent `%s`, transcript `%s`. Kind `%s`: %s.%s\n\n' \
		"$UTC" "$prog" "${ws:-<no workstation>}" "${why:-no why given}" "$agent" "$transcript" \
		"$handoff_kind" "$kind_state" \
		"${ws_missing:+ THE REGISTER AND OBJECT-LOG WRITES WERE NOT MADE: this session ran with no configured workstation, so the row still reads as it did and the register is BEHIND this file (\`R-A11-14\`). The next session binds with \`lane-start --no-launch\`.}"
	printf '**WRITERS at %s** (%s found under `%s`) — FIRST count the live writers: `ListAgents` in Claude, the agent'"'"'s equivalent elsewhere. A writer still live OWNS its worktree: do not relaunch it; one message telling it that its in-flight call died and who the coordinator now is, is enough. Relaunch only a writer that is NOT live, from where it stands — `git status` and `git log @{u}..` in its worktree, then its brief. WHERE THE COUNT AND THIS LIST DISAGREE, THE COUNT WINS: this list is what the paused session expected, the count is what is true.\n\n' \
		"$UTC" "$writer_count" "${dir:-<no recorded checkout>}"
	if [ "$writer_count" = 0 ]; then
		printf -- '- none running at the handoff. A writer this lane starts later is listed by the next refresh.\n'
	else
		cat -- "$writers_tmp"
	fi
	printf '\n'
}

handoff_written=0
if [ -z "$handoff_file" ]; then
	note "the row names no handoff this command could find${handoff_cell:+ ('$handoff_cell')}, so the top block was NOT written. The record below is still written; put this block at the head of the lane's handoff by hand:"
	top_block >&2
else
	hs_tmpd="$(mktemp -d 2>/dev/null || printf '')"
	if [ -z "$hs_tmpd" ]; then
		note "could not create a temporary directory, so the handoff was not refreshed: $handoff_file"
	else
		{ top_block
		  printf -- '---\n\n'
		  cat -- "$handoff_file"
		} > "$hs_tmpd/out"
		# PROVED BEFORE IT LANDS: taking the new block back out again must give
		# the original file byte for byte. That is also what catches a file whose
		# last line has no newline.
		hs_added="$(( $(grep -c '' "$hs_tmpd/out") - $(grep -c '' "$handoff_file") ))"
		if tail -n +$((hs_added + 1)) -- "$hs_tmpd/out" | cmp -s - "$handoff_file"; then
			# THE FLAG FOLLOWS THE WRITE AND NEVER THE INTENTION (Copilot round 1 on
			# openRepoTools#47). A handoff file that is read-only, or on a filesystem
			# that is full, fails HERE — and `handoff_written=1` set regardless is
			# what lets `--restart` pass its gate and respawn the pane over a STALE
			# top block, which is the one document the new session is started with.
			if cat -- "$hs_tmpd/out" > "$handoff_file"; then   # the redirect FOLLOWS the symlink
				handoff_written=1
				step "handoff refreshed: $handoff_file (+$hs_added lines at the head)"
			else
				note "the refreshed top block could NOT be written to $handoff_file (the error above is the shell's own), so that file still carries the block it had. It is printed below; put it at the head of that file by hand:"
				top_block >&2
			fi
		else
			note "the splice of the new top block into $handoff_file did not prove out (the old file must survive it byte for byte), so NOTHING was written to it."
			top_block >&2
		fi
		rm -rf -- "$hs_tmpd"
	fi
fi

# The commit is in the LANE'S OWN workspace repository and is not one of the
# writes a missing workstation stops (A11 Addendum 4 ruling 11): it is where the
# gap is NAMED. One commit, an explicit pathspec and the Rule 5 trailer.
if [ "$handoff_written" = 1 ] && [ "${LANES_NO_GIT:-0}" != 1 ]; then
	# THE PARENT IS RESOLVED WITH `cd -P`, NOT `readlink -f` (Copilot round 3 on
	# openRepoTools#47, the same rule as `lane-start`'s `real_of`). Where
	# `readlink -f` is not in the userland the fallback hands the path back
	# UNRESOLVED, so `hs_repo` — which git answers with a PHYSICAL path — and
	# `hs_rel`, derived from the symlinked spelling, disagree: `git add` then
	# refuses a pathspec that "leaves the repository", and the handoff this act
	# has just written is left uncommitted. A handoff is reached through the
	# estate's `handoffs` symlink on every workstation that has one.
	hs_dirreal="$( CDPATH=''; cd -P -- "$(dirname -- "$handoff_file")" 2>/dev/null && pwd -P )" ||
		hs_dirreal="$(dirname -- "$handoff_file")"
	hs_real="$hs_dirreal/$(basename -- "$handoff_file")"
	hs_repo="$(git -C "$(dirname -- "$hs_real")" rev-parse --show-toplevel 2>/dev/null || :)"
	if [ -n "$hs_repo" ]; then
		hs_rel="${hs_real#"$hs_repo"/}"
		if git -C "$hs_repo" add -- "$hs_rel" >/dev/null 2>&1 &&
		   git -C "$hs_repo" commit -q -m "handoff($lane@${ws:-unknown}): PAUSED, ${why:-handoff}" -m "Lane: $lane" -- "$hs_rel" >/dev/null 2>&1; then
			step "handoff commit: handoff($lane@${ws:-unknown}): PAUSED"
			if git -C "$hs_repo" pull --rebase -q origin "${LANES_BRANCH:-main}" >/dev/null 2>&1 &&
			   git -C "$hs_repo" push -q origin "${LANES_BRANCH:-main}" >/dev/null 2>&1; then
				step "handoff pushed to origin/${LANES_BRANCH:-main}"
			else
				git -C "$hs_repo" rebase --abort >/dev/null 2>&1 || :
				note "the handoff is committed here and was NOT pushed (a conflict, or no reachable origin). Never force; look first, then push:
    git -C $hs_repo fetch origin ${LANES_BRANCH:-main} && git -C $hs_repo log --oneline origin/${LANES_BRANCH:-main} -3
    git -C $hs_repo pull --rebase origin ${LANES_BRANCH:-main} && git -C $hs_repo push origin ${LANES_BRANCH:-main}"
			fi
		else
			note "the handoff is written and NOT committed — an uncommitted write is captured by the next lane's commit and its attribution is lost (Amendment 4(d)). Commit it yourself:
    git -C $hs_repo commit -m \"handoff($lane@${ws:-unknown}): PAUSED\" -m \"Lane: $lane\" -- $hs_rel"
		fi
	fi
fi

# ------------------------------------------------------- 4. the swap record
#
# THE FREE TEXT IS SANITIZED ONCE: Amendment 7(b)/R26 refuses any payload or
# free text containing ` — ` (exit 2), because that separator is what divides a
# line's fields from its free text.
sanitize() { printf '%s' "$1" | sed 's/ — /; /g'; }
# THE FREE TEXT NAMES THE KIND AFTER ITS WHY (Amendment 17 Addendum 1 (h), in
# force 2026-09-14T20:59:31Z): `clear in-process`, `clear respawn`, `switch
# respawn`, `reset respawn` — the why the caller gave, then the word for what
# happened to the PROCESS. A handoff that cannot know which will follow writes
# `kind unknown`, which is the addendum's own spelling of it. The payload
# carries the same fact as a sub-field (`; kind <k>`) for the readers that
# parse the line; this is for the person who reads it.
kind_word="$handoff_kind"
[ "$handoff_kind" = unknown ] && kind_word="kind unknown"
why_text="$(sanitize "${why:-handoff}") $kind_word"

# THE PAYLOAD. It opens `swap; ` because that is what `swapped` matches on — the
# record the launcher restarts from — and the sub-fields after it are Amendment
# 11(c)'s three plus Amendment 17(b)'s two. A value carrying `, `, ` — `, `; ` or
# `"` is DROPPED (the sub-field, not the line) and what was dropped is PRINTED:
# `R-A11-11` binds this writer — *a swap is never left unwritten* — so an
# offending sub-field costs its own information and never the record.
payload="swap"
refused=""
# THE SAME FENCE FOR ALL FOUR SEPARATORS (Copilot round 3 on openRepoTools#47).
# `window` is two space-separated refs in ONE sub-field, so a `; ` inside it
# would be read back as the END of the sub-field and the rest as another one:
# every reader of this line would then recover a window ref that is not the
# lane's. The comment above already said both were dropped; now they are.
case "$window_ref" in *', '* | *' — '* | *'; '* | *'"'*) refused="$refused window=$window_ref"; window_ref="" ;; esac
case "$dir" in *', '* | *' — '* | *'; '* | *'"'*) refused="$refused dir=$dir"; dir="" ;; esac
dir_field="$dir"
case "$dir_field" in *' '*) dir_field="\"$dir_field\"" ;; esac
[ -z "$window_ref" ] || payload="$payload; window $window_ref"
[ -z "$dir_field" ] || payload="$payload; dir $dir_field"
[ -z "$profile_name" ] || payload="$payload; profile $profile_name"
[ -z "$ws" ] || payload="$payload; workstation $ws"
# AMENDMENT 17(b) — THE TWO SUB-FIELDS THAT MAKE THE LANE RESUMABLE BY ANY
# AGENT. They go LAST, after Amendment 11(c)'s, because every reader written
# before this amendment stops at the sub-field it knows and a reader that finds
# none says so (Amendment 7(i)'s cutover rule).
payload="$payload; agent $agent; transcript $transcript"
# AND THE KIND OF CLEAR, AFTER THEM, ON THE SAME ARGUMENT: a reader written
# before this field stops at the sub-field it knows. It is in the record and not
# only in the handoff because the record is what a launcher and a later reader
# have — `in-process` says the writers of that session were still running when
# the line was written, which is the one fact that decides whether relaunching
# them is right.
payload="$payload; kind $handoff_kind"
[ -z "$refused" ] || note "DROPPED sub-field (not appended, and the line is still written):$refused"

# ------------------------------------------------------------ the LATE branch
if [ "$do_late" = 1 ]; then
	late_payload="$payload; late $late_at"
	late_why="$(sanitize "${why:-late; usage limit hit before the swap at $late_at}") $kind_word"
	if LANES_LANE="$lane" LANES_SESSION="$uuid" "$LANES_EDIT" log PAUSED "lane:$lane" \
		'→' "$late_payload" "$late_why" --utc "$late_at"; then
		step "late PAUSED written, dated $late_at (before the relaunch, which is the only place it can go)"
	else
		die "the late PAUSED was NOT written (the helper refused it — its own message is above). Nothing else was done." 2
	fi
	say ""
	say "LATE RECORD WRITTEN for lane $lane, dated $late_at. Now start the lane:"
	say "  pclaude ${profile_name:-<profile>}"
	exit 0
fi

# --- BEGIN shared one-line cut (lane-collision-protocol Amendment 13(a)) ---
# BYTE-IDENTICAL IN `lane-start`, `lane-end` AND `lane-handoff`, the three
# commands that write a row's state cell — the same trade the four lane helpers
# already make for their workspace resolver, and for the same reason: a drifted
# copy is TWO ANSWERS to one question, and "what may this line contain, and
# where may it be cut" is one question.
#
# FOUR THINGS THE CELL'S LINE MAY NOT CARRY, and `set-row-state` REFUSES all
# four — which would cost the row its stamp or its closing write, so they are
# fixed here rather than met there:
#
#   ` · `  the phrase's own separator. A second one reads back as a fourth part
#          of `<STATE> · <UTC> · <one line>`; it is spelled `; `.
#   `|`    a cell boundary in a Markdown table row. A launch command or a
#          directory may legitimately hold one — `claude --flag 'a|b'`, a path
#          with a pipe in it — and the row is where it would forge a column
#          (Copilot round 1 on openRepoTools#82). It is spelled `¦`, the broken
#          bar, which is not a separator anywhere here; the object log's own
#          line keeps the character itself.
#   CR/LF  a row is ONE LINE of a table, so a newline in this text would split
#          it in two and every row after it would be read as a lane. Spelled
#          `; ` for the same reason the separator is (Copilot round 2).
#   >240   ratified decision O1's cap. Cut at 230 with the last partial WORD
#          dropped, which is what makes the cut safe: `${s:0:n}` counts BYTES
#          wherever the locale is not a UTF-8 one, and a byte offset can land
#          inside the very characters above. 230 and not 240, so the ` ...`
#          marker fits inside the cap however the two count.
cut_to_line() {   # <line> — the row's one line, safe to hand to set-row-state
  ctl="${1//$'\r'/ }"
  ctl="${ctl//$'\n'/; }"
  ctl="${ctl// · /; }"
  ctl="${ctl//|/¦}"
  [ "${#ctl}" -gt 230 ] || { printf '%s' "$ctl"; return 0; }
  ctl="${ctl:0:230}"
  case "$ctl" in *' '*) ctl="${ctl% *}" ;; esac
  printf '%s ...' "$ctl"
}
# --- END shared one-line cut ---

# ------------------------------------------------- (a) the object-log PAUSED
record_written=0
row_write_refused=""
if [ -n "$ws_missing" ]; then
	note "NOT WRITTEN: the PAUSED line, the LANES.md line and the row's state cell all stop where there is no configured workstation (clause (k) rule (d), \`R-A11-14\`). The handoff refreshed above names the gap, and the restart line below carries --lane, because a restart cannot resolve this lane from a row that was never set."
	row_write_refused=1
else
	if LANES_LANE="$lane" LANES_SESSION="$uuid" "$LANES_EDIT" log PAUSED "lane:$lane" \
		'→' "$payload" "$why_text"; then
		record_written=1
		step "object log: PAUSED lane:$lane → $payload"
	else
		note "the PAUSED line was NOT written — the helper's own refusal is above. Write it before anything else:"
		note "  LANES_LANE=$lane LANES_SESSION=$uuid $LANES_EDIT log PAUSED lane:$lane '→' \"$payload\" \"$why_text\""
	fi
	# (b) the LANES.md file-level line, the shape every prior PAUSED/RESUMED
	# used. It is written whether or not (a) could be (`R-A11-11`: a swap is
	# never left unwritten) — EXCEPT where there is no transcript uuid to name,
	# which is the one thing that must never be written into either file. The
	# literal `unknown` is in this estate's append-only log four times already
	# and no later line corrects any of them (Amendment 11 clause (e)); a
	# register line naming it would be the fifth, one file along.
	if [ -n "$uuid" ]; then
		"$LANES_EDIT" append-line "PAUSED — lane $lane, session $uuid@$ws, $UTC, $why_text; handoff refreshed" >/dev/null 2>&1 ||
			note "the LANES.md file-level PAUSED line was not appended (the register may be busy or behind); the object-log line above is the record readers take."
	else
		note "no transcript uuid is knowable for this lane, so neither the object log's PAUSED nor the register's file-level line was written — a record naming 'unknown' in that field is a record no restart can read (Amendment 11 clause (e)). The handoff file above is refreshed and is the whole of what this act left behind. Bind the session first:  lane-start --no-launch <repo> <n>"
	fi
	# (c) the row: ONE WRITE, which sets the whole cell (Amendment 13(a)).
	#
	# It used to be TWO, and both of them were guesses at a cell that was a
	# history: `replace-in-row` flipping the leading state word — derived by
	# grepping the row for `| WORD ·` or `| WORD |`, since the anchor had to
	# occur exactly once or the write was refused — and then an
	# `append-row-status` putting `PAUSED — <payload>` at the END of the same
	# cell, so the row said PAUSED twice, in two places, with a day of narrative
	# between them. The cell is now one phrase that `set-row-state` REPLACES, so
	# a swap writes it once and there is no anchor to guess at: a row whose cell
	# opens with anything at all, or with nothing, takes the same write.
	#
	# The payload carries the record's sub-fields (`swap; window …; dir …;
	# profile …; agent …; transcript …`), which is exactly the line a person
	# reading the row wants; a ` · ` inside it would read back as a fourth part
	# of the phrase, and 240 characters is the cap (ratified decision O1) — the
	# object-log line written above carries the full payload either way.
	hs_line="$(cut_to_line "$payload")"
	LANES_LANE="$lane" "$LANES_EDIT" set-row-state "$lane" "PAUSED · $hs_line" >/dev/null 2>&1 || row_write_refused=1
	[ -z "$row_write_refused" ] || note "the row's state cell was NOT set to PAUSED (the write was refused — run it by hand to see what it says: lanes-edit.sh set-row-state $lane \"PAUSED · $hs_line\"). The restart line below carries --lane for that reason."
fi

# ------------------------------------------- 5. the restart line — one command
if [ -n "$row_write_refused" ]; then
	restart_cmd="pclaude --lane $lane ${profile_name:-<profile>}"
	restart_note=" (the row was not flipped, so the lane must be named explicitly)"
else
	restart_cmd="pclaude ${profile_name:-<profile>}"
	restart_note=""
fi
say ""
say "READY — restart with: $restart_cmd$restart_note"
say "  record: PAUSED lane:$lane → $payload"
say "  agent $agent, transcript $transcript (lane-start --agent $agent resumes it)"

# -------------------------------------------- Amendment 17(f) / 18(d): the end
#
# THE RECORD COMES FIRST, ALWAYS. *"a `/ctx` whose record could not be written
# REFUSES before it kills anything (a pane is never respawned over an unrecorded
# lane)"* — so both branches below test `record_written` before they touch tmux,
# and a lane whose PAUSED line did not land keeps its pane and its session.
if [ "$do_restart" = 1 ] || [ "$do_exit" = 1 ]; then
	[ "$record_written" = 1 ] ||
		die "the lane's PAUSED record was NOT written, so this pane is left exactly as it is: a pane is never respawned over an unrecorded lane, and a session is never ended without one (Amendment 17(f)). Fix the write above and re-run." 2
	# AND THE RECORD IS THREE WRITES, NOT ONE (Copilot rounds 1 and 2 on
	# openRepoTools#47). The object-log line above is the first of them; the
	# ROW is what every other lane and every launcher reads this lane's state
	# from, and the HANDOFF is the document the new session is started with —
	# its top block is literally the respawn's first prompt (`lane-start`'s
	# 5a). A pane respawned over an unflipped row leaves the register saying
	# RUNNING about a session that no longer exists, and a pane respawned over
	# a STALE top block hands the new session the last handoff's instructions:
	# the writers of another act, the why of another act. Neither is a state
	# this command may create and then kill the only process that could fix it,
	# so both are gates, and each names the act that clears it.
	[ -z "$row_write_refused" ] ||
		die "the lane's PAUSED line is written and the ROW WAS NOT FLIPPED (the note above says why), so this pane is left exactly as it is: respawning it would leave the register reading RUNNING for a session that has just been replaced, and every other lane reads the row. Flip it and re-run, or restart by hand:  $restart_cmd" 2
	[ "$handoff_written" = 1 ] ||
		die "the lane's PAUSED line is written and the HANDOFF WAS NOT REFRESHED (the note above says why), so this pane is left exactly as it is: the top block of that file is what the new session is started with, and respawning now would hand it the block of a handoff this act has replaced. Put the block printed above at the head of the handoff, then re-run — or restart by hand once you have:  $restart_cmd" 2
	have_tmux ||
		die "the record is written, and there is no tmux here to ${do_restart:+respawn}${do_exit:+end} this pane with. Do it by hand — the record is the part that mattered." 2
	# THE PANE, from the LIVE RECORD's own `tmux` field — `<session>:<@id>.%<pane>`
	# — because that is the pane the session is really in; the window ref is the
	# fallback for a record that carries none, and tmux resolves it to that
	# window's active pane.
	target="${pane:-${TMUX_PANE:-}}"
	[ -n "$target" ] || target="${wid:-$win}"
	[ -n "$target" ] ||
		die "the record is written, and no pane of this lane's could be resolved (no live record names one, \$TMUX_PANE is unset and this window has no ref). Nothing was killed." 2
fi

if [ "$do_exit" = 1 ]; then
	# AMENDMENT 18(d): the session ENDS, because a handoff to another place is a
	# handoff and not a restart. `/exit` is typed into the lane's own pane —
	# Amendment 12's M1, the one mechanism there is — so the session ends at its
	# next prompt with nothing of the person's lost.
	if tmux send-keys -t "$target" '/exit' Enter 2>/dev/null; then
		say "  /exit typed into $target (Amendment 18(d): the session ends where the handoff was requested from elsewhere)"
	else
		die "the record is written and `/exit` could NOT be typed into $target. Type it in the lane's own pane yourself." 2
	fi
	exit 0
fi

if [ "$do_restart" = 1 ]; then
	# AMENDMENT 17(f) — THE RESPAWN, THROUGH THE LAUNCHER, WITH THE TOP BLOCK AS
	# THE NEW SESSION'S FIRST PROMPT. `respawn-pane -k` replaces the pane's
	# process, so the act survives the death of the session that started it: the
	# session running this command is killed BY the command it just wrote the
	# record for.
	#
	# WHAT THE RESPAWN LINE USED TO BE, AND WHY IT IS NOT THAT ANY MORE.
	# Amendment 18 Addendum 2 (i-8) names two doors for this act: *"relaunches
	# the lane's own pane with `lane <name>` (its parked branch is exactly
	# Amendment 11(i)'s act), or through the launcher directly"*. This command
	# respawned with the first of them, and openRepoTools#94 is what that cost:
	# `lane` is a HUMAN DISPATCHER whose valid outcomes include attaching to an
	# existing session without launching anything, and the fresh-session
	# requirement it was asked to carry was an environment variable that the
	# launcher's own `tmux new-session` dropped on the way through.
	#
	# BOTH DOORS ARE KEPT, ONE LEVEL DOWN. What tmux starts now is this
	# command's `--supervise` mode, and what the SUPERVISOR starts is (i-8)'s
	# second door — `pclaude --lane <lane> <profile>`, the launcher directly —
	# falling to `lane-start` itself where this workstation has no launcher or
	# the lane's record names no profile. The ground of (i-8) is honoured
	# exactly: *"no word is kept on `PATH` for it alone"*, and none is — the
	# supervisor is a mode of a command that is already installed, and a person
	# still has one word, `lane`.
	#
	# THE DEVIATION IS WRITTEN DOWN rather than taken quietly: it is decision 5
	# of `openspec/changes/add-supervised-context-restart/design.md`, and the
	# protocol text that would ratify it is task 7.4's, unwritten as this
	# lands.

	# ---- THE PRE-KILL COMMIT POINT: THE RESTART INTENT (openRepoTools#94)
	#
	# THE FRESH SESSION IS WRITTEN DOWN BEFORE ANYTHING IS KILLED, and that is
	# the whole of this change. `LANE_START_FRESH=1` in the respawn's command
	# string was the seam and it was measured NOT ARRIVING: `claude-profile`
	# re-creates the child through `tmux new-session`, and tmux hands a command
	# the SERVER's environment and not the client's — the launcher's own code
	# says so, which is why it threads six values into the command string
	# explicitly and why a seventh nobody thought to thread simply vanished.
	# The pane came back resuming the transcript this act had just paused.
	#
	# SO THE REQUIREMENT BECOMES A FILE. The intent is written under the lane's
	# own control root, carries the lane, generation, operation, old
	# transcript, agent, profile, checkout, pane, handoff path and DIGEST and
	# the launch mode, and `lane-start` reads it back whatever the environment
	# did. It is the one channel that crosses a boundary another repository
	# owns.
	#
	# AND IT IS A GATE, LIKE THE THREE ABOVE IT. Amendment 17(f) is an order —
	# *a `/ctx` whose record could not be written REFUSES before it kills
	# anything* — and after this change the intent IS part of that record: a
	# pane respawned with no intent is a pane whose supervisor has nothing to
	# launch from, which is the same unrecorded restart one step along. It
	# therefore refuses here, with the old process still alive, rather than
	# after it is dead.
	#
	# THE GENERATION COMES FROM THE LANE'S LIFECYCLE WHERE THIS WORKSTATION HAS
	# ONE (openRepoTools#91's `lane-state`), so the two fences are one number;
	# where it has none the intent carries 0 and fences on its own operation
	# alone, which is what a workstation before that change can honestly say.
	ri_gen=0
	ri_g_out="$(LANES_NO_FETCH=1 "$LANES_EDIT" lane-state "$lane" 2>/dev/null \
		| awk -F'\t' '$1 == "generation" { print $2; exit }')" || :
	case "${ri_g_out:-}" in '' | *[!0-9]*) ri_gen=0 ;; *) ri_gen="$ri_g_out" ;; esac
	operation="$(printf 'ctx-%s-%s-%s' "$(date -u +%Y%m%dT%H%M%SZ)" "$$" "${RANDOM:-0}")"
	ri_args=(set-restart-intent "$lane" pending
		--expect 'none|ready|failed'
		--operation "$operation" --generation "$ri_gen"
		--mode fresh-from-handoff
		--agent "$agent" --pane "$target"
		--old-transcript "${transcript:-none}")
	[ -n "$profile_name" ] && ri_args+=(--profile "$profile_name")
	case "$dir" in /*) ri_args+=(--dir "$dir") ;; esac
	case "$handoff_file" in /*) ri_args+=(--handoff "$handoff_file") ;; esac
	[ -n "$window_ref" ] && ri_args+=(--window "$window_ref")
	ri_wrc=0
	LANES_NO_FETCH=1 "$LANES_EDIT" "${ri_args[@]}" >/dev/null 2>&1 || ri_wrc=$?
	case "$ri_wrc" in
	0) : ;;
	7) die "lane $lane already has a restart in flight (its intent is \`pending\` or \`starting\`), so this /ctx did NOT replace the pane: an ordinary context clear never supersedes an operation somebody else is in the middle of. The record above IS written. Read what is open:  $prog --restart-status --lane $lane" 2 ;;
	*) die "the lane's PAUSED record, row and handoff are all written and the RESTART INTENT could not be (\`set-restart-intent\` exited $ri_wrc), so this pane is left exactly as it is. The intent is what tells the new session it is a FRESH one primed by the handoff's top block, and a pane respawned without it comes up resuming the transcript this act just paused — which is openRepoTools#94, measured. Restart by hand once it can be written:  $restart_cmd" 2 ;;
	esac
	# READ BACK BEFORE THE KILL, because a write that reported success and a
	# record a second process can read are not the same fact, and the process
	# that could fix the difference is the one about to die.
	ri_back="$(LANES_NO_FETCH=1 "$LANES_EDIT" restart-intent "$lane" 2>/dev/null \
		| awk -F'\t' '$1 == "operation" { print $2; exit }')" || :
	[ "$ri_back" = "$operation" ] ||
		die "the restart intent was written and reads back as operation '${ri_back:-nothing}' rather than $operation, so this pane is left exactly as it is: the supervisor would launch for an operation this act does not own. The record above IS written. Restart by hand:  $restart_cmd" 2
	say "  restart intent $operation written (generation $ri_gen, mode fresh-from-handoff)"

	# ---- THE RESPAWN, INTO A SUPERVISOR AND NOT INTO THE LAUNCH ITSELF
	#
	# WHAT TMUX STARTS IS A PROCESS THAT STAYS. The old line respawned the pane
	# with the launch, so a launch that failed took the pane with it and left
	# an empty dead window where a person's lane had been — against Amendment
	# 11's own invariant, *"No path the launcher opened exits the pane"*. The
	# supervisor is that invariant kept for the one act that had nobody
	# keeping it: it claims the intent, runs the launch as its CHILD, confirms
	# readiness, and on any failure stays in the pane with the diagnostic and
	# the retry.
	#
	# BY ABSOLUTE PATH, because a respawned pane's `PATH` is whatever the
	# person's shell profile makes of it, and a respawn is the one act no later
	# refusal can undo. It is checked for existence HERE, while this process is
	# still alive to say so.
	[ -x "$SELF_ABS" ] ||
		die "the record and the restart intent are written and this command cannot find itself at $SELF_ABS to hand the pane to, so nothing was respawned: tmux starts the supervisor by absolute path because a respawned pane's PATH is not this one's. Restart by hand:  $restart_cmd" 2
	# AND THE ENVIRONMENT THE SUPERVISOR NEEDS IS WRITTEN INTO THE COMMAND
	# STRING, for exactly the reason #94 exists: the workstation name is what
	# every register write from the new session is filed under (`R-A11-14`),
	# and tmux would otherwise hand the pane whatever the SERVER has.
	launch_line="$(quoted "$SELF_ABS" --supervise --lane "$lane" --operation "$operation")"
	[ -n "$ws" ] && launch_line="LANES_WORKSTATION=$(quoted "$ws") $launch_line"
	say "  respawning $target: $launch_line"
	if tmux respawn-pane -k -t "$target" "$launch_line" 2>/dev/null; then
		say "  respawned into the supervisor — it launches the fresh session, confirms it came up, and stays in this pane if it did not"
	else
		die "the record and the restart intent are written and \`tmux respawn-pane -k -t $target\` was refused, so this pane is exactly as it was and the lane's restart intent is \`pending\` for operation $operation. Nothing was killed. Start it yourself:  $restart_cmd
    or hand this pane to the supervisor once tmux will take it:
      $launch_line" 2
	fi
	exit 0
fi

exit 0
