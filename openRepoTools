	# template names it and a person had edited it, is still not published by a
	# command that came to place a template. Two answers to one finding, and the
	# cheaper one is the one that runs first.
	if [ "$((seeded + owed))" -gt 0 ]; then
		wip_quietly git -C "$checkout" add -- "${written[@]}" ||
			die "could not stage the seed in $checkout.
    What it said:
$WIP_LAST_ERR"
	fi
	# AND THE COMMIT IS THOSE PATHS AND NO OTHERS (#44 round 1,
	# `openRepoTools:1525`). `git commit` with no pathspec commits THE INDEX, so
	# a person's own `git add` of a file step 6a is deliberately blind to — a
	# TEMPLATE path they had edited — rode into the seed commit and out to
	# `main` on the push below, which is the finding this round was opened for
	# one layer down. The pathspec commits the worktree at those paths and
	# leaves every other staged change exactly where the person left it: staged,
	# uncommitted, unpushed.
	#
	# THE `diff --cached` ASKS ABOUT THE SAME PATHS, because after an `add` of
	# paths that are already in HEAD there can be nothing to commit at all — a
	# checkout that had a template file DELETED gets it back from the template
	# above, and where those bytes match HEAD `git commit` refuses with one.
	if [ "$((seeded + owed))" -gt 0 ] &&
		! git -C "$checkout" diff --cached --quiet -- "${written[@]}" 2>/dev/null; then
		wip_quietly git -C "$checkout" commit -q \
			-m "Seed this workspace repository from $SHAPE_REPOSITORY $WIP_TEMPLATE_DIR

Written by \`openRepoTools wip init\` (lane-collision-protocol Amendment 9(c)).
It holds data only: the register, the object logs, the handoffs and the
workspace manifests. The lane tooling is installed from opensoft/openRepoTools." \
			-- "${written[@]}" ||
			die "could not commit the seed in $checkout. A machine with no
    \`user.email\` configured is the usual reason, and git says so itself:
$WIP_LAST_ERR"
		say "  committed the seed in $checkout"
	fi

	# THE PUSH IS GATED ON THE REMOTE, NOT ON THE WORKTREE, and that is the
	# whole of what makes the re-run this step promises actually work. A first
	# run whose push the ruleset rejected leaves a CLEAN worktree and an
	# unpushed commit — so a `status --porcelain` gate would report "already
	# carries the seed", write the pointer file and exit 0 over an empty
	# `main`, and step 1's file test would then return on every later run.
	# That is the failure step 8 exists to prevent, met one step further on.
	#
	# AND THE REMOTE IS THE ONE STEP 6a ASKED (#64). `remote_head` is that one
	# `ls-remote`'s answer, so the commits 6a checked against `main` and the
	# push decided here are a single reading of it, never two. Where 6a could
	# not ask, `remote_head` is empty and the push below runs: the push IS the
	# probe, and a question we could not put to the remote is not an answer
	# from it.
	local local_head
	local_head="$(git -C "$checkout" rev-parse HEAD 2>/dev/null || :)"
	if [ -z "$local_head" ]; then
		say "  $checkout has no commit to push"
	elif [ -n "$remote_head" ] && [ "$local_head" = "$remote_head" ]; then
		say "  $target main already carries this commit ($(printf '%.7s' "$local_head"))"
	elif ! git -C "$checkout" push -q origin HEAD:main >/dev/null 2>&1; then
		die "the seed commit could not be pushed to $target's main.
    THAT IS THE RULESET, and it is the thing this push exists to find out: the
    organisation's PR-only ruleset refuses a direct commit, and Rule 9's one commit
    per write cannot land through a PR gate — so the register would be unwritable.
    An administrator excludes $target from it:
        gh api /orgs/$WIP_ORG/rulesets
    then adds $target to the PR-only ruleset's exempt repositories.
    The clone and the seed commit are left exactly where they are, so a re-run after
    that has only to push:
        openRepoTools wip init"
	else
		say "  pushed the seed to $target main (which is also the ruleset probe)"
	fi

	# ---- step 9: WRITE THE POINTER FILE. The SECOND thing in this toolset that
	# writes a file outside a repository, after `resume --workspace`, for the
	# same reason and under the same condition: only on a machine that has none,
	# and only because the person asked for the repository by running this. It
	# never overwrites one — step 1 already returned where one existed.
	local written="$checkout"
	case "$checkout" in "$HOME"/*) written="~${checkout#"$HOME"}" ;; esac
	mkdir -p -- "$(dirname -- "$config")" ||
		die "could not create $(dirname -- "$config") for the pointer file.
    The repository is created, cloned, seeded and pushed; only this file is
    missing, and a re-run writes it."
	[ ! -e "$config" ] ||
		die "$config appeared while this ran; it was not overwritten."
	# GUARDED, because this command's exit codes are 0 and 2 and nothing else:
	# an unguarded redirect fails under `set -e` with the shell's own status 1,
	# which is the code this toolset reserves for "findings were printed". A
	# refusal that reads as a report is the defect openRepoTools' own convention
	# exists to prevent (`status:3076-3078`).
	printf 'repository: %s\npath: %s\n' "$target" "$written" >"$config" ||
		die "could not write $config. The repository is created, cloned, seeded and
    pushed; only this file is missing, and a re-run writes it."
	say "  wrote $config"
	say "        repository: $target"
	say "        path: $written"

	# ---- step 10: LINK-ESTATES, which places the symlinks and reports the ones
	# it skipped — and then THE HOOK PAIR (#237), which `--install` deferred on a
	# workstation that had no link yet for its two entries to call.
	wip_run_link_estates
	wip_hook_pair

	# ---- step 11: THE NEXT STEP, which is one line. `<profile>` is the one
	# value a person supplies and the one this command cannot derive: it is not
	# a function of the workspace repository.
	say ""
	say "Done. The next step is one line:"
	if command -v lclaude >/dev/null 2>&1; then
		say "    lclaude --lane <repo>-<n> <profile>"
	else
		say "    pclaude --lane <repo>-<n> <profile>"
	fi
	say ""
	say "  <profile>   \`pclaude list\` names them"
	say "  <repo>-<n>  the lane naming rule: the repository the lane is homed on,"
	say "              and its position — openRepoProject-1, workBenches-2"
	return 0
}

# `wip <verb>` — one noun, one verb, and a refusal that names the one there is.
wip_dispatch() {
	local verb="${1-}"
	shift || :
	case "$verb" in
	init) ;;
	'') die "\`wip\` takes one verb and it is \`init\`:
        openRepoTools wip init [--org <org>] [--login <name>] [--team <team>] [--dry-run]" ;;
	*) die "\`wip $verb\` is not a thing this command does. The one verb is \`init\`:
        openRepoTools wip init" ;;
	esac
	while [ $# -gt 0 ]; do
		case "$1" in
		--org) shift; [ $# -gt 0 ] || die "--org needs a value"; WIP_ORG="$1"; shift ;;
		--login) shift; [ $# -gt 0 ] || die "--login needs a value"; WIP_LOGIN="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"; shift ;;
		--team) shift; [ $# -gt 0 ] || die "--team needs a value"; WIP_TEAM="$1"; shift ;;
		--dry-run) WIP_DRY_RUN=1; shift ;;
		*) die "\`wip init\` takes --org, --login, --team and --dry-run, and nothing else.
    It got '$1'." ;;
		esac
	done
	if [ -n "$WIP_LOGIN" ] && ! wip_login_is_compliant "$WIP_LOGIN"; then
		die "--login '$WIP_LOGIN' cannot form a compliant \`<user>-wip\` name: openRepoShape's
    naming contract requires \`^[a-z0-9]+(-[a-z0-9]+)*-wip\$\`. Nothing was created."
	fi
	# THE REPOSITORY, THE REF AND THE DIRECTORY ARE ASKED HERE, BEFORE `wip_init`
	# DOES ANYTHING (#241). The repository and the ref: step 7 asks
	# `wip_shape_ref` for the standard's pin, and where no
	# `contracts/openreposhape-pin.yaml` sits beside this file (an installed
	# copy) that goes to the source, with `$OPENREPOTOOLS_REPO` at
	# `$OPENREPOTOOLS_REF` as typed in a `gh api` call, a raw URL and the
	# refusals that name them. The directory: step 10 runs the `link-estates`
	# in it, or else the one on `PATH` (`wip_run_link_estates`), and so does a
	# step 1 re-run whose hook target does not answer where `~/projects/xFactory`
	# is; either names the directory as typed in its `Error`, `STALE` and `NOTE`
	# lines and in its `KEEP`, `PLAN` and `LINK` lines. A run that finds none, or
	# whose re-run needs none, runs nothing and is refused all the same: the
	# directory is asked before anyone knows which a run will be. ONCE, AND NOT IN
	# `wip_shape_ref`: step 5 has made the repository and step 6 has cloned it by
	# then, and "Nothing was fetched, installed or replaced" would not be true.
	# `wip` has one verb, so this is every `wip init`: from a checkout, an
	# installed copy or a package, and `--dry-run` too, which prints and sends
	# none of the three but is the rehearsal of a run that refuses. The values
	# come first and the directory second, the order `--install` asks them in,
	# and the directory's `:` rule comes with it: the comment headed `the values
	# no line can print as they read`, below, says why. The arguments and
	# `--login` are refused above, as they always were.
	refuse_bad_values
	refuse_bad_bin_dir wip
	wip_init
}

# --- the values no line can print as they read (#241) -----------------------
#
# THREE VALUES REACH THIS COMMAND FROM THE ENVIRONMENT AND ARE NAMED IN ITS
# LINES AS THEY WERE TYPED: the directory `--install` places into, which is in
# the `$PATH` note, in every `installed at` line and in every refusal that
# names a target, and which `wip init` may run `link-estates` from, whose own
# lines name it; and `$OPENREPOTOOLS_REPO` and `$OPENREPOTOOLS_REF`, which
# `--version` prints and every fetch and every refusal about the source sends
# or names. What a person typed into one of them is not always what a line that
# prints it shows:
#
#   * A `:` splits a `$PATH` whatever the quoting, so no `export PATH=` line can
#     name a directory that holds one, and the `NOTE` about `$PATH` that
#     `link-estates` prints, which says to add the directory, cannot be followed
#     for one. That `NOTE` prints the name as typed all the same: it is the
#     `$PATH` a `:` breaks, not the line (the directory only; a repository or a
#     ref is no `$PATH`).
#   * A newline breaks the line it is printed in into two, so the second can
#     be made to say anything; a carriage return rewrites the line on the
#     terminal (`/tmp/x^MFORGED is not on $PATH`); an escape, and the C1
#     control U+009B that is its one-character form, are the terminal's to act
#     on. DEL and every other C0 control are refused with them: none belongs
#     in a name that is printed.
#   * A character a terminal draws as something other than itself shows one
#     name as another's: U+202E reorders the rest of the line, U+200B draws as
#     nothing, so `~/.local<U+200B>/bin` reads as `~/.local/bin`, and U+2028
#     ends a line for any reader that keeps Unicode's line breaks.
#
# EACH IS ASKED ONCE, BEFORE ANYTHING IS PLACED, FETCHED OR NAMED, and a refusal
# says which KIND of character it found and never repeats the value, so the
# refusal cannot forge a line either. The repository and the ref are asked by
# `refuse_bad_values`, before `--version` prints them (where it does print
# them: a package's `--version` names its stamp and neither value), before
# `--install` names or fetches with them, in a package as in a checkout, and in
# `wip_dispatch`, before `wip init` does anything. The directory is asked by
# `refuse_bad_bin_dir`, straight before `install_commands` and, in
# `wip_dispatch`, straight after `refuse_bad_values`. `--help` and the bare
# usage name the variables and never their values, so they answer past all
# three.
#
# `wip init` ASKS ALL THREE, FROM EVERY ROUTE AND WITH `--dry-run`. The
# repository and the ref: its step 7 asks `wip_shape_ref` for the standard's
# pin, and where no `contracts/openreposhape-pin.yaml` sits beside this file (an
# installed copy) that goes to the source: `payload_probe` and `fetch_from_repo`
# SEND `$OPENREPOTOOLS_REPO` and `$OPENREPOTOOLS_REF` as typed, in a `gh api`
# call and a raw URL, and `resolve_refuse` names them (the review of #241,
# MUST-1). The directory: `wip init`'s own lines never name it, because
# `wip_run_link_estates` only EXECUTES a `link-estates`, the one in
# `$OPENREPOTOOLS_BIN_DIR` or else the one on `PATH`, but that command names
# the directory as typed, in its `Error`, `STALE` and `NOTE` lines and in the
# `KEEP`, `PLAN` and `LINK` lines for the `lanes-edit.sh` link, as it does when
# run by hand. So a directory no line can print as it reads is refused before
# `wip init` can run it, in every run. Some runs run none: a dry run, a step 1
# re-run that needs no link (its hook target answers, or `~/projects/xFactory`
# is not there) and a host with no `link-estates`. They are asked all the same,
# which is why the refusal says "may run". THE `:` RULE
# COMES WITH THE DIRECTORY: `wip init` refuses a `:` in it, because the
# directory goes on a `$PATH` (that `NOTE` is a line about one) and a `:` splits
# a `$PATH` whatever the quoting, and takes a `:` in the repository and the ref
# as `--version` does.
#
# THE RULE IS openRepoShape's, as its `install.sh` and `openRepoShape
# --install` hold it, and it is read in bytes, under `LC_ALL=C` in a subshell,
# so the answer is the same in every locale:
#
#   * a CONTROL CHARACTER is `[[:cntrl:]]` (U+0000 to U+001F and DEL) or a C1
#     control (U+0080 to U+009F), which in UTF-8 is `0xC2` and a byte from
#     `0x80` to `0x9F`. It is NOT `[![:print:]]`: under `C` that matches every
#     byte past ASCII, so a directory called `café` was refused for a fault it
#     has not got (openRepoShape #940);
#   * a MISDRAWN CHARACTER is one of `MISDRAWN_CHARACTERS`, whose UTF-8 bytes
#     `misdrawn_characters` looks for and names by code point, so the refusal
#     can say which one nobody can see.
#
# THE TWO CASES openRepoShape #858 LEFT OPEN, DECIDED HERE:
#
#   * A NAME A MULTIBYTE LOCALE READS AS TEXT IS PLACED. GBK, GB18030 and CP936
#     read `0xC2 0x80` to `0xC2 0x9F` as 32 hanzi, and Big5, EUC-JP and EUC-KR
#     read U+00AD's two bytes as one letter, so the bytes alone refuse a name
#     that holds no control character at all in the locale it was typed in.
#     Where the bytes refuse a DIRECTORY, `locale_reading` asks the person's
#     own locale how it reads them and the C1 and misdrawn checks are made on
#     that reading. Only a directory is read this way: a repository and a ref
#     are held to the bytes alone, because no repository or ref has a reason
#     to be spelled in such a charset, and that is the stricter of the two.
#   * A LONE `0x9B` BYTE IS PLACED, and so is every other byte that is not UTF-8
#     (an overlong form of a control, a lone `0xE9`). A terminal that reads
#     UTF-8 draws such a byte as a character it cannot read, and only one set
#     to an 8-bit charset acts on it. This is the KNOWN LIMIT: it is the trade
#     openRepoShape made (#867), and `tests/test_install_unprintable_values_241.py`
#     holds it in a row of its own so that nobody changes it by accident. For
#     the same reason a locale that reads those bytes as letters, left in a
#     terminal that reads UTF-8, hands that terminal a C1 control it acts on.

#: THE CHARACTERS A TERMINAL DRAWS AS SOMETHING OTHER THAN THEMSELVES, by code
#: point, a range as its first and last (openRepoShape #837). Every entry is
#: U+0080 or above, because `misdrawn_characters` builds the two-, three- and
#: four-byte forms of UTF-8 and no other.
#:   00AD        the soft hyphen, drawn as a hyphen in a terminal cell and as
#:               nothing elsewhere, never as what it is;
#:   061C, 200E-200F, 202A-202E, 2066-2069
#:               the twelve bidirectional controls, which reorder the text
#:               around them: a mark the characters beside it, an embedding,
#:               override or isolate the rest of the line;
#:   2028-2029   the line and paragraph separators, which end a line for any
#:               reader that keeps Unicode's line breaks;
#:   200B, 2060-206F, FEFF, FFF9-FFFB, 1D173-1D17A, E0001
#:               the format characters of no width that nothing needs: the
#:               zero-width space and no-break space, the word joiner, the
#:               invisible operators, the deprecated format controls, the
#:               interlinear annotation characters, the musical beam, tie,
#:               slur and phrase controls, and the deprecated language tag.
#: LEFT OUT, EACH FOR ITS REASON: U+200C and U+200D (a name in Persian, in an
#: Indic script or with an emoji sequence holds them) and U+180E (Mongolian
#: needs it as Persian needs U+200C); the tags, the variation selectors and
#: U+034F, which are drawn as part of the character before them; the format
#: characters a script builds its signs with; and every space and the blank
#: Hangul fillers, each drawn as a blank cell, as a space is.
MISDRAWN_CHARACTERS=(00AD 061C 200B 200E-200F 2028-202E 2060-206F FEFF FFF9-FFFB 1D173-1D17A E0001)

#: WHICH OF THEM "$1" HOLDS, as `U+XXXX`, comma-separated, in that order, or
#: nothing. Run under `LC_ALL=C`, in a subshell, so the match is byte by byte
#: in every locale: each character's UTF-8 is built from its code point with
#: printf's octal escapes (`%b` reads `\0NNN`, as POSIX defines it), in two
#: bytes below U+0800, three below U+10000 and four above, and looked for in
#: the value as bytes. No byte is read back as a number, so one list says both
#: what is refused and what the refusal names.
misdrawn_characters() {
	local value="$1" entry code last bytes name found=""
	for entry in "${MISDRAWN_CHARACTERS[@]}"; do
		code=$((0x${entry%-*}))
		last=$((0x${entry#*-}))
		while [ "$code" -le "$last" ]; do
			if [ "$code" -lt 2048 ]; then
				printf -v bytes '\\0%o\\0%o' $((0xC0 | (code >> 6))) \
					$((0x80 | (code & 63)))
			elif [ "$code" -lt 65536 ]; then
				printf -v bytes '\\0%o\\0%o\\0%o' $((0xE0 | (code >> 12))) \
					$((0x80 | ((code >> 6) & 63))) $((0x80 | (code & 63)))
			else
				printf -v bytes '\\0%o\\0%o\\0%o\\0%o' \
					$((0xF0 | (code >> 18))) $((0x80 | ((code >> 12) & 63))) \
					$((0x80 | ((code >> 6) & 63))) $((0x80 | (code & 63)))
			fi
			printf -v bytes '%b' "$bytes"
			case "$value" in
			*"$bytes"*)
				printf -v name 'U+%04X' "$code"
				found="${found:+$found, }$name"
				;;
			*) ;;
			esac
			code=$((code + 1))
		done
	done
	printf '%s' "$found"
}

#: A C1 CONTROL IN "$1": U+0080 to U+009F, which UTF-8 spells as `0xC2` and a
#: byte from `0x80` to `0x9F`, looked for as those two bytes under `LC_ALL=C`
#: in a subshell, so the locale changes nothing. Left to a UTF-8 locale,
#: `[[:cntrl:]]` matches a C1 control only in a value that is valid UTF-8: one
#: byte that is not (a lone `0xE9`) makes bash match byte by byte, and then
#: U+009B's two bytes are no control.
holds_c1_control() {   # <value>
	(LC_ALL=C; case "$1" in *$'\302'[$'\200'-$'\237']*) exit 0 ;; *) exit 1 ;; esac)
}

#: THE VALUE AS THE PERSON'S LOCALE READS IT, IN UTF-8, WHERE THAT LOCALE READS
#: TWO OR MORE OF ITS BYTES AS ONE CHARACTER (openRepoShape #858). The control
#: check and `misdrawn_characters` look for UTF-8's bytes under `LC_ALL=C`, and
#: a multibyte charset that is not UTF-8 reads some of those bytes as text: GBK,
#: GB18030 and CP936 read `0xC2 0x80` to `0xC2 0x9F` as 32 hanzi; GBK, Big5,
#: EUC-JP and EUC-KR read U+00AD's two bytes as a hanzi, a kanji or a Hangul
#: syllable; and in Shift_JIS a kanji whose second byte is `0xC2`, before one
#: of the common kanji, puts a C1 control's two bytes side by side. It prints
#: the reading, and succeeds, only where:
#:   * `locale charmap`, asked under the person's own `LC_ALL`, `LC_CTYPE` and
#:     `LANG`, answers with a charset that is neither UTF-8, whose reading is
#:     the bytes, nor ASCII, which reads no byte past 0x7F;
#:   * `iconv` reads the whole value in that charset;
#:   * the reading, written back into that charset by `iconv`, is the value
#:     again, byte for byte, so an `iconv` that drops or changes a byte, or
#:     prints nothing at all and exits 0, gives no reading; and
#:   * the reading has fewer characters than the value has bytes, counted under
#:     `LC_ALL=C` as the bytes of UTF-8 that start a character (0x80 to 0xBF
#:     continue one). A single-byte charset reads each byte alone, and there
#:     the bytes decide: under a Latin-1 `LANG` left in a terminal that reads
#:     UTF-8, U+FEFF's three bytes would read as three letters.
#: Otherwise it prints nothing and fails, and the bytes decide: no `locale` or
#: no `iconv` (a minimal container), a charset either does not know, or a value
#: the charset cannot read. The locale is taken at its word, and that is the
#: trade (see above): a multibyte locale that is not UTF-8, left in a terminal
#: that reads UTF-8, is handed the C1 bytes it reads as letters, and that
#: terminal acts on them. This is openRepoShape's `locale_reading`, copied as it
#: is, so that neither command places a directory the other refuses.
locale_reading() {
	local charmap reading
	charmap="$(locale charmap 2>/dev/null)" || return 1
	case "$charmap" in
	"" | [Uu][Tt][Ff]-8 | [Uu][Tt][Ff]8 | ANSI_X3.4-1968 | *ASCII*) return 1 ;;
	*) ;;
	esac
	reading="$(printf '%s' "$1" | iconv -f "$charmap" -t UTF-8 2>/dev/null)" ||
		return 1
	[ "$(printf '%s' "$reading" | iconv -f UTF-8 -t "$charmap" 2>/dev/null)" = "$1" ] ||
		return 1
	(
		LC_ALL=C
		letters=${reading//[$'\200'-$'\277']/}
		[ "${#letters}" -lt "${#1}" ] || exit 1
		printf '%s' "$reading"
	)
}

#: WHAT "$1" HOLDS THAT NO LINE CAN PRINT AS IT READS, in words that never
#: repeat it, and 0; or nothing and 1 where it holds none. A CONTROL CHARACTER
#: comes first: `[[:cntrl:]]` is asked of the bytes as typed (those characters
#: are ASCII's in every charset a locale reads), and the C1 controls and the
#: misdrawn characters of the value as `locale_reading` reads it, when the
#: caller says `locale` and the bytes refuse it, else of the bytes too.
#: `$(...)` drops a newline at the end of a reading, which is why the typed
#: bytes are asked for the first.
value_fault() {   # <value> [locale]
	local value="$1" seen="$1" misdrawn
	if [ "${2-}" = locale ] &&
		{ holds_c1_control "$value" || [ -n "$(LC_ALL=C; misdrawn_characters "$value")" ]; }; then
		seen="$(locale_reading "$value")" || seen="$value"
	fi
	if (LC_ALL=C; case "$value" in *[[:cntrl:]]*) exit 0 ;; *) exit 1 ;; esac) ||
		holds_c1_control "$seen"; then
		printf '%s' 'a control character, such as a newline, a carriage return, a tab or an escape'
		return 0
	fi
	misdrawn="$(LC_ALL=C; misdrawn_characters "$seen")"
	if [ -n "$misdrawn" ]; then
		printf 'a character a terminal draws as something other than itself (%s): one that is invisible, is drawn as another character, ends a line or reorders the text around it' "$misdrawn"
		return 0
	fi
	return 1
}

#: THE DIRECTORY `--install` PLACES INTO AND `wip init` MAY RUN `link-estates`
#: FROM, ASKED BEFORE ANYTHING IS PLACED, FETCHED OR NAMED: refused for a
#: control character, a misdrawn character or a `:`, in that order, naming the
#: kind and never the directory. It is the directory as `install_commands` and
#: `wip_run_link_estates` compute it, so a `$HOME` holding one is refused when
#: `$OPENREPOTOOLS_BIN_DIR` is unset. A `:` IS REFUSED IN BOTH RUNS, because the
#: directory goes on a `$PATH` (`--install`'s note about one, and the `NOTE`
#: `link-estates` prints about one) and a `:` splits a `$PATH` whatever the
#: quoting. A WINDOWS SPELLING (`D:\tools`) holds a `:` and is refused with the
#: rest: nothing here spells one the way bash does, and on Windows the way in
#: is WSL2. `wip_dispatch` calls it with `wip`, and the refusal is then in `wip
#: init`'s words. It places nothing, and it says the run MAY run `link-estates`:
#: a dry run, a step 1 re-run that needs no link and a host with no
#: `link-estates` run none, and are asked all the same. It gives a reason for
#: each kind, as `--install`'s does. For a control or misdrawn character the
#: reason is that `link-estates` names the directory as typed, in its own lines
#: and in its `NOTE` about a `$PATH`, so none of them can print it as it reads.
#: For a `:` it is NOT that: `link-estates` prints the name intact, and what the
#: `:` breaks is the `$PATH`, so that `NOTE`'s "add it" cannot be followed.
#: Without an argument it is `--install`'s, byte for byte as it was before `wip
#: init` asked.
refuse_bad_bin_dir() {   # [wip]
	local dir="${OPENREPOTOOLS_BIN_DIR:-$HOME/.local/bin}" fault holds because wip_because
	if fault="$(value_fault "$dir" locale)"; then
		holds="$fault"
		because="so no line about \$PATH can print the name as it reads."
		wip_because="That command names the directory as typed, in its own lines and in a note about \$PATH, so none of them can print it as it reads."
	else
		case "$dir" in
		*:*)
			holds="a ':', and a ':' is what splits a \$PATH into its directories"
			because="so no line about \$PATH can name it."
			wip_because="That command's note about \$PATH says to add the directory, which a ':' makes impossible."
			;;
		*) return 0 ;;
		esac
	fi
	if [ "${1-}" = wip ]; then
		die "\`wip init\` may run \`link-estates\` from a directory whose name holds $holds. $wip_because
    Nothing was fetched, created or changed. Set \$OPENREPOTOOLS_BIN_DIR to a
    directory without one, then run this again."
	fi
	die "\`--install\` would place the ${#INSTALLABLES[@]} commands in a directory whose name holds $holds, $because
    NOTHING was installed and nothing already installed was replaced. Set
    \$OPENREPOTOOLS_BIN_DIR to a directory without one, then run this again."
}

#: THE REPOSITORY AND THE REF, CHECKED ONCE, BEFORE ANY LINE NAMES EITHER AND
#: BEFORE ANY REQUEST CARRIES THEM (openRepoShape #866): the same rule, with a
#: `:` allowed, because neither is a `$PATH`. The refusal never repeats the
#: value, so the shape refusals after it (`is_slug`'s, a fetch's) are the only
#: lines that print one, and by then it holds nothing a terminal acts on.
refuse_bad_values() {
	local fault
	if fault="$(value_fault "$REPO")"; then
		die "\$OPENREPOTOOLS_REPO holds $fault, so this command will not print it or send it in a request.
    Nothing was fetched, installed or replaced. Set \$OPENREPOTOOLS_REPO to an
    owner/name, such as opensoft/openRepoTools, then run this again."
	fi
	if fault="$(value_fault "$REF")"; then
		die "\$OPENREPOTOOLS_REF holds $fault, so this command will not print it or send it in a request.
    Nothing was fetched, installed or replaced. Set \$OPENREPOTOOLS_REF to a
    branch, a tag or a commit, such as main, then run this again."
	fi
}

# --- package mode -----------------------------------------------------------
#
# A PACKAGE READS ITS OWN STAMP BEFORE IT ACTS ON ANY ARGUMENT (#228, FR-012,
# design.md Decision 4). So a broken one refuses every invocation, `--help`,
# `--version`, `--install`, `wip` and none at all alike, and a build that
# cannot name its release places nothing. Package mode is decided from this
# file's own path (`package_payload_dir`), and the stamp is the file beside its
# payload and nothing else: no environment variable names it, mends it or
# stands in for it (FR-011, research R4). In a checkout or the one-line install
# this sets nothing and reads nothing.
package_init() {
	local here=""
	here="$(package_payload_dir)" || return 0
	PACKAGE_DIR="$here"
	stamp_read "${here%/*}/_release.py" ||
		die "this package's stamp (openrepotools/_release.py) $STAMP_WHY, so this build is broken and nothing ran. A package's stamp is a release's whole stamp or the unstamped one. Reinstall it: pipx reinstall openrepotools"
}

# `--version` IN PACKAGE MODE names the release this command IS, from the stamp
# `package_init` read: never the release of the files `--install` placed, and
# never the source a fetch would read (contracts/cli-output.md, FR-014).
package_version() {
	if [ "$STAMP_STATE" = stamped ]; then
		say "openRepoTools $STAMP_VERSION ($STAMP_REPOSITORY @ $STAMP_COMMIT)"
		say "  version   $STAMP_VERSION"
		say "  tag       $STAMP_TAG"
		say "  commit    $STAMP_COMMIT"
		say "  digest    $STAMP_DIGEST (sorted-ls-tree-r-v1)"
	else
		say "openRepoTools 0.0.0 (an unstamped package)"
		say "  version   0.0.0, unstamped: a package built from a checkout, not a release"
		say "  tag       none"
		say "  commit    none"
		say "  digest    none"
	fi
}

# ONCE, AFTER EVERY FUNCTION IS DEFINED AND BEFORE THE FIRST ARGUMENT IS READ.
package_init

# --- arguments ------------------------------------------------------------
#
# THREE FLAGS AND ONE VERB PAIR, and no others. The refusal names the commands
# rather than repeating the usage: somebody typing `openRepoTools park` wants
# `park`, and the shortest true answer is where it is.
#
# `wip` CONSUMES THE REST OF THE LINE, because `wip init --org x` is one
# command with its own options and not four arguments to this one.
while [ $# -gt 0 ]; do
	case "$1" in
	-h | --help) usage; exit 0 ;;
	--version)
		# A PACKAGE NAMES ITS RELEASE. A checkout and the one-line install name
		# the repository and the ref they fetch from, as they always have, and
		# so they are checked first (#241): a package prints neither value, so
		# it asks neither of them anything.
		if [ -n "$PACKAGE_DIR" ]; then
			package_version
		else
			refuse_bad_values
			say "openRepoTools ($REPO @ $REF)"
		fi
		exit 0 ;;
	--install) MODE="install"; shift ;;
	wip) shift; wip_dispatch "$@"; exit $? ;;
	*)
		die "openRepoTools installs the estate commands and creates the workspace they read.
    It takes --install, \`wip init\`, --help or --version. The commands themselves:
    \`park --help\`, \`resume --help\`, \`status --help\`."
		;;
	esac
done

if [ "$MODE" = "install" ]; then
	# THE THREE VALUES NO LINE CAN PRINT AS THEY READ ARE REFUSED FIRST (#241):
	# before a request carries the repository or the ref, before the directory
	# is named by a line or a refusal, and before anything is placed.
	refuse_bad_values
	refuse_bad_bin_dir
	install_commands
	exit 0
fi

# NO ARGUMENT AT ALL is the usage, on stdout and exit 0: a person who typed the
# name to see what it is has asked a question, not made a mistake.
usage
exit 0
