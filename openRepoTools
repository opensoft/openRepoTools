wip_config_file() { printf '%s\n' "${AGENT_PROTOCOL_ROOT:-$HOME/.agents}/workspace.yaml"; }

# Where a new clone goes. `$PROJECTS_DIR` names one directory when it is set;
# otherwise `~/projects`, then `~/Projects` where that exists and is a
# different directory — the block `park`, `resume` and `status` already carry,
# narrowed to the one question this command asks of it.
wip_projects_dir() {
	if [ -n "${PROJECTS_DIR:-}" ]; then printf '%s\n' "$PROJECTS_DIR"; return 0; fi
	[ -d "$HOME/projects" ] && { printf '%s\n' "$HOME/projects"; return 0; }
	if [ -d "$HOME/Projects" ]; then printf '%s\n' "$HOME/Projects"; return 0; fi
	printf '%s\n' "$HOME/projects"
}

wip_yaml_field() {
	local v
	v="$(sed -n -e "s/^$1:[[:space:]]*//p" "$2" 2>/dev/null | head -n 1 |
		sed -e 's/[[:space:]]*#.*$//' -e 's/[[:space:]]*$//')"
	v="${v%\"}"; v="${v#\"}"
	v="${v%\'}"; v="${v#\'}"
	case "$v" in
	'~') v="$HOME" ;;
	'~/'*) v="$HOME/${v#'~/'}" ;;
	esac
	printf '%s\n' "$v"
}

wip_norm_repo() {
	local u="${1%.git}"
	case "$u" in
	https://github.com/*) u="${u#https://github.com/}" ;;
	ssh://git@github.com/*) u="${u#ssh://git@github.com/}" ;;
	git@github.com:*) u="${u#git@github.com:}" ;;
	esac
	printf '%s' "$u" | tr '[:upper:]' '[:lower:]'
}

# Is $2 the ROOT of a checkout of $1? The same three-part test the four lane
# helpers make, because step 1's idempotence and their refusal have to agree on
# what "already has a workspace" means, or a host can pass one and fail the
# other. Local only; no network.
wip_is_checkout_of() {
	local want="$1" path="$2" origin toplevel real
	[ -n "$path" ] || return 1
	git -C "$path" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 1
	origin="$(wip_norm_repo "$(git -C "$path" remote get-url origin 2>/dev/null || :)")"
	want="$(wip_norm_repo "$want")"
	if [ -z "$origin" ] || [ "$origin" != "$want" ]; then
		# The origin's path ENDING in the `<owner>/<name>` the pointer file
		# spells is the same repository: a GitHub Enterprise host, an ssh alias
		# and a local bare mirror laid out by owner and name all say that, and
		# the pointer file spells `<owner>/<name>` because that is what a person
		# types. The four lane helpers make this same test, in the same words.
		case "$origin" in
		*/"$want") ;;
		*) return 1 ;;
		esac
	fi
	toplevel="$(git -C "$path" rev-parse --show-toplevel 2>/dev/null || :)"
	real="$(cd -- "$path" 2>/dev/null && pwd -P)" || return 1
	[ "$toplevel" = "$real" ]
}

wip_have_gh() { command -v gh >/dev/null 2>&1; }

# --- step 2: the login ------------------------------------------------------
#
# `gh api user -q .login`, LOWERCASED — the naming contract's own definition of
# `<user>`. A login that cannot form a compliant name under that family's
# pattern is a refusal naming the pattern and its source, never a name repaired
# by guesswork (R-A9-3).
wip_login_is_compliant() {
	case "$1" in
	'' | *[![:lower:][:digit:]-]* | -* | *- | *--*) return 1 ;;
	*) return 0 ;;
	esac
}

wip_derive_login() {
	local login
	wip_have_gh || die "\`wip init\` needs your GitHub login and there is no \`gh\` to read it with.
    Install GitHub CLI, run \`gh auth login\`, then run \`openRepoTools wip init\` again.
    Nothing was created."
	if command -v timeout >/dev/null 2>&1; then
		login="$(timeout 20 gh api user -q .login 2>/dev/null || :)"
	else
		login="$(gh api user -q .login 2>/dev/null || :)"
	fi
	login="$(printf '%s' "$login" | tr '[:upper:]' '[:lower:]')"
	[ -n "$login" ] || die "\`gh api user\` did not answer with a login, so this command does not know whose
    workspace to create. That is the one precondition it has:
        gh auth login
    Then run \`openRepoTools wip init\` again. Nothing was created."
	wip_login_is_compliant "$login" || die "the GitHub login '$login' cannot form a compliant \`<user>-wip\` name.
    openRepoShape's naming contract requires \`^[a-z0-9]+(-[a-z0-9]+)*-wip\$\`, and an
    underscore, a doubled hyphen or a leading or trailing one does not fit it. This
    command does not repair a name by guesswork. Name the repository yourself:
        openRepoTools wip init --login <name>
    Nothing was created."
	printf '%s\n' "$login"
}

# --- step 4: the team, or no team ------------------------------------------
#
# `gh api /user/teams` filtered to the organisation. EXACTLY ONE match is used.
# None, or more than one, and `--team` is omitted ENTIRELY — from what is run
# and from what is printed — with one line saying why. A placeholder a person
# must fill is a question wearing a different hat, and this command asks at
# most once. (Ratified decision 2.)
wip_derive_team() {
	local org="$1" teams count
	WIP_TEAM=""
	WIP_TEAM_WHY=""
	if ! wip_have_gh; then
		WIP_TEAM_WHY="no \`gh\` to read /user/teams with"
		return 0
	fi
	teams="$(gh api --paginate /user/teams \
		-q ".[] | select((.organization.login | ascii_downcase) == \"$(printf '%s' "$org" | tr '[:upper:]' '[:lower:]')\") | .slug" \
		2>/dev/null || :)"
	count="$(printf '%s' "$teams" | grep -c . || :)"
	case "${count:-0}" in
	1)
		WIP_TEAM="$(printf '%s' "$teams" | head -n 1)"
		;;
	0)
		WIP_TEAM_WHY="you are in no team in $org"
		;;
	*)
		WIP_TEAM_WHY="you are in $count teams in $org, and this command does not choose between them"
		;;
	esac
	return 0
}

# --- step 5: the block an administrator runs -------------------------------
#
# THREE ADMINISTRATOR ACTS, NOT TWO (Addendum 1(2) on brettheap/new-workstation#17).
# Every value of steps 2 to 4 is already substituted, so what is printed runs as
# it stands. The third is not a fixed command, because a ruleset's id is not
# derivable without reading the organisation's rulesets: the block prints the
# one call that lists them, with the organisation substituted, and names the
# change to make.
# GIT'S OWN WORDS, KEPT (F9 of the #24 review, ruled R-A9-15). The three
# failures a FRESH workstation actually meets are here — the clone, the stage
# and the commit — and all three ran `>/dev/null 2>&1` and died with a summary
# of this command's own devising. A machine with no `user.email` configured got
# `could not commit the seed in <path>.` and nothing else, from the command
# whose whole job is to set up a new machine, when git had already said exactly
# what to do about it. So the command runs, its stderr is kept, and the last of
# it is printed UNDER the refusal — the shape `fetch_from_repo`'s refusal
# already has, where it names both ways it tried.
#
# STDOUT IS STILL DROPPED: `gh repo clone` and `git commit` are chatty on
# success and this command's own `say` lines are the report. It is the WORDS OF
# A FAILURE that were being thrown away, not progress.
WIP_LAST_ERR=""
wip_quietly() {   # <command> [args…] — 0 or 1, with stderr in $WIP_LAST_ERR
	workdir
	WIP_LAST_ERR=""
	if "$@" >/dev/null 2>"$WORKDIR/cmd-err"; then
		return 0
	fi
	WIP_LAST_ERR="$(tail -n 6 -- "$WORKDIR/cmd-err" 2>/dev/null | sed -e 's/^/    | /')"
	[ -n "$WIP_LAST_ERR" ] || WIP_LAST_ERR="    | (it printed nothing at all)"
	return 1
}

wip_admin_block() {
	local target="$1" org="$2" team="$3"
	say ""
	say "  # 1. create the repository (org-owned, private)"
	if [ -n "$team" ]; then
		say "  gh repo create $target --private --team $team \\"
	else
		say "  gh repo create $target --private \\"
	fi
	say "      --description \"${WIP_LOGIN}'s workspace repository: lanes, handoffs, workspaces\""
	say ""
	if [ -n "$team" ]; then
		say "  # 2. give the team read; --team alone grants the org default, not read"
		say "  gh api --method PUT \\"
		say "      /orgs/$org/teams/$team/repos/$target -f permission=pull"
		say ""
		say "  # 3. exclude it from the organisation's PR-only ruleset. Without this,"
	else
		say "  # 2. exclude it from the organisation's PR-only ruleset. Without this,"
	fi
	say "  #    Rule 9's one commit per write cannot land and the register is"
	say "  #    unwritable. List the rulesets, then add $target to the"
	say "  #    PR-only one's exempt repositories:"
	say "  gh api /orgs/$org/rulesets"
	say ""
	if [ -z "$team" ]; then
		say "  (No \`--team\` and no team grant: ${WIP_TEAM_WHY:-no single team matched}. The"
		say "   repository is created without one and an administrator may add one.)"
		say ""
	fi
}

# --- step 7: the template, and the whole of its substitution table ----------
#
# openRepoTools substitutes the placeholders ITSELF. openRepoShape's engine
# (`scripts/shape_materialize.py`) is reached only by that repository's own
# tools, and `grep -rn 'workspace-root'` finds no code path there for this
# template at all — so the consumer substitutes, the consumer is this command,
# and the tokens are exactly these three (clause (c) step 7):
#
#   {{LOGIN}}             the lowercased GitHub login      step 2
#   {{ORG}}               the organisation                 step 3
#   {{SHAPE_REPOSITORY}}  opensoft/openRepoShape           constant here
#
# A TOKEN THE TABLE DOES NOT CARRY IS A REFUSAL NAMING THE TOKEN — never a
# blank, and never a literal `{{…}}` written into a person's repository. That
# is what openRepoShape's own engine does with an unsubstituted token
# (`Refusal("template-unsubstituted", …)`), and it is why the table is written
# here rather than left to a private function that is no published contract.
wip_substitute() {
	local file="$1" left
	# `|` as the sed delimiter would collide with the table rows in LANES.md;
	# these three values are a login, an `<org>` and an `<owner>/<name>`, so `#`
	# cannot appear in any of them and is safe as the delimiter.
	sed -e "s#{{LOGIN}}#$WIP_LOGIN#g" \
		-e "s#{{ORG}}#$WIP_ORG#g" \
		-e "s#{{SHAPE_REPOSITORY}}#$SHAPE_REPOSITORY#g" \
		-- "$file" >"$file.subst" || die "could not substitute the template file $file"
	left="$(grep -o -e '{{[A-Z_]*}}' "$file.subst" 2>/dev/null | sort -u | tr '\n' ' ' || :)"
	if [ -n "$left" ]; then
		rm -f -- "$file.subst"
		die "the template carries a placeholder this command has no value for: $left
    (in ${file##*/}). Amendment 9(c) step 7's substitution table is {{LOGIN}}, {{ORG}}
    and {{SHAPE_REPOSITORY}}, and a token outside it is a refusal naming the token —
    never a blank, and never a literal {{…}} written into your repository.
    Nothing was created."
	fi
	mv -f -- "$file.subst" "$file"
}

# The template's bytes, materialized EXACTLY the way `--install` gets its own
# files: from the checkout beside this command when run from one, else
# `gh api …/contents/<path>` at the pinned ref, else the raw URL. *That the
# template travels by the installer's own fetch path is the drafter's; the
# issue named the template and not its transport.*
wip_shape_ref() {
	local pin selfdir=""
	[ -f "$SELF" ] && selfdir="$(cd -- "$(dirname -- "$SELF")" && pwd)"
	if [ -n "$selfdir" ] && [ -f "$selfdir/contracts/openreposhape-pin.yaml" ]; then
		pin="$(sed -n -e 's/^commit:[[:space:]]*//p' "$selfdir/contracts/openreposhape-pin.yaml" | head -n 1)"
		pin="${pin%\"}"; pin="${pin#\"}"
		[ -n "$pin" ] && { printf '%s\n' "$pin"; return 0; }
	fi
	workdir
	if fetch_from_repo "contracts/openreposhape-pin.yaml" "$WORKDIR/pin.yaml"; then
		pin="$(sed -n -e 's/^commit:[[:space:]]*//p' "$WORKDIR/pin.yaml" | head -n 1)"
		pin="${pin%\"}"; pin="${pin#\"}"
		[ -n "$pin" ] && { printf '%s\n' "$pin"; return 0; }
	fi
	printf 'main\n'
}

wip_fetch_template_file() {
	local rel="$1" dest="$2" ref="$3" selfdir="" path="$WIP_TEMPLATE_DIR/$rel"
	[ -f "$SELF" ] && selfdir="$(cd -- "$(dirname -- "$SELF")" && pwd)"
	if [ -n "$selfdir" ] && [ -f "$selfdir/upstream/openRepoShape/$path" ]; then
		cp -- "$selfdir/upstream/openRepoShape/$path" "$dest"
		return 0
	fi
	if command -v gh >/dev/null 2>&1 &&
		gh api "repos/$SHAPE_REPOSITORY/contents/$path?ref=$ref" \
			-H 'Accept: application/vnd.github.raw' >"$dest" 2>/dev/null &&
		[ -s "$dest" ]; then
		return 0
	fi
	if command -v curl >/dev/null 2>&1 &&
		curl -fsSL "https://raw.githubusercontent.com/$SHAPE_REPOSITORY/$ref/$path" \
			>"$dest" 2>/dev/null && [ -s "$dest" ]; then
		return 0
	fi
	# `workspaces/.gitkeep` is zero bytes upstream, so `-s` above is false for
	# it on every path. It carries no placeholder and no content by definition:
	# git tracks no empty directory, and that is the whole of its job.
	case "$rel" in
	*/.gitkeep | .gitkeep) : >"$dest"; return 0 ;;
	esac
	return 1
}

# --- the command itself -----------------------------------------------------
wip_init() {
	local config target checkout ref rel dest seeded=0 owed=0 kind
	local existing_repo existing_path
	# THE PATHS THE SEED OWES THIS CHECKOUT, which is what step 8 stages and
	# commits and the whole of what it commits: the ones step 7 wrote (`seeded`)
	# and the ones an earlier run wrote and could not commit (`owed`). Two
	# counters rather than `${#written[@]}`: an empty array expanded as
	# `"${written[@]}"` is an UNBOUND VARIABLE under `set -u` in the bash 3.2
	# macOS ships, so every reader of this list is guarded on a count, and the
	# count that says how many were COPIED is the one step 7's line prints.
	local written
	written=()

	# ---- step 1: DETECT. A file test, not a network call, and the whole of the
	# idempotence. A host that already has a workspace does nothing at all.
	config="$(wip_config_file)"
	if [ -f "$config" ]; then
		existing_repo="$(wip_yaml_field repository "$config")"
		existing_path="$(wip_yaml_field path "$config")"
		if [ -n "$existing_repo" ] && [ -n "$existing_path" ] &&
			wip_is_checkout_of "$existing_repo" "$existing_path"; then
			say "workspace repository: $existing_repo"
			say "  checked out at      $existing_path"
			say "  named by            $config"
			say "openRepoTools wip init: nothing to do."
			return 0
		fi
		# A file that names a repository the path is NOT a checkout of is a
		# refusal, never a silent overwrite: which private repository holds a
		# person's unfinished work is theirs to name, and this command has
		# exactly one write to that file and only on a machine that has none.
		if [ -n "$existing_repo" ]; then
			die "$config already names \`repository: $existing_repo\`, and its \`path: ${existing_path:-<none>}\`
    is not the root of a checkout of it. This command never overwrites that file.
    Either fix the two lines by hand, or move the file aside and re-run. Nothing
    was created."
		fi
		die "$config exists and names no \`repository:\`. This command never overwrites
    that file — a half-written pointer is still somebody's. Fix it by hand, or move
    it aside and re-run. Nothing was created."
	fi

	# ---- steps 2 to 4: DERIVE. Nothing here is asked.
	[ -n "$WIP_LOGIN" ] || WIP_LOGIN="$(wip_derive_login)"
	[ -n "$WIP_ORG" ] || WIP_ORG="$WIP_ORG_DEFAULT"
	target="$WIP_ORG/$WIP_LOGIN-wip"
	if [ -z "$WIP_TEAM" ]; then
		wip_derive_team "$WIP_ORG"
	fi
	say "workspace repository: $target"
	say "  login               $WIP_LOGIN (derived from gh api user)"
	say "  organisation        $WIP_ORG"
	if [ -n "$WIP_TEAM" ]; then
		say "  team                $WIP_TEAM (the one team you are in there)"
	else
		say "  team                none — ${WIP_TEAM_WHY:-no single team matched}, so --team is omitted"
		say "                      entirely and an administrator may add one later."
	fi

	checkout="$(wip_projects_dir)/$WIP_LOGIN-wip"

	if [ "$WIP_DRY_RUN" -eq 1 ]; then
		say ""
		say "--dry-run, so nothing below was done:"
		say "  would create  $target (private, org-owned)"
		say "  would clone   $target -> $checkout"
		say "  would seed    ${#WIP_TEMPLATE_FILES[@]} files from $SHAPE_REPOSITORY $WIP_TEMPLATE_DIR"
		say "  would push    one commit to main (which is also the ruleset probe)"
		say "  would write   $config (repository:, path:)"
		say "  would run     link-estates"
		return 0
	fi

	# ---- step 5: CREATE IT, OR PRINT THE COMMANDS — ruling 2.
	wip_have_gh || die "\`wip init\` needs \`gh\` to create or find $target. Install GitHub CLI,
    run \`gh auth login\`, then run this again. Nothing was created."
	if gh repo view "$target" >/dev/null 2>&1; then
		say ""
		say "  $target is already there; this run adopts it."
	else
		say ""
		say "  creating $target"
		local create_args
		create_args=(repo create "$target" --private)
		[ -n "$WIP_TEAM" ] && create_args+=(--team "$WIP_TEAM")
		create_args+=(--description "$WIP_LOGIN's workspace repository: lanes, handoffs, workspaces")
		if gh "${create_args[@]}" >/dev/null 2>&1; then
			say "  created $target"
			if [ -n "$WIP_TEAM" ]; then
				# `--team` alone grants the ORG DEFAULT, not read.
				# THE LINE ITSELF, not a pointer to a block that is not printed
				# on this path: `wip_admin_block` is reached only where the
				# CREATE failed, and this arm is the one where it succeeded
				# (F8 of the #24 review).
				gh api --method PUT \
					"/orgs/$WIP_ORG/teams/$WIP_TEAM/repos/$target" -f permission=pull \
					>/dev/null 2>&1 || {
					say "  (could not give team $WIP_TEAM read. An administrator can:"
					say "     gh api --method PUT /orgs/$WIP_ORG/teams/$WIP_TEAM/repos/$target -f permission=pull)"
				}
			fi
		else
			# RULING 2: PRINT THE COMMAND, and continue once the repository
			# exists. It never asks for a token and never tries a second
			# credential.
			say ""
			# NAMED FOR WHAT HAPPENED, not for a cause this has not proved. The
			# usual cause is that the account may not create a repository in
			# this organisation, and the block below is the answer to that; a
			# network that was down is the other, and the same block re-run
			# costs nothing. Claiming the first outright would send a person to
			# an administrator over a dropped connection.
			say "\`gh repo create $target\` did not succeed — most often because this account"
			say "may not create a repository in $WIP_ORG."
			say "These are the acts an administrator runs. Every value is already filled in:"
			wip_admin_block "$target" "$WIP_ORG" "$WIP_TEAM"
			# ONE QUESTION, ONE RE-CHECK, no poll loop and no timeout to choose:
			# an unbounded wait is a decision the person never asked to make.
			if [ -t 0 ]; then
				printf '%s' "Press Enter when the administrator has run these (Ctrl-C to stop): " >&2
				read -r _ || :
				if gh repo view "$target" >/dev/null 2>&1; then
					say "  $target is there now; carrying on."
				else
					die "$target is still not there, so there is nothing to clone. Run the block
    above, then: openRepoTools wip init   (it is idempotent and picks up here)."
				fi
			else
				# An unattended launch must not block on a person.
				die "$target does not exist and this run has no terminal to wait on. Run the block
    above, then: openRepoTools wip init"
			fi
		fi
	fi

	# ---- step 6: CLONE IT. Before the seed, because the seed is a commit and a
	# commit needs a checkout.
	if [ -d "$checkout/.git" ]; then
		wip_is_checkout_of "$target" "$checkout" ||
			die "$checkout is already a checkout, and not of $target. This command will not
    write into a clone of somebody else's repository, and it will not move one aside.
    Move it yourself, or pass a different projects directory with \$PROJECTS_DIR.
    $target exists; NOTHING was written into that checkout, and a re-run picks
    up from here."
		say "  $checkout is already a checkout of $target"
	elif [ -e "$checkout" ]; then
		die "$checkout already exists and is not a git checkout. $target exists;
    NOTHING was written into that path, and a re-run picks up from here once it
    is moved aside."
	else
		mkdir -p -- "$(dirname -- "$checkout")"
		say "  cloning $target -> $checkout"
		wip_quietly gh repo clone "$target" "$checkout" -- --quiet ||
			die "could not clone $target into $checkout. Nothing else was changed.
    What it said:
$WIP_LAST_ERR"
	fi

	# ---- step 6a: AN ADOPTED CHECKOUT CARRIES THE TEMPLATE AND NOTHING ELSE,
	# OR THIS COMMAND STOPS (#40, finding 1).
	#
	# Step 8 staged with `git add -A -- .` and committed whatever
	# `status --porcelain` had found, so a checkout ADOPTED at the derived path —
	# or one a half-finished earlier run left behind — had every unrelated
	# modified, deleted and untracked file it carried staged, committed and
	# `push origin HEAD:main`ed as part of the seed. The repository on the other
	# end of that push is the one a person keeps their unfinished work in, which
	# is the last place a file should arrive by accident.
	#
	# ASKED HERE, BEFORE STEP 7 WRITES A SINGLE BYTE INTO THAT CHECKOUT, for the
	# reason `plan_install_targets` is asked before the fetch: a refusal costs
	# nothing at all at this point, and the person's own files are still exactly
	# where they left them when they read it.
	#
	# THE TEMPLATE'S OWN PATHS ARE NOT `UNRELATED`, which is why the question is
	# put to git as an EXCLUSION and not as "is it clean": a first run that
	# fetched and copied the ${#WIP_TEMPLATE_FILES[@]} files and then could not
	# commit them — no `user.email`, the case F9 is written about — leaves
	# exactly those paths behind, and step 7's promise is that a re-run after a
	# half-finished run is safe. `--untracked-files=all` because git collapses an
	# untracked DIRECTORY to one line otherwise, and `handoffs/` is not a path
	# any exclusion below spells.
	local status_args unrelated
	status_args=(status --porcelain --untracked-files=all -- .)
	for rel in "${WIP_TEMPLATE_FILES[@]}"; do
		status_args+=(":(exclude)$rel")
	done
	unrelated="$(git -C "$checkout" "${status_args[@]}" 2>/dev/null | sed -e 's/^/    /' || :)"
	if [ -n "$unrelated" ]; then
		die "$checkout carries changes this command did not write:
$unrelated
    A seed commit is $SHAPE_REPOSITORY's $WIP_TEMPLATE_DIR and nothing else, and the
    push that follows it goes straight to $target's main — so anything else
    staged beside it is somebody's unfinished work published. NOTHING was written
    into that checkout on this run and nothing was staged.
    Commit, stash or remove those paths, then re-run:
        openRepoTools wip init"
	fi

	# ---- step 7: SEED IT FROM THE TEMPLATE, additively. A repository that
	# already has a commit on `main` is NOT re-seeded: files the template would
	# place and that are already there are left exactly as they are, and the
	# missing ones are added — which is what makes a re-run after a
	# half-finished first run safe.
	ref="$(wip_shape_ref)"
	workdir
	for rel in "${WIP_TEMPLATE_FILES[@]}"; do
		dest="$WORKDIR/tpl-$(printf '%s' "$rel" | tr '/' '_')"
		if [ -e "$checkout/$rel" ] || [ -L "$checkout/$rel" ] ||
			git -C "$checkout" cat-file -e ":$rel" 2>/dev/null ||
			git -C "$checkout" cat-file -e "HEAD:$rel" 2>/dev/null ||
			[ -n "$(git -C "$checkout" ls-files -u -- "$rel" 2>/dev/null)" ]
		then
			# ALREADY THERE, OR AS GOOD AS — AND THE SEED CAN STILL OWE IT. A template path the
			# WORKTREE carries and HEAD does not is what an earlier run of this
			# command leaves behind when it copied the template and could not
			# commit it: no `user.email`, the case the refusal below is written
			# about. Step 8 has to carry those, or the re-run this step promises
			# commits nothing, pushes nothing, and writes the pointer file over
			# an EMPTY main — the one state no later run can dig out of.
			#
			# A TEMPLATE PATH HEAD ALREADY CARRIES IS THE PERSON'S, whatever it
			# says now: this command has never modified a committed file, so a
			# change at one is not its leftover and never enters its commit
			# (#44 round 1, `openRepoTools:1525`).
			#
			# `! cat-file -e HEAD:…` ALONE IS NOT PROOF (#44 round 2,
			# `openRepoTools:1621`): a template path that is UNTRACKED and
			# carries a PERSON'S OWN CONTENT is absent from HEAD exactly as
			# this command's own leftover is, so it answered this question the
			# same way and went into the seed regardless of whose bytes they
			# were. The bytes settle what the question alone could not: this
			# command's own leftover is what THIS RUN would itself write
			# there, so the template is fetched and substituted the same way
			# a MISSING file below is, and the two are compared before either
			# is trusted as this command's own.
			#
			# THE WORKTREE TEST ALONE MISSES FOUR MORE SHAPES (#44 round 3,
			# `openRepoTools:1613`/`:1615`/`:1699`): a DANGLING symlink answers
			# `[ -e ]` false exactly as nothing-there-at-all does, so without
			# the `-L` above the MISSING branch below would meet it at `cp` and
			# follow it — writing this run's bytes wherever it points, inside
			# this checkout or far outside it; a person's own `git add` of a
			# template path, followed by removing the worktree file, leaves
			# the INDEX carrying something the worktree no longer does, which
			# the same MISSING branch would silently overwrite at `cp` and
			# step 8 would then stage over; a `git rm` of a path HEAD already
			# carries — staged, worktree gone, index gone too — passes none of
			# the first three tests either, so without asking `HEAD` directly
			# here the same MISSING branch would put the file straight back,
			# undoing a deletion this command has never modified a committed
			# file to make; and an UNRESOLVED MERGE CONFLICT can leave a path
			# at stages 1-3 with no stage 0, no worktree file and no `HEAD`
			# entry at all — invisible to all four other tests — so it is
			# asked for directly too. All four are asked for here instead,
			# beside the worktree.
			if ! git -C "$checkout" cat-file -e "HEAD:$rel" 2>/dev/null; then
				# THE SAME QUESTION `unplaceable_kind` ASKS OF AN INSTALL TARGET,
				# asked of an owed candidate: a SYMLINK is never this command's
				# own, dangling or not, because `cmp` reads through a live one to
				# whatever it names — so one whose target happens to hold the
				# template's own bytes would pass the comparison below, and a
				# `git add` of it stages the LINK ITSELF, not the bytes at its far
				# end — and a FIFO, a socket or a device node is worse: `cmp`
				# opens it and can block waiting for a writer, or read whatever a
				# device answers, rather than refusing. `path_kind` already
				# answers all three the same way `--install`'s own planners rely
				# on; this command has placed none of them at a template path, so
				# any of them here is refused before either branch can act on it,
				# open it, or write through it.
				if kind="$(path_kind "$checkout/$rel")"; then
					die "$checkout/$rel is $kind, and a seed commit is the template's own bytes
    at a REGULAR FILE and nothing else there could be. Nothing beyond this run's own
    template bytes was written into that checkout, and nothing was staged.
    Remove or replace that path, then re-run:
        openRepoTools wip init"
				fi
				# AN UNRESOLVED MERGE CONFLICT'S STAGES ARE INVISIBLE TO A
				# STAGE-0 QUESTION: `:$rel` reads stage 0 alone, so a path with
				# only stages 1-3 (added differently on both sides of a merge,
				# say) answers `cat-file -e ":$rel"` false exactly as an empty
				# index does, and step 6a's own exclusion of template paths
				# means no earlier gate has seen it either. This command has
				# never resolved anybody's merge, so a conflict here is refused
				# rather than silently settled by whichever branch the
				# worktree's own state happens to satisfy.
				if [ -n "$(git -C "$checkout" ls-files -u -- "$rel" 2>/dev/null)" ]; then
					die "$checkout has an unresolved merge conflict at $rel, and HEAD does not
    carry $rel either, so this command cannot tell which side, if either, is its own
    template substitution. This command has never resolved anybody's merge. Nothing beyond
    this run's own template bytes was written into that checkout, and nothing was staged.
    Resolve that conflict, then re-run:
        openRepoTools wip init"
				fi
				# AND THE INDEX CAN OWE SOMETHING THE WORKTREE NO LONGER HAS AT ALL:
				# this command has never staged a path and then removed its own file
				# from under it, so an index entry with nothing on disk behind it is
				# somebody else's, whatever it holds.
				if [ ! -e "$checkout/$rel" ]; then
					die "$checkout/$rel does not exist, HEAD does not carry $rel, and something is
    staged there anyway — so this is somebody's own staged addition, removed from the
    worktree after being added, and not this command's to overwrite or commit over. Nothing
    beyond this run's own template bytes was written into that checkout, and nothing
    already staged was changed.
    Commit, stash or unstage that path, then re-run:
        openRepoTools wip init"
				fi
				wip_fetch_template_file "$rel" "$dest" "$ref" ||
					die "could not fetch $WIP_TEMPLATE_DIR/$rel from $SHAPE_REPOSITORY at $ref, so $rel
    itself was NOT seeded. Nothing beyond an earlier template path's own bytes in
    this same run, if it reached one before this fetch, was written into that
    checkout, and nothing was staged; a re-run picks up from here. Both ways were tried:
    gh api repos/$SHAPE_REPOSITORY/contents/$WIP_TEMPLATE_DIR/$rel?ref=$ref
    curl -fsSL https://raw.githubusercontent.com/$SHAPE_REPOSITORY/$ref/$WIP_TEMPLATE_DIR/$rel"
				wip_substitute "$dest"
				# THE WORKTREE IS NOT THE ONLY PLACE THOSE BYTES CAN LIE EITHER (#44
				# round 3, `openRepoTools:1647`): HEAD lacking `$rel` says nothing
				# about the INDEX, so a person's own edit `git add`ed at this path
				# — staged before this run and never committed — sits exactly
				# where step 8's `add` would overwrite it, and a worktree that
				# happens to read back as the template is not permission to stage
				# over what is already staged there. The index is asked the same
				# question the worktree already answers: no entry is this
				# command's own leftover exactly as no file is, and an entry
				# whose bytes are not the template fails it exactly as the
				# worktree's would.
				if cmp -s -- "$dest" "$checkout/$rel" &&
					{ ! git -C "$checkout" cat-file -e ":$rel" 2>/dev/null ||
					git -C "$checkout" cat-file -p ":$rel" 2>/dev/null |
						cmp -s -- "$dest" -; }
				then
					written+=("$rel")
					owed=$((owed + 1))
				else
					die "$checkout/$rel exists, HEAD does not carry it, and its worktree bytes, its staged
    bytes, or both are not what $SHAPE_REPOSITORY's $WIP_TEMPLATE_DIR/$rel substitutes to at
    $ref — so this is not an earlier run's own leftover; it is somebody's own file, staged or
    not, at a path the template also names. A seed commit is the template and nothing else, and
    this command will not publish it or stage over what is already staged there. Nothing beyond
    this run's own template bytes was written into that checkout, and nothing was staged.
    Commit, stash or remove that path, then re-run:
        openRepoTools wip init"
				fi
			fi
			continue
		fi
		wip_fetch_template_file "$rel" "$dest" "$ref" ||
			die "could not fetch $WIP_TEMPLATE_DIR/$rel from $SHAPE_REPOSITORY at $ref, so $rel
    itself was NOT seeded. Nothing beyond an earlier template path's own bytes in
    this same run, if it reached one before this fetch, was written into that
    checkout, and nothing was staged; a re-run picks up from here. Both ways were tried:
    gh api repos/$SHAPE_REPOSITORY/contents/$WIP_TEMPLATE_DIR/$rel?ref=$ref
    curl -fsSL https://raw.githubusercontent.com/$SHAPE_REPOSITORY/$ref/$WIP_TEMPLATE_DIR/$rel"
		wip_substitute "$dest"
		mkdir -p -- "$checkout/$(dirname -- "$rel")"
		cp -- "$dest" "$checkout/$rel"
		written+=("$rel")
		seeded=$((seeded + 1))
	done
	if [ "$seeded" -gt 0 ]; then
		say "  seeded $seeded of ${#WIP_TEMPLATE_FILES[@]} template files from $SHAPE_REPOSITORY @ $ref"
	else
		say "  the workspace already carries every template file; none was replaced"
	fi

	# ---- step 8: COMMIT AND PUSH — AND THAT PUSH IS THE RULESET PROBE.
	# A newly created repository is not excluded from the organisation's PR-only
	# ruleset until an administrator excludes it, and until it is, every register
	# write will be refused by the gate. So this push is not only the seed
	# landing; it is the verification (Addendum 1(2)).
	#
	# EACH PATH BY NAME, NEVER `git add -A -- .` (#40, finding 1). Step 6a means
	# there is nothing unrelated left in the worktree for a `-A` to sweep up —
	# and this means that a path step 6a could not see as unrelated, because the
	# template names it and a person had edited it, is still not published by a
	# command that came to place a template. Two answers to one finding, and the
	# cheaper one is the one that runs first.
	if [ "$((seeded + owed))" -gt 0 ]; then
		wip_quietly git -C "$checkout" add -- "${written[@]}" ||
			die "could not stage the seed in $checkout.
    What it said:
$WIP_LAST_ERR"
	fi
	# AND THE COMMIT IS THOSE PATHS AND NO OTHERS (#44 round 1,
	# `openRepoTools:1525`). `git commit` with no pathspec commits THE INDEX, so
	# a person's own `git add` of a file step 6a is deliberately blind to — a
	# TEMPLATE path they had edited — rode into the seed commit and out to
	# `main` on the push below, which is the finding this round was opened for
	# one layer down. The pathspec commits the worktree at those paths and
	# leaves every other staged change exactly where the person left it: staged,
	# uncommitted, unpushed.
	#
	# THE `diff --cached` ASKS ABOUT THE SAME PATHS, because after an `add` of
	# paths that are already in HEAD there can be nothing to commit at all — a
	# checkout that had a template file DELETED gets it back from the template
	# above, and where those bytes match HEAD `git commit` refuses with one.
	if [ "$((seeded + owed))" -gt 0 ] &&
		! git -C "$checkout" diff --cached --quiet -- "${written[@]}" 2>/dev/null; then
		wip_quietly git -C "$checkout" commit -q \
			-m "Seed this workspace repository from $SHAPE_REPOSITORY $WIP_TEMPLATE_DIR

Written by \`openRepoTools wip init\` (lane-collision-protocol Amendment 9(c)).
It holds data only: the register, the object logs, the handoffs and the
workspace manifests. The lane tooling is installed from opensoft/openRepoTools." \
			-- "${written[@]}" ||
			die "could not commit the seed in $checkout. A machine with no
    \`user.email\` configured is the usual reason, and git says so itself:
$WIP_LAST_ERR"
		say "  committed the seed in $checkout"
	fi

	# THE PUSH IS GATED ON THE REMOTE, NOT ON THE WORKTREE, and that is the
	# whole of what makes the re-run this step promises actually work. A first
	# run whose push the ruleset rejected leaves a CLEAN worktree and an
	# unpushed commit — so a `status --porcelain` gate would report "already
	# carries the seed", write the pointer file and exit 0 over an empty
	# `main`, and step 1's file test would then return on every later run.
	# That is the failure step 8 exists to prevent, met one step further on.
	local local_head remote_head remote_refs
	local_head="$(git -C "$checkout" rev-parse HEAD 2>/dev/null || :)"
	if remote_refs="$(git -C "$checkout" ls-remote origin main 2>/dev/null)"; then
		remote_head="$(printf '%s\n' "$remote_refs" | awk 'NR==1 {print $1}')"
	else
		# Could not ask. Fall through to the push: the push IS the probe, and a
		# question we could not put to the remote is not an answer from it.
		remote_head=""
	fi
	if [ -z "$local_head" ]; then
		say "  $checkout has no commit to push"
	elif [ -n "$remote_head" ] && [ "$local_head" = "$remote_head" ]; then
		say "  $target main already carries this commit ($(printf '%.7s' "$local_head"))"
	elif ! git -C "$checkout" push -q origin HEAD:main >/dev/null 2>&1; then
		die "the seed commit could not be pushed to $target's main.
    THAT IS THE RULESET, and it is the thing this push exists to find out: the
    organisation's PR-only ruleset refuses a direct commit, and Rule 9's one commit
    per write cannot land through a PR gate — so the register would be unwritable.
    An administrator excludes $target from it:
        gh api /orgs/$WIP_ORG/rulesets
    then adds $target to the PR-only ruleset's exempt repositories.
    The clone and the seed commit are left exactly where they are, so a re-run after
    that has only to push:
        openRepoTools wip init"
	else
		say "  pushed the seed to $target main (which is also the ruleset probe)"
	fi

	# ---- step 9: WRITE THE POINTER FILE. The SECOND thing in this toolset that
	# writes a file outside a repository, after `resume --workspace`, for the
	# same reason and under the same condition: only on a machine that has none,
	# and only because the person asked for the repository by running this. It
	# never overwrites one — step 1 already returned where one existed.
	local written="$checkout"
	case "$checkout" in "$HOME"/*) written="~${checkout#"$HOME"}" ;; esac
	mkdir -p -- "$(dirname -- "$config")" ||
		die "could not create $(dirname -- "$config") for the pointer file.
    The repository is created, cloned, seeded and pushed; only this file is
    missing, and a re-run writes it."
	[ ! -e "$config" ] ||
		die "$config appeared while this ran; it was not overwritten."
	# GUARDED, because this command's exit codes are 0 and 2 and nothing else:
	# an unguarded redirect fails under `set -e` with the shell's own status 1,
	# which is the code this toolset reserves for "findings were printed". A
	# refusal that reads as a report is the defect openRepoTools' own convention
	# exists to prevent (`status:3076-3078`).
	printf 'repository: %s\npath: %s\n' "$target" "$written" >"$config" ||
		die "could not write $config. The repository is created, cloned, seeded and
    pushed; only this file is missing, and a re-run writes it."
	say "  wrote $config"
	say "        repository: $target"
	say "        path: $written"

	# ---- step 10: LINK-ESTATES, which places the symlinks and reports the ones
	# it skipped.
	local linker="${OPENREPOTOOLS_BIN_DIR:-$HOME/.local/bin}/link-estates"
	[ -x "$linker" ] || linker="$(command -v link-estates 2>/dev/null || :)"
	if [ -n "$linker" ] && [ -x "$linker" ]; then
		say ""
		say "  link-estates:"
		# ONE PROJECTS TREE ACROSS THE SEAM. This toolset spells that directory
		# `$PROJECTS_DIR` (`park:131`, `resume:114`, and step 6 above); the lane
		# protocol's commands, which arrived from the workspace repository,
		# spell it `$PROJECTS_ROOT` (`link-estates:200`, `lane-start:427`).
		# Amendment 9(g) keeps every mechanic of Amendments 6 to 8, so the
		# helpers keep their name — but step 10 must run the linker against the
		# tree step 6 actually cloned into, or a host with `$PROJECTS_DIR` set
		# to anything but the default gets a clone in one tree and its symlinks
		# looked for in another. Passed only where the person has not set
		# `$PROJECTS_ROOT` themselves: their answer wins over our inference.
		PROJECTS_ROOT="${PROJECTS_ROOT:-$(wip_projects_dir)}" "$linker" ||
			say "  (link-estates reported the above and changed nothing else)"
	else
		say ""
		say "  link-estates is not installed, so no symlinks were placed."
		say "  \`openRepoTools --install\` places it; then run \`link-estates\`."
	fi

	# ---- step 11: THE NEXT STEP, which is one line. `<profile>` is the one
	# value a person supplies and the one this command cannot derive: it is not
	# a function of the workspace repository.
	say ""
	say "Done. The next step is one line:"
	say "    pclaude run <profile> --lane <repo>-<n>"
	say ""
	say "  <profile>   \`pclaude list\` names them"
	say "  <repo>-<n>  the lane naming rule: the repository the lane is homed on,"
	say "              and its position — openRepoProject-1, workBenches-2"
	return 0
}

# `wip <verb>` — one noun, one verb, and a refusal that names the one there is.
wip_dispatch() {
	local verb="${1-}"
	shift || :
	case "$verb" in
	init) ;;
	'') die "\`wip\` takes one verb and it is \`init\`:
        openRepoTools wip init [--org <org>] [--login <name>] [--team <team>] [--dry-run]" ;;
	*) die "\`wip $verb\` is not a thing this command does. The one verb is \`init\`:
        openRepoTools wip init" ;;
	esac
	while [ $# -gt 0 ]; do
		case "$1" in
		--org) shift; [ $# -gt 0 ] || die "--org needs a value"; WIP_ORG="$1"; shift ;;
		--login) shift; [ $# -gt 0 ] || die "--login needs a value"; WIP_LOGIN="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"; shift ;;
		--team) shift; [ $# -gt 0 ] || die "--team needs a value"; WIP_TEAM="$1"; shift ;;
		--dry-run) WIP_DRY_RUN=1; shift ;;
		*) die "\`wip init\` takes --org, --login, --team and --dry-run, and nothing else.
    It got '$1'." ;;
		esac
	done
	if [ -n "$WIP_LOGIN" ] && ! wip_login_is_compliant "$WIP_LOGIN"; then
		die "--login '$WIP_LOGIN' cannot form a compliant \`<user>-wip\` name: openRepoShape's
    naming contract requires \`^[a-z0-9]+(-[a-z0-9]+)*-wip\$\`. Nothing was created."
	fi
	wip_init
}

# --- arguments ------------------------------------------------------------
#
# THREE FLAGS AND ONE VERB PAIR, and no others. The refusal names the commands
# rather than repeating the usage: somebody typing `openRepoTools park` wants
# `park`, and the shortest true answer is where it is.
#
# `wip` CONSUMES THE REST OF THE LINE, because `wip init --org x` is one
# command with its own options and not four arguments to this one.
while [ $# -gt 0 ]; do
	case "$1" in
	-h | --help) usage; exit 0 ;;
	--version) say "openRepoTools ($REPO @ $REF)"; exit 0 ;;
	--install) MODE="install"; shift ;;
	wip) shift; wip_dispatch "$@"; exit $? ;;
	*)
		die "openRepoTools installs the estate commands and creates the workspace they read.
    It takes --install, \`wip init\`, --help or --version. The commands themselves:
    \`park --help\`, \`resume --help\`, \`status --help\`."
		;;
	esac
done

if [ "$MODE" = "install" ]; then
	install_commands
	exit 0
fi

# NO ARGUMENT AT ALL is the usage, on stdout and exit 0: a person who typed the
# name to see what it is has asked a question, not made a mistake.
usage
exit 0
