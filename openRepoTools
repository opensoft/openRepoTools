WIP_LOGIN=""
WIP_ORG=""
WIP_TEAM=""
WIP_TEAM_WHY=""
WIP_DRY_RUN=0

wip_config_file() { printf '%s\n' "${AGENT_PROTOCOL_ROOT:-$HOME/.agents}/workspace.yaml"; }

# Where a new clone goes. `$PROJECTS_DIR` names one directory when it is set;
# otherwise `~/projects`, then `~/Projects` where that exists and is a
# different directory — the block `park`, `resume` and `status` already carry,
# narrowed to the one question this command asks of it.
wip_projects_dir() {
	if [ -n "${PROJECTS_DIR:-}" ]; then printf '%s\n' "$PROJECTS_DIR"; return 0; fi
	[ -d "$HOME/projects" ] && { printf '%s\n' "$HOME/projects"; return 0; }
	if [ -d "$HOME/Projects" ]; then printf '%s\n' "$HOME/Projects"; return 0; fi
	printf '%s\n' "$HOME/projects"
}

wip_yaml_field() {
	local v
	v="$(sed -n -e "s/^$1:[[:space:]]*//p" "$2" 2>/dev/null | head -n 1 |
		sed -e 's/[[:space:]]*#.*$//' -e 's/[[:space:]]*$//')"
	v="${v%\"}"; v="${v#\"}"
	v="${v%\'}"; v="${v#\'}"
	case "$v" in
	'~') v="$HOME" ;;
	'~/'*) v="$HOME/${v#'~/'}" ;;
	esac
	printf '%s\n' "$v"
}

wip_norm_repo() {
	local u="${1%.git}"
	case "$u" in
	https://github.com/*) u="${u#https://github.com/}" ;;
	ssh://git@github.com/*) u="${u#ssh://git@github.com/}" ;;
	git@github.com:*) u="${u#git@github.com:}" ;;
	esac
	printf '%s' "$u" | tr '[:upper:]' '[:lower:]'
}

# Is $2 the ROOT of a checkout of $1? The same three-part test the four lane
# helpers make, because step 1's idempotence and their refusal have to agree on
# what "already has a workspace" means, or a host can pass one and fail the
# other. Local only; no network.
wip_is_checkout_of() {
	local want="$1" path="$2" origin toplevel real
	[ -n "$path" ] || return 1
	git -C "$path" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 1
	origin="$(wip_norm_repo "$(git -C "$path" remote get-url origin 2>/dev/null || :)")"
	want="$(wip_norm_repo "$want")"
	if [ -z "$origin" ] || [ "$origin" != "$want" ]; then
		# The origin's path ENDING in the `<owner>/<name>` the pointer file
		# spells is the same repository: a GitHub Enterprise host, an ssh alias
		# and a local bare mirror laid out by owner and name all say that, and
		# the pointer file spells `<owner>/<name>` because that is what a person
		# types. The four lane helpers make this same test, in the same words.
		case "$origin" in
		*/"$want") ;;
		*) return 1 ;;
		esac
	fi
	toplevel="$(git -C "$path" rev-parse --show-toplevel 2>/dev/null || :)"
	real="$(cd -- "$path" 2>/dev/null && pwd -P)" || return 1
	[ "$toplevel" = "$real" ]
}

wip_have_gh() { command -v gh >/dev/null 2>&1; }

# --- step 2: the login ------------------------------------------------------
#
# `gh api user -q .login`, LOWERCASED — the naming contract's own definition of
# `<user>`. A login that cannot form a compliant name under that family's
# pattern is a refusal naming the pattern and its source, never a name repaired
# by guesswork (R-A9-3).
wip_login_is_compliant() {
	case "$1" in
	'' | *[![:lower:][:digit:]-]* | -* | *- | *--*) return 1 ;;
	*) return 0 ;;
	esac
}

wip_derive_login() {
	local login
	wip_have_gh || die "\`wip init\` needs your GitHub login and there is no \`gh\` to read it with.
    Install GitHub CLI, run \`gh auth login\`, then run \`openRepoTools wip init\` again.
    Nothing was created."
	if command -v timeout >/dev/null 2>&1; then
		login="$(timeout 20 gh api user -q .login 2>/dev/null || :)"
	else
		login="$(gh api user -q .login 2>/dev/null || :)"
	fi
	login="$(printf '%s' "$login" | tr '[:upper:]' '[:lower:]')"
	[ -n "$login" ] || die "\`gh api user\` did not answer with a login, so this command does not know whose
    workspace to create. That is the one precondition it has:
        gh auth login
    Then run \`openRepoTools wip init\` again. Nothing was created."
	wip_login_is_compliant "$login" || die "the GitHub login '$login' cannot form a compliant \`<user>-wip\` name.
    openRepoShape's naming contract requires \`^[a-z0-9]+(-[a-z0-9]+)*-wip\$\`, and an
    underscore, a doubled hyphen or a leading or trailing one does not fit it. This
    command does not repair a name by guesswork. Name the repository yourself:
        openRepoTools wip init --login <name>
    Nothing was created."
	printf '%s\n' "$login"
}

# --- step 4: the team, or no team ------------------------------------------
#
# `gh api /user/teams` filtered to the organisation. EXACTLY ONE match is used.
# None, or more than one, and `--team` is omitted ENTIRELY — from what is run
# and from what is printed — with one line saying why. A placeholder a person
# must fill is a question wearing a different hat, and this command asks at
# most once. (Ratified decision 2.)
wip_derive_team() {
	local org="$1" teams count
	WIP_TEAM=""
	WIP_TEAM_WHY=""
	if ! wip_have_gh; then
		WIP_TEAM_WHY="no \`gh\` to read /user/teams with"
		return 0
	fi
	teams="$(gh api --paginate /user/teams \
		-q ".[] | select((.organization.login | ascii_downcase) == \"$(printf '%s' "$org" | tr '[:upper:]' '[:lower:]')\") | .slug" \
		2>/dev/null || :)"
	count="$(printf '%s' "$teams" | grep -c . || :)"
	case "${count:-0}" in
	1)
		WIP_TEAM="$(printf '%s' "$teams" | head -n 1)"
		;;
	0)
		WIP_TEAM_WHY="you are in no team in $org"
		;;
	*)
		WIP_TEAM_WHY="you are in $count teams in $org, and this command does not choose between them"
		;;
	esac
	return 0
}

# --- step 5: the block an administrator runs -------------------------------
#
# THREE ADMINISTRATOR ACTS, NOT TWO (Addendum 1(2) on brettheap/new-workstation#17).
# Every value of steps 2 to 4 is already substituted, so what is printed runs as
# it stands. The third is not a fixed command, because a ruleset's id is not
# derivable without reading the organisation's rulesets: the block prints the
# one call that lists them, with the organisation substituted, and names the
# change to make.
# GIT'S OWN WORDS, KEPT (F9 of the #24 review, ruled R-A9-15). The three
# failures a FRESH workstation actually meets are here — the clone, the stage
# and the commit — and all three ran `>/dev/null 2>&1` and died with a summary
# of this command's own devising. A machine with no `user.email` configured got
# `could not commit the seed in <path>.` and nothing else, from the command
# whose whole job is to set up a new machine, when git had already said exactly
# what to do about it. So the command runs, its stderr is kept, and the last of
# it is printed UNDER the refusal — the shape `fetch_from_repo`'s refusal
# already has, where it names both ways it tried.
#
# STDOUT IS STILL DROPPED FROM THE REPORT, and it is now dropped INTO A FILE
# rather than into `/dev/null`: `gh repo clone` and `git commit` are chatty on
# success and this command's own `say` lines are what a person reads, so nothing
# here ever prints it. It is the WORDS OF A FAILURE that were being thrown away,
# not progress. The file is what lets a command whose OUTPUT is the answer — step
# 6a's `git status`, #49 — run through this one wrapper instead of carrying a
# second copy of the stderr-capture below: `$WIP_LAST_OUT` names it, it lives in
# the workdir the `EXIT` trap removes, and it is rewritten by every call, so a
# caller reads it before making the next one.
WIP_LAST_ERR=""
WIP_LAST_OUT=""
wip_quietly() {   # <command> [args…] — 0 or 1, stderr in $WIP_LAST_ERR, stdout AT $WIP_LAST_OUT
	workdir
	WIP_LAST_ERR=""
	WIP_LAST_OUT="$WORKDIR/cmd-out"
	if "$@" >"$WIP_LAST_OUT" 2>"$WORKDIR/cmd-err"; then
		return 0
	fi
	WIP_LAST_ERR="$(tail -n 6 -- "$WORKDIR/cmd-err" 2>/dev/null | sed -e 's/^/    | /')"
	[ -n "$WIP_LAST_ERR" ] || WIP_LAST_ERR="    | (it printed nothing at all)"
	return 1
}

wip_admin_block() {
	local target="$1" org="$2" team="$3"
	say ""
	say "  # 1. create the repository (org-owned, private)"
	if [ -n "$team" ]; then
		say "  gh repo create $target --private --team $team \\"
	else
		say "  gh repo create $target --private \\"
	fi
	say "      --description \"${WIP_LOGIN}'s workspace repository: lanes, handoffs, workspaces\""
	say ""
	if [ -n "$team" ]; then
		say "  # 2. give the team read; --team alone grants the org default, not read"
		say "  gh api --method PUT \\"
		say "      /orgs/$org/teams/$team/repos/$target -f permission=pull"
		say ""
		say "  # 3. exclude it from the organisation's PR-only ruleset. Without this,"
	else
		say "  # 2. exclude it from the organisation's PR-only ruleset. Without this,"
	fi
	say "  #    Rule 9's one commit per write cannot land and the register is"
	say "  #    unwritable. List the rulesets, then add $target to the"
	say "  #    PR-only one's exempt repositories:"
	say "  gh api /orgs/$org/rulesets"
	say ""
	if [ -z "$team" ]; then
		say "  (No \`--team\` and no team grant: ${WIP_TEAM_WHY:-no single team matched}. The"
		say "   repository is created without one and an administrator may add one.)"
		say ""
	fi
}

# --- step 7: the template, and the whole of its substitution table ----------
#
# openRepoTools substitutes the placeholders ITSELF. openRepoShape's engine
# (`scripts/shape_materialize.py`) is reached only by that repository's own
# tools, and `grep -rn 'workspace-root'` finds no code path there for this
# template at all — so the consumer substitutes, the consumer is this command,
# and the tokens are exactly these three (clause (c) step 7):
#
#   {{LOGIN}}             the lowercased GitHub login      step 2
#   {{ORG}}               the organisation                 step 3
#   {{SHAPE_REPOSITORY}}  opensoft/openRepoShape           constant here
#
# A TOKEN THE TABLE DOES NOT CARRY IS A REFUSAL NAMING THE TOKEN — never a
# blank, and never a literal `{{…}}` written into a person's repository. That
# is what openRepoShape's own engine does with an unsubstituted token
# (`Refusal("template-unsubstituted", …)`), and it is why the table is written
# here rather than left to a private function that is no published contract.
wip_substitute() {
	local file="$1" left
	# `|` as the sed delimiter would collide with the table rows in LANES.md;
	# these three values are a login, an `<org>` and an `<owner>/<name>`, so `#`
	# cannot appear in any of them and is safe as the delimiter.
	sed -e "s#{{LOGIN}}#$WIP_LOGIN#g" \
		-e "s#{{ORG}}#$WIP_ORG#g" \
		-e "s#{{SHAPE_REPOSITORY}}#$SHAPE_REPOSITORY#g" \
		-- "$file" >"$file.subst" || die "could not substitute the template file $file"
	left="$(grep -o -e '{{[A-Z_]*}}' "$file.subst" 2>/dev/null | sort -u | tr '\n' ' ' || :)"
	if [ -n "$left" ]; then
		rm -f -- "$file.subst"
		die "the template carries a placeholder this command has no value for: $left
    (in ${file##*/}). Amendment 9(c) step 7's substitution table is {{LOGIN}}, {{ORG}}
    and {{SHAPE_REPOSITORY}}, and a token outside it is a refusal naming the token —
    never a blank, and never a literal {{…}} written into your repository.
    Nothing was created."
	fi
	# THE WORKSPACE'S `.gitignore` CARRIES THE BYTECODE AND CACHE RULES
	# (opensoft/openRepoTools#162, cause 19: generated bytecode committed into
	# handoff attachments). Added HERE, in the one function both step 7 paths
	# go through, so the bytes a seed writes and the bytes a re-run compares
	# an earlier run's leftover against are the same bytes. A line the template
	# already carries is not repeated.
	case "${file##*/}" in
	tpl-.gitignore) wip_hygiene_lines "$file.subst" >>"$file.subst" ||
		die "could not add the bytecode and cache rules to the template file $file" ;;
	esac
	mv -f -- "$file.subst" "$file"
}

#: The lines every `<user>-wip` ignores (#162): bytecode, test and type-check
#: caches, dependency trees and virtual environments - a handoff attachment
#: is evidence, and none of these is.
WIP_HYGIENE_LINES=(
	"__pycache__/"
	"*.pyc"
	"*.pyo"
	".pytest_cache/"
	".mypy_cache/"
	".ruff_cache/"
	"node_modules/"
	".venv/"
	"venv/"
	"site-packages/"
)

# The hygiene block, less every line `$1` already carries; nothing at all when
# it carries them all. A bare `grep`, never `command grep`
# (opensoft/openRepoTools#292): its failure IS the missing line, and macOS's
# bash 3.2 ends a `set -e` script where a utility run through `command` fails,
# even on the left of `||`.
wip_hygiene_lines() {   # <the .gitignore as it stands>
	local line missing=""
	for line in "${WIP_HYGIENE_LINES[@]}"; do
		grep -Fqx -- "$line" "$1" 2>/dev/null || missing="$missing$line
"
	done
	[ -n "$missing" ] || return 0
	printf '\n# Bytecode, caches, dependency trees and virtual environments are never\n'
	printf '# a workspace repository'"'"'s: a handoff attachment is evidence, not a build\n'
	printf '# (opensoft/openRepoTools#162). `lanes-edit.sh` refuses to commit them.\n'
	printf '%s' "$missing"
}

# The template's bytes, materialized EXACTLY the way `--install` gets its own
# files: from the checkout beside this command when run from one, else
# `gh api …/contents/<path>` at the pinned ref, else the raw URL. *That the
# template travels by the installer's own fetch path is the drafter's; the
# issue named the template and not its transport.*
wip_shape_ref() {
	local pin selfdir=""
	[ -f "$SELF" ] && selfdir="$(cd -- "$(dirname -- "$SELF")" && pwd)"
	if [ -n "$selfdir" ] && [ -f "$selfdir/contracts/openreposhape-pin.yaml" ]; then
		pin="$(sed -n -e 's/^commit:[[:space:]]*//p' "$selfdir/contracts/openreposhape-pin.yaml" | head -n 1)"
		pin="${pin%\"}"; pin="${pin#\"}"
		[ -n "$pin" ] && { printf '%s\n' "$pin"; return 0; }
	fi
	workdir
	# NO PIN BESIDE THIS FILE — the installed copy, a vendored tree: the pin is
	# the one the CODE carries (#186). A single repository's is read exactly as
	# it always was, at `$REF`; an adopted assembly's is the code leg's, at the
	# commit the assembly pins, never the assembly's own `contracts/`. A source
	# that does not answer leaves `main`, as it always did, and so does a pin
	# the source does not carry. An adopted assembly whose code cannot be
	# resolved refuses, in step 7's words (`resolve_refuse`).
	RESOLVE_FOR=wip
	payload_probe
	case "$PROBE_LAYOUT" in
	unknown) printf 'main\n'; return 0 ;;
	single) : ;;
	*) payload_resolve_remote ;;
	esac
	if fetch_from_repo "contracts/openreposhape-pin.yaml" "$WORKDIR/pin.yaml"; then
		pin="$(sed -n -e 's/^commit:[[:space:]]*//p' "$WORKDIR/pin.yaml" | head -n 1)"
		pin="${pin%\"}"; pin="${pin#\"}"
		[ -n "$pin" ] && { printf '%s\n' "$pin"; return 0; }
	fi
	printf 'main\n'
}

wip_fetch_template_file() {
	local rel="$1" dest="$2" ref="$3" selfdir="" path="$WIP_TEMPLATE_DIR/$rel"
	[ -f "$SELF" ] && selfdir="$(cd -- "$(dirname -- "$SELF")" && pwd)"
	if [ -n "$selfdir" ] && [ -f "$selfdir/upstream/openRepoShape/$path" ]; then
		cp -- "$selfdir/upstream/openRepoShape/$path" "$dest"
		return 0
	fi
	if command -v gh >/dev/null 2>&1 &&
		gh api "repos/$SHAPE_REPOSITORY/contents/$path?ref=$ref" \
			-H 'Accept: application/vnd.github.raw' >"$dest" 2>/dev/null &&
		[ -s "$dest" ]; then
		return 0
	fi
	if command -v curl >/dev/null 2>&1 &&
		curl -fsSL "https://raw.githubusercontent.com/$SHAPE_REPOSITORY/$ref/$path" \
			>"$dest" 2>/dev/null && [ -s "$dest" ]; then
		return 0
	fi
	# `workspaces/.gitkeep` is zero bytes upstream, so `-s` above is false for
	# it on every path. It carries no placeholder and no content by definition:
	# git tracks no empty directory, and that is the whole of its job.
	case "$rel" in
	*/.gitkeep | .gitkeep) : >"$dest"; return 0 ;;
	esac
	return 1
}

# --- step 6a's history question: is this commit one `wip init` made? --------
#
# STEP 6a LETS THROUGH, AHEAD OF origin's `main`, THIS COMMAND'S OWN SEED AND
# NOTHING ELSE (#64), so the answer here is ALL of what step 8's own commit is
# and never one part of it a person's commit could happen to share. Four tests,
# and a commit has to pass every one:
#
#   * ONE PARENT OR NONE. Step 8 commits on top of HEAD — on an empty `main`
#     that is a root commit — and never merges. It is asked first because the
#     path test below cannot ask it: `diff-tree` prints NOTHING for a merge
#     unless it is asked for a combined diff, so a merge would answer "no path
#     outside the template" by naming no path at all.
#   * THE SUBJECT step 8 writes, `Seed this workspace repository from …` — a
#     PREFIX, because what follows it names the template's repository and
#     directory, which are this file's constants and not a part of the promise.
#   * THE BODY'S `Written by \`openRepoTools wip init\`` line, which is the
#     sentence in that message that says whose commit it is.
#   * AND A TREE THAT DIFFERS FROM ITS PARENT'S — the empty tree, for a root
#     commit, which is what `--root` compares it with — AT ONE OR MORE TEMPLATE
#     PATHS AND AT NO OTHER. Step 8 commits `"${written[@]}"` by pathspec, which
#     is template paths and nothing else, and commits only where `diff --cached`
#     says there is something to commit, so it has never made an empty one.
#
# A MESSAGE IS SOMETHING ANYBODY CAN TYPE, which is why the tree is asked as
# well as the words: a commit wearing the seed's subject and trailer and
# touching a path the template does not name is somebody's own work in a
# borrowed coat, and it is refused like any other. What this does NOT do is
# compare the bytes at those paths with the template: the seed it is looking
# at was written from the template at whatever commit THAT run pinned, which
# need not be this run's, and Brett Heap's ruling on #64 asks for the subject,
# the trailer and the tree — the parent count is the tree test made sound —
# and not the bytes. A person who writes this command's own message over
# their own edit of a template file has said, in so many words, that it is
# the seed.
#
# `--no-show-signature` ON EVERY `log` HERE, because `log.showSignature` is a
# person's own config and it prints the signature check's report ON STDOUT,
# ahead of the format: a seed this command committed on a machine with
# `commit.gpgSign` set would then read back with that report as its first
# line — `No signature`, `Good "git" signature …` — instead of its subject,
# and be refused as somebody else's.
#
# EVERY READ THAT FAILS IS A NO, so a commit this could not ask about is
# refused and never passed (#49's lesson, asked of history). Paths are
# compared as `diff-tree` prints them: one it had to C-quote is never one of
# `$WIP_TEMPLATE_FILES`, which are nine plain ASCII paths, so it is refused
# rather than misread.
wip_is_own_seed() {   # <checkout> <commit> — 0 only for a commit `wip init` itself made
	local checkout="$1" commit="$2" parents subject body paths path rel known
	parents="$(git -C "$checkout" log -1 --no-show-signature --format=%P "$commit" 2>/dev/null)" ||
		return 1
	case "$parents" in *' '*) return 1 ;; esac
	subject="$(git -C "$checkout" log -1 --no-show-signature --format=%s "$commit" 2>/dev/null)" ||
		return 1
	case "$subject" in
	'Seed this workspace repository from '*) ;;
	*) return 1 ;;
	esac
	body="$(git -C "$checkout" log -1 --no-show-signature --format=%b "$commit" 2>/dev/null)" ||
		return 1
	case "$body" in
	*'Written by `openRepoTools wip init`'*) ;;
	*) return 1 ;;
	esac
	paths="$(git -C "$checkout" diff-tree --root --no-commit-id --name-only -r "$commit" 2>/dev/null)" ||
		return 1
	[ -n "$paths" ] || return 1
	while IFS= read -r path; do
		known=0
		for rel in "${WIP_TEMPLATE_FILES[@]}"; do
			if [ "$path" = "$rel" ]; then
				known=1
				break
			fi
		done
		[ "$known" -eq 1 ] || return 1
	done <<EOF
$paths
EOF
	return 0
}

# --- step 10's two acts: the links, then the hook pair (#237) ---------------
#
# `link-estates` places the symlinks and reports the ones it skipped. One of
# them is `~/projects/xFactory/lanes-edit.sh`, the path both of `--install`'s
# hook entries call — which is why the pair is completed here, after it, and
# why step 1 runs this again on a workstation whose link is missing.
wip_run_link_estates() {
	local linker="${OPENREPOTOOLS_BIN_DIR:-$HOME/.local/bin}/link-estates"
	[ -x "$linker" ] || linker="$(command -v link-estates 2>/dev/null || :)"
	if [ -n "$linker" ] && [ -x "$linker" ]; then
		say ""
		say "  link-estates:"
		# ONE PROJECTS TREE ACROSS THE SEAM. This toolset spells that directory
		# `$PROJECTS_DIR` (`park:131`, `resume:114`, and `wip_init`'s step 6); the lane
		# protocol's commands, which arrived from the workspace repository,
		# spell it `$PROJECTS_ROOT` (`link-estates:200`, `lane-start:427`).
		# Amendment 9(g) keeps every mechanic of Amendments 6 to 8, so the
		# helpers keep their name — but step 10 must run the linker against the
		# tree step 6 actually cloned into, or a host with `$PROJECTS_DIR` set
		# to anything but the default gets a clone in one tree and its symlinks
		# looked for in another. Passed only where the person has not set
		# `$PROJECTS_ROOT` themselves: their answer wins over our inference.
		PROJECTS_ROOT="${PROJECTS_ROOT:-$(wip_projects_dir)}" "$linker" ||
			say "  (link-estates reported the above and changed nothing else)"
	else
		say ""
		say "  link-estates is not installed, so no symlinks were placed."
		say "  \`openRepoTools --install\` places it; then run \`link-estates\`."
	fi
}

# THE HOOK PAIR, BY `--install`'s OWN READ AND ITS OWN WRITE (#237): the rival
# refusal, the two staged outcomes and the gate are `plan_hook_merge` and
# `place_hook_pair`, word for word, so `wip init` and `--install` are one rule
# for one file. In a SUBSHELL, because a refusal there is `die`: it prints what
# `--install` would have refused with and exits 2 — the subshell, not this run.
# The workspace this command exists to make is made by then, so the refusal is a
# note beside it and the exit stays 0, the way a `link-estates` that refused is
# (step 10). ONE RULE ON BOTH PATHS: on step 1's the reconcile is the only act,
# and the exit is still 0 — a 2 there would tell a caller the workspace failed,
# which it did not — so the usage and the README say so where the exit codes
# are (the #237 review, S1). `set -e` is put back on INSIDE the subshell: the
# `set +e` that lets this read the subshell's status would otherwise reach
# everything the two functions run, and they are written for `--install`'s
# `set -e`.
#
# THE SUBSHELL CLEANS UP AFTER ITSELF (#332). A subshell does not keep the traps
# `workdir` set — bash resets the ones a shell caught — and the `$PLACING` that
# `hook_write_settings` sets in it is the subshell's own, so the `EXIT` and
# `INT` traps of this shell would run with it empty and never name the
# temporary: a Ctrl-C, or a `kill` of the group, left
# `settings.json.openrepotools.<pid>.XXXXXX` behind, as it did for `--install`
# before. So the subshell sets an `EXIT` trap of its own, which removes only the
# temporary — never the workdir, which this shell goes on using. Bash runs an
# `EXIT` trap as it dies of a SIGINT, a SIGTERM or a SIGHUP too, and the
# subshell is where the signal of a group lands first.
#
# A LINK MADE BETWEEN THIS PLANNING AND THIS WRITE IS REFUSED AS `--install`
# REFUSES IT (#331): the two functions it runs ask again where each acts, and
# their refusal is a `die` in this subshell, so it is a note beside the workspace
# and the exit stays 0, with the link as it was made. The refusal itself changes
# nothing, and the note says only that. A `chmod` before it may have restored the
# mode of the regular file that is the far end of the link now, and the lines
# above the note report it, so the note does not say nothing was changed (#331).
wip_hook_pair() {
	local rc
	say ""
	say "  hook entries in $(claude_home)/settings.json:"
	workdir
	set +e
	( set -e
	  trap '[ -z "$PLACING" ] || rm -f -- "$PLACING"* || :' EXIT
	  plan_hook_merge
	  place_hook_pair )
	rc=$?
	set -e
	if [ "$rc" -ne 0 ]; then
		say "  (not reconciled: the refusal above is the one \`openRepoTools --install\` makes, and"
		say "   this refusal changed nothing. Fix what it names, then run \`openRepoTools wip init\` again.)"
	fi
	return 0
}

wip_hook_pair_would() {
	say "  would merge   the SessionStart and UserPromptSubmit hook entries into"
	say "                $(claude_home)/settings.json, once ~/projects/xFactory/lanes-edit.sh"
	say "                answers \`guard\` (until then each run says it deferred them)"
}

# --- the command itself -----------------------------------------------------
wip_init() {
	local config target checkout ref rel dest seeded=0 owed=0 kind
	local existing_repo existing_path
	local ancestor rest comp staged_mode staged_entry index_tag ancestor_mode
	# THE TEMPLATE PATHS THIS CHECKOUT HAS IN HEAD AND NOT ON DISK, because the
	# index marks them `skip-worktree` (#69). Counted as well as collected, for
	# the reason `written` is: an empty array expanded as `"${sparse_paths[@]}"`
	# is an UNBOUND VARIABLE under `set -u` in the bash 3.2 macOS ships.
	local sparse=0 sparse_paths
	sparse_paths=()
	# THE PATHS THE SEED OWES THIS CHECKOUT, which is what step 8 stages and
	# commits and the whole of what it commits: the ones step 7 wrote (`seeded`)
	# and the ones an earlier run wrote and could not commit (`owed`). Two
	# counters rather than `${#written[@]}`: an empty array expanded as
	# `"${written[@]}"` is an UNBOUND VARIABLE under `set -u` in the bash 3.2
	# macOS ships, so every reader of this list is guarded on a count, and the
	# count that says how many were COPIED is the one step 7's line prints.
	local written
	written=()

	# ---- step 1: DETECT. A file test, not a network call, and the whole of the
	# idempotence. A host that already has a workspace does nothing at all.
	config="$(wip_config_file)"
	if [ -f "$config" ]; then
		existing_repo="$(wip_yaml_field repository "$config")"
		existing_path="$(wip_yaml_field path "$config")"
		if [ -n "$existing_repo" ] && [ -n "$existing_path" ] &&
			wip_is_checkout_of "$existing_repo" "$existing_path"; then
			say "workspace repository: $existing_repo"
			say "  checked out at      $existing_path"
			say "  named by            $config"
			say "openRepoTools wip init: nothing to do for the workspace itself."
			# THE HOOK PAIR IS THE ONE THING A RE-RUN STILL OWES (#237). A run cut
			# off between step 9 and step 10 — or one whose `link-estates` could
			# not link yet — left a workspace this file test accepts and no link
			# for `--install`'s two entries to call, and nothing else would ever
			# heal it: every later run returned here. So, only where that path
			# does not answer `guard` and `~/projects/xFactory` is there for the
			# link to go into, `link-estates` runs again; then the pair is
			# reconciled, which on a healthy workstation writes nothing.
			if [ "$WIP_DRY_RUN" -eq 1 ]; then
				say ""
				say "--dry-run, so nothing below was done:"
				if ! hook_target_answers && [ -d "$HOME/projects/xFactory" ]; then
					say "  would run     link-estates (${HOOK_TARGET_WHY})"
				fi
				wip_hook_pair_would
				return 0
			fi
			if ! hook_target_answers && [ -d "$HOME/projects/xFactory" ]; then
				say "  ${HOOK_TARGET_WHY}, so link-estates runs again:"
				wip_run_link_estates
			fi
			wip_hook_pair
			return 0
		fi
		# A file that names a repository the path is NOT a checkout of is a
		# refusal, never a silent overwrite: which private repository holds a
		# person's unfinished work is theirs to name, and this command has
		# exactly one write to that file and only on a machine that has none.
		if [ -n "$existing_repo" ]; then
			die "$config already names \`repository: $existing_repo\`, and its \`path: ${existing_path:-<none>}\`
    is not the root of a checkout of it. This command never overwrites that file.
    Either fix the two lines by hand, or move the file aside and re-run. Nothing
    was created."
		fi
		die "$config exists and names no \`repository:\`. This command never overwrites
    that file — a half-written pointer is still somebody's. Fix it by hand, or move
    it aside and re-run. Nothing was created."
	fi

	# ---- steps 2 to 4: DERIVE. Nothing here is asked.
	[ -n "$WIP_LOGIN" ] || WIP_LOGIN="$(wip_derive_login)"
	[ -n "$WIP_ORG" ] || WIP_ORG="$WIP_ORG_DEFAULT"
	target="$WIP_ORG/$WIP_LOGIN-wip"
	if [ -z "$WIP_TEAM" ]; then
		wip_derive_team "$WIP_ORG"
	fi
	say "workspace repository: $target"
	say "  login               $WIP_LOGIN (derived from gh api user)"
	say "  organisation        $WIP_ORG"
	if [ -n "$WIP_TEAM" ]; then
		say "  team                $WIP_TEAM (the one team you are in there)"
	else
		say "  team                none — ${WIP_TEAM_WHY:-no single team matched}, so --team is omitted"
		say "                      entirely and an administrator may add one later."
	fi

	checkout="$(wip_projects_dir)/$WIP_LOGIN-wip"

	if [ "$WIP_DRY_RUN" -eq 1 ]; then
		say ""
		say "--dry-run, so nothing below was done:"
		say "  would create  $target (private, org-owned)"
		say "  would clone   $target -> $checkout"
		say "  would seed    ${#WIP_TEMPLATE_FILES[@]} files from $SHAPE_REPOSITORY $WIP_TEMPLATE_DIR"
		say "  would push    one commit to main (which is also the ruleset probe)"
		say "  would write   $config (repository:, path:)"
		say "  would run     link-estates"
		wip_hook_pair_would
		return 0
	fi

	# ---- step 5: CREATE IT, OR PRINT THE COMMANDS — ruling 2.
	wip_have_gh || die "\`wip init\` needs \`gh\` to create or find $target. Install GitHub CLI,
    run \`gh auth login\`, then run this again. Nothing was created."
	if gh repo view "$target" >/dev/null 2>&1; then
		say ""
		say "  $target is already there; this run adopts it."
	else
		say ""
		say "  creating $target"
		local create_args
		create_args=(repo create "$target" --private)
		[ -n "$WIP_TEAM" ] && create_args+=(--team "$WIP_TEAM")
		create_args+=(--description "$WIP_LOGIN's workspace repository: lanes, handoffs, workspaces")
		if gh "${create_args[@]}" >/dev/null 2>&1; then
			say "  created $target"
			if [ -n "$WIP_TEAM" ]; then
				# `--team` alone grants the ORG DEFAULT, not read.
				# THE LINE ITSELF, not a pointer to a block that is not printed
				# on this path: `wip_admin_block` is reached only where the
				# CREATE failed, and this arm is the one where it succeeded
				# (F8 of the #24 review).
				gh api --method PUT \
					"/orgs/$WIP_ORG/teams/$WIP_TEAM/repos/$target" -f permission=pull \
					>/dev/null 2>&1 || {
					say "  (could not give team $WIP_TEAM read. An administrator can:"
					say "     gh api --method PUT /orgs/$WIP_ORG/teams/$WIP_TEAM/repos/$target -f permission=pull)"
				}
			fi
		else
			# RULING 2: PRINT THE COMMAND, and continue once the repository
			# exists. It never asks for a token and never tries a second
			# credential.
			say ""
			# NAMED FOR WHAT HAPPENED, not for a cause this has not proved. The
			# usual cause is that the account may not create a repository in
			# this organisation, and the block below is the answer to that; a
			# network that was down is the other, and the same block re-run
			# costs nothing. Claiming the first outright would send a person to
			# an administrator over a dropped connection.
			say "\`gh repo create $target\` did not succeed — most often because this account"
			say "may not create a repository in $WIP_ORG."
			say "These are the acts an administrator runs. Every value is already filled in:"
			wip_admin_block "$target" "$WIP_ORG" "$WIP_TEAM"
			# ONE QUESTION, ONE RE-CHECK, no poll loop and no timeout to choose:
			# an unbounded wait is a decision the person never asked to make.
			if [ -t 0 ]; then
				printf '%s' "Press Enter when the administrator has run these (Ctrl-C to stop): " >&2
				read -r _ || :
				if gh repo view "$target" >/dev/null 2>&1; then
					say "  $target is there now; carrying on."
				else
					die "$target is still not there, so there is nothing to clone. Run the block
    above, then: openRepoTools wip init   (it is idempotent and picks up here)."
				fi
			else
				# An unattended launch must not block on a person.
				die "$target does not exist and this run has no terminal to wait on. Run the block
    above, then: openRepoTools wip init"
			fi
		fi
	fi

	# ---- step 6: CLONE IT. Before the seed, because the seed is a commit and a
	# commit needs a checkout.
	if [ -d "$checkout/.git" ]; then
		wip_is_checkout_of "$target" "$checkout" ||
			die "$checkout is already a checkout, and not of $target. This command will not
    write into a clone of somebody else's repository, and it will not move one aside.
    Move it yourself, or pass a different projects directory with \$PROJECTS_DIR.
    $target exists; NOTHING was written into that checkout, and a re-run picks
    up from here."
		say "  $checkout is already a checkout of $target"
	elif [ -e "$checkout" ]; then
		die "$checkout already exists and is not a git checkout. $target exists;
    NOTHING was written into that path, and a re-run picks up from here once it
    is moved aside."
	else
		mkdir -p -- "$(dirname -- "$checkout")"
		say "  cloning $target -> $checkout"
		wip_quietly gh repo clone "$target" "$checkout" -- --quiet ||
			die "could not clone $target into $checkout. Nothing else was changed.
    What it said:
$WIP_LAST_ERR"
	fi

	# ---- step 6a: AN ADOPTED CHECKOUT CARRIES THE TEMPLATE AND NOTHING ELSE,
	# OR THIS COMMAND STOPS (#40, finding 1).
	#
	# Step 8 staged with `git add -A -- .` and committed whatever
	# `status --porcelain` had found, so a checkout ADOPTED at the derived path —
	# or one a half-finished earlier run left behind — had every unrelated
	# modified, deleted and untracked file it carried staged, committed and
	# `push origin HEAD:main`ed as part of the seed. The repository on the other
	# end of that push is the one a person keeps their unfinished work in, which
	# is the last place a file should arrive by accident.
	#
	# ASKED HERE, BEFORE STEP 7 WRITES A SINGLE BYTE INTO THAT CHECKOUT, for the
	# reason `plan_install_targets` is asked before the fetch: a refusal costs
	# nothing at all at this point, and the person's own files are still exactly
	# where they left them when they read it.
	#
	# THE TEMPLATE'S OWN PATHS ARE NOT `UNRELATED`, which is why the question is
	# put to git as an EXCLUSION and not as "is it clean": a first run that
	# fetched and copied the ${#WIP_TEMPLATE_FILES[@]} files and then could not
	# commit them — no `user.email`, the case F9 is written about — leaves
	# exactly those paths behind, and step 7's promise is that a re-run after a
	# half-finished run is safe. `--untracked-files=all` because git collapses an
	# untracked DIRECTORY to one line otherwise, and `handoffs/` is not a path
	# any exclusion below spells.
	#
	# AND A `git status` THIS COMMAND COULD NOT RUN IS A REFUSAL, NEVER A CLEAN
	# ANSWER (#49). The question was asked as
	# `… 2>/dev/null | sed … || :`, which discarded git's own diagnostic and then
	# turned ANY failure of the pipeline — under this file's `set -o pipefail`,
	# `git status`'s own: a corrupt index, an unreadable `.git`, a submodule
	# error — into a plain empty string. An empty change list is exactly what
	# "nothing unrelated, proceed" looks like, so a checkout this command could
	# not even ASK about was read as clean and step 7 wrote template bytes into
	# it, past the one gate that exists to refuse before a byte is written. The
	# run is `wip_quietly`'s now: its stdout is the change list, read from
	# `$WIP_LAST_OUT` and never from a capture a failure can empty, and its
	# stderr is git's own words under the refusal — the shape every other
	# failure in this function already has.
	local status_args
	status_args=(status --porcelain --untracked-files=all -- .)
	for rel in "${WIP_TEMPLATE_FILES[@]}"; do
		status_args+=(":(exclude)$rel")
	done
	wip_quietly git -C "$checkout" "${status_args[@]}" ||
		die "could not ask git what $checkout carries, so this run cannot tell whether that
    checkout holds anything this command did not write — and it will not seed a checkout
    it could not put that question to. NOTHING was written into that checkout on this run
    and nothing was staged.
    What it said:
$WIP_LAST_ERR"
	if [ -s "$WIP_LAST_OUT" ]; then
		die "$checkout carries changes this command did not write:
$(sed -e 's/^/    /' -- "$WIP_LAST_OUT")
    A seed commit is $SHAPE_REPOSITORY's $WIP_TEMPLATE_DIR and nothing else, and the
    push that follows it goes straight to $target's main — so anything else
    staged beside it is somebody's unfinished work published. NOTHING was written
    into that checkout on this run and nothing was staged.
    Commit, stash or remove those paths, then re-run:
        openRepoTools wip init"
	fi

	# ---- AND A CHECKOUT AHEAD OF origin's `main` BY ANYTHING BUT THIS
	# COMMAND'S OWN SEED IS REFUSED THE SAME WAY (#64, Brett Heap's RULING of
	# 2026-10-02, verbatim "go with option 1 on #64").
	#
	# The question above is the WORKTREE and the INDEX, and it never looked at
	# HISTORY. Step 8 pushes `HEAD:main` wherever HEAD is not what origin's
	# `main` already carries, and HEAD carries every commit beneath it — so a
	# clean adopted checkout holding commits of a person's own that never left
	# this workstation (a register edit made here and not pushed, a note
	# committed on the wrong clone) had every one of them published to the
	# `main` of their workspace repository by a command that came to place a
	# template. That is #40's finding 1 one layer down, and it is closed at the
	# same gate for the same reason: before step 7 writes a byte, where a
	# refusal costs nothing and the person's commits are exactly where they
	# left them, with the list in front of them. Pushing those commits, or
	# discarding them, is theirs to do; this command does neither.
	#
	# THE SEED IS EXEMPT, AND HAS TO BE, or step 8's own promise breaks. A
	# first run whose push the organisation's PR-only ruleset refused leaves a
	# clean worktree and EXACTLY ONE commit ahead of `main` — its seed — and
	# step 8's refusal tells the person that "a re-run after that has only to
	# push". So a commit this command made is let through, and it is known by
	# everything that makes it this command's own, never by its message alone:
	# `wip_is_own_seed` above. Every OTHER commit in `<origin main>..HEAD` is a
	# refusal naming all of them, seed or not, because what step 8 would push
	# is the whole range and the person should see the whole range.
	#
	# THE REMOTE IS ASKED HERE, ONCE, AND STEP 8 READS THE SAME ANSWER. One
	# `ls-remote`, one `remote_head`: the range this gate checked and the push
	# step 8 decides on can never be two different readings of `main`. And the
	# line read is `refs/heads/main` BY NAME, never the first line: a pattern
	# of `main` matches every ref whose name ENDS in it, so a branch such as
	# `refs/heads/backup/main` sorts before `refs/heads/main`, and the first
	# line was then that branch's tip read as `main` — which would wave through
	# every commit the branch carries, and tell step 8 that a `main` it never
	# pushed to already had them.
	#
	# A REMOTE THAT COULD NOT BE ASKED IS STEP 8'S OWN ARM, KEPT, as the ruling
	# keeps it: this check is skipped, said in one line, and the run goes on to
	# the push, which is the probe. Not a refusal, because there is nothing
	# true to refuse with — no `main` to name commits against — and because the
	# remote that will not answer `ls-remote` is the remote step 8 pushes to,
	# by the same URL, transport and credential, so the push almost always
	# meets the same wall and step 8 stops the run before the pointer file is
	# written. And NOT an empty `main` either: `remote_asked` is kept apart
	# from `remote_head` because an unanswered question read as "no `main`
	# yet" would put EVERY local commit ahead — refusing the very seed re-run
	# the exemption above exists for. The window this leaves is a remote that
	# refuses the question and takes the push a moment later, and that is the
	# trade the ruling chose with this arm.
	#
	# A RANGE THAT CANNOT BE LISTED IS A REFUSAL, NEVER AN EMPTY ONE (#49's
	# lesson, asked of history). Its usual cause is a `main` this checkout has
	# never fetched — another workstation pushed to it since — and an empty
	# list read from that failure is exactly what "nothing ahead, proceed"
	# looks like.
	local remote_head="" remote_asked=0 remote_refs history_range where ahead ahead_log commit
	local seeds_ahead=0
	if remote_refs="$(git -C "$checkout" ls-remote origin main 2>/dev/null)"; then
		remote_asked=1
		remote_head="$(printf '%s\n' "$remote_refs" |
			awk '$2 == "refs/heads/main" && !seen { print $1; seen = 1 }')"
	fi
	if [ "$remote_asked" -eq 0 ]; then
		say "  could not ask origin where $target's main is, so the commits this checkout"
		say "  carries were not checked against it here; the push below is the probe."
	elif git -C "$checkout" rev-parse -q --verify 'HEAD^{commit}' >/dev/null 2>&1; then
		if [ -n "$remote_head" ]; then
			history_range="$remote_head..HEAD"
			where="$target's main ($(printf '%.7s' "$remote_head"))"
		else
			history_range="HEAD"
			where="$target's main (it has none yet)"
		fi
		wip_quietly git -C "$checkout" rev-list "$history_range" ||
			die "could not list the commits $checkout carries that are not on $where,
    so this run cannot tell whether any of them is somebody's unreviewed work — and a
    history this command could not read is never one it may push. Most often that \`main\`
    is a commit this checkout has never fetched, because another workstation pushed to it
    since. NOTHING was written into that checkout on this run and nothing was staged.
    Fetch it, merge or rebase this checkout's own commits onto origin/main, then re-run:
        git -C $checkout fetch origin
        openRepoTools wip init
    What it said:
$WIP_LAST_ERR"
		ahead="$(cat -- "$WIP_LAST_OUT")"
		for commit in $ahead; do
			if wip_is_own_seed "$checkout" "$commit"; then
				seeds_ahead=$((seeds_ahead + 1))
				continue
			fi
			ahead_log="$(git -C "$checkout" log --oneline --no-decorate --no-color \
				--no-show-signature "$history_range" 2>/dev/null)" || ahead_log="$ahead"
			die "$checkout carries commits that are not on $where,
    and not every one of them is this command's own seed:
$(printf '%s\n' "$ahead_log" | sed -e 's/^/    /')
    This command ends by pushing HEAD to $target's main, so it would publish every
    commit above to your workspace repository unreviewed — and what it came to push
    is $SHAPE_REPOSITORY's $WIP_TEMPLATE_DIR and nothing else.
    NOTHING was written into that checkout on this run and nothing was staged.
    Push those commits yourself, or discard them, then re-run:
