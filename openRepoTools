# ------------------------------------------ THE RECEIPT OF WHAT IT PLACED
#
# opensoft/openRepoTools#57, and it descends from COPILOT'S ROUND-3 FINDING ON
# #45 (`openRepoTools:263`) — which is a finding about the retirement directly
# below this section:
#
#     "This ownership test is only a searchable content substring, not proof
#     that this installer created the file. A user-owned `restart` script
#     copied from an old installation or containing the same banner will
#     satisfy `grep` and be deleted on the next install […] Use durable
#     ownership metadata or another check that distinguishes installer output
#     from a user file before removing it."
#
# IT WAS DECLINED FOR `restart`, AND THE REASON DOES NOT GENERALISE. No
# installer that ever placed `restart` wrote a receipt, so no receipt can
# identify the copies that are on people's PATHs today: for that population the
# header marker is the only evidence that exists, and it stays exactly where it
# is. What #57 asks is that EVERY RETIREMENT AFTER THIS ONE have better — which
# costs nothing except that this run write down what it did.
#
# SO IT WRITES DOWN WHAT IT PLACED, one row per regular file:
#
#     <name><TAB><destination><TAB><sha256><TAB><UTC>
#
# and the name is the word this command PRINTED beside that placement — `park`,
# `handoff`, `/ctx` — because one name is a skill AND a command file at four
# different paths, and a row's subject is therefore its DESTINATION — spelled as
# its CANONICAL ABSOLUTE PATH (`receipt_dest`), so that a relative
# `$OPENREPOTOOLS_BIN_DIR` means the same file to the run that wrote the row and
# to every later run from any other directory. A run
# REPLACES the row of every destination it placed and KEEPS every other row, so
# a person who moves `$OPENREPOTOOLS_BIN_DIR` keeps the evidence for the copies
# in the old one, which are the copies a later retirement will meet there.
#
# THE ROWS ARE READ OFF DISK, FROM THE SAME LISTS THE PLACEMENTS ARE MADE FROM,
# after the last of them. Nothing is remembered from inside the loops: the
# planners have already refused every target that is not a regular file this
# user can write, the loops have written them, and what a receipt must carry is
# the digest of the bytes that ARE THERE. That is also why this is one call in
# `install_commands` and not a line inside each loop — the smallest hunk in the
# two functions this estate's other branches are editing.
#
# IT IS NOT AN ARTIFACT OF THE COUNT. The count is the invariant of what
# `--install` PLACES; this is the record of that placement. A ROW GOES TO EVERY
# PLACED REGULAR FILE — the `INSTALLABLES` plus the skill files and the command
# files at both of their destinations — and to nothing else: the two hook
# entries get no row, because an entry inside somebody else's JSON file is not a
# file this command placed, and the receipt carries no row for itself.
#
# THE NUMBER THAT COMES OUT IS DERIVED, NOT STATED, because every statement of
# it went stale the next time a list moved (Copilot on #103, `openRepoTools:325`,
# which found twenty-six where there were twenty-seven): `ARTIFACTS - HOOK_ENTRIES`
# in `tests/test_openrepotools_command.py`, which is `len(INSTALLED) + 2 *
# len(SKILL_NAMES) + 2 * len(COMMAND_NAMES)`. Today that is 31 artifacts, 29 of
# them files, 29 rows — 17 + 6 + 6, since opensoft/openRepoTools#162 put
# `lane-worktrees` in `INSTALLABLES` — and it moves with `INSTALLABLES`, `SKILLS`
# and `COMMANDS`, and with nothing else.
#
# A RECEIPT THAT CANNOT BE WRITTEN IS A NOTE AND NEVER A REFUSAL (#57's own
# words, and the same rule the retirement follows one function down). The
# commands, the skills and the hook entries are what a person asked for; a
# record of them this installer could not write is its problem and not theirs,
# and the marker is still there for a retirement to fall back to. Fail closed,
# out loud, in one line, and carry on.
#
# AND THE RECEIPT IS ONLY EVER ASKED ABOUT A PATH THIS COMMAND COMPUTED. It is
# never read as a list of paths to remove: `retire_commands` walks `RETIRED`
# against its own `$dir` and asks the receipt one question about the target it
# already has in hand — is the file at THIS path the one I wrote. So a receipt
# somebody else authored can change an answer and can never name a file for
# removal, which is the difference between a record and an instruction.

#: WHERE THE RECEIPT LIVES. `$OPENREPOTOOLS_DATA_DIR`, else the XDG data
#: directory — `$XDG_DATA_HOME`, else `~/.local/share`. It is DATA and does not
#: belong beside the commands in `$OPENREPOTOOLS_BIN_DIR`: a bin directory is a
#: PATH entry, and a `.tsv` in one is a file every shell walks past for ever
#: (`repos.tsv` is there under protest, and Amendment 9(b) says so). XDG is the
#: one convention that answers "where does a tool keep its own record" on Linux
#: and macOS alike, and the override is there because the bin directory has one.
#:
#: THE DIRECTORY AS CONFIGURED IS ONE THING AND THE PATH THIS FILE READS AND
#: WRITES IS ANOTHER (Copilot round 4 on #103, `openRepoTools:365`). The first
#: shape handed the configured string to every caller, so a relative
#: `$OPENREPOTOOLS_DATA_DIR` was `data/installed.tsv` in every line and every
#: `[ -f ]`: a spelling, not a file. `receipt_file` is the CANONICAL path — the
#: directory resolved by `receipt_dest`, the same `pwd -P` the destinations in
#: the rows go through — whenever the directory is THERE TO RESOLVE, and the
#: configured spelling otherwise: a directory that does not exist has no
#: receipt in it to read, and the one caller that MAKES it (`receipt_replace`)
#: creates it first and asks again. A getter that created directories would
#: make a retirement's read a write.
#:
#: WHAT RESOLVING DOES NOT DO is make a relative `data` mean the same directory
#: from two working directories: that is what being relative IS. So
#: `receipt_record` says so, on the line beside the one that names the
#: receipt, rather than leaving a person to find out from a later run that
#: could not see the first one's evidence.
receipt_data_dir() {   # the directory as configured, which may be relative
	printf '%s\n' "${OPENREPOTOOLS_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/openRepoTools}"
}
receipt_file() {
	receipt_dest "$(receipt_data_dir)/installed.tsv"
}

#: A TAB AND A NEWLINE AS VALUES, because the receipt is a TSV and a
#: destination carrying either would split one row into two columns or into two
#: rows. `$'\t'` is the shorter spelling and no file in this repository uses
#: one; `printf` is the spelling every one of them does use. The `X` is there
#: because `$( )` strips TRAILING newlines and there would otherwise be nothing
#: left to assign.
RECEIPT_TAB="$(printf '\t')"
RECEIPT_NEWLINE="$(printf '\nX')"
RECEIPT_NEWLINE="${RECEIPT_NEWLINE%X}"

RECEIPT_ROWS=""   # this run's rows, staged in $WORKDIR
RECEIPT_DESTS=""  # their destinations, one per line, for the merge
RECEIPT_STAMP=""  # the UTC of this run
RECEIPT_COUNT=0   # how many rows it wrote
RECEIPT_WHY=""    # why it could not, where it could not

# THE DIGEST, IN WHICHEVER SPELLING THIS MACHINE HAS. `sha256sum` is GNU and a
# stock macOS ships none; `shasum -a 256` is in the Perl toolchain macOS does
# ship, and is on every Linux this estate runs. Neither is a hard dependency —
# a machine with neither gets the note and the marker — so this is the one
# place either name is spelled.
#
# THE FILE IS FED ON STDIN AND NEVER NAMED AS AN OPERAND, and that is not a
# style choice: GNU `sha256sum` ESCAPES a filename containing a backslash or a
# newline and prefixes the whole line with `\`, so `${out%% *}` off a named
# operand hands back `\<digest>` for a bin directory somebody spelled with a
# backslash in it. Read from stdin, both spellings print `<digest>  -`.
sha256_of() {   # <path> — its digest, or 1 and nothing at all
	local out=""
	[ -f "$1" ] && [ -r "$1" ] || return 1
	if command -v sha256sum >/dev/null 2>&1; then
		out="$(sha256sum <"$1" 2>/dev/null)" || return 1
	elif command -v shasum >/dev/null 2>&1; then
		out="$(shasum -a 256 <"$1" 2>/dev/null)" || return 1
	else
		return 1
	fi
	out="${out%% *}"
	[ -n "$out" ] || return 1
	printf '%s\n' "$out"
}

# THE ONE LINE A RECEIPT THAT COULD NOT BE WRITTEN GETS. It says where, why,
# that the install is not affected, and what a retirement falls back to — and
# it is `say` and not `die`, which is the whole of #57's ruling on this.
#
# THE EXIT BELONGS TO THE REASON AND NOT TO THE LINE, which is why it is a
# sentence a caller puts in its `why` rather than a tail on every note: a
# machine with no `sha256sum` and no `shasum` is not a machine that wants to be
# told to name a different directory.
RECEIPT_ELSEWHERE='name a directory this installer may write with $OPENREPOTOOLS_DATA_DIR'
receipt_note() {   # <file> <why>
	say "receipt: NOT written to $1 — $2. Everything above is installed; a later retirement falls back to the \`Installed on PATH by\` header, which is the evidence it has today."
}

# THE DESTINATION AS THE RECEIPT SPELLS IT: ABSOLUTE, AND WITH EVERY SYMLINK IN
# ITS DIRECTORY RESOLVED (Copilot on #103, `openRepoTools:524`). A row is
# evidence about ONE FILE, and `$OPENREPOTOOLS_BIN_DIR=bin` — which the planner
# accepts — names a different file from every directory it is run in: the first
# shape stored `$dir/$name` as supplied, so a row written from one working
# directory was compared, as a string, against the `bin/restart` of another, and
# that other file was hashed and could be removed. So the one spelling every
# read and write goes through is the PHYSICAL path of the file's directory plus
# its own name — `record`, `verdict` and `forget` all ask THIS, never the
# `$dir/$name` they were handed, and the line a person reads still prints the
# path as they spelled it.
#
# THE DIRECTORY IS RESOLVED, NEVER THE FILE: `receipt_add` has already refused a
# symlink at the path itself, and a link is somebody's decision about their own
# PATH, which is no business of a row's. `(cd -- "$dir" && pwd -P)` is the
# portable spelling (macOS and bash 3.2 have no `realpath`, and `readlink -f`
# is not in a stock macOS userland — `lanes-edit.sh` asks the same question the
# same way). `CDPATH` is emptied first, because a `cd` through one PRINTS the
# directory it went to and the substitution would hold two lines. And the
# trailing `X` is the one `RECEIPT_NEWLINE` uses: `$( )` strips trailing
# newlines, and a directory whose name ENDS in one would otherwise resolve to a
# DIFFERENT, shorter path — one with no newline in it, past the TSV guard.
#
# IT NEVER FAILS: a directory that cannot be entered answers with the path as
# given, which is not absolute, and the one caller that WRITES a row refuses a
# destination that is not — the callers that only READ simply never match it.
receipt_dest() {   # <path> — its canonical absolute spelling, else the path as given
	local dir="" base="" real=""
	case "$1" in
	*/*) dir="${1%/*}"; base="${1##*/}" ;;
	*) dir="."; base="$1" ;;
	esac
	[ -n "$dir" ] || dir="/"
	real="$(CDPATH= cd -- "$dir" >/dev/null 2>&1 && pwd -P && printf X)" ||
		{ printf '%s\n' "$1"; return 0; }
	real="${real%X}"
	real="${real%"$RECEIPT_NEWLINE"}"
	case "$real" in
	/) printf '/%s\n' "$base" ;;
	*) printf '%s/%s\n' "$real" "$base" ;;
	esac
}

# WHETHER A PATH CANNOT BE A COLUMN OF THE RECEIPT: it carries a tab or a newline.
receipt_tsv_unsafe() {   # <path> — 0 if it cannot, 1 if it can
	case "$1" in
	*"$RECEIPT_TAB"*|*"$RECEIPT_NEWLINE"*) return 0 ;;
	esac
	return 1
}

# ONE ROW, STAGED. The digest is of the bytes at the destination, so a run that
# placed nothing new still records what is there — which is the point: the
# receipt answers "is the file at this path mine", not "did I write it today".
#
# A DESTINATION CARRYING A TAB OR A NEWLINE GETS NO RECEIPT AT ALL, rather than
# a row that is silently two columns or two rows. `$OPENREPOTOOLS_BIN_DIR` is a
# path a person chooses — the retirement one function down already prints its
# `rm` quoted because of the spaces people put in them — and a TSV has no
# escape. Failing the whole receipt rather than dropping the row is the fail-
# closed half: a receipt missing exactly the file a retirement will ask about,
# with nothing on screen, is worse than no receipt at all.
receipt_add() {   # <name> <destination> — 0, or 1 with $RECEIPT_WHY set
	local name="$1" given="$2" dest="" digest=""
	[ -f "$given" ] && [ ! -L "$given" ] || return 0
	# THE TAB AND NEWLINE QUESTION IS ASKED OF BOTH SPELLINGS — the one the person
	# supplied, BEFORE anything resolves it, and the canonical one, which a symlink
	# in the directory can make carry a tab the supplied one never had.
	if receipt_tsv_unsafe "$given"; then
		RECEIPT_WHY="$given has a tab or a newline in it and this file is tab-separated"
		return 1
	fi
	dest="$(receipt_dest "$given")"
	if receipt_tsv_unsafe "$dest"; then
		RECEIPT_WHY="$dest has a tab or a newline in it and this file is tab-separated"
		return 1
	fi
	case "$dest" in
	/*) ;;
	*)
		RECEIPT_WHY="$given could not be resolved to an absolute path"
		return 1
		;;
	esac
	digest="$(sha256_of "$dest")" || {
		RECEIPT_WHY="$dest could not be digested"
		return 1
	}
	printf '%s\t%s\t%s\t%s\n' "$name" "$dest" "$digest" "$RECEIPT_STAMP" \
		>>"$RECEIPT_ROWS" || {
		RECEIPT_WHY="the rows could not be staged in $WORKDIR"
		return 1
	}
	printf '%s\n' "$dest" >>"$RECEIPT_DESTS" || {
		RECEIPT_WHY="the rows could not be staged in $WORKDIR"
		return 1
	}
	RECEIPT_COUNT=$((RECEIPT_COUNT + 1))
	return 0
}

# EVERY ROW OF THE RECEIPT WHOSE DESTINATION IS NOT ONE OF THESE, appended to a
# staged file. ONE implementation for the two callers that need it — the merge,
# which keeps what this run did not replace, and the retirement, which drops
# the row of the file it removed — because two copies of one parse is how the
# two come to disagree about what a row is.
#
# A ROW IS FOUR FIELDS OR MORE, and anything else in that file is ignored
# rather than repaired: a comment somebody added, a truncated line, a column a
# later version appends. Reading "at least four" rather than "exactly four" is
# what lets a fifth column arrive without this half having to be taught about
# it first.
#
# AND A ROW WHOSE FILE IS NO LONGER AT THAT PATH IS NOT KEPT (Copilot round 1
# on #103). `receipt_forget` runs AFTER the `rm` it accompanies, so a write
# that fails in the instant between them leaves the receipt naming a path this
# installer's copy has left — and nothing would ever clear it. This makes that
# window CLOSE BY ITSELF: the next `--install` reads the same file, finds that
# file gone, and drops the row. It is also what stops the receipt growing for
# ever with the bin directories and profile roots people delete.
#
# WHAT IS KEPT IS WHAT COULD HAVE BEEN WRITTEN: a REGULAR FILE THAT IS NOT A
# LINK, which is `receipt_add`'s own test one function up, spelled the same way
# (Copilot round 2 on #103, `openRepoTools:468`). The first shape of this asked
# `[ -e ] || [ -L ]` — "is there anything at all at that path" — which kept the
# row of a destination that had become a directory, a socket, a FIFO or a
# symlink. A row is evidence about a REGULAR FILE this installer placed, and
# where one of those sits at that path the file it is evidence about is not
# there; the two halves now say that in one sentence each rather than two
# different ones.
receipt_rows_except() {   # <receipt> <destinations file> <staged file>
	local row="" rest="" dest=""
	[ -f "$1" ] && [ ! -L "$1" ] || return 0
	# A RECEIPT THAT EXISTS AND CANNOT BE OPENED IS A FAILURE, NOT AN EMPTY ONE
	# (Copilot round 4 on #103, `openRepoTools:575`). The `done <"$1"` below
	# fails quietly when it cannot open the file, and the `return 0` this
	# function ends in then reported a clean scan of no rows — so
	# `receipt_record` replaced the receipt with this run's rows alone and every
	# row about a copy this run did not place was gone. OPENED, not `-r`: the
	# answer that matters is the one the loop is about to get, and for root those
	# two agree anyway. Both callers already print their note on a non-zero.
	: 2>/dev/null <"$1" || return 1
	while IFS= read -r row || [ -n "$row" ]; do
		case "$row" in
		*"$RECEIPT_TAB"*"$RECEIPT_TAB"*"$RECEIPT_TAB"*) ;;
		*) continue ;;
		esac
		rest="${row#*"$RECEIPT_TAB"}"
		dest="${rest%%"$RECEIPT_TAB"*}"
		# A RELATIVE DESTINATION IS NEVER KEPT (Copilot on #103, `openRepoTools:524`).
		# This command writes none any more, and a row that says `bin/park` is a
		# row about whichever directory the next run is standing in: the `-f` just
		# below would answer for THAT run's `bin/park`, which is the cwd-dependence
		# `receipt_dest` removes from every other read.
		case "$dest" in
		/*) ;;
		*) continue ;;
		esac
		if grep -qFx -e "$dest" -- "$2"; then continue; fi
		[ -f "$dest" ] && [ ! -L "$dest" ] || continue
		printf '%s\n' "$row" >>"$3" || return 1
	done <"$1"
	return 0
}

# THE WRITE ITSELF: `mktemp` in the same directory, `mv -f`. It is the shape
# `place_skill_and_hook` writes `settings.json` with and for the same reason —
# a half-written receipt is a receipt that says a file is not this installer's.
# AND NO `chmod`: the receipt's mode is the 0600 `mktemp` gives the temporary,
# whatever the umask, which is `settings.json`'s mode too. Two rules meet here
# and this is how both are kept. #48 (PR #102) rules that EVERY `chmod` this
# command performs fails through `die` — a mode-stamp failure is a refusal —
# and `tests/test_openrepotools_command.py` reads the script's text to hold
# every site to it; #57 rules that a receipt this command cannot write is a
# NOTE and never a refused install. A stamp that may not `die` and may not
# fall silent is a stamp that must not exist, and 0600 wants none: this is one
# account's evidence, read by that account's own retirements, and nothing else
# reads it.
#
# `mv -f` DOES NOT FOLLOW A SYMLINK — it replaces the link itself — which is
# why `receipt_record` refuses one BEFORE reaching this: silently swapping a
# person's link for a regular file is the same act `cp` through one is, in the
# other direction.
#
# THE TEMPORARY IS WITHIN THE CLEANUP'S REACH FROM `mktemp` TO THE `mv` (#342),
# as the settings temporary is (#332) and a placement's is (#167): `$PLACING`
# holds its PREFIX — `installed.tsv.<this pid>.` beside the receipt — before
# `mktemp` runs, and `remove_workdir`, which the `EXIT` and `INT` traps run,
# removes whatever starts with it. The two arms below remove the temporary
# where the shell goes on; a signal is the failure neither of them sees, and
# it left `installed.tsv.XXXXXX` beside the receipt, which no later run looked
# for. Cleared once the `mv` has happened, and in each arm that removes the
# temporary, so the traps never glob after a file that is no longer this
# write's. `mktemp`'s answer comes back through the workdir, as the settings
# write's does, so the shell waits for `mktemp` as a plain command and a SIGINT
# in that wait runs the `INT` trap. So this needs the workdir, which both
# callers make first; without one it makes nothing and answers 1, which each
# caller turns into its note, never a file at `/placing`.
receipt_replace() {   # <staged file> — 0, or 1 having changed nothing
	local file="" dir="" tmp=""
	[ -n "$WORKDIR" ] && [ -d "$WORKDIR" ] || return 1
	file="$(receipt_file)"
	dir="$(dirname -- "$file")"
	mkdir -p -- "$dir" 2>/dev/null || return 1
	# THE DIRECTORY EXISTS NOW, so the canonical path can be had (round 4 on
	# #103, `openRepoTools:365`): on a first install the answer above was still
	# the configured spelling.
	file="$(receipt_file)"
	dir="$(dirname -- "$file")"
	PLACING="$dir/installed.tsv.$$."
	mktemp -- "${PLACING}XXXXXX" 2>/dev/null >"$WORKDIR/placing" ||
		{ rm -f -- "$PLACING"*; PLACING=""; return 1; }
	read_answer tmp "$WORKDIR/placing"
	cp -- "$1" "$tmp" 2>/dev/null || { rm -f -- "$tmp"; PLACING=""; return 1; }
	mv -f -- "$tmp" "$file" 2>/dev/null || { rm -f -- "$tmp"; PLACING=""; return 1; }
	PLACING=""
	return 0
}

# THE RECEIPT FOR THIS RUN, from the same three lists the placements are made
# from. Called once, after the last placement and before the one removal.
receipt_record() {
	local dir="${OPENREPOTOOLS_BIN_DIR:-$HOME/.local/bin}"
	local file="" kind="" name="" target="" why="" profiles="" claude_dir="" data_dir=""
	file="$(receipt_file)"
	# WHAT IS AT THAT PATH, BEFORE A BYTE OF IT IS READ OR WRITTEN — the same
	# question `plan_install_targets` and `plan_skill_targets` put to every
	# path this command writes, asked through the same `path_kind`. A symlink,
	# a directory or anything else there is not this installer's receipt: it is
	# neither read nor replaced, and the note says which it found.
	if kind="$(path_kind "$file")"; then
		receipt_note "$file" "it is $kind, and this installer's receipt is a regular file it makes itself — $RECEIPT_ELSEWHERE"
		return 0
	fi
	# AND WHETHER THERE IS ANYTHING HERE TO DIGEST WITH, asked once and named as
	# the cause it is. Without this the first file would fail `sha256_of` and
	# the note would say that FILE could not be digested — true, and not the
	# sentence a person needs to read on a machine that has neither tool.
	if ! command -v sha256sum >/dev/null 2>&1 && ! command -v shasum >/dev/null 2>&1; then
		receipt_note "$file" "there is no \`sha256sum\` and no \`shasum -a 256\` on this PATH, and a row without a digest is a row that proves nothing"
		return 0
	fi
	workdir
	RECEIPT_ROWS="$WORKDIR/receipt-rows"
	RECEIPT_DESTS="$WORKDIR/receipt-dests"
	RECEIPT_COUNT=0
	RECEIPT_WHY=""
	RECEIPT_STAMP="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
	: >"$RECEIPT_ROWS" 2>/dev/null || { receipt_note "$file" "its rows could not be staged in $WORKDIR"; return 0; }
	: >"$RECEIPT_DESTS" 2>/dev/null || { receipt_note "$file" "its rows could not be staged in $WORKDIR"; return 0; }
	for name in "${INSTALLABLES[@]}"; do
		receipt_add "$name" "$dir/$name" || { receipt_note "$file" "$RECEIPT_WHY"; return 0; }
	done
	# THE SKILLS AND THE COMMAND FILES TOO, under the name each was PRINTED
	# with: they are regular files this run placed, at paths it chose, and a
	# record of what was placed that left them out — every one a path a
	# retirement could one day meet — would answer only part of the question
	# anybody asks it. The two homes are taken once, each by a `$(…)` of its
	# own, so no `for` list below holds two (#342, the reason is above
	# `remove_workdir`).
	profiles="$(skills_home)"
	claude_dir="$(claude_home)"
	for name in "${SKILLS[@]}"; do
		for target in "$profiles/shared/skills/$name/SKILL.md" "$claude_dir/skills/$name/SKILL.md"; do
			receipt_add "$name" "$target" || { receipt_note "$file" "$RECEIPT_WHY"; return 0; }
		done
	done
	for name in "${COMMANDS[@]}"; do
		for target in "$profiles/shared/commands/$name.md" "$claude_dir/commands/$name.md"; do
			receipt_add "/$name" "$target" || { receipt_note "$file" "$RECEIPT_WHY"; return 0; }
		done
	done
	# THIS RUN'S ROWS FIRST, THEN EVERY EARLIER ROW IT DID NOT REPLACE.
	receipt_rows_except "$file" "$RECEIPT_DESTS" "$RECEIPT_ROWS" ||
		{ receipt_note "$file" "the rows already there could not be read"; return 0; }
	if receipt_replace "$RECEIPT_ROWS"; then
		file="$(receipt_file)"
		say "receipt: $RECEIPT_COUNT placed files recorded in $file"
		data_dir="$(receipt_data_dir)"
		case "$data_dir" in
		/*) ;;
		*)
			say "  the data directory $data_dir is a RELATIVE path, which names a different directory from every working directory — this run resolved it to $(dirname -- "$file"). Name an absolute one with \$OPENREPOTOOLS_DATA_DIR so a later \`--install\` from anywhere reads this receipt."
			;;
		esac
	else
		why="$(unusable_dir_kind "$(dirname -- "$file")")" || why="the write failed"
		receipt_note "$file" "$why — $RECEIPT_ELSEWHERE"
	fi
	return 0
}

# WHAT THE RECEIPT SAYS ABOUT ONE PATH, in one word, and never an exit code: a
# `$( )` that returned non-zero under `set -e` would take the install with it,
# and "I have nothing to say about this file" is an ANSWER here rather than a
# failure.
#
#   placed  — a row names this path and the bytes there still have its digest.
#             This installer's copy beyond argument.
#   edited  — a row names it and the digest has MOVED. Somebody's edit of an
#             installed command, or their own file at a path one used to be:
#             either way not this installer's to remove.
#   unknown — no receipt, or no row for THIS path. The header marker is what
#             answers then, exactly as it does today.
#   unverified — a row names it and NOTHING COULD BE DIGESTED to compare with:
#             no `sha256sum` and no `shasum` on this PATH, a tool that failed, or
#             a file this user cannot read (Copilot on #103, `openRepoTools:711`).
#             It is NOT `unknown`, and the difference is the whole of #57: the
#             header marker is the answer for a path the receipt has NOTHING TO
#             SAY about, and a path it HAS a row for and cannot check is a path
#             it has something to say about and cannot say yet. The first shape
#             of this folded the two into one word, so the marker removed an
#             edited, receipt-tracked command on exactly the machine that could
#             not tell it was edited — the ownership mistake the receipt exists
#             to prevent, made by the code that carries it. Named and left.
#   unreadable — the receipt EXISTS and cannot be OPENED (Copilot round 4 on
#             #103, `openRepoTools:716`). The scan never ran, so "no row" is not
#             something it found: it is the same ignorance as `unverified`, one
#             step earlier, and it gets the same answer — named and left —
#             with its own sentence, because the person's remedy is the
#             receipt's mode and not a digest tool. `unknown` is for a scan that
#             RAN and found nothing.
#
# THE FIRST MATCHING ROW WINS. This command writes one row per destination, so
# a second is a hand-edit, and picking the first is the only rule that does not
# depend on which end of the file somebody appended to.
receipt_verdict() {   # <target> — placed | edited | unverified | unreadable | unknown, always 0
	local file="" row="" rest="" dest="" digest="" disk="" want=""
	file="$(receipt_file)"
	[ -f "$file" ] && [ ! -L "$file" ] || { printf 'unknown\n'; return 0; }
	: 2>/dev/null <"$file" || { printf 'unreadable\n'; return 0; }
	# THE ROW IS ABOUT A FILE, AND THE FILE IS ASKED ABOUT BY THE SAME SPELLING
	# THE ROW WAS WRITTEN IN (`receipt_dest`, Copilot on #103, `openRepoTools:524`).
	want="$(receipt_dest "$1")"
	while IFS= read -r row || [ -n "$row" ]; do
		case "$row" in
		*"$RECEIPT_TAB"*"$RECEIPT_TAB"*"$RECEIPT_TAB"*) ;;
		*) continue ;;
		esac
		rest="${row#*"$RECEIPT_TAB"}"
		dest="${rest%%"$RECEIPT_TAB"*}"
		[ "$dest" = "$want" ] || continue
		digest="${rest#*"$RECEIPT_TAB"}"
		digest="${digest%%"$RECEIPT_TAB"*}"
		disk="$(sha256_of "$1")" || { printf 'unverified\n'; return 0; }
		if [ "$disk" = "$digest" ]; then printf 'placed\n'; else printf 'edited\n'; fi
		return 0
	done <"$file"
	printf 'unknown\n'
	return 0
}

# AND THE ROW OF A FILE THAT IS NO LONGER THERE IS DROPPED, because a receipt
# that still names a removed path would answer `edited` about whatever somebody
# puts there next — which is the safe direction, and still a sentence about
# their file that is not true.
#
# NOT ONE OF ITS FAILURES IS SILENT (Copilot round 1 on #103, `openRepoTools:660`).
# Three of the four steps here used to `return 0` on a write that failed — a
# full disk while staging, a data directory that went away between the read and
# the write — so the receipt could keep a live row for a path the `rm` above had
# just emptied and NOTHING on screen would say so. Every one of them now reaches
# the same note, and the note names the repair: `receipt_rows_except` drops a
# row whose file is gone, so the next `--install` clears it whatever happened
# here. Still never a `die`: the retirement has already done its work.
receipt_forget() {   # <destination>
	local file="" kept="" dests="" dropped=1
	file="$(receipt_file)"
	[ -f "$file" ] && [ ! -L "$file" ] || return 0
	workdir
	kept="$WORKDIR/receipt-kept"
	dests="$WORKDIR/receipt-forget"
	# THE ROW IS DROPPED BY THE SPELLING IT WAS WRITTEN IN (`receipt_dest`); the
	# note below still names the path as the person spelled it.
	if : >"$kept" 2>/dev/null && printf '%s\n' "$(receipt_dest "$1")" >"$dests" 2>/dev/null &&
		receipt_rows_except "$file" "$dests" "$kept" &&
		receipt_replace "$kept"; then
		dropped=0
	fi
	[ "$dropped" = 0 ] ||
		receipt_note "$file" "its row for $1 could not be dropped, so it still names a path this installer's copy has left — the next \`--install\` drops it, because a row whose file is gone is not kept"
	return 0
}

# ---------------------------------------------- THE WORDS THAT WERE RETIRED
#
# A WORD THAT LEAVES THE LIST HAS TO LEAVE THE DIRECTORY (Copilot round 1 on
# #45, `openRepoTools:234`). Dropping `restart` from `INSTALLABLES` stops THIS
# run from copying it and does nothing at all about the copy the LAST run
# placed — so a workstation that took the install before lane-collision-protocol
# Amendment 18 Addendum 2 would keep `restart` on its PATH for ever, which is
# the one thing that addendum says must stop: *"`restart` is no longer a command
# a person is given"*, ratified 2026-09-14T16:50:32Z verbatim "ratify". An
# installer whose only act is to stop writing a file is not a retirement; it is
# a file nobody will ever clean up.
#
# AND IT REMOVES ONLY WHAT IT WROTE. The test is the header this installer puts
# in every command it owns — `Installed on PATH by ` + the installer's own name
# — so a person's own script that happens to be called `restart` is NAMED and
# LEFT EXACTLY AS IT IS, with the one line to run printed beside it. Deleting a
# file this command did not write is not an act an installer may take on
# somebody's behalf, and a retirement that did would be the worst possible way
# to learn the difference.
RETIRED=(restart)
retire_commands() {
	local dir="${OPENREPOTOOLS_BIN_DIR:-$HOME/.local/bin}"
	local name target verdict=""
	for name in "${RETIRED[@]}"; do
		target="$dir/$name"
		# `-e` FOLLOWS THE LINK AND IS FALSE FOR A DANGLING ONE (Copilot round 4 on
		# #45, `openRepoTools:261`), so a `restart` SYMLINK whose target has since
		# gone — and the pre-move `link-estates` put exactly such links in a
		# workstation's `~/.local/bin`, pointing into a checkout that may no longer
		# be there — was NEITHER removed NOR named: it stayed on PATH, and the one
		# run that was going to mention it said nothing. `-L` is the other half of
		# "is there anything at this path at all"; what happens next is the same as
		# for any other link, which is that it is named and left.
		[ -e "$target" ] || [ -L "$target" ] || continue
		# `! -L` BEFORE `-f`, BECAUSE `-f` FOLLOWS THE LINK (Copilot round 2 on
		# #45). A person's own `restart` SYMLINK pointing at a file that happens
		# to carry this installer's header would otherwise be unlinked — and
		# `plan_install_targets` refuses a `-L` target for exactly that reason
		# (`unplaceable_kind`, which names the link rather than writing through
		# it). A link is somebody's decision about their own PATH; it is named
		# here and left, like every other file this installer did not write.
		#
		# THE RECEIPT IS ASKED FIRST, AND THE MARKER IS WHAT ANSWERS WHEN IT HAS
		# NOTHING TO SAY (#57, on Copilot's round-3 finding on #45). A row whose
		# digest still matches is this installer's copy beyond argument; a row
		# whose digest has MOVED is a file this installer may not remove even
		# though the header is still in it, because what the header proves is
		# where those lines came from and not who owns the bytes now. It is
		# asked only of a REGULAR FILE THAT IS NOT A LINK, for the reason the
		# `! -L` below gives: a link is somebody's decision about their own
		# PATH, whatever the receipt remembers about the path it sits at.
		verdict=unknown
		if [ ! -L "$target" ] && [ -f "$target" ]; then
			verdict="$(receipt_verdict "$target")"
		fi
		if [ "$verdict" = placed ]; then
			rm -f -- "$target"
			# AND THE ROW GOES WITH THE FILE, so the receipt never names a path
			# nothing of this installer's is at any more.
			receipt_forget "$target"
			say "$name: RETIRED, removed from $target — this installer's own receipt carries its digest (lane-collision-protocol Amendment 18 Addendum 2; \`lane <name>\` is that act now)"
		elif [ "$verdict" = edited ]; then
			say "$name: RETIRED by lane-collision-protocol Amendment 18 Addendum 2, and $target no longer holds the bytes this installer's receipt recorded — an edit of it, or your own file at that path. Left exactly as it is; remove it yourself if it is stale:  rm -f -- \"$target\""
		elif [ "$verdict" = unverified ]; then
			# A ROW IT CANNOT CHECK IS NEVER THE HEADER'S TO ANSWER (Copilot on #103,
			# `openRepoTools:711`): the receipt names this path, so the marker is not
			# the evidence — and the digest that would have settled it could not be
			# taken. One line, the same shape as the two above: where, why, the `rm`.
			say "$name: RETIRED by lane-collision-protocol Amendment 18 Addendum 2, and $target has a row in this installer's receipt that could not be checked, because no digest tool answered (\`sha256sum\`, \`shasum -a 256\`) — so it is NOT removed on the strength of its header either. Left exactly as it is; remove it yourself if it is stale:  rm -f -- \"$target\""
		elif [ "$verdict" = unreadable ]; then
			# A RECEIPT THAT CANNOT BE OPENED CANNOT SAY "NO ROW" (Copilot round 4 on
			# #103, `openRepoTools:716`): it may carry exactly the row that says this
			# file is an edit. Same shape as the arm above, and it names the receipt,
			# because that is the file whose mode the person has to look at.
			say "$name: RETIRED by lane-collision-protocol Amendment 18 Addendum 2, and this installer's receipt $(receipt_file) exists but could not be read, so whether $target is its copy is not known — it is NOT removed on the strength of its header either. Left exactly as it is; remove it yourself if it is stale:  rm -f -- \"$target\""
		elif [ ! -L "$target" ] && [ -f "$target" ] && grep -qF -e 'Installed on PATH by `openRepoTools --install`' -- "$target" 2>/dev/null; then
			rm -f -- "$target"
			say "$name: RETIRED, removed from $target (lane-collision-protocol Amendment 18 Addendum 2; \`lane <name>\` is that act now)"
		else
			# THE PRINTED REMOVAL IS QUOTED, AND IT IS THIS FILE'S OWN SPELLING
			# (Copilot round 9 on #45, `openRepoTools:281`): both planners print
			# `rm -f -- "<path>" "<path>"` out of a `paths` they build with the
			# quotes IN, because `OPENREPOTOOLS_BIN_DIR` is a path a person chooses
			# and a bare one with a space in it is a line that removes nothing. `-f`
			# for the reason those two give: what a removal needs is the DIRECTORY's
			# write bit, not the file's.
			say "$name: RETIRED by lane-collision-protocol Amendment 18 Addendum 2, and $target is NOT this installer's copy — left exactly as it is. Remove it yourself if it is stale:  rm -f -- \"$target\""
		fi
	done
}

# ALL OF THEM IN HAND BEFORE ANY OF THEM IS PLACED (openRepoShape #82, F10 of
# the review on its #83). One file at a time, dying on the first fetch that
# failed, leaves a person with a NEW `openRepoTools` and no `park` — a
# half-install that says `installed at` and is not one — and nothing on screen
# to say which were missing. Every one is collected into the temporary directory
# first: a failure there replaces NOTHING, names what was not fetched, and exits.
#
# NO NUMBER IS SPELLED IN THIS BLOCK, and that is the fix rather than a bigger
# number (#26, the review of `37632b1`, `openRepoTools:226`). It said "ALL FOUR"
# and "which of the four" while `INSTALLABLES` carried ELEVEN — the count grew
# under a comment stating the old one, which is the same defect as the stale
# artifact counts `2f44da0` corrected and as `lane-start`'s "no fifth rung". The
# code below already derives every count it prints from `${#INSTALLABLES[@]}`.
collect_commands() {
	local name missing=""
	# Run from a file, install THOSE bytes: `--install` then needs no network
	# and no `gh` at all — and `park`, `resume` and `status` sit BESIDE this
	# file, in the checkout and in the repository alike, so the siblings that
	# are there are copied and only a missing one is fetched. Run from stdin
	# (`curl … | bash -s -- --install`) there is no file to copy from at all,
	# so each one is fetched at this same ref. WHICH of those it is, and from
	# where, is `payload_select`'s one decision (#186), made before this runs.
	payload_select
	workdir
	STAGED="$WORKDIR/staged"
	mkdir -p "$STAGED"
	for name in "${INSTALLABLES[@]}"; do
		if [ -n "$PAYLOAD_DIR" ] && [ -f "$PAYLOAD_DIR/$name" ]; then
			cp -- "$PAYLOAD_DIR/$name" "$STAGED/$name"
			continue
		fi
		# A LOCAL SOURCE IS NEVER COMPLETED FROM A NETWORK: it was whole when
		# it was chosen, and a file gone since is missing, not fetched.
		if [ "$PAYLOAD_MODE" != local ]; then
			fetch_from_repo "$name" "$STAGED/$name" && continue
		fi
		missing="${missing:+$missing }$name"
	done
	[ -z "$missing" ] || die "could not fetch $missing from $(payload_where), so NOTHING was installed
    and nothing already installed was replaced. \`--install\` places all
    ${#INSTALLABLES[@]} files or none: a new openRepoTools beside a missing park is
    a half-install that reads like a whole one. Both ways were tried:
    gh api repos/${PAYLOAD_REPO:-$REPO}/contents/<file>?ref=${PAYLOAD_REV:-$REF}
    curl -fsSL https://raw.githubusercontent.com/${PAYLOAD_REPO:-$REPO}/${PAYLOAD_REV:-$REF}/<file>"
}

# WHAT MODE A PLACED ARTIFACT IS AT, asked without `stat`. GNU spells that
# `stat -c %a` and BSD `stat -f %Lp`, and nothing this repository ships may
# reach for one of the two without the other beside it — so `find` answers it
# instead, in the one spelling both agree on: with the octal preceded by
# neither `-` nor `+`, GNU and BSD `find` each evaluate `-perm` true only where
# the permission bits are EXACTLY that number.
#
# IT IS ASKED SO THAT A LINE CAN TELL THE TWO CASES APART. `--install` stamps
# the documented mode on every artifact whether or not the bytes changed
# (#40, findings 2 and 3), and a run that repaired a mode and reported
# `unchanged` is a run that told a person there was nothing to look at.
#
# `find`'S ANSWER COMES THROUGH A PIPE INTO `read`, NEVER A `$(…)` (#318): a
# pipeline is a plain command, which bash waits for in its job table, so a
# SIGINT in that wait runs the `INT` trap once it is over (search "A `$(…)` IS
# NOT A PLAIN COMMAND"). `read` succeeds only where `find` printed a line, and
# `find` prints one only for a path at exactly that mode: the same yes the
# `[ -n "$(…)" ]` it replaces gave. Nothing is written to a file, so it needs
# no workdir and is still asked alone by the suite.
mode_is() {   # <octal> <path>
	find "$2" -maxdepth 0 -perm "$1" -print 2>/dev/null | read -r _
}

# WHO OWNS A PATH, as `<uid>:<gid>`, and nothing where it cannot be read —
# asked without `stat` for the reason `mode_is` gives. `ls -n` prints both as
# numbers, in its third and fourth fields, on GNU, BSD and busybox alike, and
# `-d` keeps the answer about the path itself. The `|| :` keeps a path `ls`
# cannot read an empty answer rather than a `pipefail` exit.
owner_of() {   # <path>
	{ ls -lnd -- "$1" 2>/dev/null || :; } | awk 'NR == 1 { print $3 ":" $4 }'
}

# EVERY FILE `--install` PLACES IS WRITTEN BESIDE ITS TARGET AND RENAMED OVER IT
# (opensoft/openRepoTools#167): a temporary in the target's own directory, the
# bytes, the mode, then `mv -f`. It was `cp` onto the target, which keeps the
# target's INODE and rewrites its bytes — and bash reads a script from its file
# while it runs it, at an offset, so a lane tool that was running when an
# install replaced it went on reading the NEW text from the OLD offset. Measured
# on 2026-09-30: `A.sh: line 4: ript,: command not found`, then the new text's
# commands run from its middle. `lanes-edit.sh`, `lane-start` and the landers
# run for minutes, so a repair install at a busy moment could corrupt a lane's
# register write mid-flight. A rename puts a NEW inode at the path in one step:
# a process that has the old one open reads the old text to its end, and the
# next one to start reads the new. The SAME directory, because a rename is
# atomic only within one filesystem, and the same shape the receipt and
# `settings.json` were already written in.
#
# THE MODE GOES ON THE TEMPORARY, so the target never exists at the wrong mode
# for even an instant, and a stamp that fails (#48) leaves whatever was at the
# target exactly as it was.
#
# EVERY FAILURE REMOVES THE TEMPORARY, then refuses naming the target, and a
# run killed while one exists leaves nothing behind either: `$PLACING` holds
# its PREFIX — `.<name>.openrepotools.<this pid>.` — from BEFORE `mktemp` runs
# until after the `mv`, and `remove_workdir`, which the `EXIT` and `INT` traps
# run, removes whatever starts with it. A name the trap learnt only from
# `mktemp`'s answer had a window, between the file being made and the answer
# being assigned, in which a signal left it behind (Copilot round 2 on #172);
# the pid keeps the prefix this run's own. The leading dot keeps it out of a
# listing, and the suffix after the name keeps it out of every glob a reader of
# these directories takes (`*.md` in `commands/`).
#
# NO ANSWER HERE IS TAKEN WITH `$(…)` (#250). Bash waits for a command
# substitution's child outside its job table, and a SIGINT that arrives in
# that wait is lost, trapped or not: a Ctrl-C as `mktemp`'s answer came back
# did nothing, and the install went on. So `dirname`, `mktemp` and `owner_of`
# are plain commands writing to a file in the workdir — a wait the `INT` trap
# is run after — and `read` takes each answer back: a path up to a NUL, which
# no path holds, so a directory with a newline in its name comes back whole,
# less the one newline the command ends it with. `parent` holds the directory,
# never `$PLACING`, which the traps glob. The `readlink` that names a link
# refused before the rename writes there too (#318), and `read_answer` takes
# its answer as the `$(…)` it replaces did. Had a SIGINT been lost in that
# wait, the run would have gone on to the refusal and its exit 2 instead of
# dying of the signal. That is inferred from how bash waits, not measured: at
# the merge of #250's and #257's branches the late-link case (a link made after
# planning) died of SIGINT after its hold.
#
# SO A PLACEMENT NEEDS THE WORKDIR, AND REFUSES WITHOUT ONE (#250). With
# `$WORKDIR` empty, each answer above would be written to `/placing`, at the
# root of the filesystem, which a root run can create. No caller reaches this
# without one today: all three are reached from `install_commands` after
# `collect_commands` has run `workdir`, and each stages its source in the
# workdir. The refusal is for a caller that one day does not, and it comes
# before anything is made.
#
# THE OWNER STAYS WHO IT WAS (Copilot on #172). A rename puts the TEMPORARY's
# inode at the path, and the temporary belongs to whoever runs this — so a root
# `--install` into another user's home, which this file goes out of its way to
# allow (search "WHAT `-w` DOES NOT PROVE"), would hand that user root-owned
# copies that their own next `--install` refuses as unwritable. `cp` kept the
# owner by keeping the inode; this keeps it by giving the temporary the
# target's uid and gid before the rename. Where that `chown` is refused and the
# OWNER differs — an account placing over a file another account owns, which
# only root may give away — the placement refuses rather than take the file
# over. Where only the GROUP differs and cannot be kept, it is placed anyway:
# at 755 and 644 the group's bits are the other bits, so nobody gains or loses
# a permission by it (Copilot round 2 on #172 asked that it not be silent, and
# this is why it may be). And an owner NOBODY COULD READ is not "nothing to
# keep": `owner_of` answers nothing where `ls` cannot say, which is also what an
# absent target gives, so a target that EXISTS with no readable owner is
# refused before the rename rather than handed this run's owner (Copilot on
# #172 at bef4b85).
#
# A DIRECTORY AT THE TARGET IS REFUSED HERE as well as in planning, because `mv`
# moves a file INTO a directory named as its destination rather than failing,
# and the planners are a phase earlier. Two installs that race (#106) each
# still place whole files; serializing them is #106's lock, not this.
place_by_rename() {   # <staged source> <target> <mode> <what a refusal adds>
	local source="$1" target="$2" mode="$3" rest="$4" parent="" tmp="" was="" now="" value=""
	if [ -z "$WORKDIR" ] || [ ! -d "$WORKDIR" ]; then
		die "\$WORKDIR is ${WORKDIR:-empty}${WORKDIR:+, which is not a directory}, and a placement passes each command's answer through a file in it, so $target was not placed and what was there is untouched.
    $rest"
	fi
	dirname -- "$target" >"$WORKDIR/placing"
	IFS= read -r -d '' parent <"$WORKDIR/placing" || :
	PLACING="${parent%$'\n'}/.${target##*/}.openrepotools.$$."
	mktemp -- "${PLACING}XXXXXX" >"$WORKDIR/placing" ||
		{ rm -f -- "$PLACING"*; PLACING=""; die "could not create a temporary file beside $target, so it was not placed.
    $rest"; }
	IFS= read -r -d '' tmp <"$WORKDIR/placing" || :
	tmp="${tmp%$'\n'}"
	cp -- "$source" "$tmp" ||
		{ rm -f -- "$tmp"; PLACING=""; die "could not write $target, so it was not placed and what was there is untouched.
    $rest"; }
	chmod "$mode" "$tmp" ||
		{ rm -f -- "$tmp"; PLACING=""; die "could not set mode $mode on $target, so it was not placed and what was there is untouched.
    $rest"; }
	owner_of "$target" >"$WORKDIR/placing"
	IFS= read -r was <"$WORKDIR/placing" || :
	owner_of "$tmp" >"$WORKDIR/placing"
	IFS= read -r now <"$WORKDIR/placing" || :
	if [ -z "$was" ] && { [ -e "$target" ] || [ -L "$target" ]; }; then
		rm -f -- "$tmp"
		PLACING=""
		die "could not read who owns $target, so it was not placed and what was there is untouched: a rename would give it this run's owner.
    $rest"
	fi
	if [ -n "$was" ] && [ "$was" != "$now" ] &&
		! chown -- "$was" "$tmp" 2>/dev/null &&
		[ "${was%%:*}" != "${now%%:*}" ]; then
		rm -f -- "$tmp"
		PLACING=""
		die "$target belongs to uid ${was%%:*}, and this run cannot give the new copy that owner, so it was not placed and what was there is untouched.
    $rest"
	fi
	if [ -d "$target" ]; then
		rm -f -- "$tmp"
		PLACING=""
		die "$target is a directory, so nothing was placed there: \`mv\` would have put the file inside it.
    $rest"
	fi
	# A LINK AT THE TARGET IS REFUSED HERE TOO, AS THE LAST QUESTION BEFORE THE
	# RENAME (#257). Every planner refuses a link at every target, so a link
	# here appeared after planning — a `pipx install` that finished mid-run puts
	# one at `<dir>/openRepoTools` — and `mv` would replace it with a regular
	# file: pipx's command gone until the next `pipx install` or `pipx upgrade`.
	# It is asked with a builtin, so nothing runs between this test and the
	# rename but `mv` starting. A link made in that instant is still replaced:
	# a rename takes whatever is at its destination, and no `mv` this file can
	# count on refuses a link there. The refusal names the link and prints no
	# `rm`, because it may be pipx's and the only `openRepoTools` that can run
	# `--install` (ADV3); the run it asks for asks about it afresh.
	if [ -L "$target" ]; then
		rm -f -- "$tmp"
		PLACING=""
		{ readlink -- "$target" 2>/dev/null || printf '<unreadable>'; } >"$WORKDIR/placing"
		read_answer value "$WORKDIR/placing"
		die "$target is a symlink to $value now, and was not one when this run planned, so nothing was placed there and the link is left as it was: \`mv\` would have replaced it with a regular file. Run \`openRepoTools --install\` again, and it asks about $target afresh.
    $rest"
	fi
	mv -f -- "$tmp" "$target" ||
		{ rm -f -- "$tmp"; PLACING=""; die "could not move the new $target into place, so what was there is untouched.
    $rest"; }
	PLACING=""
}

install_commands() {
	local dir="${OPENREPOTOOLS_BIN_DIR:-$HOME/.local/bin}"
	local name target source verb placed=0 from="" beside=""
	# ALL THIRTY-ONE IN HAND BEFORE ANY IS PLACED. Every file `INSTALLABLES`
	# lists, the skills, the command files, and the TWO artifacts that are not
	# whole files — the two hook entries merged into one `settings.json` —
	# are all computed here, so a fetch that failed replaces nothing and a merge
	# that cannot be computed refuses having placed nothing. That last one is
	# the same rule `--install` already had, extended to cover a merge: an
	# installer that got half way through a person's settings is worse than one
	# that did not start. BOTH OUTCOMES OF THAT MERGE ARE IN HAND (#237) — the
	# pair added, and the pair deferred with our guard entry taken out — and
	# which one is written is asked only after the bin loop, because the path
	# the two entries call is a link to the `lanes-edit.sh` that loop places.
	#
	# THE TARGETS ARE ASKED ABOUT FIRST, before even the fetch: a target that
	# cannot be written THROUGH is a refusal that costs nothing at all here,
	# and a network round-trip if it waits (A9 Addendum 4, R-A9-12).
	plan_install_targets
	# THE SOURCE NEXT, AND ONCE (#186): which bytes, from where, at which
	# commit — every refusal in it costs nothing, because nothing is collected
	# or placed until it has answered.
	payload_select
	collect_commands
	collect_skills || die "could not fetch one of the ${#SKILLS[@]} skills (${SKILLS[*]}) or the ${#COMMANDS[@]} command file (${COMMANDS[*]}) from $(payload_where), so
    NOTHING was installed and nothing already installed was replaced."
	plan_hook_merge
	plan_skill_targets
	# EVERY FAILURE FROM HERE IS A `die`, and this was the one that was not
	# (#44 round 1, Sourcery's `README.md:237`). `plan_install_targets` has
	# proved the nearest existing ancestor writable, so what is left for this to
	# meet is a race or a full disk — and under `set -e` an unguarded `mkdir`
	# exits 1, which reads as a report of findings from a run that placed none.
	mkdir -p -- "$dir" || die "could not create $dir for the ${#INSTALLABLES[@]} commands.
    NOTHING was installed and nothing already installed was replaced."
	for name in "${INSTALLABLES[@]}"; do
		source="$STAGED/$name"
		target="$dir/$name"
		# PIPX'S LINK IS LEFT TO PIPX (#228, FR-016): nothing is placed over it
		# or through it, it is not counted, and its line says what updates it.
		#
		# IT IS ASKED AGAIN AT ITS OWN TURN (#257), not taken from what
		# `plan_install_targets` found. A `pipx install` that finishes between
		# the two puts its link at a target this run planned to place, and the
		# rename would replace it with a regular file. So the target is left to
		# pipx when it is pipx's link NOW, and the match sets what the count line
		# reads; and a target planning left to pipx that is not pipx's link now
		# has changed since planning, which refuses, touching nothing at it. Any
		# other link is refused by `place_by_rename`, at the last instant before
		# the rename that would replace it.
		if [ "$name" = openRepoTools ]; then
			if pipx_link_match "$target"; then
				say "openRepoTools: left to pipx at $PIPX_LINK (a link into pipx's openrepotools environment); update it with \`pipx upgrade openrepotools\`, then run \`openRepoTools --install\` again"
				continue
			fi
			if [ -n "$PIPX_LINK" ]; then
				die "$target was pipx's link when this run planned, and is not now, so nothing was placed there and what is there now is left as it was. Run \`openRepoTools --install\` again, and it asks about $target afresh.
    Whatever the lines above report is placed; the skills, the command files and the
    hook entries are not placed at all."
			fi
		fi
		# A LINK IS NOT "THE BYTES ARE RIGHT" (#257). `[ -e ]` and `cmp` read
		# THROUGH a link, so one made since planning to a file that holds
		# exactly these bytes passes both, and the `chmod` below would stamp its
		# far end: somebody's own file, moded by a run that says "already
		# installed". Every planner refuses a link at every target it places
		# over, so a link here appeared after planning, and it takes the other
		# arm, where `place_by_rename` refuses it, naming it and leaving it as
		# it was. The question is asked LAST, after `cmp`, so only `mode_is`'s
		# `find` stands between it and `chmod`. A link made in that instant is
		# still followed: no `chmod` this file can count on stops at one (GNU's
		# has no `-h`).
		if [ -e "$target" ] && cmp -s "$source" "$target" && [ ! -L "$target" ]; then
			# THE BYTES WERE RIGHT, WHICH IS NOT THE SAME AS NOTHING TO DO
			# (#40, finding 2). The `chmod` below has always run on this arm
			# too — the eleven are the one set this installer never got wrong —
			# but the line said `unchanged` over a mode it had just repaired.
			# The mode is asked BEFORE it is stamped, and the line says which
			# of the two happened.
			if mode_is 755 "$target"; then
				verb="already installed at $target (unchanged)"
			else
				verb="already installed at $target (mode restored to 755)"
			fi
			# STAMPED EVERY TIME, AND ITS FAILURE IS A REFUSAL (#48). A copy that
			# is not executable is not a command, and this was the ONE mode stamp
			# in this file with no `die` beside it: under `set -e` a failure here
			# left the shell's own 1, which this toolset spends on "findings were
			# printed", as the answer from a run that was refusing with the
			# commands before it already placed. On THIS arm it is stamped in
			# place — a mode is metadata, and no running copy reads it — and on
			# the other `place_by_rename` stamps the temporary (#167).
			#
			# AND NO OWNERSHIP PREFLIGHT IN FRONT OF IT, which is the decision
			# `unplaceable_kind` already carries — search "WHAT `-w` DOES NOT PROVE"
			# for the whole of it. `[ -O ]` is the question that would catch this
			# first, and it is a guard no test in this suite can reach and one that
			# would refuse a root `--install` into another user's home, where the
			# stamp does in fact succeed. R-A9-15 is the ruling that a guard nobody
			# can test is a guard nobody can rely on, so the stamp's own failure is
			# the refusal, naming the file it could not mode.
			chmod 755 "$target" ||
				die "could not set mode 755 on $target, so that command is not executable.
    Whatever the lines above report is placed; this one has its bytes and not its
    mode, and the skills, the command files and the hook entries are not placed at
    all."
		else
			if [ -e "$target" ]; then verb="updated at $target"; else verb="installed at $target"; fi
			# WRITTEN BESIDE ITSELF AND RENAMED OVER ITSELF, never rewritten in
			# place (#167): a lane tool running from this path finishes on the
			# text it started with. `place_by_rename` says why.
			place_by_rename "$source" "$target" 755 "Whatever the lines above report is placed; the skills, the command files and the
    hook entries are not placed at all."
		fi
		placed=$((placed + 1))
		say "$name: $verb"
	done
	# THE COUNT, out loud: a person reading eight lines cannot tell whether a
	# ninth was meant to be there.
	if [ -z "$PIPX_LINK" ]; then
		say "openRepoTools: $placed of ${#INSTALLABLES[@]} placed in $dir"
	elif pipx_own_run; then
		# BESIDE PIPX'S LINK the count says where the missing one is
		# (contracts/cli-output.md), and from pipx's own environment that is
		# all it says.
		say "openRepoTools: $placed of ${#INSTALLABLES[@]} placed in $dir, and 1 left to pipx"
	else
		# ANY OTHER RUN BESIDE IT — a checkout's, the one-line install's, a
		# package outside pipx's venv — also says where the other sixteen now
		# come from and which release is beside the link (research R5,
		# FR-019): `install_source` and `pipx_release` say why each is spelt so.
		# Their answers come back through the workdir, never a `$(…)`, because
		# this line is between two placements (#318).
		install_source >"$WORKDIR/answer"
		read_answer from "$WORKDIR/answer"
		pipx_release >"$WORKDIR/answer"
		read_answer beside "$WORKDIR/answer"
		say "openRepoTools: $placed of ${#INSTALLABLES[@]} placed in $dir, and 1 left to pipx; the other $placed now come from $from, not from $beside"
	fi
	# THE RETIREMENT IS THE LAST ACT OF THE INSTALL, AFTER EVERY PLACEMENT
	# (Copilot round 7 on #45, `openRepoTools:369`). It is the one DESTRUCTIVE
	# step here, and it ran before `place_skill_and_hook` — so a skill directory
	# or a `settings.json` this run could not write left a workstation with the
	# old word already deleted and the adoption it was migrating to unfinished.
	# Every other refusal in this file places NOTHING rather than half of it; this
	# one removes nothing until the rest of the install has actually happened.
	place_skill_and_hook
	# THE RECEIPT IS WRITTEN BETWEEN THE LAST PLACEMENT AND THE ONE REMOVAL
	# (#57). After the placements, because a row carries the digest of the bytes
	# that are actually at a destination and every destination has to have been
	# written first; before the retirement, because that reads it and then drops
	# the row of anything it removes. A run that REFUSED part way through the
	# placements writes none of it and leaves the header marker as the evidence,
	# which is the population the marker exists for anyway.
	receipt_record
	retire_commands
	# ONE PATH NOTE for everything it placed: the directory is the same one.
	case ":${PATH:-}:" in
	*":$dir:"*) ;;
	*)
		say "  $dir is not on \$PATH. Add it:"
		say "    export PATH=\"$dir:\$PATH\""
		;;
	esac
	venv_note
	# AND LAST, IN A PACKAGE: whether the `openRepoTools` a shell will run is
	# this package's (FR-021). It changes nothing and leaves the exit status.
	path_report
}

# ONE VIRTUAL ENVIRONMENT PER REPOSITORY, OUTSIDE THE ESTATE
# (opensoft/openRepoTools#162, cause 3: "968 of 1,000 removals were dependency
# caches"). `${XDG_CACHE_HOME:-$HOME/.cache}/openRepoTools/venvs/<repo>/` is
# the convention `docs/README-lanes.md` states, and this repository's own is
# NAMED here with its state - and NOT CREATED: making one needs pip and the
# network, and an install from a checkout needs neither. `tests/run.sh` runs
# the suite from it once it is there and has pytest.
venv_note() {
	local venv="${XDG_CACHE_HOME:-$HOME/.cache}/openRepoTools/venvs/openRepoTools"
	local quoted_venv="" quoted_python=""
	if [ -x "$venv/bin/python3" ]; then
		say "openRepoTools: this repository's virtual environment is $venv (present; tests/run.sh runs from it when it has pytest)"
	else
		say "openRepoTools: this repository's virtual environment is $venv (not created; one per repository, outside the estate):"
		# QUOTED FOR THE SHELL IT IS PASTED INTO: `$XDG_CACHE_HOME` is the
		# person's to choose, spaces and all. By `printf -v`, which this shell
		# runs itself, not two `$(…)` in one `say` (#342, the reason is above
		# `remove_workdir`): the same bytes.
		printf -v quoted_venv '%q' "$venv"
		printf -v quoted_python '%q' "$venv/bin/python3"
		say "    python3 -m venv $quoted_venv && $quoted_python -m pip install pytest"
	fi
}


# =========================================================================
# THE FOURTEEN ARTIFACTS THAT ARE NOT BIN-DIRECTORY FILES
# =========================================================================
#
# lane-collision-protocol Amendment 9(b), inheriting A8 Addendum 2's R-A8-5
# unvaried — and that ruling is itself ratified. Measured on Eagle 2026-09-12:
# every `pclaude run` execs with `CLAUDE_CONFIG_DIR=<profile dir>`; 418 profile
# config dirs exist; 0 of them carry a SessionStart hook; and every profile's
# `skills` is a symlink to ONE shared directory. So:
#
#   * EACH SKILL goes to `$CLAUDE_PROFILES_HOME/shared/skills/<name>/SKILL.md`
#     — one write that all 418 profiles read through their own symlinks;
#   * `~/.claude` KEEPS A COPY of each skill for a bare `claude` run outside the
#     launcher, plus ONE MERGED ENTRY in `~/.claude/settings.json`;
#   * THE PROFILE `SessionStart` ENTRY IS NOT THIS COMMAND'S. It stays the
#     launcher's, which already rewrites each profile's settings.json on every
#     run and preserves hook keys. This command never writes a profile's
#     settings.json at all. One path, one writer, in both halves.
#
# TWENTY-NINE ARTIFACTS ALWAYS, PLUS THE TWO HOOK ENTRIES ONCE THEIR TARGET
# ANSWERS, AND THE COUNT IS THE INVARIANT: one file per `INSTALLABLES` name in
# the bin directory, one skill per `SKILLS` name in the shared skills
# directory, its bare-run copy, one command file per `COMMANDS` name at those
# same two paths, and — once
# `~/projects/xFactory/lanes-edit.sh` exists, is executable and answers `guard`
# (opensoft/openRepoTools#237, the launcher's own rule) — TWO merged entries in
# `~/.claude/settings.json`. It was twelve before Amendment 11 added a SECOND
# WORD ON PATH — `restart` then, `lane` since Amendment 18 Addendum 2 retired
# that one — `lanes` and the `/restart` skill, sixteen before ruling 9 added
# `commands/swap.md`, eighteen before Amendment 12 adoption act 3 added the
# `UserPromptSubmit` name guard beside the `SessionStart` entry, and nineteen
# before Amendment 17 added `lane-handoff`, the `handoff` skill and the
# `/handoff` and `/ctx` command files, twenty-six before Amendment 16 added
# `lane-rename`, twenty-seven before opensoft/workBenches#119 added
# `claude-current` and `claude-restart-check`, twenty-nine before
# opensoft/openRepoTools#160 added `lanes-index`, and thirty before
# opensoft/openRepoTools#162 added `lane-worktrees`; #237 then held the last
# two back until the path they call answers, which moves no list. The count
# moves with the lists rather than being restated from memory.
#
# WHY A COMMAND FILE IS HERE AT ALL, WHEN ADOPTION ACT 6 SAYS THE LAUNCHER
# VENDORS THEM (F-X28, A11 Addendum 4 ruling 9, ratified "a11 addendum 4 yes").
# `opensoft/workBenches#74` @`0b7f6bc` deletes the whole `claude/commands` lane
# surface along with the launcher's copy of the `lane-swap` skill — and act 6,
# which would have `--install` inherit the command files, comes AFTER act 3,
# which is this PR's base. So on the day 4b lands, clause (g)'s `/swap` — a
# RATIFIED decision, and one of the six edits to in-force text — would be
# installed by NOBODY. The alternative was a PR of its own between now and then,
# and the ruling took this one.

#: THE SKILLS THIS REPOSITORY SHIPS, each placed at the same two paths. A
#: skill's DIRECTORY NAME is what `/<name>` invokes, so the list is the names
#: and every path is derived from one.
#:
#: `restart` joins `lane-swap` under Amendment 11 clause (f) and ratified
#: decision 7: `/restart` is the INSIDE half and `lane <name>` on `PATH` is the
#: outside one (Amendment 18 Addendum 2 retired `restart` from the PATH and
#: moved its act to that word), and the inside half has to be a skill because a
#: running session cannot `exec` a launcher over itself.
SKILLS=(handoff lane-swap restart)
skill_source_path() { printf 'skills/%s/SKILL.md\n' "$1"; }

#: THE COMMAND FILES THIS REPOSITORY SHIPS, each placed at the same two paths a
#: skill is (A11 Addendum 4 ruling 9). A command file's BASENAME is what
#: `/<name>` invokes, so the list is the names and every path is derived from
#: one — the same shape `SKILLS` has, for the same reason.
#:
#: `swap` is clause (g)'s ratified alias: `/swap` invokes the `lane-swap` skill
#: and adds nothing to it. The file is vendored BYTE FOR BYTE from
#: `opensoft/workBenches#71`, which is where it was written, because two copies
#: of one procedure that must stay byte-equal is the alternative that clause
#: rejects by name — and `#74` deletes that copy, which is why this one exists.
COMMANDS=(handoff ctx swap)
command_source_path() { printf 'commands/%s.md\n' "$1"; }
#: Kept as a single name for the one thing that is still singular: the
#: `SessionStart` hook's own entry, which belongs to the handoff skill's
#: amendment and not to the skill set. The name moved with the skill under
#: Amendment 17(a) — one act, three names — and the ENTRY it keys is unchanged,
#: because its only idempotence is the exact command string.
SKILL_NAME="handoff"
SKILL_SOURCE_PATH="$(skill_source_path "$SKILL_NAME")"

skills_home() { printf '%s\n' "${CLAUDE_PROFILES_HOME:-$HOME/.claude-profiles}"; }
claude_home() { printf '%s\n' "${CLAUDE_USER_DIR:-$HOME/.claude}"; }

#: THE HOOK ENTRY, byte for byte Amendment 8 clause (e)'s and byte for byte
#: what opensoft/workBenches#63's launcher ensures in each profile. The string
#: is the ONLY idempotence any of the three places has — a re-formatted
#: quotation of a string whose only idempotence is exact match is a SECOND
#: string — so it is spelled once here and never rebuilt.
HOOK_COMMAND='~/projects/xFactory/lanes-edit.sh session-start || true'
HOOK_MATCHER='startup|resume|clear|fork'
HOOK_TIMEOUT=5

hook_block_text() {
	cat <<'BLOCK'
  {
    "matcher": "startup|resume|clear|fork",
    "hooks": [
      { "type": "command", "command": "~/projects/xFactory/lanes-edit.sh session-start || true", "timeout": 5 }
    ]
  }
BLOCK
}

#: THE SECOND HOOK — lane-collision-protocol AMENDMENT 12's NAME GUARD, adoption
#: act 3 (opensoft/openRepoTools#25). Same shape, same file, same all-or-nothing
#: merge, and TWO deliberate differences from the entry above:
#:
#:   * NO `|| true`. On `SessionStart` that suffix is the whole safety property —
#:     a hook that dies must not break the session it was meant to orient. On
#:     `UserPromptSubmit` it would be the OPPOSITE of the mechanism: exit 2 is
#:     what BLOCKS a prompt (code.claude.com/docs/en/hooks), and `cmd || true`
#:     exits 0 for every code the command can produce. Copying the string with
#:     its suffix would have installed a guard that refuses nothing, silently,
#:     which is the exact state Amendment 12 exists to end.
#:   * NO MATCHER. `UserPromptSubmit` has no source to match on; the `matcher`
#:     key belongs to the events that do.
#:
#: The `~/projects/xFactory/lanes-edit.sh` spelling is the estate's convention
#: and `link-estates` places that link — the same path the entry above uses, so
#: one workstation has one spelling of one file.
GUARD_COMMAND='~/projects/xFactory/lanes-edit.sh guard'
GUARD_TIMEOUT=5

guard_block_text() {
	cat <<'BLOCK'
  {
    "hooks": [
      { "type": "command", "command": "~/projects/xFactory/lanes-edit.sh guard", "timeout": 5 }
    ]
  }
BLOCK
}

#: THE GATE ON THE PAIR (opensoft/openRepoTools#237, opensoft/workBenches#107).
#: Both entries call `~/projects/xFactory/lanes-edit.sh`, a symlink `link-estates`
#: places — and on a fresh workstation only `openRepoTools wip init` runs that,
#: AFTER this install. Merged before the link exists, the guard is a command that
#: is not there at every prompt: exit 127, a hook error per prompt, and never the
#: refusal (exit 2) it is for. So the pair is merged only once that path EXISTS,
#: IS EXECUTABLE AND ANSWERS `guard`, by the probe opensoft/workBenches'
#: `claude-profile` launcher puts to the same path before it ensures the same two
#: strings in each profile: the `awk` below is that probe byte for byte — comment
#: lines dropped, the case arm anchored where a line begins, one process and no
#: pipe. The `-x` is the one test it adds, because a file that is there and not
#: executable fails the hook the same way (exit 126).
#:
#: UNTIL THEN THE PAIR IS DEFERRED, AND EVERY RUN SAYS SO, with the remedy.
#: Nothing is added, and OUR EXACT GUARD ENTRY, in a file that already carries
#: it, is taken out — the launcher's own downgrade (workBenches#90), filtered on
#: each entry's NESTED array (workBenches#89), so every other hook, grouped with
#: ours or not, stays where it is, and the file is written back at 600. The
#: `SessionStart` entry is LEFT where it is: it ends in `|| true` and cannot fail
#: a session, which is the launcher's rule too. The strings, their exact-match
#: identity, the rival refusal and the receipt do not move; the count does —
#: twenty-nine artifacts always, plus these two once the path answers.
#:
#: `$HOME/projects`, and not `$PROJECTS_DIR`: the `~` in both strings is the
#: harness's to expand, so that is the one directory the hooks ever run from.
hook_target() { printf '%s\n' "$HOME/projects/xFactory/lanes-edit.sh"; }

HOOK_TARGET_WHY=""
hook_target_answers() {   # 0 when the pair may be merged; 1 with $HOOK_TARGET_WHY set
	local target
	target="$(hook_target)"
	HOOK_TARGET_WHY=""
	if [ ! -e "$target" ]; then
		if [ -L "$target" ]; then
			HOOK_TARGET_WHY="${target} is a symlink to $(readlink -- "$target" 2>/dev/null || :), which does not resolve (it is not there, or the links loop)"
		elif [ -d "$HOME/projects/xFactory" ]; then
			HOOK_TARGET_WHY="${target} is not there"
		else
			HOOK_TARGET_WHY="${target} is not there (nor is $HOME/projects/xFactory, which \`link-estates\` links it into)"
		fi
		return 1
	fi
	if [ ! -f "$target" ]; then
		HOOK_TARGET_WHY="${target} is not a regular file"
		return 1
	fi
	if [ ! -x "$target" ]; then
		HOOK_TARGET_WHY="${target} is not executable"
		return 1
	fi
	# A SCRIPT THAT CANNOT BE READ CANNOT BE RUN, and the probe below cannot
	# read it either: without this, mode 111 read as "no `guard` subcommand".
	if [ ! -r "$target" ]; then
		HOOK_TARGET_WHY="${target} is not readable"
		return 1
	fi
	if ! awk '
		/^[[:space:]]*#/ { next }
		/^[[:space:]]*([A-Za-z0-9_-]+\|)*guard(\|[A-Za-z0-9_-]+)*\)/ { found=1; exit }
		END { exit !found }
	' "$target" 2>/dev/null; then
		HOOK_TARGET_WHY="${target} has no \`guard\` subcommand"
		return 1
	fi
	return 0
}

#: The remedy every deferral and every removal prints, in one place.
hook_pair_remedy() {
	# WITH NO `~/projects/xFactory` THE REMEDY BELOW LOOPS: `link-estates` links
	# into that directory only where it exists, so a re-run alone changes
	# nothing. That is said first, where it is the case.
	if [ ! -d "$HOME/projects/xFactory" ]; then
		say "  ~/projects/xFactory has to exist first: \`link-estates\` links that path only into it."
	fi
	say "  The pair is merged once that path answers \`guard\`: \`openRepoTools wip init\` runs"
	say "  \`link-estates\`, which links it where ~/projects/xFactory exists, and then merges"
	say "  the pair; or run \`link-estates\` yourself and \`openRepoTools --install\` again."
}

# EVERY SKILL'S BYTES, by `--install`'s own rule: from the checkout beside this
# file when run from one, else fetched at this same ref. ALL OF THEM IN HAND
# BEFORE ANY IS PLACED, which is the same all-or-nothing rule the seventeen files
# already have — a new `/restart` beside a `handoff` that could not be fetched
# is a half-install that reads like a whole one.
collect_skills() {
	local name src
	payload_select
	workdir
	for name in "${SKILLS[@]}"; do
		src="$(skill_source_path "$name")"
		if [ -n "$PAYLOAD_DIR" ] && [ -f "$PAYLOAD_DIR/$src" ]; then
			cp -- "$PAYLOAD_DIR/$src" "$WORKDIR/skill-$name.md"
			continue
		fi
		[ "$PAYLOAD_MODE" != local ] || return 1
		fetch_from_repo "$src" "$WORKDIR/skill-$name.md" || return 1
	done
	# THE COMMAND FILES IN THE SAME BREATH, under the same all-or-nothing rule
	# (ruling 9). A `/swap` that could not be fetched beside a `/lane-swap` that
	# could is a half-install of an ALIAS PAIR, which is worse than either
	# alone: the skill is installed, the alias the text ratifies is not, and
	# nothing on screen says which.
	for name in "${COMMANDS[@]}"; do
		src="$(command_source_path "$name")"
		if [ -n "$PAYLOAD_DIR" ] && [ -f "$PAYLOAD_DIR/$src" ]; then
			cp -- "$PAYLOAD_DIR/$src" "$WORKDIR/command-$name.md"
			continue
		fi
		[ "$PAYLOAD_MODE" != local ] || return 1
		fetch_from_repo "$src" "$WORKDIR/command-$name.md" || return 1
	done
	return 0
}

# THE TWO MERGES INTO `~/.claude/settings.json`, COMPUTED BEFORE ANYTHING IS
# PLACED. It is the same all-or-nothing rule `--install` already has, extended
# to the two artifacts that are not whole files: a merge that cannot be
# computed refuses having placed nothing — and since Amendment 12 adoption act
# 3 the rule covers the PAIR, because a settings file that took the
# `SessionStart` entry and refused the `UserPromptSubmit` guard is a half
# install of a hook pair and nothing on screen would say which half.
#
#   * it is written with `jq`, and refuses naming `jq` where it is absent. This
#     repository carries no JSON-handling code otherwise, so the dependency is
#     named rather than assumed. It is not bash, so the macOS bash-3.2 parse
#     gate is unaffected;
#   * it NEVER writes the file whole and never replaces it: the file already
#     carries a `UserPromptSubmit` hook of the person's own — the usage guard
#     — and a user's settings are not an installer's to own. THAT IS WHY THE
#     `UserPromptSubmit` ARM KEYS ON THE VERB `guard` AS A WHOLE ARGUMENT and
#     not as a substring: this command adds an entry to an event a person is
#     already using, and every entry already there stays exactly where it is;
#   * it is idempotent by EXACT MATCH on the entry's `command` string;
#   * an entry under SessionStart whose `command` DIFFERS, one under
#     UserPromptSubmit that RUNS `guard` with a different string, a file it
#     cannot parse, or a `hooks` value that is not an object → refuse, print
#     the exact block, place nothing. An installer that repairs a file it does
#     not understand is how a person loses a setting they meant;
#   * it WRITES THE FILE BACK AT MODE 600 — it sets that mode, it does not
#     preserve one (F8 of the #24 review: a pre-existing file at 640 comes out
#     600, measured). workBenches' setup-claude-profiles.sh writes this same
#     file on every ./setup.sh through jq + mktemp + chmod 600 + mv -f, so 600
#     is the mode this file already has on a host that has run that script, and
#     an installer that widened it would be silently undone or would widen it
#     behind that script's back.
HOOK_PLAN=""      # "absent" | "present" | "nofile"
GUARD_PLAN=""     # the same three, for Amendment 12's UserPromptSubmit entry
HOOK_MERGED=""    # a staged whole file, ready to move into place
HOOK_DEFERRED=""  # the same file with OUR guard entry taken out, or "" (#237)
HOOK_STRIP_WHY="" # why that entry could not be taken out, or ""

# THE DESTINATIONS, PROVED WRITABLE BEFORE ANY OF THE SEVENTEEN IS PLACED — every
# directory the artifacts that are not one of the seventeen files go into, derived
# from the two lists and NOT counted in this sentence. It said "THE THREE
# DESTINATIONS" while the loop below built seven of them, which is the same
# defect `collect_commands` names above: a number restated beside a list that
# grew is a number that goes stale where nobody is looking.
#
# Amendment 9(b) computes the merge in hand "so a merge that cannot be computed
# refuses having placed nothing" — and the merge computing fine against a
# directory nobody may write to is the same failure one step later. A
# filesystem gives no transaction, so this cannot make those placements
# atomic; what it does is move the failure that actually happens — a directory
# that is not ours to write — back to the planning phase, where the refusal
# still costs nothing. IT MAKES NONE OF THEM: the question is put to the nearest
# ancestor that exists, so a run that refuses leaves a machine exactly as it
# found it, and the placement's own guarded `mkdir -p` is the one writer of
# these directories (#44 round 1, Sourcery's
# `tests/test_install_skill_and_hook.py:658`).
plan_skill_targets() {
	local d name dirs=() target kind bad="" paths="" profiles="" claude_dir=""
	# THE TWO HOMES ARE TAKEN ONCE, each by a `$(…)` of its own, so no list
	# below holds two (#342, the reason is above `remove_workdir`).
	profiles="$(skills_home)"
	claude_dir="$(claude_home)"
	for name in "${SKILLS[@]}"; do
		dirs+=("$profiles/shared/skills/$name" "$claude_dir/skills/$name")
	done
	# A COMMAND FILE HAS NO DIRECTORY OF ITS OWN — it is a file in the commands
	# directory, where a skill is a `SKILL.md` in a directory named for it — so
	# the two command destinations are added once rather than once per name.
	if [ "${#COMMANDS[@]}" -gt 0 ]; then
		dirs+=("$profiles/shared/commands" "$claude_dir/commands")
	fi
	dirs+=("$claude_dir")
	for d in "${dirs[@]}"; do
		if kind="$(unusable_dir_kind "$d")"; then
			die "\`--install\` places a skill, a command file or the SessionStart entry in
    $d (Amendment 9(b)), and $kind.
    NOTHING was installed and nothing already installed was replaced."
		fi
	done
	# AND THE SIX FILES INSIDE THEM, BY R-A9-12 (F-X17). The loop above proved
	# the DIRECTORIES writable and stopped there, while `place_skill_and_hook`
	# then reaches each `SKILL.md` with `[ -e ]`, `cmp -s` and `cp` — not one of
	# which can tell a regular file from a link to one. So a symlink at
	# `~/.claude/skills/restart/SKILL.md` was followed and WRITTEN THROUGH: the
	# skill stays uninstalled, the target stays a link, and the bytes land
	# wherever it points. That is the same failure R-A9-12 was ruled on for the
	# seventeen in the bin directory, one directory along, and the ruling says
	# nothing about which path it applies to.
	#
	# `unplaceable_kind` is asked rather than re-tested, because two copies of
	# one rule is how the bin half would come to refuse a dangling link and the
	# skill half would not — and that is exactly what happened to the second
	# half of the question it answers: a target that IS a regular file and is
	# not this user's to write (#40, finding 4). The eleven were already placed
	# by the time `cp` met it, on the one path that promises all or none, so the
	# `-w` is asked here beside the `-L`.
	#
	# BOTH QUESTIONS OUTLIVE THE `cp` (#167). The write is a rename now, which
	# follows no link and needs the DIRECTORY's write bit rather than the
	# file's — so neither target would FAIL any more; each would be REPLACED,
	# without a word. A link is somebody's link, and swapping it for a regular
	# file unasked is the same act as writing through it, in the other
	# direction (the receipt's own rule, `receipt_replace`); a read-only file
	# is somebody saying "not this one". The refusal is the same refusal.
	for name in "${SKILLS[@]}"; do
		for target in "$profiles/shared/skills/$name/SKILL.md" "$claude_dir/skills/$name/SKILL.md"; do
			kind="$(unplaceable_kind "$target")" || continue
			bad="${bad:+$bad
}    $target — $kind"
			paths="${paths:+$paths }\"$target\""
		done
	done
	for name in "${COMMANDS[@]}"; do
		for target in "$profiles/shared/commands/$name.md" "$claude_dir/commands/$name.md"; do
			kind="$(unplaceable_kind "$target")" || continue
			bad="${bad:+$bad
}    $target — $kind"
			paths="${paths:+$paths }\"$target\""
		done
	done
	[ -z "$bad" ] || die "\`--install\` places a REGULAR FILE IT CAN WRITE at each of these skill and
    command targets, and these are not that:
$bad
    Each file is placed by renaming a new copy over its path, so installing
    over a symlink would replace somebody's link with a regular file, over a
    directory would put the file inside it, and over a file this user cannot
    write would replace a file somebody made read-only — none of it asked for.
    NOTHING was installed and nothing already installed was replaced.
    Clear them, then re-run — \`rm -f\` takes a read-only file, because what a
    removal needs is the DIRECTORY's write bit and not the file's:
        rm -f -- $paths"
}

# THE SEVENTEEN TARGETS, PROVED PLACEABLE BEFORE ANY OF THE THIRTY-ONE IS PLACED
# (A9 Addendum 4, R-A9-12, ruled on F5 of the #24 review).
#
# `cp` FOLLOWS A SYMLINK. The loop below tested `[ -e "$target" ]`, compared
# with `cmp -s` and then copied, and not one of the three can tell a regular
# file from a link to one — so against the bin directory the pre-move
# `link-estates` actually leaves on a workstation, `--install` printed
# `lane-start: updated at …`, `9 of 9 placed`, exit 0, and BOTH claims were
# false: the target stayed a symlink, so the command was never installed, and
# the post-move bytes landed in `opensoft/brett-wip`'s WORKING TREE on the
# other end of it. That repository is the one every lane writes:
# `lanes-edit.sh`'s `refuse_dirty_checkout` then refuses `log`, `claim` and
# `release` on that workstation until somebody runs `git checkout -- lanes/`.
# workBenches' `setup-estate-commands.sh` refuses the whole estate install on a
# target that "already exists as a symlink" too, so a host in this state also
# fails the estate install that follows — the exact failure clause (f)(3) is
# written about.
#
# THE REFUSAL OUTLIVES THE `cp` (#167). The loop places by RENAME now, which
# follows no link: it would swap the link itself for a regular file, without a
# word, which is the same act in the other direction — the person's link gone
# and nothing on screen saying so. `plan_skill_targets` says the same of the
# files it walks.
#
# A HOST STILL CARRYING THOSE SYMLINKS IS THE NORMAL PRE-ACT-5 CASE, not an
# exotic one: adoption act 6 clears them on each workstation before the first
# `--install` that carries this, and act 5 strips `brett-wip` to data. So the
# refusal names every offending path, says what each one IS, and prints the one
# `rm` that clears them — rather than leaving a person to remember a step.
# WHAT IS AT A PATH, WHERE IT IS NOT A REGULAR FILE.
# ONE implementation of R-A9-12's test, for every path this command writes: the
# seventeen in the bin directory, the six `SKILL.md`s (F-X17), the six command
# files, and `~/.claude/settings.json` (#44 round 1, `openRepoTools:878`).
# Prints what is there and returns 0; returns 1 — saying nothing — where the
# path is absent or is a regular file.
#
# `-L` AS WELL AS `-e`, because a DANGLING symlink is the sharper case: `[ -e ]`
# is false on one, so it reads as ABSENT. `cp` through it created the file at the
# far end — a write into a repository this command was never told about — and
# the rename that replaced `cp` (#167) would swap the link for a file unasked.
#
# IT IS ASKED APART FROM THE `-w`, because the `-w` is not asked of every path.
# Every write here is a rename since #167, and a rename needs the DIRECTORY's
# write bit and never the file's: `unplaceable_kind` asks the file's own `-w` of
# the files this installer owns, as a person's "not this one", while the
# SessionStart merge — which has always replaced `settings.json` through
# `mktemp` + `mv -f` — merges into one this user cannot write. A single walk that
# asked `-w` of all three would refuse an install that works.
path_kind() {   # <path>
	local t="$1"
	if [ -L "$t" ]; then
		printf 'a symlink to %s' "$(readlink -- "$t" 2>/dev/null || printf '<unreadable>')"
		return 0
	fi
	if [ -d "$t" ]; then
		printf 'a directory'
		return 0
	fi
	if [ -e "$t" ] && [ ! -f "$t" ]; then
		printf 'not a regular file'
		return 0
	fi
	return 1
}

# AND WHETHER IT MAY BE WRITTEN OVER: `-w` as well as `-f` (#40, finding 4).
# This answered "a regular file" with `return 1` and asked nothing else, so
# every existing file counted as one `--install` may place over — and
# `plan_skill_targets` let a READ-ONLY `SKILL.md` or command file through.
# `install_commands` has already copied the seventeen PATH files by the time
# `place_skill_and_hook` reaches the `cp`, so an ordinary permission failure
# there left a host with seventeen of the thirty-one artifacts placed, on the one
# path in this file that promises all or none. A mode is not an exotic state
# either: `chmod 444` on a file a person did not want overwritten is what a
# person does.
#
# THAT LAST SENTENCE IS NOW THE WHOLE REASON (#167). The write is a rename, which
# needs the directory's write bit and not the file's, so a read-only target would
# no longer FAIL half way — it would be replaced without a word. The question
# stays, so that a person's `chmod 444` is still the refusal it was.
#
# WHAT `-w` DOES NOT PROVE IS THAT THE MODE STAMP CAN SUCCEED, and that limit is
# deliberate (#44 round 1, the suppressed comment at `openRepoTools:635`). A
# GROUP-WRITABLE file owned by another account passes `-w` and refuses the
# `chmod` where the stamp is made IN PLACE — the arm whose bytes were already
# right; the arm that writes stamps its own temporary (#167) — and the question
# that would settle it — `[ -O ]`, this euid against
# the file's owner — is one no test in this suite can put: `tmp_path` cannot
# make a second account, and it would refuse a root `--install` into another
# user's home, where the `chmod` does in fact succeed. A guard no test reaches
# is the guard R-A9-15 was ruled about, so this asks what it can prove and the
# stamp's own failure stays a `die` naming the artifact it could not mode.
#
# THE REFUSAL'S ONE REMEDY STAYS TRUE OF THE NEW KIND, which is why it is
# answered here rather than in a second walk: `rm -f` takes a read-only file —
# what a removal needs is the DIRECTORY's write bit, not the file's — so the
# `rm -f -- <paths>` both planners print clears every path either of them names.
unplaceable_kind() {   # <target>
	local t="$1" kind
	if kind="$(path_kind "$t")"; then
		printf '%s' "$kind"
		return 0
	fi
	if [ -f "$t" ] && [ ! -w "$t" ]; then
		printf 'a regular file this user cannot write'
		return 0
	fi
	return 1
}

# WHETHER A DIRECTORY THIS RUN MUST CREATE A FILE IN CAN TAKE ONE — asked of the
# NEAREST ANCESTOR THAT EXISTS, because a directory that is not there yet is
# exactly as placeable as the directory it would be created in (#44 round 1,
# `openRepoTools:653`, and Sourcery's `README.md:237`). `plan_install_targets`
# asked `[ -d "$dir" ]` first and so asked NOTHING AT ALL where the answer was
# "not yet": a `$OPENREPOTOOLS_BIN_DIR` under a parent this user cannot write
# passed planning and met the `mkdir -p` in `install_commands`, which died with
# the shell's own 1 under `set -e` — the code this toolset spends on "findings
# were printed" — instead of the refusal this phase exists to print.
#
# `-x` AS WELL AS `-w`, because creating a file in a directory takes both of its
# bits (#44 round 1, the suppressed comment at `openRepoTools:658`): a directory
# at 0600 accepts no new file at all, and `-w` alone passed it. ONE
# implementation for the bin directory and for the seven destinations
# `plan_skill_targets` walks, for the reason `unplaceable_kind` is one: two
# copies of one rule is how the bin half comes to refuse what the skill half
# allows.
#
# AND IT CREATES NOTHING. `plan_skill_targets` proved a directory writable by
# `mkdir -p`-ing it first, so a run that then REFUSED had already left seven
# directories on a machine that had none — which is not what "NOTHING was
# installed" says (#44 round 1, Sourcery's
# `tests/test_install_skill_and_hook.py:658`). Every place this command writes
# into is made in the PLACEMENT phase, by the guarded `mkdir -p` each `cp`
# already carries.
#
# `-L` STOPS THE WALK TOO, not only `-e` (#44 round 2, `openRepoTools:701`).
# `-e` follows a symlink, so it is FALSE on a DANGLING one — the walk read
# that as "not there yet" and stepped past it to ask about ITS parent instead,
# so a dangling `skills_home` or bin-directory ancestor passed this planner and
# met `mkdir -p` after other artifacts were already placed, on the one path
# that promises all or none. A symlink, dangling or not, is something AT that
# path; the walk stops at the nearest one of those, exactly as it stops at the
# nearest directory, file or anything else that is there.
unusable_dir_kind() {   # <directory>
	local d="$1" up
	while [ ! -e "$d" ] && [ ! -L "$d" ]; do
		up="$(dirname -- "$d")"
		[ "$up" != "$d" ] || break
		d="$up"
	done
	if [ -L "$d" ] && [ ! -e "$d" ]; then
		printf '%s is a symlink to %s, which is not there' "$d" \
			"$(readlink -- "$d" 2>/dev/null || printf '<unreadable>')"
		return 0
	fi
	if [ ! -d "$d" ]; then
		printf '%s is not a directory' "$d"
		return 0
	fi
	if [ ! -w "$d" ]; then
		printf '%s is not writable' "$d"
		return 0
	fi
	if [ ! -x "$d" ]; then
		printf '%s is not searchable (a create takes its `x` bit as well as its `w`)' "$d"
		return 0
	fi
	return 1
}

# ------------------------------------------------------------- PIPX'S LINK
#
# opensoft/openRepoTools#228, User Story 1: `specs/006-release-pypi/contracts/
# pipx-link.md` is the rule and `contracts/cli-output.md` the exact lines (the
# change's design.md Decision 6). `pipx install openrepotools` places ONE
# command, `<dir>/openRepoTools`, as a symbolic link into its own venv, and that
# link may be the only `openRepoTools` on the workstation that can run
# `--install` at all. So it is the one link `--install` LEAVES WHERE IT IS: it
# is skipped, said out loud, counted as left to pipx, and given no receipt row
# (`receipt_add` writes none for a link); no refusal lists it and no line ever
# advises its `rm`. `retire_commands` never meets it, because `RETIRED` does not
# hold `openRepoTools`.
#
# IT IS DECIDED FROM PATHS AND THE EXISTENCE OF FILES, AND FROM NOTHING ELSE. No
# JSON is parsed, so it needs no `jq` and is decided before the `jq` check,
# which stays where it is (FR-018); `PIPX_HOME` is never read, so it holds under
# every home pipx uses — `$PIPX_HOME`, `~/.local/pipx`, `~/.local/share/pipx`
# and macOS's `~/Library/Application Support/pipx`, whose SPACE is why every
# expansion here is quoted. And it holds in every mode: the package's own
# `--install`, a checkout's and the one-line install's.
#
# A LINK THAT LOOKS LIKE A VENV AND FAILS THE RULE — a later pipx layout, or a
# `pip install` into a plain venv — is still refused, because it is not provably
# pipx's. It is named for what it is, and NO `rm` IS PRINTED FOR IT: removing it
# may remove the only command that can run `--install` (ADV3, SC-006).

PIPX_LINK=""      # <dir>/openRepoTools, once it is known to be pipx's link
PIPX_VENV=""      # the canonical venv that link resolves into
PIPX_PAYLOAD=""   # that venv's canonical lib/python*/site-packages/openrepotools/payload

#: EVERY LINK FOLLOWED, BY PLAIN `readlink`, which prints a link's own value on
#: Linux, macOS and BSD alike: `readlink -f` is not in a stock macOS userland and
#: neither is `realpath`. A relative value is joined to the LINK'S OWN directory,
#: as the kernel reads it. Past 40 hops — a longer chain, or a cycle — it fails,
#: and such a path is not pipx's link, whatever it ends at. Then the last path's
#: DIRECTORY is canonicalised with `cd -P` and `pwd -P`, its own name kept, so
#: the answer is one spelling of one file. `CDPATH` is emptied, because a `cd`
#: through one prints where it went. Nothing outside it is read, because the PATH
#: report reuses it and the suite cuts it out to run alone (`installer_function`).
link_resolve() {   # <path> — its canonical path with every link followed; 1 past 40 hops
	local p="$1" v="" dir="" hops=0
	while [ -L "$p" ]; do
		hops=$((hops + 1))
		[ "$hops" -le 40 ] || return 1
		v="$(readlink -- "$p")" || return 1
		case "$v" in
		/*) ;;
		*) v="$(dirname -- "$p")/$v" ;;
		esac
		p="$v"
	done
	dir="$(CDPATH= cd -P -- "$(dirname -- "$p")" 2>/dev/null && pwd -P)" || return 1
	printf '%s/%s\n' "${dir%/}" "${p##*/}"
}

#: PACKAGE MODE, FROM PATHS (design.md Decision 4): this file's directory,
#: resolved with `cd -P` and `pwd -P`, is named `payload`, its parent is named
#: `openrepotools`, and that parent holds a regular `_release.py` — the layout an
#: installed wheel of this package has, and no other. A checkout's directory is
#: its root, and the one-line install runs from a pipe or from a placed file in
#: `<dir>`, so neither ever matches. Prints that directory, or returns 1.
#:
#: `package_init` asks it once, before the arguments are read, and keeps the
#: answer in PACKAGE_DIR: the payload directory, canonical, in package mode, and
#: empty in a checkout or the one-line install. It is set here, so that nothing
#: in the environment can set it.
PACKAGE_DIR=""
package_payload_dir() {
	local here="" parent=""
	[ -f "$SELF" ] || return 1
	here="$(CDPATH= cd -P -- "$(dirname -- "$SELF")" 2>/dev/null && pwd -P)" || return 1
	[ "${here##*/}" = payload ] || return 1
	parent="${here%/*}"
	[ "${parent##*/}" = openrepotools ] && [ -f "$parent/_release.py" ] || return 1
	printf '%s\n' "$here"
}

#: STEPS 1 TO 3 OF THE RULE, which the match and the venv-shaped refusal share:
#: <target> is a symbolic link, it resolves, and what it resolves to is a regular
#: file named `openRepoTools` in a directory named `bin`. Prints that `bin`'s
#: parent — the venv, as far as a path can say — which is canonical because the
#: resolution is.
link_venv() {   # <target> — the venv it links into, or 1
	local resolved="" bin="" venv=""
	[ -L "$1" ] || return 1
	resolved="$(link_resolve "$1")" || return 1
	[ -f "$resolved" ] && [ "${resolved##*/}" = openRepoTools ] || return 1
	bin="${resolved%/*}"
	[ "${bin##*/}" = bin ] || return 1
	venv="${bin%/*}"
	printf '%s\n' "${venv:-/}"
}

#: PIPX'S LINK (FR-015): steps 1 to 3, then the two things only pipx's venv of
#: this package holds — a regular `pipx_metadata.json` beside its `bin/`, of
#: which nothing but its EXISTENCE is read, and a regular `openRepoTools` in some
#: `lib/python*/site-packages/openrepotools/payload` under it. The glob is looped
#: over with a `-f` test, because bash leaves a glob that matches nothing as its
#: own text. A match records the three values the run reads, and nothing else.
#:
#: THE RULE IS ASKED IN A `( … )` SUBSHELL, AND ITS ANSWER COMES BACK THROUGH THE
#: WORKDIR (#318). `link_venv` and the payload's canonical spelling are answers
#: taken with `$(…)`, and a SIGINT the shell takes while it waits for a `$(…)`
#: can be lost (search "A `$(…)` IS NOT A PLAIN COMMAND"); the placement loop
#: asks this on every `--install`, at `openRepoTools`' own turn. Asked by
#: `pipx_link_paths` inside the subshell, every one of those waits is the
#: subshell's, and the shell waits for the subshell as for a plain command. It
#: prints the venv and the payload, each ended by a NUL, which no path holds,
#: so both come back exactly as their `$(…)` gave them. Planning asks this
#: before anything else has made the workdir, so this makes it.
pipx_link_match() {   # <dir>/openRepoTools — 0 with PIPX_LINK, PIPX_VENV and PIPX_PAYLOAD set, else 1
	local venv="" canonical=""
	workdir
	( pipx_link_paths "$1" ) >"$WORKDIR/answer" || return 1
	{ IFS= read -r -d '' venv && IFS= read -r -d '' canonical; } <"$WORKDIR/answer" ||
		return 1
	PIPX_LINK="$1" PIPX_VENV="$venv" PIPX_PAYLOAD="$canonical"
	return 0
}
pipx_link_paths() {   # <dir>/openRepoTools — its venv and payload, each ended by a NUL, else 1
	local venv="" payload="" canonical=""
	venv="$(link_venv "$1")" || return 1
	[ -f "${venv%/}/pipx_metadata.json" ] || return 1
	for payload in "${venv%/}"/lib/python*/site-packages/openrepotools/payload; do
		[ -f "$payload/openRepoTools" ] || continue
		canonical="$(CDPATH= cd -P -- "$payload" 2>/dev/null && pwd -P)" || continue
		printf '%s\0%s\0' "$venv" "$canonical"
		return 0
	done
	return 1
}

#: A LINK INTO A PYTHON ENVIRONMENT THAT FAILS THE RULE: steps 1 to 3 hold, the
#: venv holds a regular `pyvenv.cfg`, as every venv does, and the whole match
#: does not hold. Prints the venv, for the refusal to name. The match is asked in
#: a subshell, so that asking it here records nothing.
venv_shaped_link() {   # <dir>/openRepoTools — the venv, or 1
	local venv=""
	venv="$(link_venv "$1")" || return 1
	[ -f "${venv%/}/pyvenv.cfg" ] || return 1
	if (pipx_link_match "$1"); then return 1; fi
	printf '%s\n' "$venv"
}

#: PIPX'S OWN ENVIRONMENT (research R5): a package-mode run whose payload,
#: PACKAGE_DIR, is under the venv pipx's link resolves into. Both paths are
#: canonical, so this compares one spelling of each.
pipx_own_run() {
	[ -n "$PIPX_VENV" ] && [ -n "$PACKAGE_DIR" ] || return 1
	case "$PACKAGE_DIR/" in
	"${PIPX_VENV%/}"/lib/*) return 0 ;;
	esac
	return 1
}

#: WHERE THE OTHER SIXTEEN NOW COME FROM, for the count line of every run beside
#: pipx's link but pipx's own (research R5). A PACKAGE names its own release,
#: from the stamp `package_init` read, in a pipx venv or not: it placed its own
#: payload and fetched from nothing, so `$REPO @ $REF` would name a source it
#: never used. A checkout and the one-line install name the source they
#: collected from, `payload_where`'s pair with `@` in place of `at`. An adopted
#: source mounted in a local assembly fetches nothing and so sets no
#: PAYLOAD_REPO or PAYLOAD_REV: the pin its payload was checked against names
#: that same pair there.
install_source() {
	if [ -n "$PACKAGE_DIR" ]; then
		printf 'openrepotools %s\n' "$STAMP_VERSION"
	elif [ "$SOURCE_LAYOUT" = adopted ]; then
		printf '%s @ %s\n' "${PAYLOAD_REPO:-${PIN_SOURCE_REPOSITORY-}}" "${PAYLOAD_REV:-${PIN_COMMIT-}}"
	else
		printf '%s @ %s\n' "$REPO" "$REF"
	fi
}

#: WHAT IS BESIDE PIPX'S LINK, for the same line: `openrepotools <VERSION>` of
#: the stamp beside pipx's payload, `0.0.0` where it is unstamped. It is read in
#: a SUBSHELL, because `stamp_read` sets the STAMP_* values and this run's own
#: are the ones `install_source` names. A stamp there that fails the reader is
#: another install's, not this one's, so it refuses nothing: the clause says it
#: cannot be read, and the install goes on. The subshell is a `( … )` whose
#: answer comes back through the workdir, not a `$(…)`, because the count line
#: that asks is between two placements (#318).
pipx_release() {
	local version=""
	if ( stamp_read "${PIPX_PAYLOAD%/*}/_release.py" && printf '%s' "$STAMP_VERSION" ) >"$WORKDIR/release"; then
		read_answer version "$WORKDIR/release"
		printf 'openrepotools %s\n' "$version"
	else
		printf '%s\n' "the openrepotools beside pipx's link, whose stamp cannot be read"
	fi
}

#: `^from openrepotools(\.[A-Za-z_][A-Za-z0-9_]*)* import ` by `case`, the
#: import pip's console-script template writes for the entry point at column 0.
#: The name characters are written out, for the reason ORT_ALNUM gives.
pip_imports_entry() {   # <line>
	local rest="" name=""
	case "$1" in "from openrepotools"*) ;; *) return 1 ;; esac
	rest="${1#from openrepotools}"
	while :; do
		case "$rest" in
		' import '*) return 0 ;;
		.*) rest="${rest#.}" ;;
		*) return 1 ;;
		esac
		name="${rest%%[!${ORT_ALNUM}_]*}"
		case "$name" in '' | [0123456789]*) return 1 ;; esac
		rest="${rest#"$name"}"
	done
}

#: PIP'S CONSOLE SCRIPT FOR THIS PACKAGE (FR-020, contracts/pipx-link.md), at a
#: target that is a regular file and not a link: what `pip install --user
#: openrepotools` leaves at `~/.local/bin/openRepoTools`. It is another
#: installer's command, and `--install` refuses to replace it in every mode, its
#: own run included. Both halves of pip's template must hold:
#:
#:   * A PYTHON INTERPRETER, in either form pip writes: a `#!` line whose first
#:     word's last `/` segment begins with `python`, or the three-line `/bin/sh`
#:     trampoline pip writes when that path holds a space or is too long for a
#:     shebang — `#!/bin/sh`, then `'''exec' <python> … "$0" "$@"` with the
#:     interpreter quoted up to the next `"` or unquoted up to the first space,
#:     then `' '''`;
#:   * THE ENTRY POINT'S IMPORT at column 0 in one of the first 20 lines
#:     (`pip_imports_entry`).
#:
#: Read by `IFS= read -r`, `case` and parameter expansion: bash 3.2's.
pip_script_is() {   # <dir>/openRepoTools — 0 when it is pip's console script for openrepotools
	local line="" n=0 first="" second="" third="" imports=1 word="" rest=""
	local exec_word="'''exec' " tail=' "$0" "$@"' close="' '''" dq='"'
	[ -f "$1" ] && [ ! -L "$1" ] && [ -r "$1" ] || return 1
	while [ "$n" -lt 20 ] && { IFS= read -r line || [ -n "$line" ]; }; do
		n=$((n + 1))
		case "$n" in
		1) first="$line" ;;
		2) second="$line" ;;
		3) third="$line" ;;
		esac
		if [ "$imports" -ne 0 ] && pip_imports_entry "$line"; then imports=0; fi
	done 2>/dev/null <"$1" || return 1
	[ "$imports" -eq 0 ] || return 1
	# THE SHEBANG FORM: the first word after `#!` names a Python.
	case "$first" in '#!'*) ;; *) return 1 ;; esac
	word="${first#??}"
	while :; do case "$word" in ' '* | "$ORT_TAB"*) word="${word#?}" ;; *) break ;; esac; done
	word="${word%%[ $ORT_TAB]*}"
	case "${word##*/}" in python*) return 0 ;; esac
	# THE TRAMPOLINE FORM, its three lines exactly as pip writes them.
	[ "$first" = '#!/bin/sh' ] && [ "$third" = "$close" ] || return 1
	case "$second" in "$exec_word"*) ;; *) return 1 ;; esac
	rest="${second#"$exec_word"}"
	case "$rest" in
	"$dq"*)
		rest="${rest#?}"
		case "$rest" in *"$dq"*) ;; *) return 1 ;; esac
		word="${rest%%"$dq"*}"
		rest="${rest#*"$dq"}"
		;;
	*)
		word="${rest%% *}"
		rest="${rest#"$word"}"
		;;
	esac
	case "$rest" in *"$tail") ;; *) return 1 ;; esac
	case "${word##*/}" in python*) return 0 ;; esac
	return 1
}

#: THE `openRepoTools` A SHELL WILL RUN, asked last in a package-mode
#: `--install` (FR-021, research R7). `<prefix>` is five levels above the
#: payload, the parent of its `lib/`, and is named only where the four
#: directories between are an installed wheel's — `openrepotools`,
#: `site-packages`, `python*` and `lib` — so a layout that names no prefix gets
#: no note. The first `openRepoTools` on PATH, as `type -P` finds it, and this
#: package's console script, `<prefix>/bin/openRepoTools`, are each followed
#: through `link_resolve`, so pipx's link and the script it points at are one
#: file. A mismatch, or no `openRepoTools` on PATH at all, is the one note. It
#: changes nothing, and never fails: the exit status stays the install's.
path_report() {
	local up="$PACKAGE_DIR" prefix="" want="" first="" got="" expected=""
	[ -n "$up" ] || return 0
	up="${up%/*}"
	[ "${up##*/}" = openrepotools ] || return 0
	up="${up%/*}"
	[ "${up##*/}" = site-packages ] || return 0
	up="${up%/*}"
	case "${up##*/}" in python*) ;; *) return 0 ;; esac
	up="${up%/*}"
	[ "${up##*/}" = lib ] || return 0
	prefix="${up%/*}"
	want="$prefix/bin/openRepoTools"
	first="$(type -P openRepoTools 2>/dev/null)" || first=""
	if [ -z "$first" ]; then
		say "openRepoTools: note: the first openRepoTools on your PATH is none, not this package's $want, so the release you just installed is not the one that runs; put the directory that holds pipx's link to it on PATH"
		return 0
	fi
	got="$(link_resolve "$first")" || got=""
	expected="$(link_resolve "$want")" || expected=""
	if [ -n "$got" ] && [ "$got" = "$expected" ]; then
		return 0
	fi
	say "openRepoTools: note: the first openRepoTools on your PATH is $first, not this package's $want, so the release you just installed is not the one that runs; put the directory that holds pipx's link to it ahead of $(dirname -- "$first") on PATH"
}

plan_install_targets() {
	local dir="${OPENREPOTOOLS_BIN_DIR:-$HOME/.local/bin}"
	local name target kind bad="" paths="" venv="" leave="" clear=""
	PIPX_LINK="" PIPX_VENV="" PIPX_PAYLOAD=""
	# THE DIRECTORY FIRST, which is the `-w` question for every target that is
	# not there yet: an absent file is placeable exactly where the directory it
	# would be created in takes a write. `plan_skill_targets` asks this of the
	# ones it writes into; the bin directory is the same question for the eleven,
	# and without it a `$OPENREPOTOOLS_BIN_DIR` that is not this user's failed at
	# the first `cp` under `set -e` — exit 1, which this toolset spends on
	# "findings were printed", from a run that placed nothing and said nothing.
	# A directory that is not there YET is asked about through the nearest
	# ancestor that is, because `install_commands` creates it and a parent that
	# refuses the `mkdir -p` is a refusal this phase can print for nothing.
	if kind="$(unusable_dir_kind "$dir")"; then
		die "\`--install\` places the ${#INSTALLABLES[@]} commands in $dir, and $kind.
    NOTHING was installed and nothing already installed was replaced."
	fi
	for name in "${INSTALLABLES[@]}"; do
		target="$dir/$name"
		# PIPX'S LINK IS ASKED ABOUT BEFORE ANY LINK IS REFUSED (FR-015), at the
		# one command pipx places. It is no bad target: the placement loop skips
		# it, once it has asked again at that target's own turn and found it
		# still pipx's (#257); a link that has gone or changed by then is
		# refused there. A venv-shaped link IS a bad target, listed for what it
		# is, with the paragraph that says to leave it, and kept out of the
		# `rm -f` line.
		if [ "$name" = openRepoTools ]; then
			if pipx_link_match "$target"; then
				continue
			fi
			if venv="$(venv_shaped_link "$target")"; then
				bad="${bad:+$bad
}    $target — a link into a Python environment, perhaps pipx's ($venv), in a layout this installer does not recognise"
				leave="
    Leave $target where it is: it may be the only openRepoTools that can
    run \`--install\`. Run \`pipx reinstall openrepotools\`, then \`openRepoTools --install\`
    again, and if this refusal stays, open an issue on opensoft/openRepoTools naming
    the layout under $venv."
				continue
			fi
			# PIP'S CONSOLE SCRIPT IS NOT THIS INSTALLER'S TO REPLACE (FR-020),
			# in any mode: refused here, before anything is fetched or placed.
			if pip_script_is "$target"; then
				die "\`--install\` will not replace $target: it is pip's console script for openrepotools (\`pip install --user openrepotools\` leaves it there), and another installer's command is not this installer's to overwrite.
    NOTHING was installed and nothing already installed was replaced.
    pipx is the one package route. To move to it:
        pip uninstall openrepotools
        pipx install openrepotools
        openRepoTools --install"
			fi
		fi
		kind="$(unplaceable_kind "$target")" || continue
		bad="${bad:+$bad
}    $target — $kind"
		paths="${paths:+$paths }\"$target\""
	done
	[ -n "$bad" ] || return 0
	# THE `rm -f` LINE NAMES ONLY WHAT IT IS SAFE TO REMOVE, so with a
	# venv-shaped link the only bad target there is no "Clear them" at all.
	[ -z "$paths" ] || clear="
    Clear them, then re-run — \`rm -f\` takes a read-only file, because what a
    removal needs is the DIRECTORY's write bit and not the file's:
        rm -f -- $paths
    (The pre-move \`link-estates\` puts exactly these links in a workstation's
    \`~/.local/bin\`, pointing into \`opensoft/brett-wip\` — the checkout every
    lane writes. Amendment 9's adoption act 6 removes them per host before the
    first \`--install\` that carries this, and act 5 strips that repository to
    data.)"
	die "\`--install\` places a REGULAR FILE IT CAN WRITE at each of these, and these are
    not that:
$bad$leave
    Each command is placed by renaming a new copy over its path, so installing
    over a symlink would replace somebody's link with a regular file, over a
    directory would put the file inside it, and over a file this user cannot
    write would replace a file somebody made read-only — none of it asked for.
    NOTHING was installed and nothing already installed was replaced.$clear"
}

# THE RIVALS THEMSELVES, FOR A REFUSAL TO NAME (#59). It is the conflict half of
# the read in `plan_hook_merge` with the answer taken off: every command under
# this event that runs this hook's verb AND IS NOT OURS, one per line and
# indented into the refusal's block.
#
# ONE IMPLEMENTATION FOR BOTH ENTRIES, for the reason `unplaceable_kind` is one:
# what differs between the two arms is the EVENT, OUR OWN STRING and the VERB a
# rival is recognised by, and a second copy of this is how one arm comes to name
# what the other cannot.
#
# IT MATTERS NOW IN A WAY IT DID NOT BEFORE. With `conflict` beating `present`, a
# refused file may carry OUR entry as well as the rival — so "remove that entry"
# with nothing named is a remedy a person can read as "remove the one this
# installer just printed", which would leave the second writer exactly where it
# is and take the working entry away instead.
hook_rivals() {   # <settings> <event> <our command> <verb pattern>
	jq -r --arg e "$2" --arg c "$3" --arg v "$4" '
		[ (.hooks[$e] // [])[]? | (.hooks // [])[]? | .command // empty ]
		| map(select(. != $c and test($v)))
		| map("        " + .) | join("\n")' "$1" 2>/dev/null ||
		printf '        (that file could not be re-read to name them)'
}

# THE REFUSAL FOR A LINK (OR ANYTHING BUT A REGULAR FILE) AT `settings.json`,
# ONE TEXT FOR EVERY PLACE THAT ASKS (#331). Planning asks first, and so
# does each act that would go THROUGH the file or OVER it: the two `chmod 600`
# of `hook_pair_merge` and `hook_pair_defer`, and the `mv` of
# `hook_write_settings`. Four wordings of one reason is how one of them comes to
# omit the `rm` that clears it, so the reason and the remedy are spelled here
# once and the caller says what is and is not placed.
settings_link_refusal() {   # <settings> <what it is> <what was and was not placed>
	die "\`--install\` merges its two hook entries into a REGULAR FILE, and this is not
    one:
    $1 — $2
    A \`chmod\` follows a link, so the mode this installer stamps would land on
    whatever is on the other end of it; and the merge itself writes a temporary
    beside this path and moves it here, which would take the link away.
    $3
    Clear it — what is on the other end keeps its bytes and its mode — then
    re-run:
        rm -f -- \"$1\""
}

# A LINK THAT IS AT `settings.json` NOW AND WAS NOT WHEN THIS RUN PLANNED (#331).
# Planning refuses a link there once, and the pair is the last thing `--install`
# writes — after the seventeen commands, the skills and the command files —
# so a dotfiles manager, a second run or a person has had that long to make one,
# and `chmod` would stamp the file at its far end while `mv -f` would swallow
# the link: the two harms planning's refusal exists for (#44 round 1). It is
# the late refusal `place_by_rename` makes of a link at a placed file (#257),
# in planning's own words, and it leaves the link and its far end alone. Each
# caller asks `[ -L ]`, a builtin, as the LAST question before its act, so
# nothing runs between the test and `chmod` or `mv` starting; a link made in
# that instant is still followed or replaced, because GNU `chmod` has no `-h`
# and no `mv` this file can count on refuses a link at its destination. The
# link's far end is read through a file in the workdir and not `$(readlink …)`,
# the way `hook_write_settings` takes each of its answers (#332); where there is
# no workdir it is said to be unreadable.
#
# WHAT IT SAYS WAS STAMPED IS TRUE IN EVERY CORNER IT FIRES IN (#331). In one,
# the `present` arm of `hook_pair_merge` has already restored the mode of the
# regular file that was here (the `SessionStart` entry there and the guard's
# not: an install from before Amendment 12), a link is made, and the write that
# follows meets it. "mode restored to 600" was true when printed, and the stamp
# may be on what is now the far end, so the text says only that THIS refusal
# wrote nothing there and stamped no mode.
settings_link_since_planning() {   # <settings>
	local far=""
	if [ -n "$WORKDIR" ] && [ -d "$WORKDIR" ]; then
		{ readlink -- "$1" 2>/dev/null || printf '<unreadable>'; } >"$WORKDIR/placing"
		IFS= read -r -d '' far <"$WORKDIR/placing" || :
		far="${far%$'\n'}"
	fi
	[ -n "$far" ] || far="<unreadable>"
	settings_link_refusal "$1" "a symlink to $far now, and it was not one when this run planned" \
		"Whatever the lines above report is placed. If they report this path's mode
    restored, that stamp landed on whatever was here then, which may be what is on the
    other end of this link now. This refusal wrote nothing there and stamped no mode,
    so the link is as it was made."
}

plan_hook_merge() {
	local settings existing kind rivals=""
	settings="$(claude_home)/settings.json"
	# EACH REFUSAL HERE HOLDS ONE `$(…)` (#342, the reason is above
	# `remove_workdir`): where both entries are printed they come from one
	# `$(hook_block_text; guard_block_text)`, whose first block ends in the
	# newline that joined the two `$(…)` it replaces, so the bytes are the
	# same; and where a rival is named, `hook_rivals` answers into `$rivals`
	# first.
	command -v jq >/dev/null 2>&1 || die "\`--install\` needs \`jq\` to merge its TWO hook entries into
    $settings, and there is no \`jq\` on this PATH. It refuses rather than
    rewriting a JSON file by hand, and NOTHING was installed. Install jq, then
    re-run. The entries it would have merged — the \`SessionStart\` one and
    Amendment 12's \`UserPromptSubmit\` name guard, which are ONE all-or-nothing
    merge:
$(hook_block_text; guard_block_text)"

	# WHAT IS AT THAT PATH, BEFORE A BYTE OF IT IS READ (#44 round 1,
	# `openRepoTools:878`). This file carries the LAST TWO artifacts — the
	# thirtieth and thirty-first — since Amendment 12 adoption act 3 put the
	# name guard beside the `SessionStart` entry, and it is the only path no
	# walk asked about; the
	# `present` arm now CHMODs it, and `chmod`
	# follows a symlink, so a `~/.claude/settings.json` linked into a dotfiles
	# checkout had the 600 stamped on the file at the far end — an unrelated
	# file re-moded by an installer that reported `already installed
	# (unchanged)` for it. The two merge arms are the older half of the same
	# defect: `mv -f` REPLACES a symlink with the regular file it wrote, so the
	# link a person put there was swallowed and the far end silently stopped
	# being what `claude` reads.
	#
	# `path_kind` AND NOT `unplaceable_kind`, because this file is not placed
	# with `cp`: the merge writes a temporary beside it and moves that into
	# place, which takes the DIRECTORY's write bit and not the file's, so a
	# read-only `settings.json` is one this command may still merge into.
	if kind="$(path_kind "$settings")"; then
		settings_link_refusal "$settings" "$kind" \
			"NOTHING was installed and nothing already installed was replaced."
	fi

	workdir
	HOOK_MERGED="$WORKDIR/settings.json"
	HOOK_DEFERRED=""
	HOOK_STRIP_WHY=""
	local staged="$WORKDIR/settings.stage.json"

	if [ ! -e "$settings" ]; then
		HOOK_PLAN="nofile"; GUARD_PLAN="nofile"
		jq -n --arg c "$HOOK_COMMAND" --arg m "$HOOK_MATCHER" --argjson t "$HOOK_TIMEOUT" \
		      --arg g "$GUARD_COMMAND" --argjson gt "$GUARD_TIMEOUT" \
			'{hooks: {SessionStart: [{matcher: $m, hooks: [{type: "command", command: $c, timeout: $t}]}],
			          UserPromptSubmit: [{hooks: [{type: "command", command: $g, timeout: $gt}]}]}}' \
			>"$HOOK_MERGED" || die "could not compose $settings; nothing was installed."
		return 0
	fi

	jq -e . "$settings" >/dev/null 2>&1 || die "$settings is not valid JSON, so \`--install\` cannot merge its two entries into
    it and will not rewrite it. NOTHING was installed and nothing already installed was
    replaced. Fix that file, then re-run. The entries it would have merged:
$(hook_block_text; guard_block_text)"

	jq -e '(has("hooks") | not) or (.hooks | type == "object")' "$settings" >/dev/null 2>&1 ||
		die "$settings has a \`hooks\` that is not an object, so there is nothing to merge
    either entry into. NOTHING was installed. The entries it would have merged:
$(hook_block_text; guard_block_text)"

	# THE THREE ANSWERS, in one read: our exact command already there; some
	# OTHER SessionStart entry that runs `session-start` (a second writer of
	# this very hook, which is the case Amendment 9(b) says must refuse); or
	# nothing of ours at all.
	#
	# THE CONFLICT ARM IS NARROWED, AND THE NARROWING IS RATIFIED: A9 Addendum 3
	# R-A9-8 with A9 Addendum 4 R-A9-14, on brettheap/new-workstation#17.
	# Amendment 9(b)'s clause reads "an entry under `SessionStart` whose
	# `command` DIFFERS … → refuse, print the exact block, and place nothing at
	# all", unqualified. Read literally, a person whose `~/.claude/settings.json`
	# carries ANY unrelated SessionStart hook — a statusline refresh, a `git
	# fetch` — could never run `--install` at all, and no amount of removing OUR
	# entry would help them. This workstation carries exactly such an entry
	# today (`herdr-agent-state.sh session`, matcher `*`), so the narrowing is
	# not hypothetical.
	#
	# IT KEYS ON `session-start`, WHICH IS WHAT R-A9-8 SAYS, and not on
	# `lanes-edit.sh`, which is what this line said until R-A9-14 (F7 of the #24
	# review). The two are not the same set either way round: an entry running
	# `lanes-edit.sh who` is no competing writer of this hook and was refused,
	# and `~/bin/lane-hook.sh session-start` IS one — a second program running
	# the same hook verb — and was merged beside, which fires the hook twice,
	# the one harm the clause names. The verb is what collides; the file that
	# carries it is not.
	#
	# AND THE RIVAL IS ASKED ABOUT FIRST, WHICH IS THE WHOLE OF #59. `present`
	# was tested first, so a settings file carrying our exact entry AND a second
	# writer of the same hook answered `present`: `--install` added nothing,
	# said nothing, and left a person with the two writers this arm exists to
	# refuse, with the run reporting success. Nothing was installed twice by
	# such a run — with the exact entry there, there is nothing to add — but the
	# state was never NAMED, and somebody who runs `--install` expecting it to
	# police this hook was told everything was fine.
	#
	# WHICH IS WHY THE RIVAL TEST EXCLUDES OUR OWN STRING (`. != $c`) rather
	# than being asked second: our entry is no rival to itself, and an arm that
	# read it as one would refuse every re-run of `--install` on a workstation
	# that had already taken it. `present` keeps the rest of its meaning — our
	# entry there and nothing competing with it — and `conflict` means what it
	# says whatever else the file carries.
	#
	# THE VERB IS SPELLED ONCE, in `hook_verb` here and `guard_verb` below: the
	# answer and the list of rivals the refusal prints are the same question
	# asked twice, and a pattern written twice is a pair that drifts.
	local hook_verb='session-start'
	existing="$(jq -r --arg c "$HOOK_COMMAND" --arg v "$hook_verb" '
		[ (.hooks.SessionStart // [])[]? | (.hooks // [])[]? | .command // empty ] as $cmds
		| if ($cmds | map(select(. != $c and test($v))) | length) > 0 then "conflict"
		  elif ($cmds | index($c)) then "present"
		  else "absent" end' "$settings" 2>/dev/null || printf 'error')"

	# AND THE SAME THREE ANSWERS FOR AMENDMENT 12's ENTRY, keyed on its own verb.
	#
	# `guard` AS A WHOLE ARGUMENT, and not as a substring — the one place this
	# read differs from the one above, and the difference is load-bearing. The
	# `SessionStart` arm keys on `session-start`, a word that appears in nothing
	# else; `guard` appears in `~/projects/xFactory/guard.sh`, a plain
	# `UserPromptSubmit` hook a person's settings may already carry and one this
	# installer must leave exactly where it is. So the test is the verb with a
	# boundary on both sides: a command RUNNING `guard` collides, a file merely
	# NAMED guard does not. That is R-A9-14's rule one event over — the verb is
	# what collides; the file that carries it is not.
	#
	# THE ORDER IS THE ONE ABOVE'S, FOR THE REASON ABOVE (#59), and so is every
	# other byte of this read: the two arms differ in the EVENT, in OUR OWN
	# STRING and in the verb a rival is recognised by, and in nothing else. An
	# arm that answered a question the other does not is how a person comes to
	# be refused for one entry of a pair and not for the other.
	local existing_guard guard_verb='(^|\s)guard(\s|$)'
	existing_guard="$(jq -r --arg c "$GUARD_COMMAND" --arg v "$guard_verb" '
		[ (.hooks.UserPromptSubmit // [])[]? | (.hooks // [])[]? | .command // empty ] as $cmds
		| if ($cmds | map(select(. != $c and test($v))) | length) > 0 then "conflict"
		  elif ($cmds | index($c)) then "present"
		  else "absent" end' "$settings" 2>/dev/null || printf 'error')"

	case "$existing" in
	conflict)
		rivals="$(hook_rivals "$settings" SessionStart "$HOOK_COMMAND" "$hook_verb")"
		die "$settings already carries a SessionStart entry that runs \`session-start\` with a
    DIFFERENT command string:
$rivals
    Exact-string match is the only idempotence this entry has, so merging would fire
    the hook twice — and repairing a setting a person meant is not an installer's to
    do. A SECOND WRITER REFUSES WHETHER OR NOT OUR OWN ENTRY IS BESIDE IT: two writers
    of one hook is the state this arm exists to refuse, and a file carrying both is
    that state. NOTHING was installed.
    Remove EVERY entry listed above — all of them are second writers of this hook,
    and one left behind refuses the next run the same way — but not the block below,
    which is this installer's own. Then re-run. The entry this places, byte for byte:
$(hook_block_text)
    (Amendment 9's adoption act 6 removes the hand-installed entry on each
    workstation before the first \`--install\` that carries this.)"
		;;
	present | absent) HOOK_PLAN="$existing" ;;
	*) die "$settings could not be read for a SessionStart entry; nothing was installed." ;;
	esac

	case "$existing_guard" in
	conflict)
		rivals="$(hook_rivals "$settings" UserPromptSubmit "$GUARD_COMMAND" "$guard_verb")"
		die "$settings already carries a UserPromptSubmit entry that runs \`guard\` with a
    DIFFERENT command string:
$rivals
    Exact-string match is the only idempotence this entry has, so merging would fire
    the name guard twice — two refusals for one prompt. Repairing a setting a person
    meant is not an installer's to do, and A SECOND WRITER REFUSES WHETHER OR NOT OUR
    OWN ENTRY IS BESIDE IT: two writers of one hook is that state either way. So
    NOTHING was installed. Remove EVERY entry listed above — all of them are second
    writers of this hook, and one left behind refuses the next run the same way —
    but not the block below, which is this installer's own. Then re-run.
    The entry this places, byte for byte:
$(guard_block_text)"
		;;
	present | absent) GUARD_PLAN="$existing_guard" ;;
	*) die "$settings could not be read for a UserPromptSubmit entry; nothing was installed." ;;
	esac

	# BOTH MERGES ARE COMPUTED BEFORE EITHER IS PLACED, into one staged file, so
	# the all-or-nothing rule covers the PAIR: a settings file that took the
	# SessionStart entry and refused the guard is a half-install of a hook pair,
	# and nothing on screen would say which half.
	cp -- "$settings" "$HOOK_MERGED" ||
		die "could not stage $settings for merging; nothing was installed."
	if [ "$HOOK_PLAN" = absent ]; then
		jq --arg c "$HOOK_COMMAND" --arg m "$HOOK_MATCHER" --argjson t "$HOOK_TIMEOUT" '
			.hooks = (.hooks // {})
			| .hooks.SessionStart = ((.hooks.SessionStart // []) + [{
				matcher: $m,
				hooks: [{type: "command", command: $c, timeout: $t}]
			  }])' "$HOOK_MERGED" >"$staged" ||
			die "could not merge the SessionStart entry into $settings; nothing was installed."
		mv -f -- "$staged" "$HOOK_MERGED" ||
			die "could not stage the merged $settings; nothing was installed."
	fi
	if [ "$GUARD_PLAN" = absent ]; then
		jq --arg c "$GUARD_COMMAND" --argjson t "$GUARD_TIMEOUT" '
			.hooks = (.hooks // {})
			| .hooks.UserPromptSubmit = ((.hooks.UserPromptSubmit // []) + [{
				hooks: [{type: "command", command: $c, timeout: $t}]
			  }])' "$HOOK_MERGED" >"$staged" ||
			die "could not merge the UserPromptSubmit entry into $settings; nothing was installed."
		mv -f -- "$staged" "$HOOK_MERGED" ||
			die "could not stage the merged $settings; nothing was installed."
	fi

	# THE OTHER OUTCOME, STAGED BESIDE THAT ONE (#237): this same file with OUR
	# EXACT GUARD ENTRY taken out, for a run whose target does not answer
	# `guard`. Only where the file carries it — with nothing of ours to take out,
	# a deferred run has nothing to write, and writes nothing.
	#
	# THE NESTED ARRAY IS FILTERED, NOT THE OUTER ENTRY (workBenches#89): an
	# entry that grouped our command with somebody else's keeps the other
	# command and every other key it has; an entry we took nothing from passes
	# through untouched; and an outer entry goes only when our command was the
	# last thing in it. A shape this does not take apart — a `UserPromptSubmit`
	# or an entry's `hooks` that is not an array — is left exactly as it is, and
	# the read below, the same one `existing_guard` asks, says so.
	if [ "$GUARD_PLAN" = present ]; then
		HOOK_DEFERRED="$WORKDIR/settings.deferred.json"
		jq --arg g "$GUARD_COMMAND" '
			if (.hooks.UserPromptSubmit | type) == "array" then
			  .hooks.UserPromptSubmit = [ .hooks.UserPromptSubmit[]
			    | if type == "object" and ((.hooks | type) == "array") then
			        .hooks as $inner
			        | ($inner | map(select((type == "object" and .command == $g) | not))) as $kept
			        | if ($kept | length) == ($inner | length) then .
			          elif ($kept | length) > 0 then .hooks = $kept
			          else empty end
			      else . end ]
			else . end' "$settings" >"$HOOK_DEFERRED" ||
			die "could not compute $settings without its UserPromptSubmit name guard; nothing was installed."
		if jq -e --arg g "$GUARD_COMMAND" '
			[ (.hooks.UserPromptSubmit // [])[]? | (.hooks // [])[]? | .command // empty ]
			| index($g)' "$HOOK_DEFERRED" >/dev/null 2>&1; then
			HOOK_STRIP_WHY="its \`UserPromptSubmit\`, or the entry carrying the guard, is not the array of entries this command takes apart"
		fi
	fi

	# A GUARD ENTRY THIS COMMAND CANNOT TAKE OUT, AGAINST A TARGET THAT WILL NOT
	# ANSWER, IS A REFUSAL — AND IT IS DECIDED HERE, BEFORE ANYTHING IS PLACED
	# (the #237 review, M2), like every other file this merge cannot handle. The
	# one target the bin loop can still repair is let through to placement: a
	# link to the bin directory's own `lanes-edit.sh`, which that loop puts back
	# and which then answers, so the run merges instead. `hook_pair_defer` keeps
	# the same refusal for the case this read got wrong.
	if [ -n "$HOOK_STRIP_WHY" ] && ! hook_target_answers && ! hook_target_is_ours_to_place; then
		die "$(hook_strip_refusal "NOTHING was installed and nothing already installed was replaced.")"
	fi
}

# THE ONE TARGET A RUN OF `--install` CAN STILL MAKE ANSWER: a symlink spelled
# the way `link-estates` spells it, to the bin directory's own `lanes-edit.sh`,
# which the bin loop places. A bench recreate that emptied that directory
# leaves exactly this link dangling.
hook_target_is_ours_to_place() {
	local target
	target="$(hook_target)"
	[ -L "$target" ] &&
		[ "$(readlink -- "$target" 2>/dev/null || :)" = "${OPENREPOTOOLS_BIN_DIR:-$HOME/.local/bin}/lanes-edit.sh" ]
}

hook_strip_refusal() {   # <what was and was not placed>
	printf '%s' "$(claude_home)/settings.json carries the UserPromptSubmit name guard, and ${HOOK_TARGET_WHY},
    so that entry would fail every prompt — but ${HOOK_STRIP_WHY}, and a file this
    command does not understand is not one it rewrites. Nothing in that file was
    changed. $1 Remove the entry below by hand, then re-run:
$(guard_block_text)"
}

# The fourteen artifacts that are not bin-directory files, in thirteen writes
# (the two hook entries go into settings.json in one), AFTER every file
# `INSTALLABLES` lists and the merge are all in hand. The last two only once
# their target answers (#237): `place_hook_pair` asks, and says which.
#
# NO ANSWER HERE IS TAKEN WITH `$(…)` (#318), for the reason above
# `remove_workdir`: where the two homes are, and the directory each target's
# `mkdir -p` makes, come back through the workdir. `skills_home` and
# `claude_home` are functions of builtins, which this shell runs itself, and
# `read_answer` takes the value `$(…)` took, the one planning checked; `dirname`
# is a plain command.
#
# WHAT A REFUSAL HERE SAYS IS PLACED IS WHAT IS TRUE AT THE POSITION IT FIRES AT
# (#321). The six skill files go first (each skill `SKILLS` lists, at the shared
# directory and then the bare one), the six command files next, the hook pair
# last. So at a skill file every skill file before it is placed, and it and the
# ones after it are not; no command file is placed there, and the hook pair is
# placed at neither. At a command file all six skill files and every command
# file before it are placed, and it and the command files after it are not.
# "This one" is the file that was to go there, at a `mkdir` refusal too: the
# one the directory was for. Each loop's sentence is written once, in
# `rest_at_a_skill` and `rest_at_a_command`, so its `mkdir` refusal and its
# `place_by_rename` refusal cannot come to two answers. Each starts "The N
# commands above are placed;", where the bin loop's refusals start "Whatever
# the lines above report is placed;".
place_skill_and_hook() {
	local shared_dir bare_dir target verb name profiles="" claude_dir="" parent=""
	local rest_at_a_skill rest_at_a_command
	rest_at_a_skill="The $placed commands above are placed; so is every skill file before this one. This one, the skill files after it, the command files and the hook are not."
	rest_at_a_command="The $placed commands above are placed; so are the skill files and every command file before this one. This one, the command files after it and the hook are not."
	skills_home >"$WORKDIR/answer"
	read_answer profiles "$WORKDIR/answer"
	claude_home >"$WORKDIR/answer"
	read_answer claude_dir "$WORKDIR/answer"
	for name in "${SKILLS[@]}"; do
	shared_dir="$profiles/shared/skills/$name"
	bare_dir="$claude_dir/skills/$name"

	# EVERY FAILURE HERE IS A `die`, never the shell's own 1. `--install`'s
	# codes are this toolset's — 0 done, 1 findings printed, 2 a refusal — and
	# an unguarded `mkdir` or `cp` under `set -e` exits 1, which reads as a
	# report of findings from a command that placed seventeen of thirty-one artifacts.
	for target in "$shared_dir/SKILL.md" "$bare_dir/SKILL.md"; do
		dirname -- "$target" >"$WORKDIR/answer"
		read_answer parent "$WORKDIR/answer"
		mkdir -p -- "$parent" ||
			die "could not create $parent for the $name skill.
    $rest_at_a_skill"
		# A LINK TAKES THE OTHER ARM, AS IT DOES IN `install_commands` (#257):
		# one made since planning is no "bytes already right", and its far end
		# is not this installer's to `chmod`. `place_by_rename` refuses it.
		if [ -e "$target" ] && cmp -s "$WORKDIR/skill-$name.md" "$target" && [ ! -L "$target" ]; then
			# THE MODE IS STAMPED WHETHER OR NOT THE BYTES MOVED (#40, finding
			# 2). This arm reported the file unchanged and then SKIPPED the
			# `chmod` below, which sat inside the `else` — so a `SKILL.md` that
			# had drifted to 755, or to anything else, kept that mode for as
			# long as its bytes stayed right and no re-run of `--install` ever
			# put it back. The eleven in the bin directory have been stamped
			# every time all along; this is that same rule, one directory on.
			if mode_is 644 "$target"; then
				verb="already installed at $target (unchanged)"
			else
				verb="already installed at $target (mode restored to 644)"
			fi
			chmod 644 "$target" || die "could not set the mode on $target."
		else
			if [ -e "$target" ]; then verb="updated at $target"; else verb="installed at $target"; fi
			# BY RENAME, as the bin directory's files are (#167). A session reads
			# a `SKILL.md` whole rather than running it, so nothing here executes
			# garbage — but one way to place a file is one rule to read, and a
			# reader that opens it mid-install still sees the old text or the
			# new, never a truncated one.
			place_by_rename "$WORKDIR/skill-$name.md" "$target" 644 "$rest_at_a_skill"
		fi
		# 644: a SKILL.md is a document a session READS, not a command. The
		# seventeen in the bin directory are stamped 755 for the reason that loop
		# gives — "a copy that is not executable is not a command" — and
		# that reason does not reach this file. Amendment 9(b) describes
		# `--install` as stamping 755 "on everything it places" while
		# arguing why adoption act 4b must delete workBenches#63's 0644
		# loop; the deletion is required either way, because two writers of
		# one path is the defect and the mode was only its symptom.
		say "$name: $verb"
	done
	done

	# THE COMMAND FILES, AT THE SAME TWO DESTINATIONS AND THE SAME MODE
	# (A11 Addendum 4 ruling 9). `setup-claude-profiles.sh` makes
	# `<profiles>/shared/commands` and links it into every profile as
	# `<profile>/commands`, exactly as it does for `skills` — so a file placed
	# in the shared directory is `/swap` in every profile, and the bare copy in
	# `~/.claude/commands/` is `/swap` in a `claude` run outside one. Two
	# destinations, for the two ways a session is started, which is the same
	# reason a skill has two.
	#
	# 644 for the same reason a `SKILL.md` is: a command file is a document a
	# session READS. The 755 argument belongs to the seventeen in the bin
	# directory, where a copy that is not executable is not a command.
	for name in "${COMMANDS[@]}"; do
		for target in "$profiles/shared/commands/$name.md" "$claude_dir/commands/$name.md"; do
			dirname -- "$target" >"$WORKDIR/answer"
			read_answer parent "$WORKDIR/answer"
			mkdir -p -- "$parent" ||
				die "could not create $parent for the /$name command.
    $rest_at_a_command"
			# A LINK TAKES THE OTHER ARM HERE TOO (#257), as a skill's does.
			if [ -e "$target" ] && cmp -s "$WORKDIR/command-$name.md" "$target" && [ ! -L "$target" ]; then
				# The same stamp on the same arm, for the same reason a skill's
				# is (#40, finding 2): the mode is this installer's to set on
				# every artifact it places, and a mode it repaired is a line
				# that says so rather than `unchanged`.
				if mode_is 644 "$target"; then
					verb="already installed at $target (unchanged)"
				else
					verb="already installed at $target (mode restored to 644)"
				fi
				chmod 644 "$target" || die "could not set the mode on $target."
			else
				if [ -e "$target" ]; then verb="updated at $target"; else verb="installed at $target"; fi
				place_by_rename "$WORKDIR/command-$name.md" "$target" 644 "$rest_at_a_command"
			fi
			say "/$name: $verb"
		done
	done

	place_hook_pair
}

# THE PAIR, BY ONE OF THE TWO OUTCOMES `plan_hook_merge` STAGED (#237), and the
# question that picks it is asked HERE, after the bin loop: the path both entries
# call is a link to the `lanes-edit.sh` that loop has just placed, so a link a
# bench recreate left dangling over an emptied `~/.local/bin` answers again by
# now, and the pair goes in on this same run. Asked earlier, it would defer the
# pair on the one run that put the link's far end back.
#
# `wip init` places the pair through this same function (`wip_hook_pair`), after
# `link-estates`, so the two writers of this file cannot come to two rules.
# Where `settings.json` is comes back through the workdir, as in
# `place_skill_and_hook` (#318); both callers have made one by now.
place_hook_pair() {
	local settings=""
	claude_home >"$WORKDIR/answer"
	read_answer settings "$WORKDIR/answer"
	settings="$settings/settings.json"
	if hook_target_answers; then
		hook_pair_merge "$settings"
	else
		hook_pair_defer "$settings"
	fi
}

# WRITTEN THROUGH A TEMPORARY IN THE SAME DIRECTORY, then moved into place:
# `mktemp` + `chmod 600` + `mv -f`, which is what workBenches'
# `scripts/setup-claude-profiles.sh:167-194` does to this very file on every
# `./setup.sh` and what Amendment 9(b) cites approvingly. A plain `cp` that fails
# half way leaves a person's settings TRUNCATED, and this is the one file in this
# installer that is not ours to own. 600, the mode workBenches' own writer of this
# file uses: an installer that widened it would be silently undone, or would widen
# it behind that script's back. Stamped on the TEMPORARY, so the file never
# exists at a wider mode for even an instant. One writer for both outcomes.
#
# THE TEMPORARY IS WITHIN THE CLEANUP'S REACH FROM `mktemp` TO THE `mv` (#332),
# as a placement's is (#167): `$PLACING` holds its PREFIX —
# `settings.json.openrepotools.<this pid>.` — before `mktemp` runs, and
# `remove_workdir`, which the `EXIT` and `INT` traps run, removes whatever
# starts with it. The three failure arms below remove the temporary where the
# shell goes on; a signal is the failure none of them sees, and it left
# `settings.json.openrepotools.XXXXXX` in `~/.claude`, one per interrupted run,
# which no later run looked for — empty or, where the signal landed after the
# `cp`, a full copy of the person's merged settings. Cleared once the `mv` has
# happened, and in each arm that removes the temporary, so the traps never
# glob after a file that is no longer this write's. A SIGTERM or a SIGHUP is not
# trapped, and does not need to be: bash runs the `EXIT` trap as it dies of
# either, so `remove_workdir` takes the temporary then; `wip init` runs this in
# a subshell and `wip_hook_pair` says how that is closed.
#
# NO ANSWER HERE IS TAKEN WITH `$(…)` (#250, #318): bash waits for a command
# substitution's child outside its job table, and a SIGINT that arrives in that
# wait can be lost, trapped or not. The `dirname` of the settings and the
# `mktemp` each write to a file in the workdir, as `place_by_rename`'s do — a
# wait the `INT` trap is run after — and `read` takes the answer back: a path up
# to a NUL, which no path holds, so a directory with a newline in its name comes
# back whole, less the one newline the command ends it with. So this write needs
# the workdir and refuses without one, before anything is made.
hook_write_settings() {   # <the staged whole file> <settings>
	local staged="$1" settings="$2" parent="" hook_tmp=""
	if [ -z "$WORKDIR" ] || [ ! -d "$WORKDIR" ]; then
		die "\$WORKDIR is ${WORKDIR:-empty}${WORKDIR:+, which is not a directory}, and writing the hook entries passes each command's answer through a file in it, so $settings was not written and what was there is untouched."
	fi
	dirname -- "$settings" >"$WORKDIR/placing"
	IFS= read -r -d '' parent <"$WORKDIR/placing" || :
	parent="${parent%$'\n'}"
	mkdir -p -- "$parent" ||
		die "could not create $parent for the hook entries."
	PLACING="$parent/settings.json.openrepotools.$$."
	mktemp -- "${PLACING}XXXXXX" >"$WORKDIR/placing" ||
		{ rm -f -- "$PLACING"*; PLACING=""; die "could not create a temporary file beside $settings."; }
	IFS= read -r -d '' hook_tmp <"$WORKDIR/placing" || :
	hook_tmp="${hook_tmp%$'\n'}"
	cp -- "$staged" "$hook_tmp" ||
		{ rm -f -- "$hook_tmp"; PLACING=""; die "could not stage the merged $settings."; }
	chmod 600 "$hook_tmp" ||
		{ rm -f -- "$hook_tmp"; PLACING=""; die "could not set mode 600 on the merged $settings."; }
	# A LINK AT THE SETTINGS IS REFUSED HERE, AS THE LAST QUESTION BEFORE THE
	# RENAME (#331): `mv -f` replaces a link with the regular file it moves, so
	# the link a person put there would be swallowed and its far end would stop
	# being what `claude` reads. The temporary is removed first, and `$PLACING`
	# cleared, as in every arm above.
	if [ -L "$settings" ]; then
		rm -f -- "$hook_tmp"
		PLACING=""
		settings_link_since_planning "$settings"
	fi
	mv -f -- "$hook_tmp" "$settings" ||
		{ rm -f -- "$hook_tmp"; PLACING=""; die "could not move the merged settings into $settings."; }
	PLACING=""
}

# THE TARGET ANSWERS: the pair, merged exactly as it was before #237.
hook_pair_merge() {   # <settings>
	local settings="$1"
	case "$HOOK_PLAN" in
	present)
		# THE ENTRY BEING THERE SAYS NOTHING ABOUT THE MODE (#40, finding 3).
		# The two arms below write this file through `mktemp` + `chmod 600` +
		# `mv -f`, so a file THEY wrote is 600 — and a file whose entry was
		# already present was never given one, which is how a direct `--install`
		# could leave `~/.claude/settings.json` world-readable for ever. 600 is
		# the narrowing of the two and the mode workBenches'
		# `setup-claude-profiles.sh` writes this same file at, so an installer
		# that left it wider would be silently undone or would widen it behind
		# that script's back.
		#
		# THIS CHMOD CAN FAIL FOR THE SAME REASON `unplaceable_kind`'s CAN (#44
		# round 1, the suppressed comment at `openRepoTools:880`): a
		# `settings.json` this euid can write but does not own takes `jq` and
		# every check `plan_hook_merge` puts to it, then refuses the mode
		# stamp, with the seventeen commands, the skills and the command files —
		# twenty-nine of the thirty-one artifacts — already placed. The guard that
		# would catch it first is the same `[ -O ]` `unplaceable_kind`'s own
		# comment declines, for the same reason: no test in this suite can
		# make a second account to own this file, and the check would refuse a
		# root `--install` into another user's home, where this `chmod` does
		# in fact succeed. The failure stays a `die` naming this file.
		if mode_is 600 "$settings"; then
			say "SessionStart hook: already installed in $settings (unchanged)"
		else
			# A LINK MADE SINCE PLANNING IS NOT A FILE TO STAMP (#331). `mode_is`
			# reads a link's OWN mode, which a link `ln -s` makes does not have
			# at 600, so a link lands here and the `chmod` below would follow it
			# to the file at its far end. Asked after `mode_is`, as the last
			# question before the `chmod`.
			[ ! -L "$settings" ] || settings_link_since_planning "$settings"
			chmod 600 "$settings" ||
				die "could not set mode 600 on $settings, which already carries this entry.
    Nothing in that file was changed."
			say "SessionStart hook: already installed in $settings (mode restored to 600)"
		fi
		;;
	esac
	case "$GUARD_PLAN" in
	present)
		# THE GUARD ENTRY'S OWN LINE, AND NO SECOND `chmod`: the mode belongs to
		# the FILE and not to either entry, so the arm above has already asked
		# for it on every run that reaches this one. Saying it twice would tell
		# a person their settings were re-moded twice for one file.
		say "UserPromptSubmit guard: already installed in $settings (unchanged)"
		;;
	esac
	# ONE WRITE FOR THE TWO ENTRIES: they live in one file, and writing it twice
	# would move a person's settings through a state carrying one of the pair.
	if [ "$HOOK_PLAN" != present ] || [ "$GUARD_PLAN" != present ]; then
		hook_write_settings "$HOOK_MERGED" "$settings"
		case "$HOOK_PLAN" in
		nofile) say "SessionStart hook: installed in $settings (the file was created, mode 600)" ;;
		absent) say "SessionStart hook: merged into $settings (one entry added; written back at mode 600)" ;;
		esac
		case "$GUARD_PLAN" in
		nofile) say "UserPromptSubmit guard: installed in $settings (the file was created, mode 600)" ;;
		absent) say "UserPromptSubmit guard: merged into $settings (one entry added; written back at mode 600)" ;;
		esac
	fi
}

# THE TARGET DOES NOT ANSWER: the pair is DEFERRED, and each entry's line says
# what this run did about it. Nothing is added. OUR GUARD ENTRY, where the file
# carries it, is taken out — an entry calling a path that does not answer
# `guard` fails every prompt, by exit 127, by exit 126 or by `unknown
# subcommand`'s 2 — and the file is written back at 600 with every other hook
# where it was. Our `SessionStart` entry, where it is there, is LEFT: its
# `|| true` keeps it from failing a session, and the file that carries it keeps
# the mode this installer stamps on it. No line here says `unchanged` or
# `installed`, so a deferred run's count is the twenty-nine it placed.
hook_pair_defer() {   # <settings>
	local settings="$1" wrote=0
	if [ "$GUARD_PLAN" = present ]; then
		[ -z "$HOOK_STRIP_WHY" ] ||
			die "$(hook_strip_refusal "Whatever the lines above report is placed.")"
		hook_write_settings "$HOOK_DEFERRED" "$settings"
		wrote=1
	fi
	case "$HOOK_PLAN" in
	present)
		if [ "$wrote" -eq 1 ] || mode_is 600 "$settings"; then
			say "SessionStart hook: left in $settings as an earlier run placed it (it ends in \`|| true\`, so it cannot fail a session while the pair is deferred)"
		else
			# THE SAME QUESTION AS `hook_pair_merge`'s, for the same reason (#331).
			[ ! -L "$settings" ] || settings_link_since_planning "$settings"
			chmod 600 "$settings" ||
				die "could not set mode 600 on $settings, which already carries the SessionStart entry.
    Nothing in that file was changed."
			say "SessionStart hook: left in $settings as an earlier run placed it (it ends in \`|| true\`, so it cannot fail a session while the pair is deferred; mode restored to 600)"
		fi
		;;
	*)
		say "SessionStart hook: deferred, not added to $settings, because ${HOOK_TARGET_WHY}"
		;;
	esac
	case "$GUARD_PLAN" in
	present)
		say "UserPromptSubmit guard: REMOVED from $settings, because ${HOOK_TARGET_WHY}, and left there it would fail every prompt. Only that entry was taken out: every other hook is where it was, and the file was written back at mode 600"
		;;
	*)
		say "UserPromptSubmit guard: deferred, not added to $settings, because ${HOOK_TARGET_WHY}"
		;;
	esac
	hook_pair_remedy
}
