#!/usr/bin/env bash
#
# lane-start — the FIRST act of a lane: name the tmux window after the lane,
# put the lane's row in the register, and launch the session under the same
# name. One command at the boundary, so the three things that must agree are
# set in one act and cannot drift apart.
#
# THE LANE RULE (Brett Heap, 2026-09-10)
#   lane = tmux window name = Claude session name, in the form
#   `<repo>-<position across, left to right>`. The working directory confers
#   NO lane — two lanes may share one; a window still called `claude` has no
#   lane at all; and whether a name is free is decided by whether the
#   register row's recorded session id is LIVE, never by whether a row exists.
#
# PROTOCOL  ~/.agents/protocols/lane-collision-protocol.md
#   Rule 4 + Amendment 2 — the window is NAMED for the lane BEFORE the row is
#     appended, and peers are addressed by that name.
#   Rule 9 + Amendment 5 — every register write is one commit, made by
#     lanes-edit.sh, in the person's workspace repository.
#   Rule 10 — every row names its workstation.
#   Amendment 6 (DRAFT 2026-09-11, awaiting Brett Heap's word) — A LANE IS
#     RESUMED BY THE SESSION ID ITS ROW RECORDS, NEVER BY ITS TITLE. Titles are
#     not unique: `claude --help` says `-r, --resume [value]` is "Resume a
#     conversation by session ID, or open interactive picker with optional
#     search term", so only a session id is an exact resume — a title merely
#     filters the picker. On 2026-09-11 four transcripts in one working
#     directory carried the title `codeXfactory-1` and eight more carried
#     `codeXfactory-1 (2)` / `(4)`, while the session Brett was actually
#     driving carried no title at all.
#
# USAGE
#   lane-start [options] <repo> <n>      # lane-start openRepoShape 2
#   lane-start [options] <repo>-<n>      # the full lane name works too
#   lane-start [options] <n>             # <repo> = basename of the cwd's git root
#   lane-start --dir <path> <lane>       # any lane name, when --dir says where
#
# <repo> is parsed out of the lane name only because it is what locates the
# lane's directory. With `--dir` there is nothing left to parse, so the name is
# taken VERBATIM — which is how a lane named before the `<repo>-<n>` rule
# (`browser-ui-repair`) is started.
#
# OPTIONS
#   --dir <path>     the lane's checkout            (default $PROJECTS_ROOT/<repo>)
#   --estate <name>  the handoff estate folder      (default <repo>)
#   --dry-run        print every step; rename nothing, write nothing, launch
#                    nothing
#   --no-launch      do everything except the launch, and print the claude
#                    command on stdout — for the launcher integration and the
#                    tests
#   -h, --help
#   --               everything after it is passed through to claude
#
# WHAT IT DOES, in order
#   1. derives LANE=<repo>-<n> and the lane's directory (which must exist);
#   2. refuses unless it is already inside tmux: it renames the window it is
#      run in and never creates a session;
#   3. LIVENESS CHECK, before it takes the name. If the register already has a
#      row for LANE it reads the session id(s) out of that row's session cell
#      and looks for a LIVE record (pid alive, start time still matching, a
#      status that is not `ended`) in every profile's `sessions/*.json`. A live
#      holder in ANOTHER tmux window is a refusal. A row whose recorded
#      sessions are all dead is a lane you are RESUMING, and that is allowed;
#   4. `tmux rename-window <LANE>` — which also turns automatic-rename OFF for
#      that window (tmux(1) rename-window), so the name survives the next
#      command the window runs;
#   5. the row: `lanes-edit.sh add-row` when there is none, otherwise
#      `append-row-status`. Never a hand edit and never a whole-file write;
#   6. the launch. It is DECIDED in step 5a, before the row is written, because
#      a brand-new session's id is minted there and step 5 must record it.
#      RESUME BEATS NEW throughout — a rename into a title that is still held
#      mints `<LANE> (2)` and the lane loses its address. Three cases, in order:
#        a. `exec claude --resume <id>`, where <id> is THE LAST session id in
#           the row's session cell and `<projects state>/<cwd key>/<id>.jsonl`
#           exists. Exact: that conversation and no other.
#        b. `exec claude --resume <LANE>` when no recorded id resolves but a
#           transcript here carries the custom title <LANE> — or `<LANE> (N)`,
#           which is the same lane: that suffix is what a rename into a title
#           something else still holds mints, and the liveness check has always
#           read it that way. THE FALLBACK, not the rule — it opens the picker
#           filtered by the title, and several transcripts can share one title.
#           A suffix found here is reported: it means a stale holder was live,
#           and the cure is to retire the holders, not to live with `(4)`.
#        c. `exec claude --name <LANE> --session-id <fresh uuid>` for a lane
#           with no history here. The uuid is minted so the row can carry it,
#           which is what makes (a) work on the next start.
#
# THE RESUME TARGET — WHY THE LAST ID
#   The session cell is a HISTORY, written left to right: a lane's row reads
#   `<first> → <after the first /clear> → <after the profile switch>`, oldest
#   first, because each succeeding session appends itself. So the LAST session
#   id in the cell is the lane's current one, and that is the only id this
#   script will resume. Earlier ids are the lane's past and are never resumed
#   (a stale lineage is precisely what went wrong on 2026-09-11).
#
# KEEPING THE ROW CURRENT
#   Resuming by a recorded id only works if the row is current, so this script
#   makes it current where it can:
#     * case (c), NEW ROW — the row is created with the minted id already in
#       its session cell, instead of `pending — set by the session's first act`;
#     * case (c), EXISTING ROW — `lanes-edit.sh replace-in-row` appends
#       `→ harness <minted id>` after the cell's last id. When the cell has no
#       id to append to (some rows record only `session_…` footer ids, which
#       are not transcript ids), it prints the command and leaves the act to
#       the session — it never guesses at the cell's text;
#     * case (a) — nothing to do: the row already names the session being
#       resumed;
#     * case (b) — the id cannot be known before the picker runs, so the
#       session stamps its own row as its first act (Amendment 6(c)).
#   `--session-id` is set to LANE_START_SESSION_ID=0 to turn the minting off;
#   the row then reads `pending — set by the session's first act` as before.
#
# WHAT COUNTS AS A SESSION ID IN THE CELL
#   The TRANSCRIPT uuid — the name of the session's `<uuid>.jsonl` — and only
#   that, because it is the only id `--resume` takes and the only one the
#   liveness records key on. Some rows record a PR-FOOTER id (`session_01…`)
#   instead; those cannot be resumed or checked, so the script names them and
#   says the row needs the transcript uuid rather than treating the cell as
#   empty. Every RESUMED / handoff / takeover stamp writes the transcript uuid.
#
# OUTPUT  every step and every refusal goes to stderr; the ONLY thing written
#   to stdout is `--no-launch`'s command line, so `--no-launch` composes.
#
# EXIT
#   0  done
#   1  environment — not inside tmux, no tmux, no such directory, no register
#   2  refusal — bad arguments, a duplicated row, or the lane is live in
#      another window
#
# ENVIRONMENT
#   PROJECTS_ROOT        default ~/projects
#   LANES_FILE           default <script dir>/LANES.md
#   LANES_EDIT           default <script dir>/lanes-edit.sh
#   CLAUDE_CONFIG_DIR    the profile whose sessions/ and projects/ are read
#   CLAUDE_PROJECTS_DIR  default $CLAUDE_CONFIG_DIR/projects, else ~/.claude/projects
#   CLAUDE_BIN           default `claude` from PATH
#   LANE_START_SESSION_ID  0 turns off minting a uuid for a new session (and
#                        therefore turns off writing it into the row)
#
# It spells no absolute path of its own: the register and its writer are found
# beside this script's own REAL path (so the `~/.local/bin` symlink works), and
# everything else hangs off $HOME.

set -euo pipefail

prog=lane-start

SELF="${BASH_SOURCE[0]}"
RESOLVED="$(readlink -f -- "$SELF" 2>/dev/null || printf '%s' "$SELF")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$RESOLVED")" && pwd)"

LANES_FILE="${LANES_FILE:-$SCRIPT_DIR/LANES.md}"
LANES_EDIT="${LANES_EDIT:-$SCRIPT_DIR/lanes-edit.sh}"
PROJECTS_ROOT="${PROJECTS_ROOT:-$HOME/projects}"
CLAUDE_HOME="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
PROJECTS_STATE="${CLAUDE_PROJECTS_DIR:-$CLAUDE_HOME/projects}"
CLAUDE_BIN="${CLAUDE_BIN:-claude}"

note() { printf '%s: %s\n' "$prog" "$*" >&2; }
step() { printf '%s: %s\n' "$prog" "$*" >&2; }
plan() { printf '%s: PLAN %s\n' "$prog" "$*" >&2; }
die()  { printf '%s: %s\n' "$prog" "$1" >&2; exit "${2:-1}"; }
usage() { sed -n '3,${/^#/!q;s/^# \{0,1\}//;p}' -- "$RESOLVED"; }
quoted() { printf '%q ' "$@" | sed 's/ $//'; }

# ------------------------------------------------------------------ arguments

dry_run=0; no_launch=0; estate=""; dir_override=""
positional=(); pass=()

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run)   dry_run=1; shift ;;
    --no-launch) no_launch=1; shift ;;
    --dir)       dir_override="${2-}"; [ -n "$dir_override" ] || die "--dir needs a path" 2; shift 2 ;;
    --dir=*)     dir_override="${1#--dir=}"; shift ;;
    --estate)    estate="${2-}"; [ -n "$estate" ] || die "--estate needs a name" 2; shift 2 ;;
    --estate=*)  estate="${1#--estate=}"; shift ;;
    -h|--help)   usage; exit 0 ;;
    --)          shift; pass=("$@"); break ;;
    -*)          die "unknown option '$1' — see $prog --help" 2 ;;
    *)           positional+=("$1"); shift ;;
  esac
done

repo=""; n=""; verbatim=""
case "${#positional[@]}" in
  2) repo="${positional[0]}"; n="${positional[1]}" ;;
  1)
    arg="${positional[0]}"
    if [[ "$arg" =~ ^[0-9]+[A-Za-z]?$ ]]; then
      n="$arg"
    elif [[ "$arg" == *-* ]] && [[ "${arg##*-}" =~ ^[0-9]+[A-Za-z]?$ ]]; then
      repo="${arg%-*}"; n="${arg##*-}"
    elif [ -n "$dir_override" ]; then
      verbatim="$arg"
    else
      die "'$arg' is not a lane: a lane is <repo>-<position>, e.g. $arg-1. Run: $prog $arg <n>, or name the checkout yourself with --dir <path> to use '$arg' as the lane name" 2
    fi
    ;;
  0) usage >&2; die "a lane needs a position: $prog <repo> <n>" 2 ;;
  *) die "too many arguments: $prog <repo> <n>" 2 ;;
esac

[ -n "$verbatim" ] || [[ "$n" =~ ^[0-9]+[A-Za-z]?$ ]] || die "'$n' is not a position — the lane form is <repo>-<position across, left to right>, e.g. 2" 2

# No <repo> anywhere: the cwd's git root names it, and only its basename.
if [ -z "$repo" ] && [ -z "$verbatim" ]; then
  top="$(git rev-parse --show-toplevel 2>/dev/null || :)"
  [ -n "$top" ] || die "no <repo> given and this directory is not a git checkout — run it inside the lane's checkout, or: $prog <repo> $n" 1
  repo="$(basename -- "$top")"
fi

LANE="${verbatim:-$repo-$n}"
[[ "$LANE" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "'$LANE' is not usable as a window and session name (allowed: letters, digits, . _ -)" 2
repo="${repo:-$LANE}"          # the verbatim form has no <repo> of its own
estate="${estate:-$repo}"

# The position after this one, for the refusal to name. `10#` because a lane
# may be `-08` and 08 is not a number in base 8.
if [[ "$n" =~ ^[0-9]+$ ]]; then next_n="$((10#$n + 1))"; else next_n="<the next free position>"; fi

if [ -n "$dir_override" ]; then DIR="$dir_override"; else DIR="$PROJECTS_ROOT/$repo"; fi
[ -d "$DIR" ] || die "no such directory: $DIR — pass --dir <path> if this lane's checkout is somewhere else" 1
DIR="$(cd -- "$DIR" && pwd)"
DIR_REAL="$(cd -- "$DIR" && pwd -P)"

[ -f "$LANES_FILE" ] || die "no register at $LANES_FILE — this script must sit beside LANES.md (or set LANES_FILE)" 1
[ -x "$LANES_EDIT" ] || die "no register writer at $LANES_EDIT — it must sit beside LANES.md (or set LANES_EDIT)" 1

step "lane $LANE · dir $DIR · estate $estate"

# ----------------------------------------------------------------- 2. in tmux

[ -n "${TMUX:-}" ] || die "run this inside the tmux window that will carry the lane — it renames that window and never creates a tmux session" 1
command -v tmux >/dev/null 2>&1 || die "tmux is not on PATH, but \$TMUX is set — this environment is inconsistent" 1
this_window="$(tmux display-message -p '#{session_name}:#{window_id}' 2>/dev/null || :)"
[ -n "$this_window" ] || die "tmux did not answer display-message — cannot tell which window this is" 1
step "this window is $this_window, named '$(tmux display-message -p '#W' 2>/dev/null || printf '?')'"

# -------------------------------------------------------- 3. liveness check

# The row, READ (never written) with the same rule lanes-edit.sh uses to find
# one: the row's FIRST backticked token is the lane name.
rows_for_lane() {
  awk -v lane="$1" '
    substr($0,1,1) == "|" {
      p1 = index($0, "`"); if (p1 == 0) next
      rest = substr($0, p1 + 1); p2 = index(rest, "`"); if (p2 == 0) next
      if (substr(rest, 1, p2 - 1) == lane) print
    }' "$LANES_FILE"
}

row="$(rows_for_lane "$LANE" || :)"
row_count=0
[ -n "$row" ] && row_count="$(printf '%s\n' "$row" | grep -c . || :)"

if [ "$row_count" -gt 1 ]; then
  die "the register has $row_count rows for lane $LANE, and lanes-edit.sh can edit neither. Merge them into one row by hand in $LANES_FILE (one line each), commit with 'LANES_LANE=$LANE lanes-edit.sh commit \"merged duplicate rows\"', then re-run" 2
fi

# Every field of a `| … |` row by position: 1 is empty (before the leading
# pipe), 2 the lane cell, 3 the session-id cell, NF-1 the state cell.
cell() { printf '%s\n' "$row" | awk -F'|' -v i="$1" '{print $i}'; }

# Only the SESSION-ID CELL is read for ids. State cells quote other lanes'
# session ids all the time ("RESUMED by <id>", "handed off to <id>"), and a
# live one of those is not this lane's holder.
# Two readings of the same cell. The liveness check below wants the SET, so it
# sorts; the resume target wants the ORDER, because the cell is a history and
# its LAST id is the lane's current session (see THE RESUME TARGET above).
session_ids=""
session_ids_ordered=""
if [ "$row_count" = 1 ]; then
  session_ids_ordered="$(cell 3 | grep -oiE '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' | tr 'A-F' 'a-f' || :)"
  [ -n "$session_ids_ordered" ] && session_ids="$(printf '%s\n' "$session_ids_ordered" | sort -u)"
  id_count=0; [ -n "$session_ids" ] && id_count="$(printf '%s\n' "$session_ids" | grep -c . || :)"
  step "the register already has a row for $LANE; its session cell names $id_count session id(s)"
  # A row may record only `session_01…` FOOTER ids. Those are not transcript
  # ids: a transcript is `<uuid>.jsonl`, so a footer id can neither be checked
  # for liveness nor resumed. Name the gap rather than behave as if the cell
  # were empty — that silence is what made 2026-09-11 hard to diagnose.
  if [ "$id_count" = 0 ]; then
    footer_ids="$(cell 3 | grep -oE 'session_[A-Za-z0-9]{10,}' | sort -u || :)"
    if [ -n "$footer_ids" ]; then
      note "the cell records only PR-footer ids ($(printf '%s' "$footer_ids" | tr '\n' ' ')), which are not transcript ids — so this lane has no liveness check and no resume target. Its session must stamp its TRANSCRIPT uuid (the name of its <uuid>.jsonl) on the row."
    fi
  fi
else
  step "the register has no row for $LANE yet"
fi

session_files() {
  find "$HOME/.claude-profiles/profiles" -path '*/sessions/*.json' -type f 2>/dev/null || :
  find "$HOME/.claude/sessions" -maxdepth 1 -name '*.json' -type f 2>/dev/null || :
}

jstr() { printf '%s' "$1" | grep -o "\"$2\":\"[^\"]*\"" | head -n1 | sed 's/^.*":"//; s/"$//'; }
jnum() { printf '%s' "$1" | grep -o "\"$2\":[0-9][0-9]*" | head -n1 | sed 's/^.*://'; }

# Alive, and still the SAME process: /proc/<pid>/stat field 22 is the start
# time the record wrote down, so a recycled pid does not read as a live lane.
# The comm field can hold spaces and parentheses, so fields are counted from
# after the last ')' — field 22 overall is field 20 of what remains.
pid_alive() {
  local pid="$1" want="$2" statline rest
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  [ -n "$want" ] || return 0
  [ -r "/proc/$pid/stat" ] || return 0
  statline="$(cat "/proc/$pid/stat" 2>/dev/null || :)"
  rest="${statline##*) }"
  # shellcheck disable=SC2086
  set -- $rest
  [ "$#" -ge 20 ] || return 0
  [ "${20}" = "$want" ]
}

# Prints "<id>\t<tmux target>\t<name>\t<pid>" for the first LIVE session that
# holds this lane, or nothing. A record whose session NAME is some other lane
# is NOT a holder: a session that retired from a lane and was renamed is still
# recorded in the old row (this register has such rows today), and refusing on
# it would lock a free name forever. `<lane> (2)` counts as the lane — that
# suffix is exactly what a collided rename mints.
live_holder() {
  local pats=() id f blob pid name status target base sid
  for id in $session_ids; do pats+=(-e "\"sessionId\":\"$id\""); done
  [ "${#pats[@]}" -gt 0 ] || return 1
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    blob="$(cat -- "$f" 2>/dev/null || :)"
    sid="$(jstr "$blob" sessionId)"
    status="$(jstr "$blob" status)"
    case "$status" in ended|exited|dead|stopped) continue ;; esac
    pid="$(jnum "$blob" pid)"
    pid_alive "$pid" "$(jstr "$blob" procStart)" || continue
    name="$(jstr "$blob" name)"
    base="${name% (*)}"
    if [ -n "$base" ] && [ "${base,,}" != "${LANE,,}" ]; then continue; fi
    target="$(jstr "$blob" tmux)"
    printf '%s\t%s\t%s\t%s\n' "$sid" "$target" "$name" "$pid"
    return 0
  done < <(session_files | tr '\n' '\0' | xargs -0 -r grep -l -F "${pats[@]}" 2>/dev/null || :)
  return 1
}

holder_here=0
if [ -n "$session_ids" ]; then
  if holder="$(live_holder)"; then
    IFS=$'\t' read -r h_id h_target h_name h_pid <<<"$holder"
    if [ "${h_target%.*}" = "$this_window" ]; then
      holder_here=1
      step "this window's own session $h_id (pid $h_pid, name '${h_name:-none}') already holds $LANE — carrying on"
    else
      note "lane $LANE is live in session $h_id (tmux ${h_target:-unknown}); take $repo-$next_n or resume that window"
      note "  $prog $repo $next_n"
      note "  tmux switch-client -t ${h_target%.*}     # or go to the window that holds it"
      exit 2
    fi
  else
    step "no live session holds $LANE — this is a resume of a lane whose sessions have all ended"
  fi
fi

# ------------------------------------------------------- 4. name the window

if (( dry_run )); then
  plan "tmux rename-window $LANE   (also turns automatic-rename off for this window)"
else
  tmux rename-window "$LANE"
  step "window renamed to $LANE (automatic-rename is now off for it)"
fi

# ------------------------------------------------- 5a. what will be launched
#
# Decided BEFORE the row is written: a brand-new session's id is minted here
# and step 5 has to record it.

# Claude keeps one transcript directory per working directory, named by that
# path with every non-alphanumeric character turned into '-'. A lane reached
# through a symlink has two spellings, so both are searched.
sanitize() { printf '%s' "$1" | tr -c 'A-Za-z0-9' '-'; }

transcript_dirs() {
  printf '%s\n' "$PROJECTS_STATE/$(sanitize "$DIR")"
  [ "$DIR_REAL" = "$DIR" ] || printf '%s\n' "$PROJECTS_STATE/$(sanitize "$DIR_REAL")"
}

# The transcript of ONE recorded session id, in this directory.
recorded_transcript() {
  local id="$1" d
  [ -n "$id" ] || return 1
  while IFS= read -r d; do
    if [ -f "$d/$id.jsonl" ]; then printf '%s\n' "$d/$id.jsonl"; return 0; fi
  done < <(transcript_dirs)
  return 1
}

# A `/rename` is a `{"type":"custom-title",…}` record inside the transcript,
# and the LAST one wins — a session renamed away from this lane must not be
# resumed by it. Several transcripts can still carry one title; that is why
# this is only the fallback.
# `<LANE> (2)` is the SAME lane: that suffix is exactly what a rename into a
# title something else still holds mints, and live_holder() already reads it
# that way. A matcher that insisted on the bare string would hide a lane from
# itself — this orchestrator's own title on 2026-09-11 was `codeXfactory-1 (4)`.
titled_transcript() {
  local d f last title base
  while IFS= read -r d; do
    [ -d "$d" ] || continue
    for f in "$d"/*.jsonl; do
      [ -e "$f" ] || continue
      last="$(grep '^{"type":"custom-title"' -- "$f" 2>/dev/null | tail -n1 || :)"
      [ -n "$last" ] || continue
      title="$(printf '%s' "$last" | sed 's/.*"customTitle":"//; s/".*//')"
      base="${title% (*)}"
      if [ "$base" = "$LANE" ]; then printf '%s\t%s\n' "$f" "$title"; return 0; fi
    done
  done < <(transcript_dirs)
  return 1
}

new_uuid() {
  if [ -r /proc/sys/kernel/random/uuid ]; then cat /proc/sys/kernel/random/uuid
  elif command -v uuidgen >/dev/null 2>&1; then uuidgen | tr 'A-F' 'a-f'
  else return 1
  fi
}

row_sid=""
[ -n "$session_ids_ordered" ] && row_sid="$(printf '%s\n' "$session_ids_ordered" | tail -n1)"

new_sid=""
if [ -n "$row_sid" ] && rec_file="$(recorded_transcript "$row_sid")"; then
  step "the row's current session is $row_sid and its transcript is here ($(basename -- "$rec_file")) — resuming it by id"
  (( holder_here )) && step "  (it is the session live in this window; --resume attaches to the same conversation)"
  cmd=("$CLAUDE_BIN" --resume "$row_sid")
elif titled="$(titled_transcript)"; then
  transcript="${titled%%$'\t'*}"; found_title="${titled#*$'\t'}"
  [ -n "$row_sid" ] && note "the row's last session id $row_sid has no transcript for this directory — falling back to the title"
  step "a transcript here carries the title '$found_title' ($(basename -- "$transcript")) — resume beats new"
  [ "$found_title" = "$LANE" ] || note "  that title carries a dedupe suffix, so another holder of '$LANE' was live when it was renamed: retire the stale holders (lane-end --retire, or retitle them '<lane> · retired <date>') and end idle background sessions still holding the name"
  note "  '--resume $LANE' FILTERS THE PICKER, it does not resume exactly: pick the lane's own session, then put its id in the row's session cell"
  (( holder_here )) && step "  (that session is the one live in this window; --resume attaches to the same conversation)"
  cmd=("$CLAUDE_BIN" --resume "$LANE")
else
  step "nothing here to resume for $LANE — a new session takes the name"
  cmd=("$CLAUDE_BIN" --name "$LANE")
  if [ "${LANE_START_SESSION_ID:-1}" != 0 ]; then
    if new_sid="$(new_uuid)"; then
      while recorded_transcript "$new_sid" >/dev/null 2>&1; do new_sid="$(new_uuid)"; done
      cmd+=(--session-id "$new_sid")
      step "minted session id $new_sid — the row will carry it, so the next $prog resumes it by id"
    else
      new_sid=""
      note "no uuid source (/proc/sys/kernel/random/uuid, uuidgen): the new session's own first act must stamp its id on the row"
    fi
  fi
fi
cmd+=(${pass[@]+"${pass[@]}"})

# ------------------------------------------------------------- 5. the row

utc="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
started="$(date -u +%Y-%m-%dT%H:%MZ)"
today="$(date -u +%Y-%m-%d)"
ws="$(hostname)"
env_name="$(basename -- "$CLAUDE_HOME")"
case "$env_name" in .claude|claude) env_name=default ;; esac
user="$(id -un)"
handoff="handoffs/$estate/session-handoff-$today-lane-$LANE.md"

# The session cell of a NEW row names the session that is about to run,
# whenever one was minted — that is the whole point of minting it.
if [ -n "$new_sid" ]; then
  session_cell="harness \`$new_sid\` (minted by $prog, $utc)"
else
  session_cell="pending — set by the session's first act"
fi

if [ "$row_count" = 0 ]; then
  new_row="| \`$LANE\` | $session_cell | $ws / $env_name / $user | $started | none | $handoff | STARTING |"
  if (( dry_run )); then
    plan "lanes-edit.sh add-row"
    plan "  $new_row"
  else
    LANES_LANE="$LANE" "$LANES_EDIT" add-row "$new_row"
    step "row added"
  fi
else
  status_text="$utc lane-start on $ws: window renamed, launching $(quoted "${cmd[@]}")"
  if (( dry_run )); then
    plan "lanes-edit.sh append-row-status $LANE \"$status_text\""
  else
    LANES_LANE="$LANE" "$LANES_EDIT" append-row-status "$LANE" "$status_text"
    step "row status appended"
  fi

  # An EXISTING row that is about to run a NEW session: append the minted id
  # after the cell's last id, so the next start resumes by id instead of by
  # title. The append is `replace-in-row`, which refuses unless its anchor
  # occurs exactly once in the row — so a failure here is a refusal, never a
  # corruption, and it never fails the launch.
  if [ -n "$new_sid" ]; then
    stamp_hint="LANES_LANE=$LANE $LANES_EDIT replace-in-row $LANE \"<the session cell's text>\" \"<that text> → harness \\\`$new_sid\\\`\""
    if [ -z "$row_sid" ]; then
      note "the row's session cell records no session id this script can read (some rows carry only \`session_…\` footer ids). STAMP IT AS THIS SESSION'S FIRST ACT:"
      note "  $stamp_hint"
    elif (( dry_run )); then
      plan "lanes-edit.sh replace-in-row $LANE '$row_sid' '$row_sid → harness \`$new_sid\`'"
    elif LANES_LANE="$LANE" "$LANES_EDIT" replace-in-row "$LANE" "$row_sid" "$row_sid → harness \`$new_sid\`" "session cell: $prog minted $new_sid for this window"; then
      step "session cell updated: $row_sid → $new_sid"
    else
      note "the session cell was NOT stamped ($row_sid is not unique in the row). STAMP IT AS THIS SESSION'S FIRST ACT:"
      note "  $stamp_hint"
    fi
  fi
fi

# ---------------------------------------------------------------- 6. launch
#
# `cmd` was decided in 5a, before the row was written.

if (( no_launch )); then
  quoted "${cmd[@]}"; printf '\n'
  step "--no-launch: the command above was printed, not run (its cwd would be $DIR)"
  exit 0
fi

if (( dry_run )); then
  plan "cd $DIR"
  plan "exec $(quoted "${cmd[@]}")"
  step "--dry-run: nothing was renamed, written or launched"
  exit 0
fi

cd -- "$DIR"
step "exec: $(quoted "${cmd[@]}")"
exec "${cmd[@]}"
