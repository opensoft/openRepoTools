  if [ -n "$ls_home" ]; then
    ls_tried="the default $ls_where, the project.yaml legs of $ls_home, and a checkout of $ls_home one or two levels under $PROJECTS_ROOT"
  else
    ls_tried="the default $ls_where. This lane has no home on record either, so there was nothing to prove a candidate against"
  fi
  die "lane $LANE has no recorded checkout and none could be PROVED, so nothing was started.
    Tried: $ls_tried.
    Name it once, and every later start reads it back out of the lane's own log:
      lane-start --dir <path> $repo $ls_pos
    Nothing here guesses. This script writes the lane HOME from the directory's
    origin, and a directory that merely has the right name would re-home the lane
    for every \`#n\` it writes afterwards (Amendment 11 clause (c); Evidence 7,
    brettheap/new-workstation#20 comment 5656793094)." 2
fi
DIR="$(cd -- "$DIR" && pwd)"
DIR_REAL="$(cd -- "$DIR" && pwd -P)"
[ "$DIR_SOURCE" = "--dir" ] || step "dir $DIR, from $DIR_SOURCE (Amendment 11 clause (c))"

# THE DIRECTORY THIS SCRIPT IS ABOUT TO RECORD MUST BE READABLE BACK OUT OF THE
# LINE THAT RECORDS IT (clause (c), and Amendment 8(b)'s same refusal for
# `window`). `, ` and ` — ` are what divide an event line into its fields and
# its free text, `; ` is what divides the payload's SUB-FIELDS from each other,
# and a `"` is what clause (c) uses to make a path with a space ONE ref under
# Amendment 7(b)'s grammar — so a path carrying any of the four is REFUSED,
# naming the path, rather than truncated, escaped or appended. A log whose own
# parser cannot read a line is a log that has lost the fact.
#
# `; ` WAS THE ONE THIS FENCE DID NOT HAVE, and clause (c) names it in the same
# breath as the other two: *"A value containing `, `, ` — ` or `; ` is refused,
# exit 2, naming it — not truncated, not escaped, and not appended."* The
# `/lane-swap` skill, the other writer the clause names, has refused all three
# since `68614bf`; this one refused two of them and the quoting does NOT cover
# the gap. `payload_subfield` splits on `; ` BEFORE it honours a quote
# (`lanes-edit.sh:payload_subfield`), so `dir "/p/a; b"` — quoted, because it
# carries a space — splits into `dir "/p/a` and `b"`, and `lane-dir` answers
# `"/p/a`: a path that is wrong, carries a quote mark, and was never written by
# anyone. That is Evidence 3's failure exactly, in a file nothing rewrites.
case "$DIR" in
  *', '*|*' — '*|*'; '*|*'"'*)
    die "this lane's directory is $DIR, and a \`dir\` sub-field may not contain ', ', ' — ', '; ' or '\"': those are what divide an event line into its fields, its sub-fields and its free text, and the log is append-only, so a line written wrong there is wrong for ever. Move the checkout, or start the lane with --dir <a path without them>" 2 ;;
esac

# THIS LANE'S OWN ARGUMENTS, so no hint this script prints ever hands a reader a
# `<repo> <n>` to translate while the script holds both (F-B6's rule, on this
# side of the seam). A lane named before the `<repo>-<position>` rule has no
# position to print and is started through `--dir`, exactly as it was here.
if [ -n "$n" ]; then self_args="$repo $n"; else self_args="--dir $DIR $LANE"; fi

step "lane $LANE · dir $DIR · estate $estate"

# ----------------------------------------------------------------- 2. in tmux

[ -n "${TMUX:-}" ] || die "run this inside the tmux window that will carry the lane — it renames that window and never creates a tmux session" 1
command -v tmux >/dev/null 2>&1 || die "tmux is not on PATH, but \$TMUX is set — this environment is inconsistent" 1
this_window="$(tmux display-message -p '#{session_name}:#{window_id}' 2>/dev/null || :)"
[ -n "$this_window" ] || die "tmux did not answer display-message — cannot tell which window this is" 1
this_window_name="$(tmux display-message -p '#W' 2>/dev/null || :)"
# AMENDMENT 11 CLAUSE (c) — THE WINDOW SUB-FIELD IS `<tmux session>:<window
# index> <@window id>`, TWO SPACE-SEPARATED REFS IN ONE SUB-FIELD, and neither
# of them is the `<session>:<@id>` above. That one is the harness's own `tmux`
# spelling and is what `window-session` matches a session record on; the
# record's refs are a person's `<session>:<index>` and tmux's own `<@id>`,
# which is what clause (b)'s precedence 3 and clause (h)'s `window-lane` match.
# Reading one for the other is how a record would name a window nothing can
# resolve, so both are captured here, from tmux, and neither is derived from
# the other.
this_window_ref="$(tmux display-message -p '#{session_name}:#{window_index}' 2>/dev/null || :)"
this_window_id="$(tmux display-message -p '#{window_id}' 2>/dev/null || :)"
record_window="$this_window_ref"
# THE ID IS WRITTEN WHERE ONE IS KNOWABLE AND THE SUB-FIELD IS THE REF ALONE
# WHERE IT IS NOT: a record with no id is COMPLETE, because the NAME is the key
# (clause (b)) and the id is information (ratified decision 5). A tmux server
# restart, a workstation reboot or a swap taken from a terminal that is then
# closed all leave a recorded id naming nothing, and a binding keyed on the id
# would lose the lane where one keyed on the name does not.
# AND AN ID IS `@<digits>` AND NOTHING ELSE (F-X13(a)). `@*` accepted anything
# that merely STARTED with an at-sign, and two things that are not ids do: a
# tmux too old to know `#{window_id}` PRINTS THE FORMAT BACK, and a shim on
# PATH may print anything at all. Either one recorded here is a lie in an
# append-only log — and worse than an absence, because the sub-field would then
# name a window `window-lane` can never resolve while looking complete.
# `claude-profile` makes exactly this check on exactly this value
# (`workBenches#71`'s `lane-swap` skill, `:239-240`: `[[ "$win_id" =~
# ^@[0-9]+$ ]]`), and two writers of one field with two standards is the drift
# this branch removes everywhere else.
#
# Written as a `case` rather than `[[ =~ ]]` to match this file's own style for
# this test: `@` alone is not an id, and `@` followed by any non-digit is not
# one either.
case "$this_window_id" in
  @) : ;;
  @*[!0-9]*) : ;;
  @*) record_window="$this_window_ref $this_window_id" ;;
esac
case "$record_window" in
  *', '*|*' — '*|*'"'*)
    die "this window's tmux refs are '$record_window', and a \`window\` sub-field may not contain ', ', ' — ' or '\"' (Amendment 8(b), extended by Amendment 11 clause (c) to \`dir\`): those are what divide an event line into its fields and its free text, and the log is append-only. Rename the tmux session" 2 ;;
esac
step "this window is $this_window, named '${this_window_name:-?}'"
step "  its record refs are $record_window"

# -------------------------------------------------------- 3. liveness check

# The row, READ (never written) with the same rule lanes-edit.sh uses to find
# one: the row's FIRST backticked token is the lane name.
# AMENDMENT 15 — `tolower` ON BOTH SIDES, exactly as `row_line` now compares.
# This read is what decides "is this lane new", and it was the byte-for-byte
# comparison that let `lane-start openxfactory 2` add a SECOND row for
# `openXfactory-2` at 2026-09-13T23:51:56Z. Case-insensitive, the lane is found,
# the branch below is the RESUME branch, and `add-row` is never reached.
rows_for_lane() {
  awk -v lane="$1" '
    substr($0,1,1) == "|" {
      p1 = index($0, "`"); if (p1 == 0) next
      rest = substr($0, p1 + 1); p2 = index(rest, "`"); if (p2 == 0) next
      if (tolower(substr(rest, 1, p2 - 1)) == tolower(lane)) print
    }' "$LANES_FILE"
}
# The names those rows carry — which under Amendment 15 may be two spellings of
# ONE name, and a refusal that could not say so would send a person looking for
# a duplicate that is not there to find.
row_names_for_lane() {
  awk -v lane="$1" '
    substr($0,1,1) == "|" {
      p1 = index($0, "`"); if (p1 == 0) next
      rest = substr($0, p1 + 1); p2 = index(rest, "`"); if (p2 == 0) next
      t = substr(rest, 1, p2 - 1)
      if (tolower(t) == tolower(lane)) print t
    }' "$LANES_FILE"
}

row="$(rows_for_lane "$LANE" || :)"
row_count=0
[ -n "$row" ] && row_count="$(printf '%s\n' "$row" | grep -c . || :)"

if [ "$row_count" -gt 1 ]; then
  rfl_names="$(row_names_for_lane "$LANE" | tr '\n' ' ')"
  rfl_distinct="$(row_names_for_lane "$LANE" | LC_ALL=C sort -u | grep -c . || :)"
  rfl_why="and lanes-edit.sh can edit neither"
  if [ "$rfl_distinct" -gt 1 ]; then
    # BRACED, AND THE BRACES ARE LOAD-BEARING (A9 Addendum 4, R-A9-11): bash
    # decides where a variable NAME ends with `isalnum()`, which is LOCALE-
    # DEPENDENT, and bash 3.2 on Darwin under the runner's `en_US.UTF-8` reads
    # the three bytes of `—` as name characters — so this looks up
    # `rfl_names—`, which `set -u` then kills the script over. Caught by
    # `test_no_shipped_bash_leaves_a_variable_name_to_bash_3_2s_locale`, which
    # is the rule this repository already learned once.
    rfl_why="spelled ${rfl_names}— a lane name is ONE name under any case (Amendment 15), so those are two rows for ONE lane, and lanes-edit.sh can edit neither"
  fi
  die "the register has $row_count rows for lane $LANE, $rfl_why. Merge them into one row by hand in $LANES_FILE (one line each) — Amendment 15(d): append the newer row's session id(s) to the older row's session cell, in order, and remove the newer row in the SAME commit, whose message names both spellings — then commit with 'LANES_LANE=$LANE lanes-edit.sh commit \"merged duplicate rows\"' and re-run" 2
fi

# AND EVERYTHING THIS SCRIPT DECIDES FROM THE ROW IS DECIDED AGAINST WHAT HAS
# LANDED, not against this checkout. `$LANES_FILE` is the working tree, and a
# `git fetch` does not move it: a row another workstation added and pushed, or a
# uuid it stamped on an existing row, is simply absent here until something
# pulls. Two decisions turn on that row and BOTH used to read the working tree.
#   "IS THIS LANE NEW" — reaching `add-row` on that reading appends a SECOND row
#     (`add-row` checks the working tree too, and `commit_push`'s rebase then
#     brings the peer's row in underneath it), and two rows for one lane is a
#     register no helper can edit at all, because `row_line` requires exactly one.
#   "WHICH SESSION IS THIS LANE'S" — the resume target, the id in the status
#     appended to the row, and the uuid stamped on the RESUMED / STARTED line
#     (see THE RESUME TARGET above).
# So: ask for the PUBLISHED row ONCE, here, for both. 0 and 8 are the answers;
# anything else is the helper failing, and this script decides nothing about a
# row on an answer it did not get. LANES_NO_FETCH=1 is honoured inside the
# helper, for an offline start.
pub_rc=0
pub_row="$("$LANES_EDIT" register-row "$LANE" 2>/dev/null)" || pub_rc=$?
if [ "$row_count" = 0 ]; then
  case "$pub_rc" in
    8) : ;;                        # no published row either: the lane really is new
    0)
      note "the register on origin/main ALREADY has a row for $LANE, and this checkout does not:"
      pub_row_first="${pub_row%%$'\n'*}"
      printf '  %s\n' "${pub_row_first:0:200}" >&2
      note "adding a row here would make two, and two rows for one lane is a register lanes-edit.sh cannot edit."
      note "RECOVERY — bring this checkout up to date, then re-run this command:"
      note "  git -C \"$(cd -- "$(dirname -- "$LANES_FILE")/.." && pwd)\" pull --rebase origin main"
      die "refusing to add a second row for $LANE" 2 ;;
    *)
      note "the helper's own output is above."
      die "$LANES_EDIT register-row $LANE failed (exit $pub_rc). That is NOT 'the register has no row for $LANE', and this script will not add a row on an answer it did not get — a duplicate row is a register no helper can edit. Fix the helper (or run it by hand: $LANES_EDIT register-row $LANE), then re-run." 1 ;;
  esac
else
  case "$pub_rc" in
    0) : ;;
    8)
      # A row HERE and none on `origin/main`: it is in a commit this checkout
      # has not pushed, or on another branch. There is then no published cell,
      # so there is no recorded session to resume — and this script does not
      # fall back to the working tree, because falling back is the fault. The
      # ids below are named as DIAGNOSTICS, never as a target: nothing outside
      # this checkout can see them. `lane-end`'s refusal reads `origin/<branch>`
      # for the same reason and cannot see an unpushed line either — what has
      # landed is what other lanes can see.
      note "this checkout has a row for $LANE and the register on origin/main has none — so there is no PUBLISHED session cell, and no recorded session to resume."
      unpub_ids="$(printf '%s\n' "$row" | awk -F'|' '{print $3}' | grep -oiE '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' | tr 'A-F' 'a-f' | tr '\n' ' ' || :)"
      [ -n "$unpub_ids" ] && note "  the id(s) only this checkout's copy carries, which nothing else can see: ${unpub_ids% }"
      note "  RECOVERY — push the register from here, then re-run: git -C \"$(cd -- "$(dirname -- "$LANES_FILE")/.." && pwd)\" push origin main" ;;
    *)
      note "the helper's own output is above."
      die "$LANES_EDIT register-row $LANE failed (exit $pub_rc). That is NOT 'the register has no row for $LANE', and this script will not pick a resume target on an answer it did not get: resuming the working tree's id lands the operator in the lane's previous conversation and stamps that uuid on an append-only line. Fix the helper (or run it by hand: $LANES_EDIT register-row $LANE), then re-run." 1 ;;
  esac
fi

# Every field of a `| … |` row by position: 1 is empty (before the leading
# pipe), 2 the lane cell, 3 the session-id cell, NF-1 the state cell.
# OF THE PUBLISHED ROW. `$row` above is this checkout's, and it is read for
# exactly one thing: whether adding a row would make two. Every id this script
# acts on comes from `$pub_row`, which is empty when the published register has
# no row for the lane — the case the `8` branch above has already reported.
cell() { printf '%s\n' "$pub_row" | awk -F'|' -v i="$1" '{print $i}'; }

# Only the SESSION-ID CELL is read for ids. State cells quote other lanes'
# session ids all the time ("RESUMED by <id>", "handed off to <id>"), and a
# live one of those is not this lane's holder.
# Two readings of the same cell. The liveness check below wants the SET, so it
# sorts; the resume target wants the ORDER, because the cell is a history and
# its LAST id is the lane's current session (see THE RESUME TARGET above).
session_ids=""
session_ids_ordered=""
if [ "$row_count" = 1 ]; then
  session_ids_ordered="$(cell 3 | grep -oiE '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' | tr 'A-F' 'a-f' || :)"
  [ -n "$session_ids_ordered" ] && session_ids="$(printf '%s\n' "$session_ids_ordered" | sort -u)"
  id_count=0; [ -n "$session_ids" ] && id_count="$(printf '%s\n' "$session_ids" | grep -c . || :)"
  step "the register already has a row for $LANE; its session cell on origin/main names $id_count session id(s)"
  # A row may record only `session_01…` FOOTER ids. Those are not transcript
  # ids: a transcript is `<uuid>.jsonl`, so a footer id can neither be checked
  # for liveness nor resumed. Name the gap rather than behave as if the cell
  # were empty — that silence is what made 2026-09-11 hard to diagnose.
  if [ "$id_count" = 0 ]; then
    footer_ids="$(cell 3 | grep -oE 'session_[A-Za-z0-9]{10,}' | sort -u || :)"
    if [ -n "$footer_ids" ]; then
      note "the cell records only PR-footer ids ($(printf '%s' "$footer_ids" | tr '\n' ' ')), which are not transcript ids — so this lane has no liveness check and no resume target. Its session must stamp its TRANSCRIPT uuid (the name of its <uuid>.jsonl) on the row."
    fi
  fi
else
  step "the register has no row for $LANE yet"
fi

# LIVENESS IS ONE IMPLEMENTATION, and it lives in `lanes-edit.sh`, because
# `who` asks exactly this question about exactly these rows and two copies
# would drift. It reads the row's session cell itself and tries EVERY
# transcript uuid recorded there, not merely the last one — a lane whose
# earlier lineage is still running is still held.
#
# It also carries the `nameSource` fix: a session record's `name` is evidence
# about some OTHER lane only when a person or a peer set it. `nameSource:
# derived` is the harness naming a window after its working directory, and
# treating that as a denial reported "no live session holds <lane>" for
# sessions that plainly did (2026-09-11, the orchestrator's own window).
# ONLY 0 AND 8 ARE ANSWERS: 0 is "this record holds the lane", 8 is "no live
# record does". Any other exit is the helper FAILING, and this script must not
# read a failure as "the name is free" — renaming a running session into a
# title something else still holds is exactly what mints `<lane> (2)` and costs
# the lane its address (AGENTS.md rule 7). The first version swallowed the
# helper's stderr and treated every non-zero exit as "no holder", so a helper
# that could not run at all produced a confident "no live session holds <lane>"
# about a session that was live in another window.
live_holder() { "$LANES_EDIT" live-holder "$LANE"; }

# AND IT IS ASKED UNCONDITIONALLY. This used to run only when the row THIS
# CHECKOUT has already named a session id, which is the wrong gate twice over:
# the ids came from the working tree, which no fetch moves, so a row (or a newly
# stamped uuid) that another workstation had already published was read as "no
# ids, nothing to check"; and a lane with no row here at all skipped the check
# entirely. Both skip exactly when the answer matters — the helper owns the row
# lookup, fetches first, and unions the published ids with this checkout's (R25),
# so asking it costs one fetch and can only ever ADD a reason to refuse.
holder_here=0
LS_TMP="$(mktemp)"
holder=""; lh_rc=0
holder="$(live_holder 2>"$LS_TMP")" || lh_rc=$?
[ -s "$LS_TMP" ] && cat -- "$LS_TMP" >&2
case "$lh_rc" in
  0)
    # WHOSE SESSION IT IS COMES FROM THE HELPER (Amendment 8, ruling (g)), not
    # from a string compare on the `tmux` column here. The first version made
    # that compare, and on 2026-09-12 it refused this lane the window it was
    # running in: the record it was handed was the harness's `kind: bg`
    # COMPANION, which carries the interactive session's own `sessionId` and no
    # `tmux` at all, so `"none" != "$this_window"` and the refusal read
    # "lane openRepoProject-1 is live in session c5701b54… (tmux none)" about
    # the session typing the command. A record with no target is not a record in
    # no window — the helper now answers with `here`, `elsewhere` or `orphan`,
    # having tested `$CLAUDE_CODE_SESSION_ID`, the window, and this pane's
    # process tree in that order.
    #
    # AN EMPTY FIFTH FIELD IS A REFUSAL, not a pass: an older `lanes-edit.sh`
    # that does not send one must not be read as saying "here".
    IFS=$'\037' read -r h_id h_target h_name h_pid h_where <<<"$holder"
    case "$h_where" in
      here)
        holder_here=1
        step "this window's own session $h_id (pid $h_pid, name '${h_name:-none}') already holds $LANE — carrying on" ;;
      orphan)
        # AMENDMENT 6(d), and not a refusal. A live record that names no window
        # and is in no pane's process tree is an idle background session still
        # holding the name — the thing 6(d) says to retire. It is not in this
        # window, so it is not this window's session; it is in no window, so it
        # is nobody's rival either. Say so, name the act, and carry on.
        note "lane $LANE is named by a live record that is in NO window and not in this pane's process tree: session $h_id, pid $h_pid, name '${h_name:-none}'. That is an orphaned holder, not a rival (Amendment 6(d)) — retire it: kill $h_pid. Carrying on."
        ;;
      *)
        note "lane $LANE is live in session $h_id (tmux ${h_target:-unknown}); take $repo-$next_n or resume that window"
        note "  $prog $repo $next_n"
        note "  tmux switch-client -t ${h_target%.*}     # or go to the window that holds it"
        exit 2 ;;
    esac ;;
  8)
    if [ "$row_count" = 1 ]; then
      step "no live session holds $LANE — this is a resume of a lane whose sessions have all ended"
    else
      step "no live session holds $LANE — the register records no session for it at all, here or on origin/main"
    fi ;;
  *)
    note "the helper's own output is above."
    die "$LANES_EDIT live-holder $LANE failed (exit $lh_rc). That is NOT 'no live session holds $LANE', and this script will not rename the window on an answer it did not get: a rename into a name something still holds is what mints '$LANE (2)'. Fix the helper (or run it by hand: $LANES_EDIT live-holder $LANE), then re-run." 1 ;;
esac

# ------------------------------ 3a. the orphaned holders (Amendment 8(f))
#
# R-A8-6. Step 3 asked whether the lane's CURRENT id is held. This asks who is
# still holding its EARLIER ones — Amendment 6(d)'s orphans, the live-but-idle
# sessions that are the whole reason the `/resume` picker offered this lane two
# transcripts of which neither was the lane.
#
# IT NAMES THEM AND IT NEVER KILLS. The retire act is `kill <pid>`, printed
# here with the session id and the profile beside it so a person can check
# before running it, and run by that person. Clause (f) rules it the operator's
# act — an idle background session is exactly the shape of thing that turns out
# to be somebody's long-running job — and it never blocks or delays the launch:
# a helper too old to know the read simply says nothing.
ih_out=""; ih_rc=0
ih_out="$("$LANES_EDIT" idle-holders "$LANE" 2>/dev/null)" || ih_rc=$?
if [ "$ih_rc" = 0 ] && [ -n "$ih_out" ]; then
  note "lane $LANE: this row's EARLIER session ids are still held by live but idle sessions (Amendment 6(d) orphans). They are history, not alternatives — retire them, and $prog never does it for you:"
  while IFS=$'\t' read -r o_sid o_pid o_kind o_prof; do
    [ -n "$o_sid" ] || continue
    note "  session $o_sid (kind ${o_kind:-none}, profile ${o_prof:-unknown}) — retire it: kill $o_pid"
  done <<<"$ih_out"
fi

# THE RESUME TARGET, from the PUBLISHED cell (R33): the LAST id in it. Read
# here rather than in 5a because step 3b may replace it with an id the cell does
# not carry yet, and 5a's launch decision has to see that.
row_sid=""
[ -n "$session_ids_ordered" ] && row_sid="$(printf '%s\n' "$session_ids_ordered" | tail -n1)"

# ------------------------------------- 3b. the live session in THIS window
#
# A DIFFERENT QUESTION FROM STEP 3's, and Amendment 8 exists for the gap between
# them. Step 3 asks "is any session the ROW names alive"; this asks "what is
# live in THIS WINDOW". The harness mints a new transcript uuid with nobody
# acting — a `/clear` does it (Amendment 6, fact 4), and so did the 2026-09-12
# usage reset that carried this lane's conversation into `4a91f1dc…` while its
# row still ended on `09dd34d1…`. An id in no row is an id `live-holder` cannot
# look up: it answers 8, "this lane is parked", about the conversation sitting
# in the window it was asked about, and this script would then resume the lane's
# PREVIOUS conversation and stamp that uuid on an append-only line.
#
# So the id is taken from the record itself, and step 5 appends it to the
# session cell BEFORE it stamps — which is what makes liveness and the next
# resume follow it. There is no flag for this and there could not be one: the id
# does not exist until the session does. The act is `lane-start --no-launch` run
# IN the window, which is what the SessionStart hook's block asks the new
# session to do, and what this lane did by hand at 2026-09-12T16:59Z.
#
# A FAILED READ IS A WARNING HERE, NOT A REFUSAL, and that is not R22 being
# waived. R22 is for a read whose empty answer PERMITS something: `live-holder`
# fails closed because a rename over a live name costs a lane its address. This
# read only ever ADDS an id to a cell, and it runs after `live-holder` has
# already read the same records and refused if it could not — so a failure here
# means the records went unreadable between two calls a second apart, and the
# honest response is to say so and carry on rather than to refuse a lane its
# start.
# ------------------- AMENDMENT 18(h): ONE LIVE PROCESS PER TRANSCRIPT
#
# *"`lane-start` — every launch branch and `--no-launch`'s window-binding step —
# counts the live records carrying the id it is about to resume or bind, across
# every profile's `sessions/`, and REFUSES when a process other than this
# window's holds it, naming the pid(s), their windows or `bg`, and the retire
# act; it never appends such an id to the row and never launches a second resume
# of it."* Ratified 2026-09-14T13:15:18Z as revision 4 of Amendment 18;
# opensoft/openRepoTools#39.
#
# MEASURED, AND THAT IS WHY IT IS A REFUSAL AND NOT A NOTE. On 2026-09-14 at
# 12:05Z the harness spawned `claude --session-id d1ac715c… --fork-session` under
# a `bg-pty-host`; at 12:07Z the launcher NAMED it as a defect; at 12:10Z a
# `lane-start --no-launch openRepoTools 3` in a new window bound THAT SAME
# transcript as the row's session, seeing nothing; at 12:25Z a second `pclaude`
# resumed it interactively. Three live processes, one transcript file, and the
# retire act could not see any of them BECAUSE the row now recorded the id.
# The count below is the read that was missing, and it is asked of the id this
# run is about to write down or resume — never of the lane.
#
# IT FAILS CLOSED, AND THE THREE CODES ARE THE CONTRACT: 0 with rows, 8 with
# none, 64 a usage error, anything else a read that did not happen. A 2 is a
# `lanes-edit.sh` that predates this read — the un-upgraded workstation — and
# THAT one falls through with a note, exactly as clause (h)'s other reads do,
# because refusing every lane start on every workstation that has not installed
# this yet is not a safety property.
#
# AND THE HARNESS HAS A FENCE OF ITS OWN ON THE SAME FILE, WHICH THIS RUN MUST
# ASK BEFORE IT EXECS RATHER THAN AFTER (measured on Eagle 2026-09-15 against
# `claude` 2.1.270, and reproduced live in a scratch config directory): a
# `claude --resume <id>` whose id is carried by a live session record whose
# `kind` is anything but `interactive` REFUSES AND EXITS 1 before it starts,
# with
#
#   Error: Session <id> is running as a background session. Run `claude agents`
#   to find its id, then `claude attach <id>` to open it, or `claude stop <id>`
#   first to resume it here. Add --fork-session to branch off a copy instead.
#
# — the harness's own `H5`/`zpe` pair, which takes the FIRST live record for the
# id whose `kind !== "interactive"` (a `--bg` job, a `bg-pty-host` child, the
# `bg` COMPANION of Amendment 8 ruling (g)) and stops there. A second live
# INTERACTIVE record does NOT stop it — the same measurement got past that check
# and failed later, on authentication — which is exactly why 18(h) is this
# tooling's to enforce and not the harness's.
#
# THE COST OF ASKING IT LATE IS A FALSE `RESUMED`. The row, the object log and
# the handoff stamp are all written BEFORE the `exec` at the foot of this
# command, so a launch the harness refuses leaves a lane recorded as RESUMED by
# a session that never started, and in a launcher-created window — `pclaude
# --lane <lane> <profile>`, whose pane's only command this is — tmux prints
# `[exited]` over the message and closes it (opensoft/workBenches#77's shape,
# one door along). So the `resume` rule below asks the harness's question in
# front of the launch and prints the harness's own remedy beside this estate's.
dup_check() {   # <session uuid> <what this run was about to do with it> [<rules>]
  # THE RULES, AND THE THIRD ARGUMENT IS WHICH OF THEM APPLY:
  #   bind         (the default) 18(h)'s duplicate count alone — the
  #                window-binding call, which opens no transcript;
  #   resume       both rules — the branch that is about to `--resume` this id
  #                with no record of it in this window;
  #   resume-here  the harness's fence alone — the same branch where the id IS
  #                this window's own live session, whose duplicate count the
  #                window-binding call above has already made.
  local dc_id="${1-}" dc_why="${2-}" dc_rules="${3-bind}" dc_rows="" dc_rc=0 dc_other="" dc_bg="" dc_att=""
  local dc_pid dc_kind dc_tgt dc_prof dc_where dc_verdict dc_file
  [ -n "$dc_id" ] || return 0
  : > "$LS_TMP"
  dc_rows="$("$LANES_EDIT" transcript-holders "$dc_id" 2>"$LS_TMP")" || dc_rc=$?
  case "$dc_rc" in
    0 | 8) : ;;
    2) [ -s "$LS_TMP" ] && cat -- "$LS_TMP" >&2
       note "this \`lanes-edit.sh\` has no \`transcript-holders\` (exit 2), so whether another live process already carries $dc_id is NOT known here. Install the one beside this script (\`openRepoTools --install\`); carrying on."
       return 0 ;;
    *) [ -s "$LS_TMP" ] && cat -- "$LS_TMP" >&2
       die "$LANES_EDIT transcript-holders $dc_id exited $dc_rc, so whether another live process already carries that transcript could NOT be read — and that is not 'no other process does'. A transcript is held by ONE live process (Amendment 18(h)); nothing has been renamed, written or launched." 1 ;;
  esac
  [ "$dc_rc" = 0 ] || return 0
  while IFS=$'\037' read -r dc_pid dc_kind dc_tgt dc_prof dc_where dc_verdict dc_file; do
    [ -n "${dc_pid:-}" ] || continue
    # `unrelated` BLOCKS HERE AND NOWHERE ELSE, and the difference is the
    # question being asked. `transcript_holders` answers "who holds this
    # transcript, and what is this window's relation to them", and its
    # `unrelated` means THIS WINDOW CARRIES NO RECORD OF IT AT ALL — kept
    # silent there so that a rule about a TRANSCRIPT cannot overturn
    # `live_holder`'s verdicts about a LANE, or `forks`, from a read that was
    # asked about neither. THE QUESTION HERE IS 18(h)'s OWN and is narrower:
    # *"the id it is about to resume or bind"*. The ROW-RESUME branch reaches
    # this call only when `row_sid != win_sid`, so this window has no record of
    # that id and EVERY live holder of it comes back `unrelated` — counting
    # only `duplicate` made that branch's check one that could never fire
    # (Copilot round 1 on opensoft/openRepoTools#52). At the window-binding call
    # the id IS this window's own session, so a `here` record exists and nothing
    # is `unrelated`; one rule, two call sites, no second definition of a
    # duplicate.
    #
    # AND IT DOES NOT DECIDE WHETHER THE LANE IS TAKEN. An ORPHAN — a live but
    # idle holder of the row's id — is still reported and never refused as a
    # rival (Amendment 8(f), through `live_holder`'s own verdict, printed above
    # this with 6(d)'s act), and a `bg` companion still holds no lane. What
    # 18(h) adds is about the FILE: this branch's next act is `claude --resume
    # <that id>`, and the clause says *"it never appends such an id to the row
    # and never launches a second resume of it"*. 8(f)'s own sentence does not
    # reach that state either — it rules on *"a row's EARLIER session ids …
    # still held by live but idle sessions"*, and this is the id the row ENDS
    # on, which is the one a resume opens.
    #
    # THE HARNESS'S OWN FENCE FIRST, because it decides whether the `exec` this
    # branch is about to make can start at all, and it reads the record's KIND
    # and not this read's verdict: the `bg` COMPANION of the session live in
    # THIS window is `companion` here — benign, one session seen twice — and it
    # is still a record whose kind is not `interactive`, so `claude --resume`
    # stops on it. A record with no `kind` at all is written down as
    # `interactive` by `transcript_holders` (an older harness wrote nothing
    # else), which is the same reading the harness makes.
    if [ "$dc_rules" != bind ] && [ -n "${dc_kind:-}" ] && [ "$dc_kind" != interactive ]; then
      dc_bg="${dc_bg:+$dc_bg, }pid $dc_pid ($dc_where, kind $dc_kind, profile $dc_prof)"
      if [ -z "$dc_att" ] && [ -n "${dc_tgt:-}" ] && [ "$dc_tgt" != none ]; then
        dc_att="${dc_tgt%.*}"
      fi
    fi
    # AND IT IS NOT A SECOND VERDICT, SO IT DOES NOT `continue` PAST 18(h)'s
    # COUNT: one record can be both — a `bg` duplicate in another profile is a
    # second process on the file AND the thing the harness will stop on — and a
    # refusal that named only the newer of the two reasons would drop the one
    # this suite has asserted since #52. `resume-here` is the exception and
    # states why: the id is this window's own session, whose duplicate count the
    # window-binding call above has already made.
    [ "$dc_rules" = resume-here ] && continue
    case "$dc_verdict" in
      duplicate | unrelated) : ;;
      *) continue ;;
    esac
    dc_other="${dc_other:+$dc_other, }pid $dc_pid ($dc_where, kind $dc_kind, profile $dc_prof)"
    if [ -z "$dc_att" ] && [ -n "${dc_tgt:-}" ] && [ "$dc_tgt" != none ]; then
      dc_att="${dc_tgt%.*}"
    fi
  done <<<"$dc_rows"
  [ -n "$dc_bg" ] || [ -n "$dc_other" ] || return 0
  if [ -n "$dc_other" ]; then
    note "another live process already carries transcript $dc_id: $dc_other"
    note "A transcript is held by ONE live process (Amendment 18(h)): two of them append to one file, each overwriting what the other wrote, and a row that records it has two processes answering for one lane. This run was about to $dc_why, and it has done NOTHING — no window renamed, no id appended, no session launched."
  fi
  if [ -n "$dc_bg" ]; then
    note "a live BACKGROUND session already carries transcript $dc_id: $dc_bg"
    note "\`$CLAUDE_BIN --resume $dc_id\` would REFUSE to start against it — \"Session $dc_id is running as a background session … Add --fork-session to branch off a copy instead\" — and exit 1 before anything ran (measured against claude 2.1.270, and reproduced in a scratch configuration directory). This run was about to $dc_why, and it has done NOTHING: no window renamed, no id appended, no session launched. A lane recorded RESUMED by a launch the harness refuses is a false transition in two append-only files, and in a window a launcher has just made — \`pclaude --lane <lane> <profile>\`, whose pane's only command this is — tmux prints \`[exited]\` over the message and closes it."
    note "open the one that is running rather than a second copy of it: \`claude agents\` names its id, \`claude attach <id>\` opens it, \`claude stop <id>\` ends it."
  fi
  # WHERE THAT PROCESS IS, WHEN ITS RECORD SAYS SO (Amendment 18 Addendum 1's
  # posture: the conversation that is already live is ATTACHED, never started a
  # second time). The line is printed beside the retire act and not instead of
  # it: which of the two this is — the lane running in another window, or a
  # duplicate to retire — is the person's to read, and only one of them is a
  # window to go to.
  [ -n "$dc_att" ] && note "that process is in ${dc_att}: tmux switch-client -t $dc_att   (from outside tmux: tmux attach -t ${dc_att%%:*})"
  die "retire the other one first — \`lane-end\` proves it is this lane's duplicate and prints Amendment 6(d)'s act for it, and it ends, writes and kills nothing:
    lane-end $LANE --retire <pid>" 1
}

win_sid=""; win_target=""; win_name=""; win_pid=""; win_profile=""
: > "$LS_TMP"
win_rec=""; ws_rc=0
win_rec="$("$LANES_EDIT" window-session "$this_window" 2>"$LS_TMP")" || ws_rc=$?
[ -s "$LS_TMP" ] && cat -- "$LS_TMP" >&2
case "$ws_rc" in
  0)
    IFS=$'\037' read -r win_sid win_target win_name win_pid win_profile <<<"$win_rec"
    step "this window's live session is $win_sid (name '${win_name:-none}', pid $win_pid, profile ${win_profile:-unknown})" ;;
  8) step "no live session record names this window ($this_window)" ;;
  *)
    note "$LANES_EDIT window-session $this_window failed (exit $ws_rc) — carrying on without it. This read only ever ADDS the harness's new transcript uuid to the cell, and live-holder has already read the same records; if the cell is behind, stamp it yourself." ;;
esac

# AMENDMENT 18(h), THE WINDOW-BINDING STEP. Asked BEFORE the vetoes and before
# anything is taken: an id a second live process already carries is one this run
# must neither append to a cell nor resume, whatever the vetoes below decide
# about whose it is.
[ -n "$win_sid" ] && dup_check "$win_sid" "bind $win_sid as lane $LANE's session"

# The id the cell does not carry. `$session_ids` is the PUBLISHED set (step 3),
# so an id only this checkout knows is not treated as recorded either.
#
# NOT WHEN STEP 3 ALREADY FOUND ITS HOLDER HERE: a row whose OWN id is live in
# this window is a cell that is current by definition, and there is nothing to
# append. And only a TRANSCRIPT UUID is ever appended — a cell records those and
# only those (Amendment 6(b)), and a record carrying anything else in its
# `sessionId` is not something `--resume` could take.
# ------------------ 3b(i). THE WINDOW-NAME VETO (Amendment 11, `R-A11-12`)
#
# STEP 3b'S FENCE IS TWO VETOES AND NO PERMISSION, and this is the second of
# them. `R-A11-1` was corrected twice before it reached this shape and both
# corrections are worth the reader's time, because each one broke the mechanism
# in the opposite direction:
#
#   * the FIRST fence added "and the row carries no transcript yet", which made
#     step 3b's cell-stamping DEAD in every case it exists for — the `/clear`,
#     the usage reset, the profile switch — and was withdrawn (RV-T1);
#   * the SECOND made the window's own NAME a CONDITION FOR TAKING, and that
#     fails for every session that came up bare in a window still called
#     `claude`, which was 8 of this workstation's 16 windows and this lane three
#     times in one day (CF-T10). Its second disjunct, `live-holder` answering
#     `here`, is unreachable at the site it governs: the branch below requires
#     `holder_here = 0`.
#
# So neither is a permission. The rule is: the live session is taken UNLESS one
# of two vetoes fires.
#
#   VETO 1 — THE REGISTER. A uuid that belongs to ANOTHER ROW is never taken,
#     read through `lanes-edit.sh session-lane <uuid>` and fail-closed: only 0
#     and 8 are answers. That veto is ADOPTION ACT 0'S (`opensoft/brett-wip#5`
#     @`3719d97`), ported into this copy by `openRepoTools#24` (Amendment 9's
#     adoption act 3, MERGED as `d4b5710`), and this branch
#     does not re-implement it. THE SHA IS THE MERGE COMMIT AND NOT THE DRAFT
#     HEAD: act 0 merged 2026-09-13T19:14:37Z, squashed, so `#5`'s pre-merge
#     head `95e7a4c` is NOT an ancestor of `origin/main` and citing it names
#     something that never landed (F-X18).
#
#   VETO 2 — THE WINDOW'S NAME, and it is this PR's second layer. A window NAMED
#     FOR ANOTHER LANE is never taken. It catches what the register veto cannot:
#     a session whose uuid is in NO row at all — the harness mints one on every
#     `/clear` — running in a window that plainly belongs to somebody else. That
#     is Evidence 2(b) exactly: `lane-start openXfactory-5` typed from a window
#     named `openRepoProject-1` took this lane's live uuid as that lane's resume
#     target and planned to stamp it on that lane's row.
#
# A NAME IS A VETO AND NEVER A PERMISSION, which is the whole of `R-A11-12`: a
# window called `claude` vetoes nothing and the taking goes ahead, which is
# exactly the case the first correction was made to preserve.
# AND IT FAILS CLOSED, EXACTLY AS THE REGISTER VETO BESIDE IT DOES (`R-A11-12`;
# clause (d) rule 1, ratified verbatim): *"Both reads fail closed: any answer but
# 0 naming another lane or 8 leaves the cell and the resume target alone, because
# here an empty answer is what PERMITS the take."* Only **8** — no row knows this
# window's name — is permission. Every other code is a read that did not answer
# the question, and this is the one place where not answering it would be read as
# "the session is free": the cost of vetoing is one printed act, and the cost of
# permitting is another lane's uuid on an append-only line.
#
# THE `2` IS NAMED RATHER THAN LEFT TO BE FOUND. `register-row` exits 2 where
# `check_lane_name` refuses the string — a window name carrying a space, a slash
# or a leading `-`, which no lane name may carry (`lanes-edit.sh:1210-1215`). Such
# a window is not provably ANOTHER lane's, but it is not provably free either, and
# the ruling's words admit no third answer: it vetoes, and the note says which
# code came back so the operator can rename the window or pass --dir. A window
# named `claude`, `zsh` or anything else lane-SHAPED that no row knows exits 8 and
# still permits the take, which is what keeps the /clear, the usage reset and the
# profile switch working in the windows this estate actually has.
win_veto=""; win_veto_why=""
if [ -n "$win_sid" ] && [ -n "$this_window_name" ] && [ "$this_window_name" != "$LANE" ]; then
  if [ "$(printf '%s' "$this_window_name" | tr 'A-Z' 'a-z')" != "$(printf '%s' "$LANE" | tr 'A-Z' 'a-z')" ]; then
    wnv_rc=0
    "$LANES_EDIT" register-row "$this_window_name" >/dev/null 2>&1 || wnv_rc=$?
    case "$wnv_rc" in
      0) win_veto="$this_window_name"
         win_veto_why="which is another lane the register has a row for" ;;
      8) : ;;
      *) win_veto="$this_window_name"
         win_veto_why="and whether that is another lane is NOT KNOWN — \`$LANES_EDIT register-row $this_window_name\` exited $wnv_rc, which is neither 0 (a row) nor 8 (no row), so this read fails closed (R-A11-12)" ;;
    esac
  fi
fi

harness_sid=""; cell_anchor=""
if [ -n "$win_veto" ]; then
  note "this window is named '$win_veto', $win_veto_why — so the session live in it ($win_sid) is NOT taken as $LANE's, and $LANE's row is not stamped with it (Amendment 11 clause (d) rule 1, veto 2; Evidence 2(b)). Run this from $LANE's own window, or pass --dir and let it start its own session."
elif [ -n "$win_sid" ] && [ "$holder_here" = 0 ]; then
  if ! [[ "$win_sid" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]; then
    note "the session live in this window has id '$win_sid', which is not a transcript uuid — leaving the cell alone"
  elif printf '%s\n' "$session_ids" | grep -qx -F -- "$win_sid"; then
    step "  its uuid is already in the row's session cell — nothing to append"
  else
    # R-A11-1 (corrected; A11 Addendum 2, ratified 2026-09-13T18:05:29Z "Ratify
    # all four") — OWNERSHIP DECIDES, AND A LIVE SESSION THAT BELONGS TO ANOTHER
    # ROW IS NEVER TAKEN. Until this test, the branch above fired on ANY live
    # session in the typing window, so `lane-start X` typed from lane Y's window
    # resumed Y's transcript and appended Y's uuid to X's row — cross-lane
    # contamination, reproduced as Evidence 2(b) on `brettheap/new-workstation#20`
    # (the same run planned to write this lane's uuid into `openXfactory-5`'s row).
    #
    # THE TEST IS THE REGISTER, NOT THE WINDOW'S NAME. The two legitimate cases
    # this step exists for — a `/clear`, a usage reset, a profile switch — all
    # happen in a window the launcher has just made and named `claude`, BEFORE
    # step 4 renames it, and their uuid is one the harness has just minted, so it
    # is in NO row at all. Fencing on the window's name instead would refuse
    # exactly those three and leave step 3b dead, which is the failure `RV-T1`
    # raised against the withdrawn "and the row carries no transcript yet"
    # conjunct. An id that some OTHER lane's row already names is the one thing
    # that is provably not this lane's, and that is the fence.
    #
    # IT FAILS CLOSED (R22). Only 0 (a lane) and 8 (no row names it) are answers;
    # any other code is a read that did not happen — an older `lanes-edit.sh` with
    # no `session-lane` exits 2 — and a read that could not be made must never be
    # read as "the session is free", because an empty answer is what PERMITS the
    # take here. The cost of refusing is one printed act; the cost of permitting
    # is another lane's uuid on an append-only line.
    win_owner=""; wo_rc=0
    win_owner="$("$LANES_EDIT" session-lane "$win_sid" 2>/dev/null)" || wo_rc=$?
    if [ "$wo_rc" != 0 ] && [ "$wo_rc" != 8 ]; then
      note "$LANES_EDIT session-lane $win_sid failed (exit $wo_rc), so whose session is live in this window is NOT known — leaving $LANE's session cell and resume target alone. A helper with no 'session-lane' exits 2; install the one beside this script."
    elif [ "$wo_rc" = 0 ] && [ -n "$win_owner" ] && [ "$win_owner" != "$LANE" ]; then
      note "the session live in THIS window is $win_sid, and the register says it is lane $win_owner's, not $LANE's. A live session that belongs to another row is NEVER taken (R-A11-1): $LANE's session cell and resume target are left exactly as they are. Start $LANE in its own window, or take $win_owner here."
    else
      harness_sid="$win_sid"
      cell_anchor="$row_sid"
      row_sid="$harness_sid"
      note "the session live in THIS window is $harness_sid and the PUBLISHED session cell does not name it: the harness minted a new transcript (a /clear, a usage reset, a profile switch). No other row names it either, so it is this lane's current session, and the cell is stamped with it before the row's status."
    fi
  fi
elif [ -n "$win_sid" ]; then
  step "  it is the session step 3 already found holding $LANE in this window — the cell is current"
fi

# ------------------------------------------------------------- 3c. --confirm
#
# A window whose name is not the lane is a window whose lane came from somewhere
# else — the swap RECORD, or a flag — and taking it renames the window and
# writes the register. `--confirm` puts the three facts that disagree in front
# of a person first: the WINDOW, the SESSION live in it, and the ROW.
#
# NO TERMINAL AND NO `--yes` IS A REFUSAL, exit 2, before the rename and before
# any write. A question nobody can answer is not a Yes, and a launcher that read
# it as one would rename a window somebody else's lane is working in.
if (( confirm )); then
  if [ "$this_window_name" = "$LANE" ]; then
    step "--confirm: this window is already named $LANE — nothing to confirm"
  else
    # AMENDMENT 15 — A WINDOW NAMED FOR THIS LANE IN ANOTHER CASE IS NOT "not
    # the lane". The rename still happens below, because the row's spelling is
    # what the window is named; what changes is the sentence the operator is
    # asked to answer. Told their own lane's window is not the lane, the
    # reasonable answer is N — and N abandons a resume that was legitimate.
    if [ "$(printf '%s' "$this_window_name" | tr 'A-Z' 'a-z')" = "$(printf '%s' "$LANE" | tr 'A-Z' 'a-z')" ]; then
      why="named '$this_window_name', which is THIS LANE under another case — a lane name is ONE name under any case (Amendment 15), and the rename below is to the register row's own spelling, $LANE"
    else
      case "$this_window_name" in
        ""|claude|bash|zsh|sh|node) why="auto-named '${this_window_name:-none}'" ;;
        *)                          why="named '$this_window_name', which is not the lane" ;;
      esac
    fi
    note "--confirm: this window is $why. The three facts, before anything is renamed or written:"
    note "  window   $this_window '${this_window_name:-none}'"
    if [ -n "$win_sid" ]; then
      note "  session  $win_sid '${win_name:-none}' (pid $win_pid, profile ${win_profile:-unknown})"
    else
      note "  session  none — no live session record names this window"
    fi
    if [ "$row_count" = 1 ]; then
      note "  row      ${row:0:200}"
    elif [ -n "$pub_row" ]; then
      pub_row_first="${pub_row%%$'\n'*}"
      note "  row      ${pub_row_first:0:200}"
    else
      note "  row      none — the register has no row for $LANE"
    fi
    answer=""; no_tty=0
    if (( take_yes )); then
      step "Take lane $LANE in this window? [y/N] y   (--yes)"
      answer=y
    elif [ -n "${LANE_START_ANSWER+set}" ]; then
      step "Take lane $LANE in this window? [y/N] ${LANE_START_ANSWER:-<empty>}   (LANE_START_ANSWER)"
      answer="$LANE_START_ANSWER"
    elif [ -t 0 ]; then
      printf '%s: Take lane %s in this window? [y/N] ' "$prog" "$LANE" >&2
      IFS= read -r answer || answer=""
    else
      answer=""
      no_tty=1
    fi
    case "$answer" in
      y|Y|yes|YES|Yes) step "taking lane $LANE in this window" ;;
      *)
        # AMENDMENT 8(c)/(d), R-A8-3 — EVERY ANSWER LEADS SOMEWHERE AND NO
        # ANSWER EXITS. `claude-profile` EXECS this script, so this script's
        # exit status IS the launcher's: a refusal here is an exited pane with
        # no Claude in it, which is the one failure the whole change exists to
        # prevent. `N` means NOT THIS LANE, not NOT AT ALL — and no tty with no
        # `--yes` is the same answer with nobody there to give it, which must
        # still not take a lane on an inference nobody confirmed. Both fall
        # through to Claude, bare: nothing renamed, nothing written, no lane,
        # ONE notice, exit 0. Exit 2 is left to argument errors alone.
        if (( no_tty )); then
          bare_why="--confirm was passed, there is no terminal to ask on, and --yes was not, so lane $LANE is NOT taken in a window $why"
        else
          bare_why="lane $LANE is NOT taken: the answer was '${answer:-<empty, which is N>}'"
        fi
        note "$bare_why. Nothing has been renamed and nothing has been written. Starting Claude with no lane — to take it later, run: $prog $self_args"
        bare=("$CLAUDE_BIN" ${pass[@]+"${pass[@]}"})
        if (( no_launch )); then
          # The launcher asked for a command to exec; it gets the bare one, on
          # stdout, exactly as it would have got the lane's.
          quoted "${bare[@]}"; printf '\n'
          step "--no-launch: the command above was printed, not run"
          exit 0
        fi
        if (( dry_run )); then
          plan "exec $(quoted "${bare[@]}")"
          step "--dry-run: nothing was renamed, written or launched"
          exit 0
        fi
        step "exec: $(quoted "${bare[@]}")"
        exec "${bare[@]}"
        ;;
    esac
  fi
fi

# ------------------------------------------------------- 4. name the window

if (( dry_run )); then
  plan "tmux rename-window $LANE   (also turns automatic-rename off for this window)"
else
  tmux rename-window "$LANE"
  step "window renamed to $LANE (automatic-rename is now off for it)"
fi

# ------------------------------------------------- 5a. what will be launched
#
# Decided BEFORE the row is written: a brand-new session's id is minted here
# and step 5 has to record it.

# Claude keeps one transcript directory per working directory, named by that
# path with every non-alphanumeric character turned into '-'. A lane reached
# through a symlink has two spellings, so both are searched.
sanitize() { printf '%s' "$1" | tr -c 'A-Za-z0-9' '-'; }

transcript_dirs() {
  printf '%s\n' "$PROJECTS_STATE/$(sanitize "$DIR")"
  [ "$DIR_REAL" = "$DIR" ] || printf '%s\n' "$PROJECTS_STATE/$(sanitize "$DIR_REAL")"
}

# ===================== AMENDMENT 17, adoption act 6: THE TRANSCRIPT FOLLOWS
# ===================== THE LANE
#
# `transcript_dirs` above looks under THIS PROFILE's projects directory and
# nowhere else, so a lane restarted under a NEW PROFILE after a usage limit
# never resumed its conversation: it fell to the title fallback or to a new
# session primed by a handoff the stuck session never refreshed.
#
# MEASURED FIRST, AND THE FACT SHRANK THE ACT (opensoft/openRepoTools#36, the
# correction of 2026-09-14T12:35Z): on a launcher-configured workstation EVERY
# profile's `projects/` is ONE shared directory —
# `readlink -f ~/.claude-profiles/profiles/<org>/<team>/<any>/projects` →
# `~/.claude-profiles/state/opensoft/projects` — so a transcript needs NO MOVE
# to be resumed under another profile, and the whole act there is to SAY SO.
# The move is for the workstation without that layout, where the two
# directories are really two.
#
# WHY A MOVE AND NEVER A COPY: two live transcripts of one uuid diverge, and
# nothing merges them. The pointer left behind says where it went.
# THE PROFILE STORE'S ROOT IS THE DOCUMENTED ONE, NEVER `~/.claude-profiles`
# SPELLED AGAIN (Copilot round 1 on openRepoTools#47). `$CLAUDE_PROFILES_HOME`
# is in this repository's README table and is what `lanes-edit.sh`'s own profile
# walk reads (`lanes-edit.sh:4381`); a second spelling here is a second answer
# to "where are this person's profiles", and on a workstation that moved the
# store it is the WRONG one — every scan below would find nothing, and a lane
# resumed under another profile would start a new conversation beside a
# transcript that was there all along.
PROFILES_HOME="${CLAUDE_PROFILES_HOME:-$HOME/.claude-profiles}"

profile_projects_dirs() {
  # This profile's own first, then every other profile's. Team profiles sit two
  # levels down, which is the same shape `lanes-edit.sh`'s `session_files` walks
  # for the sessions beside them.
  printf '%s\n' "$PROJECTS_STATE"
  for ppd_d in "$PROFILES_HOME"/profiles/*/*/*/projects \
               "$PROFILES_HOME"/profiles/*/*/projects \
               "$PROFILES_HOME"/profiles/*/projects \
               "$CLAUDE_HOME"/projects; do
    [ -d "$ppd_d" ] && printf '%s\n' "$ppd_d"
  done
}

# THE PHYSICAL PATH, WITHOUT `readlink -f` — which is not in the stock macOS
# userland (Copilot round 1 on openRepoTools#47), where it exits 1 and a
# fallback hands the path back UNRESOLVED. Two spellings of ONE directory then
# compare as two directories, and the shared-`projects/` case below — which on
# a launcher-configured workstation is EVERY case — would move a transcript
# that never needed moving, on the platform this suite's own macOS job runs.
# `cd -P` + `pwd -P` is the shell's own answer and is in every shell that
# parses this file. A path that is not a directory comes back as it was given,
# which is what the `readlink -f` fallback did.
real_of() { ( CDPATH=''; cd -P -- "$1" 2>/dev/null && pwd -P ) || printf '%s\n' "$1"; }

profile_of_projects_dir() {   # <…/<profile>/projects> -> the profile's name
  popd_d="${1%/projects}"; popd_n="${popd_d##*/}"
  case "$popd_n" in .claude|claude|"") printf 'default\n' ;; *) printf '%s\n' "$popd_n" ;; esac
}

# The transcript of one id under ONE projects directory, in either spelling of
# the lane's path (a lane reached through a symlink has two).
transcript_under() {   # <projects dir> <id>
  tu_d="$1"; tu_id="$2"
  for tu_s in "$(sanitize "$DIR")" "$(sanitize "$DIR_REAL")"; do
    [ -f "$tu_d/$tu_s/$tu_id.jsonl" ] && { printf '%s\n' "$tu_d/$tu_s/$tu_id.jsonl"; return 0; }
  done
  return 1
}

# EVERY LIVE RECORD CARRYING AN ID, ACROSS EVERY PROFILE'S `sessions/`
# (Amendment 18(h), in force 2026-09-14T13:15:18Z: *"A transcript (one session
# id) is held by ONE live process"*). A pid is checked with `kill -0`, which is
# this machine's own answer; a record whose process is gone holds nothing.
# `<pid><TAB><tmux|bg><TAB><profile>` per holder.
live_holders_of_id() {   # <id>
  lho_id="$1"
  for lho_f in "$PROFILES_HOME"/profiles/*/*/*/sessions/*.json \
               "$PROFILES_HOME"/profiles/*/*/sessions/*.json \
               "$PROFILES_HOME"/profiles/*/sessions/*.json \
               "$CLAUDE_HOME"/sessions/*.json; do
    [ -f "$lho_f" ] || continue
    lho_blob="$(tr -d '\n' < "$lho_f" 2>/dev/null || :)"
    case "$lho_blob" in *"\"sessionId\":\"$lho_id\""*) : ;; *) continue ;; esac
    lho_pid="$(printf '%s' "$lho_blob" | grep -o '"pid":[0-9][0-9]*' | head -n1 | sed 's/.*://')"
    [ -n "$lho_pid" ] || continue
    kill -0 "$lho_pid" 2>/dev/null || continue
    lho_where="$(printf '%s' "$lho_blob" | grep -o '"tmux":"[^"]*"' | head -n1 | sed 's/^"tmux":"//; s/"$//')"
    [ -n "$lho_where" ] || lho_where=bg
    lho_prof="${lho_f%/sessions/*}"; lho_prof="${lho_prof##*/}"
    printf '%s\t%s\t%s\n' "$lho_pid" "$lho_where" "$lho_prof"
  done
}

# PUTTING THE MOVE BACK. The transaction below is three writes, and the two
# after the first each undo what came before them rather than leave a
# transcript split across two profiles. It reads `follow_transcript`'s own
# `ft_*` variables — one act, one set of names — and PRINTS what it could not
# undo rather than returning a code, because a rollback that itself failed is
# the one state nobody can infer from the outside and the refusal has to say it.
ft_rollback() {
  ftr_out=""
  if [ "${ft_moved_sib:-0}" = 1 ]; then
    mv -- "$ft_dest_dir/$ft_id" "$ft_sib" 2>/dev/null ||
      ftr_out="the sibling directory is at $ft_dest_dir/$ft_id and could not be put back to $ft_sib"
  fi
  mv -- "$ft_dest_dir/$ft_id.jsonl" "$ft_f" 2>/dev/null ||
    ftr_out="${ftr_out:+$ftr_out; }the transcript is at $ft_dest_dir/$ft_id.jsonl and could not be put back to $ft_f"
  printf '%s' "$ftr_out"
  return 0
}

# THE SEARCH, THE SAY AND THE MOVE. Sets `FOLLOW_FILE` (the transcript's path
# HERE, after any move) and `FOLLOW_WHY` (a refusal), and returns 0 found, 8
# nowhere, 2 refused. IT NEVER `die`s: a refusal inside `$( )` kills only the
# substitution's subshell, and the caller would carry on with an empty answer —
# which here would mean starting a second process on a transcript another live
# one holds.
FOLLOW_FILE=""; FOLLOW_WHY=""
follow_transcript() {   # <id>
  ft_id="$1"; FOLLOW_FILE=""; FOLLOW_WHY=""
  ft_here_real="$(real_of "$PROJECTS_STATE")"
  ft_shared=""
  while IFS= read -r ft_d; do
    [ -n "$ft_d" ] || continue
    [ "$ft_d" = "$PROJECTS_STATE" ] && continue
    ft_real="$(real_of "$ft_d")"
    if [ "$ft_real" = "$ft_here_real" ]; then
      # THE SHARED-DIRECTORY CASE, which on a launcher-configured workstation is
      # every case: the other profile's `projects/` IS this one, so the
      # transcript is already here and nothing is moved.
      ft_shared="${ft_shared:+$ft_shared }$(profile_of_projects_dir "$ft_d")"
      continue
    fi
    ft_f="$(transcript_under "$ft_d" "$ft_id" 2>/dev/null || :)"
    [ -n "$ft_f" ] || continue
    ft_prof="$(profile_of_projects_dir "$ft_d")"
    # A UUID WHOSE HOLDER IS LIVE THERE IS A REFUSAL, NEVER A MOVE (Amendment
    # 18(h)): moving the file out from under a running process, and then
    # resuming the same id here, is two live processes on one transcript — the
    # state measured on this lane on 2026-09-14 and the reason that clause
    # exists.
    ft_holders="$(live_holders_of_id "$ft_id")"
    if [ -n "$ft_holders" ]; then
      FOLLOW_WHY="transcript $ft_id is in profile $ft_prof's projects directory ($ft_d) and a LIVE process there holds it:
$(printf '%s\n' "$ft_holders" | sed 's/^/      pid /; s/\t/ in /; s/\t/ under profile /')
    A transcript is held by ONE live process (Amendment 18(h)): moving it here and resuming the id would make a second. Nothing was moved and nothing was launched.
    End that process, or retire it: lane-end $LANE --retire <pid>"
      return 2
    fi
    # THE MOVE: the `<uuid>.jsonl` and its sibling `<uuid>/` directory, into the
    # SAME slug under this profile, with a pointer left where it was.
    ft_dest_dir="$PROJECTS_STATE/$(basename -- "$(dirname -- "$ft_f")")"
    ft_sib="${ft_f%.jsonl}"
    # `--dry-run` MOVES NOTHING (Copilot round 1 on openRepoTools#47). This
    # function runs long before the dry-run exit at the foot of the script, and
    # a command whose last line is *nothing was renamed, written or launched*
    # must not have moved a person's transcript out of another profile to get
    # there. The plan is printed with both paths instead, and the caller says
    # what it would have followed.
    if (( dry_run )); then
      plan "mv $ft_f $ft_dest_dir/$ft_id.jsonl (with its sibling $ft_id/, and a pointer left where it was)"
      FOLLOW_WHY="dry-run:transcript $ft_id is in profile $ft_prof's projects directory ($ft_d) and WOULD be moved into $ft_dest_dir"
      return 8
    fi
    mkdir -p -- "$ft_dest_dir" 2>/dev/null || {
      FOLLOW_WHY="could not create $ft_dest_dir to move transcript $ft_id into"; return 2; }
    # AN OCCUPIED DESTINATION IS REFUSED BEFORE ANYTHING MOVES (Copilot round 3
    # on openRepoTools#47). `mv <dir> <existing dir>` does not fail — it moves
    # the source INSIDE it — so a `<uuid>/` already sitting here would take the
    # other profile's sidecar as `<uuid>/<uuid>/`, mark the sibling moved, and
    # resume with the transcript's state split from the transcript. Nothing this
    # command writes is worth guessing which of two `<uuid>` directories is the
    # lane's, so it names what is there and stops. A name that is NOT a
    # directory is left to the transaction below, where `mv` really does fail
    # and the rollback puts the transcript back.
    if [ -d "$ft_dest_dir/$ft_id" ] || [ -e "$ft_dest_dir/$ft_id.jsonl" ]; then
      FOLLOW_WHY="transcript $ft_id is in profile $ft_prof's projects directory ($ft_d), and something ALREADY SITS where it would go: $ft_dest_dir/$ft_id$( [ -e "$ft_dest_dir/$ft_id.jsonl" ] && printf '.jsonl' ). Nothing was moved — a move onto an occupied name puts one transcript inside another, and which of the two is this lane's is not this command's to guess. Move that aside, or end the lane that owns it."
      return 2
    fi
    if ! mv -- "$ft_f" "$ft_dest_dir/$ft_id.jsonl" 2>/dev/null; then
      FOLLOW_WHY="could not move $ft_f into $ft_dest_dir (the transcript stays where it is, and this lane will not resume an id it cannot read)"
      return 2
    fi
    # THE THREE WRITES ARE ONE TRANSACTION (Copilot round 1 on
    # openRepoTools#47). The `.jsonl`, its sibling `<uuid>/` state directory and
    # the pointer left behind are one act, and a HALF-DONE one is worse than
    # none: a sibling orphaned in the other profile is state the resumed session
    # silently loses, and a transcript gone from where a person will look for it
    # with no pointer has had its only recovery trail deleted. So each of the
    # two below is CHECKED, and a step that cannot complete puts back what the
    # steps before it moved and refuses — naming the parts it could not put
    # back, because a rollback that itself failed is the one state nobody can
    # infer from the outside.
    ft_moved_sib=0
    if [ -d "$ft_sib" ]; then
      if mv -- "$ft_sib" "$ft_dest_dir/$ft_id" 2>/dev/null; then
        ft_moved_sib=1
      else
        ft_undone="$(ft_rollback)"
        FOLLOW_WHY="transcript $ft_id moved into $ft_dest_dir, but its sibling state directory $ft_sib could NOT follow it — half a transcript is not one, so the move was put back. Nothing was launched.${ft_undone:+
    WHAT COULD NOT BE PUT BACK: $ft_undone}"
        return 2
      fi
    fi
    # THE POINTER, WHERE THE FILE WAS: `<uuid>.jsonl.moved-to-<profile>-<UTC>`.
    # A person looking for a transcript that is not where they left it is owed
    # the sentence, in the directory they are standing in — so a pointer that
    # cannot be written (a source directory that is read-only, say) undoes the
    # move rather than completing it untraceably.
    ft_to="${CLAUDE_PROFILE_NAME:-}"
    [ -n "$ft_to" ] || ft_to="$(profile_of_projects_dir "$PROJECTS_STATE")"
    ft_ptr="$ft_f.moved-to-$ft_to-$(date -u +%Y-%m-%dT%H%M%SZ)"
    if ! printf 'moved to %s by %s at %s\n' "$ft_dest_dir" "$prog" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
         > "$ft_ptr" 2>/dev/null; then
      rm -f -- "$ft_ptr" 2>/dev/null || :
      ft_undone="$(ft_rollback)"
      FOLLOW_WHY="transcript $ft_id could not be given its pointer at $ft_ptr, which is the only trail back to where it was — so the move was put back rather than left untraceable. Nothing was launched.${ft_undone:+
    WHAT COULD NOT BE PUT BACK: $ft_undone}"
      return 2
    fi
    step "transcript $ft_id was in profile $ft_prof's projects directory ($ft_d), which is NOT this profile's — moved into $ft_dest_dir, with a pointer left where it was (a copy would leave two live transcripts of one uuid diverge)"
    FOLLOW_FILE="$ft_dest_dir/$ft_id.jsonl"
    return 0
  done <<EOF
$(profile_projects_dirs)
EOF
  [ -z "$ft_shared" ] || FOLLOW_WHY="shared:$ft_shared"
  return 8
}

# The transcript of ONE recorded session id, in this directory.
recorded_transcript() {
  local id="$1" d
  [ -n "$id" ] || return 1
  while IFS= read -r d; do
    if [ -f "$d/$id.jsonl" ]; then printf '%s\n' "$d/$id.jsonl"; return 0; fi
  done < <(transcript_dirs)
  return 1
}

# A `/rename` is a `{"type":"custom-title",…}` record inside the transcript,
# and the LAST one wins — a session renamed away from this lane must not be
# resumed by it. Several transcripts can still carry one title; that is why
# this is only the fallback.
# `<LANE> (2)` is the SAME lane: that suffix is exactly what a rename into a
# title something else still holds mints, and live_holder() already reads it
# that way. A matcher that insisted on the bare string would hide a lane from
# itself — this orchestrator's own title on 2026-09-11 was `codeXfactory-1 (4)`.
# AMENDMENT 15 — THE TITLE IS MATCHED CASE-INSENSITIVELY, because the SESSION
# NAME is one of the lookups the rule names and because this is the branch that
# decides RESUME versus MINT A NEW ONE. `openXfactory-2`'s own transcript is
# titled `openxfactory-2` — the launcher named it that on 2026-09-13, and the
# row says `openXfactory-2` since the 15(d) merge — so a byte-for-byte matcher
# would find NO transcript for that lane and start a second conversation on it,
# which is the incident this amendment exists to stop, one branch along.
# `live_holder` and `fork_map` have matched titles case-insensitively all along;
# this was the one that did not.
#
# THE LANE IS LOWER-CASED ONCE, outside the loop, and only the candidate's own
# `base` per file — which is two processes this loop already spends on `grep`
# and `sed` for every file it looks at.
titled_transcript() {
  local d f last title base tt_lane_lc
  tt_lane_lc="$(printf '%s' "$LANE" | tr 'A-Z' 'a-z')"
  while IFS= read -r d; do
    [ -d "$d" ] || continue
    for f in "$d"/*.jsonl; do
      [ -e "$f" ] || continue
      last="$(grep -e '^{"type":"custom-title"' "$f" 2>/dev/null | tail -n1 || :)"
      [ -n "$last" ] || continue
      title="$(printf '%s' "$last" | sed 's/.*"customTitle":"//; s/".*//')"
      base="${title% (*)}"
      if [ "$(printf '%s' "$base" | tr 'A-Z' 'a-z')" = "$tt_lane_lc" ]; then printf '%s\t%s\n' "$f" "$title"; return 0; fi
    done
  done < <(transcript_dirs)
  return 1
}

new_uuid() {
  if [ -r /proc/sys/kernel/random/uuid ]; then cat /proc/sys/kernel/random/uuid
  elif command -v uuidgen >/dev/null 2>&1; then uuidgen | tr 'A-F' 'a-f'
  else return 1
  fi
}

# Amendment 7's lane verb follows the LAUNCH decision, which is the honest
# reading of it: a resume is a RESUMED and a new session is a STARTED.
lane_verb=STARTED
lane_sid=""

# ================= AMENDMENT 17(c): WHICH AGENT, AND WHAT IT IS LAUNCHED WITH
#
# *"`lane-start <repo> <n>` reads the row and the last `PAUSED`. Where the agent
# asked for is the one that paused, and its transcript is here, it resumes
# exactly as today (Amendment 6's case (a)). Otherwise — a different agent, or
# no transcript here — it launches the named agent with THE HANDOFF'S TOP BLOCK
# AS ITS FIRST PROMPT … With no `--agent` the default is the agent that paused;
# with no `PAUSED` the default is `claude`."*
#
# THE DEFAULT COMES FROM THE RECORD, THROUGH THE ONE READ THAT ANSWERS FOR IT
# (`lane-agent`, this amendment's sibling of `lane-dir`). 8 is "no record of
# this amendment yet" — every lane until its own next handoff — and it is not a
# failure: `claude` is what this command has always launched.
AGENT=""; AGENT_EXPLICIT=0; AGENT_ID=""; RECORDED_AGENT=""; RECORDED_AGENT_READ=0
read_recorded_agent() {
  rra_out=""; rra_rc=0
  rra_out="$("$LANES_EDIT" lane-agent "$LANE" 2>/dev/null)" || rra_rc=$?
  RECORDED_AGENT_READ=1
  case "$rra_rc" in
    0) RECORDED_AGENT="$rra_out" ;;
    8|2) RECORDED_AGENT="" ;;
    # A READ THAT FAILED IS NOT "THIS LANE'S RECORD NAMES NO AGENT", and the
    # helper says so in its own refusal: *"a caller that read it that way would
    # launch the default agent over a lane another one paused"* (Amendment
    # 7(d), `lanes-edit.sh`'s `lane-agent` arm). This used to `note` and launch
    # `claude` anyway — the one act in this whole command that no later refusal
    # can undo — so it refuses, and names the flag that goes past it, which is
    # a person naming the agent rather than this command guessing at one.
    *) die "\`$LANES_EDIT lane-agent $LANE\` failed (exit $rra_rc), so which agent paused this lane is UNKNOWN — and launching the default over a lane another agent paused is what Amendment 7(d) has this read refuse rather than answer. Run it by hand to see what it says, or name the agent: $prog --agent <name> …" 2 ;;
  esac
  return 0
}
if [ -n "$agent_flag" ]; then
  AGENT="$agent_flag"; AGENT_EXPLICIT=1
else
  read_recorded_agent
  if [ -n "$RECORDED_AGENT" ]; then AGENT="$RECORDED_AGENT"; fi
  [ -n "$AGENT" ] || AGENT=claude
  [ "$AGENT" = claude ] || AGENT_EXPLICIT=1
fi
case "$AGENT" in
  *[!A-Za-z0-9._-]*|'') die "--agent takes a manifest key — letters, digits, '.', '_', '-' — and '$AGENT' is not one (Amendment 17(b))" 2 ;;
esac
# THE AGENT THIS LANE IS RUNNING, IN THE ENVIRONMENT OF THE SESSION IT STARTS
# (Copilot round 2 on openRepoTools#47). `lane-handoff` derives the record's
# `agent` sub-field from `$LANES_AGENT`, else `claude` — so a `codex` session
# launched here would write `agent claude` at its own handoff and the next
# `lane-start` would resume it with the wrong launcher, one record along. The
# launch decides which agent this is; the launch is therefore what says so.
export LANES_AGENT="$AGENT"
# THE AGENT'S OWN RESUMABLE ID, where the record carries one. For `claude` that
# is the transcript uuid the session cell already records and this script
# already resumes; for another agent it is the one id a launch has in hand, and
# it is what the row's session cell is appended with in that agent's spelling
# (`Codex <id>`). `none` is an ANSWER — the agent has no resumable id — and is
# not carried into the cell as if it were one.
#
# AND ONLY WHERE THE RECORD IS THAT AGENT'S (Copilot round 2 on
# openRepoTools#47). `lane-transcript` answers for the LANE — its last `PAUSED`,
# whichever agent wrote it — so a lane paused by `claude` and resumed with
# `--agent codex` would take the CLAUDE uuid and append it to the row's session
# cell spelled `Codex <uuid>`: an id no `codex` can resume, attributing this
# lane's history to a conversation that is not it, in a cell nothing rewrites.
if [ "$AGENT" != claude ]; then
  [ "$RECORDED_AGENT_READ" = 1 ] || read_recorded_agent
  if [ -n "$RECORDED_AGENT" ] && [ "$RECORDED_AGENT" != "$AGENT" ]; then
    note "the lane's last handoff names agent $RECORDED_AGENT and this launch is $AGENT, so the recorded transcript is NOT carried into the row's session cell — that id is $RECORDED_AGENT's and $AGENT cannot resume it. This launch is recorded without an id of its own; the session's first act stamps the row with the one it gets."
  else
    at_out=""; at_rc=0
    at_out="$("$LANES_EDIT" lane-transcript "$LANE" 2>/dev/null)" || at_rc=$?
    case "$at_rc" in
      0) [ "$at_out" = none ] || AGENT_ID="$at_out" ;;
      8|2) : ;;
      *) note "$LANES_EDIT lane-transcript $LANE failed (exit $at_rc) — the row's session cell will record this launch without the agent's own id" ;;
    esac
  fi
fi
# `LANE_START_FRESH=1` IS THE `/ctx` SEAM, and it is one sentence: *a NEW
# session of this lane's agent, started with the top block of the handoff the
# row names as its first prompt*. That is what a context clear IS, and it is why
# `/ctx` does not simply resume the transcript it has just paused.
# `lane-handoff --restart` respawns the lane's own pane with it set (Amendment
# 17(f)); nothing else sets it, and with it unset this command behaves exactly
# as it did before this amendment.
fresh=0
[ "${LANE_START_FRESH:-0}" = 1 ] && fresh=1
first_prompt=0

# AMENDMENT 11, EVIDENCE 4 — `--name "$LANE"` IS ON EVERY LAUNCH BRANCH, NOT
# ONLY THE NEW-SESSION ONE. The session NAME is the lane's messaging address
# (Amendment 2): `ListAgents`, `SendMessage`, `@<lane>` and the statusline all
# read the harness record's name, and a resume that passes no `--name` gets a
# DERIVED one. Measured on this lane 2026-09-13: the transcript carried
# `customTitle: openRepoProject-1`, set once by `/rename`, while every process
# that resumed it that day carried `openrepoproject-b9`, `-1e`, `-27`, `-45` —
# four derived names for one lane, because only the new-session branch below
# passed the flag. A resume is a launch; a launch names its window's session
# after the lane, or the lane loses its address for the life of that session,
# and there is no API to rename a running one from inside.
new_sid=""
# ACT 6 — WHERE THE TRANSCRIPT IS, SAID RATHER THAN ASSUMED, and followed where
# it is in another profile's directory. This runs BEFORE the branch below, so
# `recorded_transcript` answers for a transcript this run has just moved here.
rec_file=""
resume_sid="$row_sid"
restored_sid=""
if [ -n "$row_sid" ] && [ "$AGENT" = claude ] && (( ! fresh )); then
  rec_file="$(recorded_transcript "$row_sid" 2>/dev/null || :)"
  if [ -n "$rec_file" ]; then
    # WHICH DIRECTORY IT WAS FOUND IN, and whether that directory is SHARED —
    # `readlink -f` equal across profiles is what makes a profile switch need no
    # move at all, and a person swapping accounts is owed that sentence rather
    # than a silent success they cannot reason about.
    shared_with=""
    here_real="$(real_of "$PROJECTS_STATE")"
    while IFS= read -r ppd; do
      [ -n "$ppd" ] && [ "$ppd" != "$PROJECTS_STATE" ] || continue
      [ "$(real_of "$ppd")" = "$here_real" ] || continue
      shared_with="${shared_with:+$shared_with }$(profile_of_projects_dir "$ppd")"
    done <<EOF
$(profile_projects_dirs)
EOF
    step "transcript $row_sid found in this profile's projects directory ($PROJECTS_STATE)${shared_with:+, which IS the directory profile(s) $shared_with read too (one shared directory: a profile switch resumes this lane by id and moves nothing)}"
  else
    # `|| ft_rc=$?` AND NOT `; ft_rc=$?`: this script runs under `set -e`, so a
    # function returning 8 as a bare command ENDS IT — with 8, which is this
    # estate's code for "no record" and which a caller would read as a lane-start
    # that found nothing rather than one that was never asked.
    ft_rc=0
    follow_transcript "$row_sid" || ft_rc=$?
    case "$ft_rc" in
      0) rec_file="$FOLLOW_FILE" ;;
      2) die "$FOLLOW_WHY" 2 ;;
      *) case "$FOLLOW_WHY" in
           shared:*) note "no transcript for $row_sid under this directory in any profile's projects directory (profiles ${FOLLOW_WHY#shared:} share this one)" ;;
           # `--dry-run` FOUND IT AND MOVED NOTHING. The run carries on as a
           # lane whose transcript is not here — which is what it would be
           # WITHOUT the move — because a dry run must not report a launch that
           # depends on a write it did not make.
           dry-run:*) note "--dry-run: ${FOLLOW_WHY#dry-run:}. Nothing was moved; the branch below is the one a lane with no transcript here takes" ;;
         esac ;;
    esac
  fi
fi

# AMENDMENT 17(c) MAKES THE PAUSED RECORD A RESUME SOURCE, NOT MERELY A LABEL.
# The row normally wins because its last transcript is the current one. A
# harness restart can, however, append the process/session id it minted while
# continuing an older Claude transcript. That id is then a perfectly readable
# row entry but has no `<id>.jsonl`; falling through to `--resume <LANE>` opens
# Claude's title picker and can immediately exit a launcher-created pane. The
# last PAUSED record already carries the exact agent transcript for this case.
# Where it names this same agent and that transcript exists, resume the exact id
# and put it back at the end of the cell below. A live session being bound in
# this window still wins: step 3b has first-hand evidence and must never be
# replaced by an older handoff.
if [ -z "$rec_file" ] && [ -z "$harness_sid" ] && [ "$AGENT" = claude ] \
   && [ "$RECORDED_AGENT" = claude ] && (( ! fresh )); then
  paused_sid=""; paused_rc=0
  paused_sid="$("$LANES_EDIT" lane-transcript "$LANE" 2>/dev/null)" || paused_rc=$?
  case "$paused_rc" in
    0)
      if [[ "$paused_sid" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]] \
         && [ "$paused_sid" != "$row_sid" ]; then
        paused_file="$(recorded_transcript "$paused_sid" 2>/dev/null || :)"
        if [ -z "$paused_file" ]; then
          paused_follow_rc=0
          follow_transcript "$paused_sid" || paused_follow_rc=$?
          case "$paused_follow_rc" in
            0) paused_file="$FOLLOW_FILE" ;;
            2) die "$FOLLOW_WHY" 2 ;;
            *) case "$FOLLOW_WHY" in
                 dry-run:*) note "--dry-run: ${FOLLOW_WHY#dry-run:}. Nothing was moved; the title/new-session branch below remains the dry-run result" ;;
               esac ;;
          esac
        fi
        if [ -n "$paused_file" ]; then
          resume_sid="$paused_sid"
          rec_file="$paused_file"
          restored_sid="$paused_sid"
          step "the row's last session id $row_sid has no transcript here, but this same agent's last PAUSED record names transcript $paused_sid and it is here ($(basename -- "$rec_file")) — resuming that exact id"
        fi
      fi ;;
    8|2) : ;;
    *) note "$LANES_EDIT lane-transcript $LANE failed (exit $paused_rc) — carrying on without the last PAUSED record's exact resume id" ;;
  esac
fi

# ---- THE LAUNCHER TABLE (Amendment 17(c)) -------------------------------
#
# ONE BRANCH PER AGENT, and a name this table does not carry is a REFUSAL that
# names the ones it does — never a guess at an argv nobody has tested. The
# table is deliberately short: `claude`, whose three cases are Amendment 6's
# and are unchanged below, and `codex`, which takes its first prompt
# positionally as `claude` does. A third agent is a row here and a test beside
# it, and nothing else.
if [ "$AGENT" != claude ]; then
  case "$AGENT" in
    codex)
      # THE LAUNCHER IS ON PATH, OR NOTHING IS WRITTEN (Copilot round 3 on
      # openRepoTools#47). The row, the object log and the Rule 3 stamp are all
      # written BEFORE the `exec` at the foot of this command, so a `codex` this
      # workstation does not have records the lane as RESUMED and then exits
      # 127 — a false transition in two append-only files that a person has to
      # repair by hand. The check is here, in 5a, which is before every write.
      command -v "$AGENT" >/dev/null 2>&1 ||
        die "this command's launcher table knows '$AGENT', and this workstation has no '$AGENT' on PATH. Nothing was written: the row, the object log and the handoff's Rule 3 stamp are all written before the launch, and a lane recorded as RESUMED by a launch that exits 127 is a false transition in two append-only files. Install it, or name an agent this workstation has: $prog --agent <name> …" 2
      # `codex` KEEPS NO ID THIS COMMAND CAN PASS: it prints its own resumable
      # id where it has one, so the lane's record carries whatever the last
      # handoff wrote (`transcript <id>`) and the session's own first act
      # corrects it. The top block is delivered positionally, which is the one
      # thing both agents in this table have in common.
      step "agent $AGENT — launching it with this lane's handoff top block as its first prompt (Amendment 17(c))"
      cmd=("$AGENT")
      lane_verb=RESUMED; lane_sid=unknown; first_prompt=1 ;;
    *)
      die "this command has no launcher for the agent '$AGENT'. It knows: claude (resume by id where its transcript is here, else a named new session with the handoff's top block as its first prompt) and codex (the top block as its first prompt). A lane is resumed by an agent whose launch this command has been taught and tested — never by a guessed argv (Amendment 17(c))." 2 ;;
  esac
elif [ -n "$resume_sid" ] && [ -n "$rec_file" ]; then
  # AMENDMENT 18(h), AND THIS IS THE ONLY LAUNCH BRANCH WITH AN ID TO COUNT
  # (`main`, #52). The clause is *"the id it is about to resume or bind"*: this
  # branch is the one that resumes an id, and the count is asked INSIDE it
  # rather than above, because above it the row's id is merely a candidate —
  # act 6's search on the lines above is what decides whether anything resumes
  # it at all, and counting the holders of a transcript nobody is about to open
  # would refuse a lane for a fact about a conversation it is not going to
  # touch. The title-fallback branch resumes through the PICKER, whose
  # transcript is not knowable here, and the new-session branch MINTS a fresh
  # uuid; neither has an id, which is stated rather than left to be noticed.
  # AND THE HARNESS'S OWN FENCE IS ASKED ON BOTH SIDES OF THAT TEST, because it
  # is the one rule that still bites when the id IS this window's session: the
  # `bg` companion of a live session carries its id, and `claude --resume` stops
  # on a companion. `resume-here` asks that and nothing else — the duplicate
  # count for this id was already made at the window-binding call above.
  #
  # ONLY WHERE AN `exec` IS ABOUT TO HAPPEN. `--no-launch` and `--dry-run` open
  # no transcript and hand the harness nothing, so the harness's refusal is not
  # theirs to inherit — and AMENDMENT 8 RULING (g) IS EXPLICIT about the shape
  # that would otherwise break: a `bg` companion is one session seen twice and
  # NEVER refuses the lane to the window its own session is running in, which is
  # exactly what a `--no-launch` binding act in that window is. 18(h)'s count is
  # asked in both, unchanged, because an id a second process holds is one this
  # run must not WRITE DOWN either.
  ls_rules=bind
  if (( ! no_launch )) && (( ! dry_run )); then ls_rules=resume; fi
  if [ "$resume_sid" != "$win_sid" ]; then
    dup_check "$resume_sid" "resume transcript $resume_sid as lane $LANE" "$ls_rules"
  elif [ "$ls_rules" = resume ]; then
    dup_check "$resume_sid" "resume transcript $resume_sid as lane $LANE" resume-here
  fi
  if [ -n "$restored_sid" ]; then
    step "the recovered resume session is $resume_sid and its transcript is here ($(basename -- "$rec_file")) — resuming it by id"
  else
    step "the row's current session is $resume_sid and its transcript is here ($(basename -- "$rec_file")) — resuming it by id"
  fi
  (( holder_here )) && step "  (it is the session live in this window; --resume attaches to the same conversation)"
  cmd=("$CLAUDE_BIN" --name "$LANE" --resume "$resume_sid")
  lane_verb=RESUMED; lane_sid="$resume_sid"
elif (( fresh )) || (( AGENT_EXPLICIT )); then
  # `--agent claude` WITH NO TRANSCRIPT HERE, and the `/ctx` respawn: a NAMED
  # NEW SESSION, with the handoff's top block as its first prompt. It skips the
  # title fallback deliberately — a caller that named an agent, or a context
  # clear that has just written a fresh top block, is asking for a new session
  # of this lane and not for a picker filtered by a title.
  fresh_why=""
  (( fresh )) && fresh_why=" (LANE_START_FRESH=1: the /ctx respawn)"
  step "agent claude — a new session named for the lane, with this lane's handoff top block as its first prompt$fresh_why"
  cmd=("$CLAUDE_BIN" --name "$LANE")
  lane_verb=RESUMED; lane_sid=unknown; first_prompt=1
  if [ -n "$harness_sid" ]; then
    note "the live session in this window ($harness_sid) is not resumed by this launch: a first prompt is delivered to a session that has none. The cell still records the session that is in the window."
  elif [ "${LANE_START_SESSION_ID:-1}" != 0 ]; then
    if new_sid="$(new_uuid)"; then
      while recorded_transcript "$new_sid" >/dev/null 2>&1; do new_sid="$(new_uuid)"; done
      cmd+=(--session-id "$new_sid")
      lane_sid="$new_sid"
      step "minted session id $new_sid — the row will carry it, so the next $prog resumes it by id"
    else
      new_sid=""
      note "no uuid source (/proc/sys/kernel/random/uuid, uuidgen): the new session's own first act must stamp its id on the row"
    fi
  fi
elif titled="$(titled_transcript)"; then
  transcript="${titled%%$'\t'*}"; found_title="${titled#*$'\t'}"
  [ -n "$row_sid" ] && note "the row's last session id $row_sid has no transcript for this directory — falling back to the title"
  step "a transcript here carries the title '$found_title' ($(basename -- "$transcript")) — resume beats new"
  # THREE ANSWERS, NOT TWO (Amendment 15). A title that is not the lane's own
  # spelling is now one of two different facts, and they have different cures: a
  # dedupe suffix means ANOTHER holder was live when this one was renamed, and a
  # title differing only by CASE means this is the lane's own transcript under
  # the spelling it was launched with before the row's became canonical. Telling
  # a person to retire stale holders for the second would send them hunting a
  # collision that never happened.
  if [ "$found_title" != "$LANE" ]; then
    if [ "$(printf '%s' "$found_title" | tr 'A-Z' 'a-z')" = "$(printf '%s' "$LANE" | tr 'A-Z' 'a-z')" ]; then
      note "  that title spells this lane in another case, which is the SAME lane (Amendment 15): the window and the launch take the register row's spelling, $LANE"
    else
      note "  that title carries a dedupe suffix, so another holder of '$LANE' was live when it was renamed: retire the stale holders (lane-end --retire, or retitle them '<lane> · retired <date>') and end idle background sessions still holding the name"
    fi
  fi
  note "  '--resume $LANE' FILTERS THE PICKER, it does not resume exactly: pick the lane's own session, then put its id in the row's session cell"
  (( holder_here )) && step "  (that session is the one live in this window; --resume attaches to the same conversation)"
  cmd=("$CLAUDE_BIN" --name "$LANE" --resume "$LANE")
  # The picker decides which transcript this is, so the id is NOT KNOWABLE
  # here — and the line says so rather than naming the row's last id, which is
  # an id whose transcript this directory does not even have (that is why this
  # branch was reached). Writing it would put a session uuid on a RESUMED that
  # belongs to a different conversation, in a file nothing rewrites. `unknown`
  # is the grammar's own word for an id nobody has; the session stamps the row
  # with its real one as its first act (Amendment 6(c)).
  lane_verb=RESUMED; lane_sid=unknown
else
  step "nothing here to resume for $LANE — a new session takes the name"
  cmd=("$CLAUDE_BIN" --name "$LANE")
  # A NEW SESSION IS NEVER ATTRIBUTED TO THE OLD ONE. With minting turned off
  # (LANE_START_SESSION_ID=0), or with no uuid source at all, there is no id to
  # write — and an empty LANES_SESSION makes the helper fall back to the LAST id
  # in the row's cell, which is the session that has ENDED. The row itself is
  # left reading `pending — set by the session's first act` in that case, so the
  # log said one thing and the row another about the same act.
  lane_sid=unknown
  if [ -n "$harness_sid" ]; then
    # Nothing is minted: the row is about to name the session that is really in
    # this window, and minting a second id beside it would give the lane two
    # answers to "which session is this". The launch still takes a new session —
    # this branch was reached because the live one has no transcript in this
    # directory and cannot be resumed by id — and it is not attributed to the
    # other one, which is what `unknown` says.
    note "the live session in this window ($harness_sid) has no transcript in this directory, so it cannot be resumed by id. A new session takes the name and nothing is minted; the cell still records the session that is in the window."
  elif [ "${LANE_START_SESSION_ID:-1}" != 0 ]; then
    if new_sid="$(new_uuid)"; then
      while recorded_transcript "$new_sid" >/dev/null 2>&1; do new_sid="$(new_uuid)"; done
      cmd+=(--session-id "$new_sid")
      lane_sid="$new_sid"
      step "minted session id $new_sid — the row will carry it, so the next $prog resumes it by id"
    else
      new_sid=""
      note "no uuid source (/proc/sys/kernel/random/uuid, uuidgen): the new session's own first act must stamp its id on the row"
    fi
  fi
fi
cmd+=(${pass[@]+"${pass[@]}"})

# A LANE WITH NO ROW IS A `STARTED`, WHATEVER BRANCH LAUNCHED IT (Copilot round
# 1 on openRepoTools#47). Two branches above set the verb to RESUMED because
# they are resuming a lane that PAUSED — `--agent <name>` and the `/ctx` seam —
# and both are reachable for a lane the register has never carried, where
# `add-row` is about to write the first row and the object log has no line at
# all. A `RESUMED` opening that log is a line no reader can pair with a start,
# in a file nothing rewrites.
if [ "$row_count" = 0 ] && [ "$lane_verb" = RESUMED ]; then
  lane_verb=STARTED
  step "this lane has no row yet, so the record of this launch is a STARTED (there is nothing to have resumed)"
fi

# IS THERE A TRANSCRIPT UUID TO NAME AT ALL? (Amendment 8(d), R-A8-2.) Computed
# HERE, with the launch decision that produced `lane_sid`, because three later
# sections read it: the row's stamp (5), the object-log line (5b) and the
# handoff's Rule 3 stamp (5c). It used to be computed between the first two,
# which left the first reading a variable the last two shared.
lane_sid_known=0
[[ "$lane_sid" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]] && lane_sid_known=1

# WHO THE TWO STAMPS NAME (Amendment 17(c)). For `claude` it is the uuid and
# nothing else — `RESUMED by <uuid>`, the line Amendment 6(c), Amendment 8(d),
# this file's own header and the manual all quote. For another agent it is
# `<agent> <id>`, and `pending` where that agent's id is not knowable until it
# prints one: the STATE cell and the handoff are histories of acts, and an act
# that happened with an id nobody has yet is still an act that happened.
stamp_who="${lane_sid:-unknown}"
stamp_ok="$lane_sid_known"
if [ "$AGENT" != claude ]; then
  stamp_who="$AGENT ${AGENT_ID:-pending}"
  stamp_ok=1
fi

# ------------------------------------------------------------- 5. the row

utc="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
started="$(date -u +%Y-%m-%dT%H:%MZ)"
today="$(date -u +%Y-%m-%d)"
# THE WORKSTATION COLUMN HAS ONE READER, AND NOW ONE SPELLING (A9 Addendum 4,
# R-A9-13). `lanes-edit.sh:438` computes this very cell as
# `${LANES_WORKSTATION:-$(hostname -s)}` and has since Amendment 6; this file
# computed it as a bare `hostname`, which honours no seam and, on any host
# whose `hostname` is a FQDN, writes `eagle.local` into a column every reader
# compares against `eagle`. Two spellings of one column are two answers. The
# seam is also what makes the moved suite runnable anywhere: its 55 seed rows
# spell the column `Eagle`, so before this it was green on a workstation
# literally named Eagle and on no other machine, GitHub's runners included.
ws_pair="$(lanes_workstation_pair)"
ws="${ws_pair%%	*}"
ws_why="$(lanes_workstation_why "${ws_pair##*	}")"
# A CONTAINER WITH NO CONFIGURED WORKSTATION WRITES NOTHING (Amendment 11,
# decision 8(d), `R-A11-14`). `$ws` goes into the row's workstation column, into
# the row's stamp and into the `session <uuid>@<ws>` of every event line this
# run writes — and `opensoft/brett-wip` `origin/main` already carries six log
# lines naming a container id, in a file nothing rewrites. The refusal is here,
# BEFORE the row and before the log, rather than at each of the three writes.
[ -z "$ws_why" ] || die "$ws_why" 2
env_name="$(basename -- "$CLAUDE_HOME")"
case "$env_name" in .claude|claude) env_name=default ;; esac
# THE AGENT'S OWN SPELLING IN THE ROW'S SESSION CELL (Amendment 17(c)): *"the
# row's session cell keeps its history as Amendment 6 has it; its entries
# already carry the agent's kind (`harness <uuid>`, `Codex <id>`)"*. The
# register has spelled Codex sessions that way since 2026-09-05, so the table
# is the register's own and not a new convention.
# --- BEGIN shared one-line cut (lane-collision-protocol Amendment 13(a)) ---
# BYTE-IDENTICAL IN `lane-start`, `lane-end` AND `lane-handoff`, the three
# commands that write a row's state cell — the same trade the four lane helpers
# already make for their workspace resolver, and for the same reason: a drifted
# copy is TWO ANSWERS to one question, and "what may this line contain, and
# where may it be cut" is one question.
#
# FOUR THINGS THE CELL'S LINE MAY NOT CARRY, and `set-row-state` REFUSES all
# four — which would cost the row its stamp or its closing write, so they are
# fixed here rather than met there:
#
#   ` · `  the phrase's own separator. A second one reads back as a fourth part
#          of `<STATE> · <UTC> · <one line>`; it is spelled `; `.
#   `|`    a cell boundary in a Markdown table row. A launch command or a
#          directory may legitimately hold one — `claude --flag 'a|b'`, a path
#          with a pipe in it — and the row is where it would forge a column
#          (Copilot round 1 on openRepoTools#82). It is spelled `¦`, the broken
#          bar, which is not a separator anywhere here; the object log's own
#          line keeps the character itself.
#   CR/LF  a row is ONE LINE of a table, so a newline in this text would split
#          it in two and every row after it would be read as a lane. Spelled
#          `; ` for the same reason the separator is (Copilot round 2).
#   >240   ratified decision O1's cap. Cut at 230 with the last partial WORD
#          dropped, which is what makes the cut safe: `${s:0:n}` counts BYTES
#          wherever the locale is not a UTF-8 one, and a byte offset can land
#          inside the very characters above. 230 and not 240, so the ` ...`
#          marker fits inside the cap however the two count.
cut_to_line() {   # <line> — the row's one line, safe to hand to set-row-state
  ctl="${1//$'\r'/ }"
  ctl="${ctl//$'\n'/; }"
  ctl="${ctl// · /; }"
  ctl="${ctl//|/¦}"
  [ "${#ctl}" -gt 230 ] || { printf '%s' "$ctl"; return 0; }
  ctl="${ctl:0:230}"
  case "$ctl" in *' '*) ctl="${ctl% *}" ;; esac
  printf '%s ...' "$ctl"
}
# --- END shared one-line cut ---

AGENT_WORD="$AGENT"
case "$AGENT" in
  claude) AGENT_WORD=harness ;;
  codex)  AGENT_WORD=Codex ;;
esac
user="$(id -un)"
handoff="handoffs/$estate/session-handoff-$today-lane-$LANE.md"

# The session cell of a NEW row names the session that is about to run,
# whenever one was minted — that is the whole point of minting it. And where a
# session is ALREADY live in this window (step 3b) the cell names THAT one: a
# lane bound to a running window mid-session is the ordinary shape of
# `--no-launch`, and a row minting a fresh uuid beside a conversation that is
# already there would name a session nobody will ever be in.
harness_cell="harness $harness_sid (transcript uuid; profile ${win_profile:-unknown})"
if [ -n "$harness_sid" ]; then
  session_cell="$harness_cell — live in this window, recorded by $prog $utc"
elif [ -n "$new_sid" ]; then
  session_cell="harness \`$new_sid\` (minted by $prog, $utc)"
else
  session_cell="pending — set by the session's first act"
fi

if [ "$row_count" = 0 ]; then
  # AMENDMENT 13(a) — A NEW ROW IS BORN IN THE PHRASE. The state cell opened
  # with the bare word `STARTING` for as long as the cell was a diary; it is one
  # phrase now — `<STATE> · <UTC> · <one line>` — and a row created outside that
  # shape is a row the first `set-row-state` would be the only thing to fix.
  # `LIVE` is the state, because this row is written by the act that takes the
  # lane live in this window, and the line says which act and on which
  # workstation.
  new_line="$lane_verb by $stamp_who (lane $LANE) — lane-start on $ws: row created"
  new_state="LIVE · $utc · $(cut_to_line "$new_line")"
  new_row="| \`$LANE\` | $session_cell | $ws / $env_name / $user | $started | none | $handoff | $new_state |"
  if (( dry_run )); then
    plan "lanes-edit.sh add-row"
    plan "  $new_row"
  else
    LANES_LANE="$LANE" "$LANES_EDIT" add-row "$new_row"
    step "row added"
  fi
else
  # AMENDMENT 8 — THE CELL FIRST, THEN THE STAMP. The harness minted a
  # transcript uuid the published cell does not carry (step 3b), and the stamp
  # below is about to name that uuid: writing the stamp first would leave, for
  # as long as the two commits are apart, a row whose status names a session its
  # own session cell does not — and if the append then refused, for ever. So the
  # cell is extended first, with the same `replace-in-row` and the same anchor
  # discipline the minted case uses below: the anchor is the PUBLISHED last id,
  # which refuses exactly when this checkout's copy of the row is older than the
  # one that landed, and a refusal prints the act rather than corrupting a cell.
  if [ -n "$harness_sid" ]; then
    harness_hint="LANES_LANE=$LANE $LANES_EDIT append-session-id $LANE \"<the session cell's last id>\" \"→ $harness_cell\""
    if [ -z "$cell_anchor" ]; then
      note "the row's session cell records no transcript uuid to append to (some rows carry only \`session_…\` footer ids, which are not transcript ids). STAMP IT AS THIS SESSION'S FIRST ACT:"
      note "  $harness_hint"
    elif (( dry_run )); then
      plan "lanes-edit.sh append-session-id $LANE '$cell_anchor' '→ $harness_cell'"
    elif LANES_LANE="$LANE" "$LANES_EDIT" append-session-id "$LANE" "$cell_anchor" "→ $harness_cell" "session cell: the harness minted $harness_sid for this window"; then
      step "session cell updated: $cell_anchor → $harness_sid (the transcript live in this window)"
    else
      note "the session cell was NOT extended with $harness_sid (this checkout's copy of the row does not carry $cell_anchor exactly once IN ITS SESSION CELL — it may be older than the published one). STAMP IT AS THIS SESSION'S FIRST ACT:"
      note "  $harness_hint"
    fi
  fi

  # The row is the next launch's first source, so make the exact transcript
  # recovered from the lane's PAUSED record its final entry again. Without
  # this, every subsequent launch would rediscover the same dead row id and
  # need the fallback. This is written before the RESUMED status for the same
  # ordering guarantee as the harness-minted append immediately above.
  if [ -n "$restored_sid" ]; then
    restored_cell="harness \`$restored_sid\` (transcript uuid; restored from the lane's last PAUSED record)"
    restored_hint="LANES_LANE=$LANE $LANES_EDIT append-session-id $LANE \"<the session cell's last id>\" \"→ $restored_cell\""
    if [ -z "$row_sid" ]; then
      note "the row's session cell records no transcript uuid to append the recovered id to. STAMP IT AS THIS SESSION'S FIRST ACT:"
      note "  $restored_hint"
    elif (( dry_run )); then
      plan "lanes-edit.sh append-session-id $LANE '$row_sid' '→ $restored_cell'"
    elif LANES_LANE="$LANE" "$LANES_EDIT" append-session-id "$LANE" "$row_sid" "→ $restored_cell" "session cell: restored $restored_sid from the lane's last PAUSED record"; then
      step "session cell updated: $row_sid → $restored_sid (the exact transcript from the lane's last PAUSED record)"
    else
      note "the session cell was NOT extended with recovered transcript $restored_sid (this checkout's copy of the row may be older than the published one). STAMP IT AS THIS SESSION'S FIRST ACT:"
      note "  $restored_hint"
    fi
  fi

  # AMENDMENT 8's RULE, FOLLOWED HERE TOO: THE CELL FIRST, THEN THE STAMP
  # (Copilot round 5 on openRepoTools#82). The harness path above says it in
  # those words — the stamp names a uuid, so the cell that carries the uuid is
  # written first — and this path did the opposite: it stamped the minted id and
  # THEN tried to append it, so a refused append left the row's state naming a
  # session its own session cell does not carry. The resume target is the
  # SESSION CELL and nothing else (Amendment 6(b)), so that never resumed the
  # wrong conversation — it resumed the id the register knew — but the row said
  # two things a reader has to reconcile. Written in this order the common path
  # says one thing, and a refused append still prints the act that cures it.
  # An EXISTING row that is about to run a NEW session: append the minted id
  # after the cell's last id, so the next start resumes by id instead of by
  # title. The append is `replace-in-row`, which refuses unless its anchor
  # occurs exactly once in the row — so a failure here is a refusal, never a
  # corruption, and it never fails the launch.
  #
  # THE ANCHOR IS THE PUBLISHED ID AND THE FILE IS THIS CHECKOUT'S, which is a
  # refusal exactly when the two disagree — a stale copy of the row, the case
  # the read above exists for. That is the right way round: appending after the
  # id THIS copy ends on would write a cell that no longer matches the one that
  # landed, and `commit_push`'s rebase would then conflict on the same line. The
  # refusal prints the act instead, and the launch is unaffected.
  if [ -n "$new_sid" ]; then
    stamp_hint="LANES_LANE=$LANE $LANES_EDIT append-session-id $LANE \"<the session cell's last id>\" \"→ harness \\\`$new_sid\\\`\""
    if [ -z "$row_sid" ]; then
      note "the row's session cell records no session id this script can read (some rows carry only \`session_…\` footer ids). STAMP IT AS THIS SESSION'S FIRST ACT:"
      note "  $stamp_hint"
    elif (( dry_run )); then
      plan "lanes-edit.sh append-session-id $LANE '$row_sid' '→ harness \`$new_sid\`'"
    elif LANES_LANE="$LANE" "$LANES_EDIT" append-session-id "$LANE" "$row_sid" "→ harness \`$new_sid\`" "session cell: $prog minted $new_sid for this window"; then
      step "session cell updated: $row_sid → $new_sid"
    else
      note "the session cell was NOT stamped (this checkout's copy of the row does not carry $row_sid exactly once IN ITS SESSION CELL — it may be older than the published one). STAMP IT AS THIS SESSION'S FIRST ACT:"
      note "  $stamp_hint"
    fi
  fi

  # AMENDMENT 6(c)'s STAMP, WRITTEN HERE. The row's first act after a resume is
  # `RESUMED by <transcript uuid>`, and under Amendment 6(b) that stamp is
  # load-bearing: it is what the NEXT lane-start resumes, so a missed one is not
  # bookkeeping debt, it is a lost lane. It used to be owed to the session that
  # lane-start had just exec'd — which is a stamp nobody writes when the session
  # dies at a usage reset before its first act, the shape this estate hits daily.
  # The verb follows the launch decision, exactly as the object-log line does: a
  # resume is RESUMED and a new session is STARTED, and the uuid is the one this
  # run actually resumes or mints, read from the PUBLISHED row (R33) or from the
  # record live in this window (step 3b).
  # THE TAIL STATES WHAT HAPPENED (Amendment 8(d), F-B5). The old line said
  # `launching <cmd>` unconditionally, so a `--no-launch` run stamped the row
  # with a launch that by definition did not happen — and `--no-launch` is now
  # the PRESCRIBED act twice over in clause (d) (the harness-mint append, and
  # the deferred writes of the title-fallback path), so the defect would have
  # become the common case rather than an edge. The head of the stamp — the
  # part Amendment 6(b) and clause (d) quote, up to and including `lane-start on
  # <ws>:` — is unchanged.
  # AMENDMENT 13(a) — WHAT HAPPENED FIRST, AND THE PLACE IT HAPPENED AFTER IT.
  # The tail used to read `window renamed, dir <dir>, window <ref>, launching
  # <cmd>`, and under a 240-character cap (ratified decision O1) that order puts
  # the ONE FACT THAT IS NOWHERE ELSE — the exact command this run launched —
  # behind two that are recorded twice over: clause (c) writes `dir` and
  # `window` into the lane's own log as sub-fields of this very act's
  # `STARTED`/`RESUMED` line, and Amendment 11's listing prints both as columns.
  # So the launch clause comes first and the two sub-fields follow it, and a
  # line long enough to be cut loses what a reader can look up rather than what
  # they cannot.
  if (( no_launch )); then
    did="window renamed, no launch"
  else
    did="window renamed, launching $(quoted "${cmd[@]}")"
  fi
  did="$did; dir $DIR${record_window:+; window $record_window}"
  # `$stamp_who` is computed with the launch decision above: the uuid for
  # Claude, `<agent> <id>` for any other agent (Amendment 17(c)).
  # AMENDMENT 13(a) — THE STAMP IS THE CELL NOW, not another entry appended to
  # it. The `state` column holds ONE PHRASE, `<STATE> · <UTC> · <one line>`, and
  # `set-row-state` stamps the UTC itself — so this builds the line alone, and
  # the `$utc` this run computed stays where it is still needed (the handoff's
  # Rule 3 stamp and the log line).
  #
  # THE STATE IS `LIVE` EITHER WAY. A launch takes the lane live in this window;
  # `--no-launch` is the recording act of a session that is already in it
  # (Amendment 6(c)), so the lane is live in both branches and the tail says
  # which one happened.
  #
  # AND THE LINE KEEPS `<verb> by <uuid>` WORD FOR WORD, because
  # `row_stamp_is_unknown` reads exactly that pair out of this cell — Amendment
  # 8(e)'s "first cure carries one condition", which tells a wrong lineage from
  # the title fallback. A ` · ` inside the line would read back as a fourth part
  # of the phrase, so it is spelled `; ` here rather than refused at the writer,
  # and a line over the cap is cut rather than costing the row its whole stamp:
  # what will not fit is in the object log, one line along.
  state_line="$lane_verb by $stamp_who (lane $LANE) — lane-start on $ws: $did"
  state_line="$(cut_to_line "$state_line")"
  if (( dry_run )); then
    plan "lanes-edit.sh set-row-state $LANE \"LIVE · $state_line\""
  else
    LANES_LANE="$LANE" "$LANES_EDIT" set-row-state "$LANE" "LIVE · $state_line"
    step "row state set: LIVE · $lane_verb by ${lane_sid:-unknown}"
  fi

  # AMENDMENT 17(c) — THE CELL, IN THE AGENT'S OWN SPELLING. A launch of an
  # agent that is not Claude mints no transcript uuid and resumes none: the one
  # id it has in hand is the `transcript <id>` the lane's own last handoff
  # recorded (Amendment 17(b)), and the cell is appended with it as the register
  # has spelled such entries since 2026-09-05 — `Codex <id>`.
  #
  # AND NOTHING IS APPENDED WHERE THERE IS NO ID. `pending` in the session cell
  # would be the same defect clause (e) refuses in the session field of a log
  # line: the cell is what Amendment 6(b) resumes from, and a placeholder there
  # is a resume target nobody has. The row's STATE cell still records the act
  # (`RESUMED by codex pending`), because that cell is a history of acts.
  if [ "$AGENT" != claude ] && [ -n "$AGENT_ID" ]; then
    agent_cell="$AGENT_WORD \`$AGENT_ID\`"
    # THE ANCHOR IS THE PUBLISHED ROW'S LAST ID, which is the same anchor the
    # minted-uuid append below uses and for the same reason: `append-session-id`
    # refuses unless it occurs exactly once IN THE SESSION CELL, so a stale copy
    # of the row is a refusal that prints the act rather than a corruption.
    # `$cell_anchor` is NOT it — that variable is set only where a session is
    # live in this window whose uuid the cell lacks (step 3b), which is never
    # the case for a launch of an agent that is not Claude.
    if [ -z "$row_sid" ]; then
      note "the row's session cell records no id to append to, so this launch's $AGENT_WORD id is not in it. STAMP IT AS THIS SESSION'S FIRST ACT:"
      note "  LANES_LANE=$LANE $LANES_EDIT append-session-id $LANE \"<the session cell's last id>\" \"→ $agent_cell\""
    elif (( dry_run )); then
      plan "lanes-edit.sh append-session-id $LANE '$row_sid' '→ $agent_cell'"
    elif LANES_LANE="$LANE" "$LANES_EDIT" append-session-id "$LANE" "$row_sid" "→ $agent_cell" "session cell: $prog launched $AGENT for this lane"; then
      step "session cell updated: $row_sid → $agent_cell"
    else
      note "the session cell was NOT extended with $agent_cell (this checkout's copy of the row may be older than the published one). STAMP IT AS THIS SESSION'S FIRST ACT:"
      note "  LANES_LANE=$LANE $LANES_EDIT append-session-id $LANE \"<the session cell's last id>\" \"→ $agent_cell\""
    fi
  fi
fi

# ------------------------------------------- 5b. the lane's own object log
#
# Amendment 7. AFTER the row, because the row is what `who` reads the lane's
# liveness and handoff path out of, and a log line that named a lane with no
# row would point at nothing. It never fails the launch: a lane that cannot
# write its log still starts, and says that it could not.

# `owner/repo` out of the lane's own origin. Every URL form the estate uses:
# `git@github.com:owner/repo.git`, `https://github.com/owner/repo`, `ssh://…`.
# It CHECKS its own answer. A remote that is a local path, a mirror or any
# non-GitHub URL does not reduce to `owner/repo`, and recording one as the
# lane's home would be inherited by every `#n` that lane ever writes — and a
# home containing a space writes an event line the log's own parser cannot
# read back. `unknown` is the honest answer and the helper already refuses to
# expand `#n` against it.

origin_url="$(git -C "$DIR" remote get-url origin 2>/dev/null || :)"
home_nwo="$(origin_nwo "$DIR" || :)"
if [ -z "$home_nwo" ]; then
  home_nwo=unknown
  if [ -z "$origin_url" ]; then
    note "$DIR has no 'origin' remote, so the lane's home repo is recorded as 'unknown' — its cross-repo checks will not run until it is known"
  else
    note "$DIR's origin ('$origin_url') does not resolve to a GitHub owner/repo, so the lane's home repo is recorded as 'unknown' rather than as something every '#n' in this lane would inherit"
  fi
else
  # THE HOME IS CANONICAL (Amendment 7, R20). A checkout keeps whatever spelling
  # its `origin` had on the day it was cloned, and this estate has moved a
  # repository between orgs while the register was live: a lane homed on
  # `opensoft/codexFactory` wrote `#5` as an object key that could never collide
  # with another lane's `codeXfactory/codexFactory#5`, so two lanes held one
  # GitHub issue and nothing detected it. `lanes/repos.tsv` is what says the two
  # spellings are one repository, and every OTHER spelling in the tooling goes
  # through it — so this one does too, BEFORE the STARTED line is written, since
  # a home is inherited by every `#n` that lane ever writes.
  home_canon=""; hr_rc=0
  home_canon="$("$LANES_EDIT" resolve-repo "$home_nwo" 2>/dev/null)" || hr_rc=$?
  case "$hr_rc" in
    0)
      if [ -n "$home_canon" ] && [ "$home_canon" != "$home_nwo" ]; then
        step "home $home_nwo resolves through lanes/repos.tsv to $home_canon — recording the canonical spelling"
        home_nwo="$home_canon"
      fi ;;
    8)
      note "lanes/repos.tsv has no row for '$home_nwo', so the lane's home is recorded exactly as its origin spells it. If this repository has ever moved org or is spelled more than one way in the register, add a row to lanes/repos.tsv so every lane keys the same object the same way." ;;
    *)
      note "$LANES_EDIT resolve-repo '$home_nwo' failed (exit $hr_rc) — recording the spelling derived from origin" ;;
  esac
fi
# AMENDMENT 11 CLAUSE (c) — THE LANE'S DIRECTORY, PROFILE AND WINDOW, WRITTEN
# HERE BECAUSE THIS IS THE MOMENT THEY ARE ALL CERTAINLY KNOWN.
#
# `dir` closes Amendment 6's oldest open item by the record rather than by a
# symlink, an environment variable or a manifest: a lane's checkout is known to
# every process that is IN it and to nothing about to start one, so the one
# process that is certainly in it writes it down. `profile` is the second, and
# it is taken from `$CLAUDE_PROFILE_NAME`, which the launcher exports into
# every session it starts (`claude-profile:658`) — today a lane's profile is
# recoverable only from the tmux session name `claude-<profile>-<ts>-<pid>`,
# which act 1's window reuse and any rename destroy and which no record
# carries, so a restart typed anywhere but in the lane's surviving window
# cannot name the profile the launcher needs. `window` is Amendment 8(b)'s,
# gaining its `<@id>` ref.
#
# A LINE WRITTEN BEFORE THIS CLAUSE CARRIES NONE OF THEM, AND A READER THAT
# FINDS NONE SAYS SO RATHER THAN ASSUMING ONE — Amendment 7(i)'s cutover rule.
# So each sub-field is appended only where its value is actually in hand: no
# `$CLAUDE_PROFILE_NAME` is a lane started outside the launcher, and inventing
# `unknown` for it would be the same defect clause (e) refuses in the session
# field.
#
# A SPACE IS THE ONE CHARACTER THAT NEEDS A RULE RATHER THAN A REFUSAL, AND THE
# RULE IS QUOTING. Amendment 7(b) makes the space the separator between several
# refs inside one sub-field — which is exactly what `window`'s two refs rely on
# — so an unquoted `dir $HOME/my projects/x` (unquoted) parses as TWO refs and `lane-dir`
# hands back a truncated path that this script then refuses as "no such
# directory". The writer quotes it; `lane-dir` and every other reader take a
# value opening with `"` as running to its closing `"`, and strip both.
quote_subfield() {
  case "$1" in
    *' '*) printf '"%s"' "$1" ;;
    *)     printf '%s' "$1" ;;
  esac
}
lane_profile="${CLAUDE_PROFILE_NAME:-}"
case "$lane_profile" in
  *', '*|*' — '*|*'; '*|*'"'*)
    note "\$CLAUDE_PROFILE_NAME is '$lane_profile', which contains ', ', ' — ', '; ' or '\"' — the lane's \`profile\` sub-field is left out rather than written unreadable"
    lane_profile="" ;;
esac
lane_payload="home $home_nwo; estate $estate; dir $(quote_subfield "$DIR")"
[ -n "$lane_profile" ] && lane_payload="$lane_payload; profile $(quote_subfield "$lane_profile")"
[ -n "$record_window" ] && lane_payload="$lane_payload; window $record_window"

# AMENDMENT 8(d), R-A8-2 — `unknown` NEVER REACHES THE OBJECT LOG, AND THE RULE
# IS THE CONDITION RATHER THAN THE PATH. Amendment 7(b): the `session` field is
# the transcript uuid and only that. `lane_sid` is the literal `unknown`
# wherever this run has no uuid to name — the title fallback, where the picker
# has not run when the stamps would be written; a session already live in this
# window whose transcript is not in this directory; a run with no uuid source at
# all; `LANE_START_SESSION_ID=0`. The log is APPEND-ONLY, so a line written
# wrong there is wrong for ever, and the grammar's own writer does not write a
# line it cannot fill in. It is not a narrowing of Amendment 7 either: A8
# narrows A7 in exactly one place, clause (b)'s `PAUSED` payload, and not here.
#
# THE ROW'S STAMP STILL CARRIES `unknown`, and that is deliberate: the state
# cell is a history of ACTS, the act happened, and a placeholder there is a
# thing a reader can see. `unknown` never enters the SESSION cell, which is what
# Amendment 6(b) resumes from, and so is never replaced in it.
#
# BOTH DEFERRED RECORDS ARE WRITTEN BY THE FIRST ACT THAT KNOWS THE UUID — the
# session's own `lane-start --no-launch`, which clause (e)'s hook prompts by
# name. That run reads the live record whose tmux target is this window, APPENDS
# that uuid to the session cell through the cell-scoped edit, and only then
# writes this line and the handoff's stamp, both carrying the real uuid.
# (`lane_sid_known` is computed with the launch decision above, which is where
# `lane_sid` is decided and where the row's own stamp first reads it.)
if (( ! lane_sid_known )); then
  note "no transcript uuid is knowable at this instant (the row's stamp says '${lane_sid:-unknown}'), so the lane's $lane_verb log line is NOT written: Amendment 7(b) makes that field a transcript uuid and only that, and the log is append-only. Nor is the handoff's Rule 3 stamp. BOTH are written by the first act that knows the uuid, which is this session's own:"
  note "  $prog --no-launch $self_args"
elif (( dry_run )); then
  plan "lanes-edit.sh log $lane_verb lane:$LANE → \"$lane_payload\""
else
  if LANES_LANE="$LANE" LANES_SESSION="$lane_sid" "$LANES_EDIT" log "$lane_verb" "lane:$LANE" '→' "$lane_payload"; then
    step "object log: $lane_verb lane:$LANE, home $home_nwo"
  else
    note "the lane's object log was NOT written ($lane_verb, home $home_nwo). Write it as this session's first act:"
    note "  LANES_LANE=$LANE $LANES_EDIT log $lane_verb lane:$LANE '→' \"$lane_payload\""
  fi
fi

# ------------------------------------------- 5c. the handoff's Rule 3 stamp
#
# AMENDMENT 8 — LANE-START WRITES THE RULE 3 STAMP. Rule 3 makes the FIRST act
# of a lane resuming from a handoff a stamp on that handoff, in place, before
# it reads any further and before any other act. It was the SESSION's to write,
# and it was missed every time: seven resumes of this lane needed it written by
# hand afterwards, and while it was owed the three records of the same day
# disagreed about how many resumes there had been — the row said six, the
# object log four, the handoff five, about ONE lane on ONE day. Amendment 6(c)
# found exactly this about the row's own stamp and cured it the same way: the
# boundary act that KNOWS the resume writes the record of it, because a stamp
# that is owed is a stamp that is missed.
#
# ON A RESUME OF AN EXISTING ROW, AND NOTHING ELSE. The verb is `$lane_verb` —
# the very one 5a decided for the row's status and 5b's object line — so the
# three can never disagree about whether this was a resume. A brand-new row is
# not a resume of anything: the file its handoff cell names does not exist yet,
# and the session that will write it has not run.
#
# THE INSERT POINT IS RULED: the line immediately after the first blank line
# that follows line 1 — line 1 being the lane header (Rule 4) and the blank the
# end of the header block. That puts THIS resume at the top of the block of
# stamps, above the ones before it.
#
# AFTER 5b, so that every `lanes-edit.sh` write this run makes is already
# committed before this one touches the checkout at all. The register and the
# handoffs share one checkout, and the helper REFUSES a checkout carrying an
# uncommitted change to a tracked file it is not itself writing (Amendment 5,
# `dirty_elsewhere`). Stamp the handoff first and let its commit fail, and the
# edit made for the row is the reason the row cannot be written.
#
# AND IT IS NEVER A REASON TO REFUSE THE LAUNCH. A handoff that has moved, a
# checkout with no git, a rebase conflict, a push that hangs — each one prints
# the command that finishes the act, and the lane still starts. Rule 3's stamp
# is the RECORD of a resume, not the licence for one, and refusing the session
# would lose the conversation the stamp is about. (Rule 3 also says a lane that
# finds an existing stamp stops and reports. That is addressed to the session
# reading the resume prompt, not to the act that records the resume: the file
# already carries one line per resume and gains one more.)

# Ruling (h)'s bound, in this script's own few lines rather than reached for in
# the helper's: every git call that touches the NETWORK runs under
# `LANES_GIT_TIMEOUT` seconds (default 60; `0` or a non-number turns the bound
# off), so a hung remote costs the launch a minute and never the session. No
# `timeout` on PATH is not a reason to skip the call — it is a reason to make
# it unbounded, which is what this did before the bound existed.
HS_TIMED_OUT=0
hs_git_net() {
  local rc=0 budget="${LANES_GIT_TIMEOUT:-60}"
  HS_TIMED_OUT=0
  case "$budget" in
    ''|0|*[!0-9]*) "${LANES_GIT:-git}" "$@" || rc=$? ;;
    *)
      if command -v timeout >/dev/null 2>&1; then
        timeout -k 5 "$budget" "${LANES_GIT:-git}" "$@" || rc=$?
        case "$rc" in 124|137) HS_TIMED_OUT=1 ;; esac
      else
        "${LANES_GIT:-git}" "$@" || rc=$?
      fi ;;
  esac
  return "$rc"
}

# F-B7 — WHICH CASE THE READER IS IN, said rather than assumed. A stamp that is
# committed here and not pushed is carried out by the next `lanes-edit.sh` write
# ONLY where the handoff lives in the register's own checkout: that write pushes
# the BRANCH, so it takes the orphaned commit with it. `hs_resolve` also accepts
# an absolute path and a workspace root, either of which can land outside
# `$LANES_REPO` — and nothing ever pushes a commit made there, because no
# `lanes-edit.sh` write goes out of it. Promising a carry that will not happen
# is worse than printing the command, so the note says which it is.
hs_carry_note() {
  if [ -n "${LANES_REPO:-}" ] && [ "$hs_repo" = "$LANES_REPO" ]; then
    note "  (this handoff is in the register's own checkout, so the next lanes-edit.sh write out of it pushes the branch and carries this commit with it.)"
  else
    note "  (this handoff is NOT in the register's checkout ($hs_repo), so no lanes-edit.sh write will ever push it: the command above is the whole of the recovery.)"
  fi
  return 0
}

# The workspace repository, which is where handoffs live (Amendment 4(a)) and,
# since Amendment 9(a), where the register lives too. THIS USED TO BE A SECOND
# READER of the same file with a looser rule — it took any `path:` at any
# indentation and checked nothing — and Amendment 9(a) is explicit that a
# second way to find one thing is a second answer. It now defers to the one
# resolver above, which is the same in all four helpers.
hs_workspace_root() { lanes_workspace_root; }

# The file the row's handoff cell names. Three spellings, first hit wins, and
# every one of them is a READ:
#   (a) a path the cell already spells — absolute, or `~`-rooted, which is
#       Amendment 4(e)'s estate spelling reaching the same file through the
#       `~/projects/<estate>/handoffs` symlink;
#   (b) `<the register's own checkout>/<cell>` — the repository-relative
#       spelling every row this script writes carries, and the one the register
#       and the handoffs share;
#   (c) `<the workspace repository>/<cell>`, for a register reached from
#       somewhere else.
# A cell that spells a path of its own is answered by (a) alone: joining an
# absolute path on to a root gives a path nothing has.
hs_resolve() {
  local cell="$1" cand root
  [ -n "$cell" ] || return 1
  case "$cell" in
    '~/'*) cand="$HOME/${cell#'~/'}" ;;
    /*)    cand="$cell" ;;
    *)     cand="" ;;
  esac
  if [ -n "$cand" ]; then
    [ -f "$cand" ] || return 1
    printf '%s\n' "$cand"; return 0
  fi
  if [ -n "${LANES_REPO:-}" ] && [ -f "$LANES_REPO/$cell" ]; then
    printf '%s\n' "$LANES_REPO/$cell"; return 0
  fi
  root="$(hs_workspace_root 2>/dev/null || :)"
  if [ -n "$root" ] && [ -f "$root/$cell" ]; then
    printf '%s\n' "$root/$cell"; return 0
  fi
  return 1
}

# The handoff path is field 7 of the PUBLISHED row: the register's header is
# `| lane | session id | workstation / env / user | started (UTC) | objects
# owned | handoff path | state |`, and awk's field 1 is the empty string before
# the leading pipe. A row carrying an EXTRA cell after its state — there are
# such rows — does not move field 7; counting back from NF would.
# AND IT STAMPS ONLY WITH A REAL UUID (R-A8-2). A stamp naming `unknown` is a
# Rule 3 record that answers nothing about who resumed, in the one document this
# protocol cannot afford to rewrite; the note above names the act that writes it
# together with the deferred log line, at the first instant either can be right.
# AND THE STAMP NAMES THE AGENT WHERE ONE WAS NAMED (Amendment 17(c)): *"the
# Rule 3 resume prompt … single-use, and stamped `RESUMED by …` before anything
# else, as Rule 3 requires"*. `$stamp_ok` is `$lane_sid_known` for Claude — the
# rule R-A8-2 gives — and 1 for an agent whose id is its own kind of id, because
# refusing that stamp would leave Rule 3 unstamped for every launch this
# amendment exists to make.
if [ "$lane_verb" = RESUMED ] && [ "$row_count" = 1 ] && (( stamp_ok )); then
  hs_cell="$(cell 7 | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' || :)"
  hs_stamp="RESUMED by $stamp_who (lane $LANE) at $utc — lane-start on $ws"
  hs_subject="handoff($LANE@$ws): RESUMED by $stamp_who"
  hs_trailer="Lane: $LANE ($ws)"
  hs_file=""
  if [ -z "$hs_cell" ]; then
    step "the row names no handoff path, so there is no Rule 3 stamp to write"
  elif ! hs_file="$(hs_resolve "$hs_cell")"; then
    hs_ws_root="$(hs_workspace_root 2>/dev/null || :)"
    note "the handoff the row points at was NOT found, so Rule 3's stamp is not written: '$hs_cell'"
    note "  looked under ${LANES_REPO:-<this checkout has no git root>} and ${hs_ws_root:-<no readable path: in ${AGENT_PROTOCOL_ROOT:-$HOME/.agents}/workspace.yaml>}"
    note "  STAMP IT AS THIS SESSION'S FIRST ACT — this line under the handoff's header block:"
    note "    $hs_stamp"
    note "  then: git -C <the workspace repo> commit -m \"$hs_subject\" -m \"$hs_trailer\" -- <the file>"
  else
    # A handoff may be reached through the estate's `handoffs` symlink, so the
    # path git is given is the REAL one: a pathspec that leaves the repository
    # lexically is a pathspec git refuses, however plainly it is inside it.
    # `cd -P` AND NOT `readlink -f`, for the reason `real_of` gives above and
    # `lane-handoff` gives one file over (Copilot round 3 on openRepoTools#47):
    # an unresolved path here is a `hs_rel` git refuses as a pathspec, and the
    # stamp is then written and never committed.
    hs_dirreal="$( CDPATH=''; cd -P -- "$(dirname -- "$hs_file")" 2>/dev/null && pwd -P )" ||
      hs_dirreal="$(dirname -- "$hs_file")"
    hs_real="$hs_dirreal/$(basename -- "$hs_file")"
    hs_repo="$(git -C "$(dirname -- "$hs_real")" rev-parse --show-toplevel 2>/dev/null || :)"
    hs_rel="$hs_real"
    [ -n "$hs_repo" ] && hs_rel="${hs_real#"$hs_repo"/}"
    hs_fix="git -C ${hs_repo:-<the workspace repo>} commit -m \"$hs_subject\" -m \"$hs_trailer\" -- $hs_rel"
    hs_at=""
    if [ -r "$hs_real" ] && [ -s "$hs_real" ]; then
      hs_at="$(awk 'NR > 1 && /^[[:space:]]*$/ { print NR; exit }' "$hs_real" || :)"
      if [ -z "$hs_at" ]; then
        hs_at=1
        note "$hs_rel has no blank line after line 1, so it has no header block to stamp under — the stamp goes directly under line 1"
      fi
    fi
    if [ -z "$hs_at" ]; then
      note "the handoff the row points at is empty or unreadable, so Rule 3's stamp is not written: $hs_file"
      note "  STAMP IT AS THIS SESSION'S FIRST ACT — this line under the handoff's header block:"
      note "    $hs_stamp"
      note "  then: $hs_fix"
    elif (( dry_run )); then
      plan "stamp $hs_rel at line $((hs_at + 1)): $hs_stamp"
      plan "$hs_fix"
      plan "  then git -C ${hs_repo:-<the workspace repo>} pull --rebase origin ${LANES_BRANCH:-main} && … push origin ${LANES_BRANCH:-main}"
    else
      # THE FILE IS SPLICED, NEVER REWRITTEN. A handoff is the one document in
      # this protocol whose whole purpose is to be read by a later session, and
      # the act that deleted two lanes' rows on 2026-09-08 was a file written
      # whole from what somebody remembered of it. So: read it, put ONE line
      # in, write the rest back unchanged — and prove it before it lands. The
      # added line must be exactly the stamp, at exactly the ruled position,
      # and taking that line back out again must give the original file byte
      # for byte. If it does not, nothing is written at all: that is also what
      # catches a file whose last line has no newline, where `head` would glue
      # the stamp on to the end of it.
      hs_tmpd="$(mktemp -d)"
      hs_pre="$hs_tmpd/pre"; hs_out="$hs_tmpd/out"
      if ! cat -- "$hs_real" > "$hs_pre" 2>/dev/null; then
        note "the handoff the row points at could not be read, so Rule 3's stamp is not written: $hs_file"
        note "  STAMP IT AS THIS SESSION'S FIRST ACT — this line under the handoff's header block:"
        note "    $hs_stamp"
        note "  then: $hs_fix"
      else
        { head -n "$hs_at" -- "$hs_pre"
          printf '%s\n' "$hs_stamp"
          tail -n "+$((hs_at + 1))" -- "$hs_pre"
        } > "$hs_out"
        if [ "$(sed -n -e "$((hs_at + 1))p" "$hs_out")" = "$hs_stamp" ] &&
           { head -n "$hs_at" -- "$hs_out"; tail -n "+$((hs_at + 2))" -- "$hs_out"; } | cmp -s - "$hs_pre"
        then
          cat -- "$hs_out" > "$hs_real"     # the redirect FOLLOWS the symlink
          step "handoff stamped at line $((hs_at + 1)) of $hs_rel: $hs_stamp"
          if [ "${LANES_NO_GIT:-0}" = 1 ]; then
            note "LANES_NO_GIT=1 — the stamp is written and NOT committed:"
            note "  $hs_fix"
          elif [ -z "$hs_repo" ]; then
            note "$hs_real is not inside a git checkout, so the stamp cannot be committed from here — it is written, and nothing outside this machine knows it."
          else
            # AMENDMENT 4(d) — one commit per write, an EXPLICIT pathspec, and
            # the `Lane:` trailer. Never `git add -A` and never a bare `git
            # commit`: this checkout is shared with every other lane on this
            # workstation, and a write left uncommitted is captured by the next
            # lane's commit with its attribution lost.
            hs_rc=0
            "${LANES_GIT:-git}" -C "$hs_repo" add -- "$hs_rel" 1>&2 || hs_rc=$?
            if [ "$hs_rc" = 0 ]; then
              "${LANES_GIT:-git}" -C "$hs_repo" commit -q -m "$hs_subject" -m "$hs_trailer" -- "$hs_rel" 1>&2 || hs_rc=$?
            fi
            if [ "$hs_rc" != 0 ]; then
              note "the stamp is written but NOT committed (git exit $hs_rc) — an uncommitted write is captured by the next lane's commit and its attribution is lost (Amendment 4(d)). Commit it yourself:"
              note "  $hs_fix"
            else
              step "handoff stamp committed: $hs_subject"
              hs_branch="${LANES_BRANCH:-main}"
              if ! hs_git_net -C "$hs_repo" pull --rebase -q origin "$hs_branch" 1>&2; then
                "${LANES_GIT:-git}" -C "$hs_repo" rebase --abort >/dev/null 2>&1 || :
                if [ "$HS_TIMED_OUT" = 1 ]; then
                  note "the pull before the push TIMED OUT after ${LANES_GIT_TIMEOUT:-60}s (ruling (h): the launch does not wait on a hung remote) — the stamp is a local commit here and was not pushed."
                else
                  note "the pull before the push did not apply (a conflict, or no reachable origin) — the rebase is aborted, the checkout is clean, and the stamp is a local commit here that was not pushed."
                fi
                # RV-B3 — LOOK FIRST, because an aborted pull does NOT mean the
                # commit stayed here. Observed live 2026-09-12T23:04Z: this
                # lane's handoff commit hit an abort on a peer lane's untracked
                # log file, and the peer's own helper then rebased and pushed —
                # carrying this lane's local commit `59a2576` out to origin
                # underneath its own `f053245`. A reader who ran the re-push
                # blind at that point lands the same stamp twice, in the one
                # document this protocol cannot afford to rewrite. The
                # push-rejected branch below has always said to look; this one
                # promised a recovery that is sometimes already done.
                note "  git -C $hs_repo fetch origin $hs_branch && git -C $hs_repo log --oneline origin/$hs_branch -3   # a peer's push may already carry it"
                note "  git -C $hs_repo pull --rebase origin $hs_branch && git -C $hs_repo push origin $hs_branch      # only if it is not there"
                hs_carry_note
              elif ! hs_git_net -C "$hs_repo" push -q origin "$hs_branch" 1>&2; then
                if [ "$HS_TIMED_OUT" = 1 ]; then
                  note "the push TIMED OUT after ${LANES_GIT_TIMEOUT:-60}s (ruling (h)) — a hung push often LANDED and the connection did not close, so look before pushing again."
                else
                  note "the push was rejected — the stamp is a local commit here and other workstations cannot see it yet."
                fi
                note "  git -C $hs_repo fetch origin $hs_branch && git -C $hs_repo log --oneline origin/$hs_branch -3"
                note "  git -C $hs_repo push origin $hs_branch      # only if it is not there"
                hs_carry_note
              else
                step "handoff stamp pushed to origin/$hs_branch"
              fi
            fi
          fi
        else
          note "the splice of Rule 3's stamp into $hs_rel did not prove out (one line added, none changed), so NOTHING was written to it. Add this line under its header block yourself:"
          note "    $hs_stamp"
          note "  then: $hs_fix"
        fi
      fi
      rm -rf -- "$hs_tmpd"
    fi
  fi
fi

# ------------------------- 5d. the first prompt (Amendment 17(c) and (f))
#
# *"it launches the named agent with THE HANDOFF'S TOP BLOCK AS ITS FIRST
# PROMPT (the Rule 3 resume prompt, read from the file the row names)"*.
#
# AFTER 5c, AND THAT ORDER IS THE WHOLE OF RULE 3. The block handed to the new
# session is read AFTER this run has stamped `RESUMED by …` into the file, so
# the session reads a prompt that already carries the record of its own resume —
# and a `/ctx` respawn hands over the block `lane-handoff` wrote one step
# earlier, which is the same bytes from the same file rather than a second copy
# of them.
#
# THE TOP BLOCK IS THE HEAD OF THE FILE DOWN TO THE FIRST `---` RULE, which is
# the marker every refresh writes between the fresh block and the history below
# it, and 200 lines at the outside for a handoff that has none. A first prompt
# is a prompt, not a document: the session reads the rest of the file itself,
# and that is what "older sections below are history" means.
handoff_top_block() {   # <file>
  awk 'NR > 1 && $0 ~ /^---[ \t]*$/ { exit } { print } NR >= 200 { exit }' "$1"
}

if (( first_prompt )); then
  fp_cell=""
  if [ "$row_count" = 1 ]; then
    fp_cell="$(cell 7 | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' || :)"
  else
    fp_cell="$handoff"
  fi
  fp_file=""
  [ -n "$fp_cell" ] && fp_file="$(hs_resolve "$fp_cell" 2>/dev/null || :)"
  if [ -n "$fp_file" ] && [ -s "$fp_file" ]; then
    fp_text="$(handoff_top_block "$fp_file")"
    if [ -n "$fp_text" ]; then
      cmd+=("$fp_text")
      step "first prompt: the top block of $fp_cell ($(printf '%s\n' "$fp_text" | grep -c .) lines), delivered to $AGENT as its opening prompt"
    else
      note "the handoff the row names is empty at its head, so $AGENT is launched with no first prompt: $fp_file"
    fi
  else
    # NEVER A REASON TO REFUSE THE LAUNCH, for the same reason a handoff that
    # cannot be stamped is not: Rule 3's block is the RECORD a session resumes
    # from, and a session with no prompt can still read the file itself.
    note "the handoff the row names was not found${fp_cell:+ ('$fp_cell')}, so $AGENT is launched with no first prompt. Its first act is to read that file and stamp it (Rule 3)."
  fi
fi

# ---------------------------------------------------------------- 6. launch
#
# `cmd` was decided in 5a, before the row was written.

if (( no_launch )); then
  quoted "${cmd[@]}"; printf '\n'
  step "--no-launch: the command above was printed, not run (its cwd would be $DIR)"
  exit 0
fi

if (( dry_run )); then
  plan "cd $DIR"
  plan "exec $(quoted "${cmd[@]}")"
  step "--dry-run: nothing was renamed, written or launched"
  exit 0
fi

cd -- "$DIR"
step "exec: $(quoted "${cmd[@]}")"
exec "${cmd[@]}"
