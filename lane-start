    --)          shift; pass=("$@"); break ;;
    -*)          die "unknown option '$1' — see $prog --help" 2 ;;
    *)           positional+=("$1"); shift ;;
  esac
done

repo=""; n=""; verbatim=""
case "${#positional[@]}" in
  2) repo="${positional[0]}"; n="${positional[1]}" ;;
  1)
