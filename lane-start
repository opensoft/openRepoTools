fi

LANE="${verbatim:-$repo-$n}"
[[ "$LANE" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "'$LANE' is not usable as a window and session name (allowed: letters, digits, . _ -)" 2
repo="${repo:-$LANE}"          # the verbatim form has no <repo> of its own
estate="${estate:-$repo}"

# The position after this one, for the refusal to name. `10#` because a lane
# may be `-08` and 08 is not a number in base 8.
if [[ "$n" =~ ^[0-9]+$ ]]; then next_n="$((10#$n + 1))"; else next_n="<the next free position>"; fi

if [ -z "${LANES_FILE:-}" ]; then die "$(lanes_workspace_why)" 1; fi
[ -f "$LANES_FILE" ] || die "no register at $LANES_FILE — the workspace repository $(lanes_ws_yaml) names carries no lanes/LANES.md. \`openRepoTools wip init\` seeds one (it is idempotent); or set LANES_FILE" 1
[ -x "$LANES_EDIT" ] || die "no register writer at $LANES_EDIT — \`lanes-edit.sh\` is installed beside this command by \`openRepoTools --install\`. Run that, or set LANES_EDIT" 1

# ----------------------------------------- 1b. THE LANE'S DIRECTORY
#
# AMENDMENT 11 CLAUSE (c). A lane's checkout is known to every process that is
# IN it and to nothing that is about to start one, and Evidence 2 turned that
# into a restart that printed `[exited]`: `openXfactory-5`'s checkout is
# `~/projects/xFactory/openxFactory`, this script derived `$PROJECTS_ROOT/<repo>`
# and died here, and the launcher had no `--dir` to pass. Evidence 3 made it
# worse and quieter — a restart started from `/workspace` came up WITHOUT the
# repository's `CLAUDE.md` and without the lane's memory, because the harness
# keys a session to the directory it was started in, while `--resume <uuid>`
# went on continuing the transcript under the repository's own project folder.
# So the directory is READ FROM THE LANE'S OWN RECORD, and this script `cd`s
# into it before it launches (step 6).
#
# SIX RUNGS, FIRST ANSWER WINS, and clause (c) states them here rather than
# leaving them to an implementation because the launcher draft that read the
# first text of that clause invented one of its own:
#
#   1. `--dir <path>` — the operator's word. NOT tested for existence at this
#      rung: the refusal below names the path and the flag that fixes it, and a
#      script that silently dropped what it was told would hide that.
#   2. the SWAP RECORD's `dir` for this lane — `swapped`'s fourth tab-separated
#      field (clause (h)).
#   3. the LANE'S LOG — `lanes-edit.sh lane-dir <lane>`, the `dir ` sub-field of
#      its last lane-kind line carrying one.
#   4. `$PROJECTS_ROOT/<repo>` — the default, and ONLY the default for a lane
#      that has never been started under this amendment.
#   5. THE ESTATE'S `project.yaml` LEGS, and
#   6. A CHECKOUT NAMED FOR THE HOME'S REPOSITORY one or two levels under
#      `$PROJECTS_ROOT` — both added for Evidence 7, both PROVED by the
#      candidate's own `origin` against the lane's recorded home, and both
#      STATED IN FULL beside the code that implements them a hundred lines
#      below rather than a second time here.
#
# THEY WERE FOUR UNTIL EVIDENCE 7 AND THIS BLOCK WENT ON SAYING SO (#26, the
# review of `c3ebcfe`, `lane-start:780`). `708395e` added rungs 5 and 6 to this
# file; `2f44da0` corrected the MANUAL's count to six. The contract THE CODE
# CARRIES still said "FOUR RUNGS" and "THERE IS NO FIFTH RUNG" a hundred lines
# above the two rungs it had grown — which makes the code below look
# unreachable to its next reader, and the one act that reading invites is
# deleting it.
#
# WHAT THAT SENTENCE RULED OUT IS UNCHANGED, AND IT WAS NEVER A COUNT: THE
# CWD'S OWN CHECKOUT IS RULED OUT BY NAME. Deriving the directory from the
# directory the operator happens to be standing in is an inference, and this
# script writes the lane's HOME into its Amendment 7 `STARTED` line from that
# directory's `origin`, which every `#n` the lane afterwards writes inherits. An
# inference that can silently re-home a lane is not worth the refusal it saves;
# the refusal names `--dir`, and `--dir` is one word. Rungs 5 and 6 are not that
# inference and cannot decay into it: every candidate is PROVED by its own
# `origin` against the recorded home, one that fails the proof is passed over,
# and both are skipped entirely for a lane with no recorded home to prove it
# against.
#
# EVERY READ FAILS TO THE NEXT RUNG AND NEVER TO A REFUSAL. Amendment 7(d)'s
# fail-closed rule says a read that could not run must never be taken for
# "nothing to report"; it does not say the rungs below it stop answering. 8 is
# no answer, 2 is a helper predating Amendment 11 — expected and silent, told
# from a caller's bug by the helper's own words rather than by its status —
# and anything else is named once and then carried past.
# `owner/repo` out of a checkout's `origin`. DEFINED HERE rather than beside
# its first old caller, because Evidence 7's two rungs are the FIRST callers
# and they run four hundred lines earlier; a function defined after its call
# site is a function that is not there yet.
origin_nwo() {
  local url nwo
  url="$(git -C "$1" remote get-url origin 2>/dev/null || :)"
  [ -n "$url" ] || return 1
  nwo="$(printf '%s\n' "$url" | sed -E 's#\.git$##; s#^git@[^:]+:##; s#^ssh://[^/]+/##; s#^https?://[^/]+/##')"
  [[ "$nwo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || return 1
  printf '%s\n' "$nwo"
}

# A CANDIDATE IS PROVED BY ITS OWN `origin`, NEVER BY ITS NAME. Both of the two
# rungs Evidence 7 adds hand every candidate through here, and a candidate whose
# origin is not the lane's recorded home is not taken — which is what keeps them
# rungs rather than the inference clause (c) rules out by name.
lane_dir_is_home() {   # <candidate dir> <owner/repo the record names>
  ldh_o="$(origin_nwo "$1" 2>/dev/null || :)"
  [ -n "$ldh_o" ] || return 1
  ldh_c="$("$LANES_EDIT" resolve-repo "$ldh_o" 2>/dev/null || :)"
  [ -n "$ldh_c" ] && ldh_o="$ldh_c"
  [ "$(printf '%s' "$ldh_o" | tr 'A-Z' 'a-z')" = "$(printf '%s' "$2" | tr 'A-Z' 'a-z')" ]
}

