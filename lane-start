# ------------------------------------------------------------------ arguments

dry_run=0; no_launch=0; estate=""; dir_override=""; confirm=0; take_yes=0
positional=(); pass=()

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run)   dry_run=1; shift ;;
    --no-launch) no_launch=1; shift ;;
    --confirm)   confirm=1; shift ;;
    --yes)       take_yes=1; shift ;;
    # THE TWO SPELLINGS OF ONE FLAG GIVE ONE ANSWER, and these two did not
    # (#26, the review of `c3ebcfe`, `lane-start:707`). `--dir ""` refuses;
    # `--dir=` set the variable to nothing and fell through as if the operator
    # had not named a directory at all — so the rungs below it ran, and one of
    # them is `$PROJECTS_ROOT/<repo>`: `lane-start --dir= <repo> <n>` started in
    # a checkout the operator had not asked for instead of refusing a path they
    # had not given. `restart:151` — the same flag, on the sibling command —
    # has carried the guard on both spellings all along, which is what makes
    # this a divergence rather than a decision. Held for every flag in this
    # estate by `test_the_two_spellings_of_a_flag_refuse_the_same_empty_value`,
    # derived from the arms themselves rather than from a list.
    --dir)       dir_override="${2-}"; [ -n "$dir_override" ] || die "--dir needs a path" 2; shift 2 ;;
