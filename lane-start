      n="$arg"
    elif [[ "$arg" == *-* ]] && [[ "${arg##*-}" =~ ^[0-9]+[A-Za-z]?$ ]]; then
      repo="${arg%-*}"; n="${arg##*-}"
    elif [ -n "$dir_override" ]; then
      verbatim="$arg"
    else
      # `lane-start <repo>` WITH NO POSITION LISTS AND SUGGESTS (Brett Heap,
      # 2026-09-13, interactive multi-choice, verbatim "Yes, list and suggest
      # (Recommended)"; A11 Addendum 4 ruling 6's third delta, tracked as
      # `opensoft/openRepoTools#28`). It used to refuse with a placeholder `<n>`
      # for the operator to translate, at the one moment they are trying to
      # start work and do not know which positions are taken.
      #
      # IT RENDERS NOTHING OF ITS OWN. `lanes --prefix <repo>` is that listing
      # and its next-free-position footer, installed beside this command by
      # `openRepoTools --install`; a second rendering here is a second thing to
      # drift. Where it is absent — an older workstation — the refusal below is
      # still the whole answer, so this is an improvement and never a dependency.
      ls_cmd="$(command -v lanes 2>/dev/null || :)"
      [ -n "$ls_cmd" ] || { [ -x "$SCRIPT_DIR/lanes" ] && ls_cmd="$SCRIPT_DIR/lanes"; }
      # AND THE REFUSAL PROMISES A LISTING ONLY WHERE ONE WAS MADE (#26, the
      # review of `c3ebcfe`, `lane-start:602`). `|| :` made every code of that
      # read the same code, and the sentence below then sent a person to "the
      # listing above" when what was above it was `lanes`'s own refusal. `0` and
      # `8` both PRINT one — 8 is the empty repository, whose listing is the
      # next free position and the line that takes it — `2` is a `lanes`
      # predating the read, which says so in its own words, and anything else is
      # a read that FAILED. Nothing of the listing is re-rendered here on any of
      # them: this command renders none of it (the paragraph above), the read's
      # own output and stderr have already gone to the terminal, and what
      # changes is only whether this refusal claims a listing it did not get.
      ls_listed=0
      if [ -n "$ls_cmd" ]; then
        note "'$arg' is a repository and not a lane. Its lanes, and the position that is free:"
        ls_rc=0
