INTEGER_COLUMNS = {"ls_order", "line_count", "unreadable_count", "archived", "row_ordinal",
                   "ordinal", "unreadable", "position", "size_bytes", "generation",
                   "writer_live", "dirty_count", "unpushed_count", "pr_number"}

#: The tables `sync` and `reconcile` write. The ledger's two and #161's
#: `worktrees` are absent on purpose.
REGISTER_TABLES = ("source_files", "lanes", "log_lines", "register_lines", "lane_aliases",
                   "transcript_pointers")


def digest_of(table: str, record: dict) -> str:
    content = [table] + [record.get(col) for col in TABLE_COLUMNS[table]]
    blob = json.dumps(content, ensure_ascii=False, separators=(",", ":"), sort_keys=False)
    return hashlib.sha256(blob.encode("utf-8")).hexdigest()


def build_records(snap: dict) -> dict:
    """Every record of the register half at one commit, WITHOUT the owner
    column: the owner is `managed-projection`'s answer, asked separately."""
    out = {table: {} for table in REGISTER_TABLES}

    def put(table: str, record_id: str, record: dict) -> None:
        out[table][record_id] = record

    # ---- the files themselves
    for path, kind in ((REGISTER_PATH, "register"), (ALIASES_PATH, "aliases"),
                       (ARCHIVE_PATH, "archive")):
        text = snap.get(kind)
        if text is None:
            continue
        put("source_files", path, {"kind": kind, "lane": None, "ls_order": None,
                                   "blob_sha": snap["blobs"].get(path),
                                   "line_count": len(text.split("\n")),
                                   "unreadable_count": None})

    # ---- the logs, every line, the unreadable ones kept (7(b))
    facts: dict = {}
    first_log_of: dict = {}
    for path, text, obj, order in snap["logs"]:
        records, _warnings = parse_log(path, text)
        lane = file_lane(path)
        first_log_of.setdefault(lane.lower(), lane)
        unreadable = 0
        for rec in records:
            rec_id = f"{rec['lane']}:{rec['ordinal']}"
            # TWO FILES WHOSE NAMES DIFFER ONLY BY CASE are two logs for one
            # lane - Amendment 15(d)'s hand merge - and each keeps its lines
            # under its own spelling, so neither file's lines replace the other's.
            if rec_id in out["log_lines"]:
                rec_id = f"{rec['file']}:{rec['ordinal']}"
            if rec["unreadable"]:
                unreadable += 1
                row = {col: None for col in TABLE_COLUMNS["log_lines"]}
                row.update(lane=rec["lane"], file=rec["file"], ordinal=rec["ordinal"],
                           unreadable=1, unreadable_why=rec["unreadable_why"], raw=rec["raw"])
            else:
                row = {col: rec.get(col) for col in TABLE_COLUMNS["log_lines"]}
                row["payload_fields"] = json.dumps(payload_fields(rec["payload"]),
                                                   ensure_ascii=False, sort_keys=False)
            put("log_lines", rec_id, row)
            if rec["unreadable"]:
                continue
            f = facts.setdefault(lane.lower(), {"home": None, "sid": None, "paused": []})
            fork = rec["payload"].startswith("fork ")
            if rec["verb"] in ("STARTED", "RESUMED") and not fork:
                hm = re.search(r"home [^ ;]+", rec["payload"])
                if hm:
                    value = hm.group(0)[5:]
                    if value != "unknown":
                        f["home"] = value
            if rec["verb"] in ("PAUSED", "RESUMED") and UUID_FULL_RE.match(rec["session"] or ""):
                f["sid"] = rec["session"].lower()
            if rec["verb"] == "PAUSED":
                pf = payload_fields(rec["payload"])
                if "transcript" in pf:
                    f["paused"].append((rec["file"], rec["ordinal"], pf.get("transcript"),
                                        pf.get("agent")))
        put("source_files", path, {"kind": "log", "lane": lane, "ls_order": order,
                                   "blob_sha": obj, "line_count": len(text.split("\n")),
                                   "unreadable_count": unreadable})

    # ---- the register: its rows and its Rule 6 / Amendment 10 lines
    rows = []
    for ordinal, line in enumerate(snap["register"].split("\n"), 1):
        name = row_name(line)
        if name is not None:
            if name != "":
                rows.append((REGISTER_PATH, ordinal, name, line, 0))
            continue
        fields = parse_register_line(line)
        if fields is not None:
            fields["ordinal"] = ordinal
            fields["raw"] = line
            put("register_lines", str(ordinal), fields)
    if snap.get("archive") is not None:
        for ordinal, line in enumerate(snap["archive"].split("\n"), 1):
            name = row_name(line)
            if name:
                rows.append((ARCHIVE_PATH, ordinal, name, line, 1))

    # ---- Amendment 16(e)'s alias table, every line kept
    alias_map: dict = {}
    if snap.get("aliases") is not None:
        for ordinal, line in enumerate(snap["aliases"].split("\n"), 1):
            if line.strip() == "":
                continue
            parts = line.split("\t")
            old = _trim(parts[0]) if parts else ""
            new = _trim(parts[1]) if len(parts) > 1 else ""
            when = _trim(parts[2]) if len(parts) > 2 else ""
            comment = bool(re.match(r"^[ \t]*#", line))
            put("lane_aliases", str(ordinal), {
                "old_name": None if comment else (old or None),
                "new_name": None if comment else (new or None),
                "utc": None if comment else (when or None), "ordinal": ordinal, "raw": line})
            if not comment and old and new:
                alias_map[old.lower()] = (old, new, ordinal)

    def resolve(name: str) -> str:
        seen = set()
        cur = name
        while cur.lower() in alias_map and cur.lower() not in seen:
            seen.add(cur.lower())
            cur = alias_map[cur.lower()][1]
        return cur

    aliases_of: dict = {}
    for _key, (old, _new, ordinal) in sorted(alias_map.items(), key=lambda kv: kv[1][2]):
        aliases_of.setdefault(resolve(old).lower(), []).append(old)

    # ---- one record per lane: every row, then every log with no row
    used_lower: set = set()
    for row_file, ordinal, name, line, archived in rows:
        rec_id = name
        if rec_id in out["lanes"]:
            rec_id = f"{name}~{'archive' if archived else 'register'}:{ordinal}"
        parts = line.split("|")
        session_cell = parts[2] if len(parts) > 2 else ""
        ids = UUID_RE.findall(session_cell.lower())
        f = facts.get(name.lower(), {})
        state = cell_state(line)
        put("lanes", rec_id, {
            "lane": name,
            "aliases": json.dumps(aliases_of.get(name.lower(), []), ensure_ascii=False),
            "home": f.get("home"),
            "workstation": _trim(parts[3]) if len(parts) > 3 else None,
            "started_utc": _trim(parts[4]) if len(parts) > 4 else None,
            "objects_cell": _trim(parts[5]) if len(parts) > 5 else None,
            "handoff_path": _trim(parts[6]) if len(parts) > 6 else None,
            "state_phrase": _trim(state) if state else None,
            "session_ids": json.dumps(ids),
            "last_session": ids[-1] if ids else f.get("sid"),
            "archived": archived, "owner": None,
            "row_file": row_file, "row_ordinal": ordinal, "row_text": line})
        used_lower.add(name.lower())
        cell_ids = ids
        for position, tid in enumerate(cell_ids, 1):
            put("transcript_pointers", f"{rec_id}:cell:{position}", {
                "lane": name, "kind": "session-cell", "transcript_id": tid, "agent": None,
                "position": position})
    for path, _text, _obj, _order in snap["logs"]:
        lane = file_lane(path)
        key = lane.lower()
        if key in used_lower:
            continue
        used_lower.add(key)
        f = facts.get(key, {})
        put("lanes", lane, {
            "lane": lane,
            "aliases": json.dumps(aliases_of.get(key, []), ensure_ascii=False),
            "home": f.get("home"), "workstation": None, "started_utc": None,
            "objects_cell": None, "handoff_path": None, "state_phrase": None,
            "session_ids": json.dumps([]), "last_session": f.get("sid"),
            "archived": 0, "owner": None, "row_file": None, "row_ordinal": None,
            "row_text": None})
    for key, f in facts.items():
        lane = first_log_of.get(key, key)
        for path, ordinal, tid, agent in f["paused"]:
            # KEYED AS `log_lines` IS (Copilot round 1 on #164): two logs whose
            # names differ only by case are two files, and a PAUSED at the same
            # line of each is two pointers, never one written over the other.
            rec_id = f"{lane}:log:{ordinal}"
            if rec_id in out["transcript_pointers"]:
                rec_id = f"{path}:log:{ordinal}"
            put("transcript_pointers", rec_id, {
                "lane": lane, "kind": "paused", "transcript_id": tid, "agent": agent,
                "position": ordinal})
    for table in ("transcript_pointers",):
        for record in out[table].values():
            for col in TABLE_COLUMNS[table]:
                record.setdefault(col, None)
    return out


# ================================================== the owner column's reader

def managed_projection(lane: str) -> str:
    """`legacy`, `managed <owner>` or `unknown`, AND NOTHING ELSE DECIDES IT.

    #97's own reader answers: `lanes-edit.sh managed-projection <lane>` exits 0
    with the owner, 8 for a legacy lane, anything else for UNKNOWN. This file
    carries no parser of the marker, so a malformed one can never be read here
    as `legacy` (Amendment 14(e)); a reader that could not be run at all is
    UNKNOWN for the same reason."""
    helper = lanes_edit_path()
    if not helper:
        return "unknown"
    try:
        proc = subprocess.run([helper, "managed-projection", lane], capture_output=True,
                              text=True, check=False, env=helper_env(),
                              stdin=subprocess.DEVNULL, timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        return "unknown"
    if proc.returncode == 0 and proc.stdout.strip():
        return f"managed {proc.stdout.strip().splitlines()[0]}"
    if proc.returncode == 8:
        return "legacy"
    return "unknown"


def fill_owners(records: dict, stored_lanes: dict | None) -> int:
    """Ask `managed-projection` for every lane whose row text is new or changed
    (all of them where `stored_lanes` is None, which is `reconcile`), and carry
    the stored answer over for a row that has not moved. An `unknown` is never
    carried: it may be a read that failed, and asking again is how it clears.
    Returns how many lanes were asked."""
    ask = []
    for rec_id, rec in records["lanes"].items():
        old = (stored_lanes or {}).get(rec_id)
        if stored_lanes is not None and old is not None and old.get("row_text") == rec["row_text"] \
                and old.get("lane") == rec["lane"] and old.get("owner") \
                and old.get("owner") != "unknown":
            rec["owner"] = old["owner"]
        else:
            ask.append(rec_id)
    if ask:
        workers = max(1, min(8, len(ask)))
        with ThreadPoolExecutor(max_workers=workers) as pool:
            answers = list(pool.map(lambda rid: managed_projection(records["lanes"][rid]["lane"]),
                                    ask))
        for rec_id, owner in zip(ask, answers):
            records["lanes"][rec_id]["owner"] = owner
    return len(ask)


# =============================================================== the stores

def ddl(dialect: str, schema: str) -> list[str]:
    q = (lambda name: f'"{schema}".{name}') if dialect == "postgres" else (lambda name: name)
    big = "BIGINT" if dialect == "postgres" else "INTEGER"
    stmts = [
        f"CREATE TABLE IF NOT EXISTS {q('schema_version')} "
        f"(version INTEGER NOT NULL, applied_utc TEXT NOT NULL)",
        f"CREATE TABLE IF NOT EXISTS {q('provenance')} (source TEXT NOT NULL PRIMARY KEY, "
        f"commit_sha TEXT, generation {big}, indexed_utc TEXT NOT NULL, "
        f"schema_version INTEGER NOT NULL)",
    ]
    for table, cols in TABLE_COLUMNS.items():
        defs = ["source TEXT NOT NULL", "record_id TEXT NOT NULL"]
        for col in cols:
            defs.append(f"{col} {big if col in INTEGER_COLUMNS else 'TEXT'}")
        defs += ["digest TEXT NOT NULL", "provenance TEXT", "indexed_utc TEXT NOT NULL",
                 "schema_version INTEGER NOT NULL", "PRIMARY KEY (source, record_id)"]
        stmts.append(f"CREATE TABLE IF NOT EXISTS {q(table)} ({', '.join(defs)})")
    # HOLDS ARE COMPUTED, NEVER STORED (14(e)), and computed AS `holders_of`
    # COMPUTES THEM (Copilot round 2 on #164), which is `who`'s answer:
    #   * a lane's state on an object is its own LAST line on it - the lane
    #     compared case-insensitively (Amendment 15), so two logs one case
    #     apart are one lane - and "last" is the FILE-ORDERED position
    #     (file, then line; PER_LANE_AWK's `file "\034" %09d line`), never
    #     the UTC (R14);
    #   * it holds while that verb is open, UNLESS another lane's own last line
    #     on the object is a TAKEOVER (`superseded_by`, R18, #30).
    # The file comparison is BYTE order, as awk's string comparison is: SQLite's
    # default BINARY collation, and Postgres's "C".
    coll = ' COLLATE "C"' if dialect == "postgres" else ""
    ll = q("log_lines")
    view = (
        f"WITH ev AS (SELECT source, lane, lower(lane) AS lk, object, verb, utc, session, "
        f"file, ordinal FROM {ll} WHERE unreadable = 0 AND object IS NOT NULL "
        f"AND object NOT LIKE 'lane:%'), "
        f"last AS (SELECT e.* FROM ev e WHERE NOT EXISTS (SELECT 1 FROM ev m "
        f"WHERE m.source = e.source AND m.object = e.object AND m.lk = e.lk "
        f"AND (m.file{coll} > e.file{coll} OR (m.file = e.file AND m.ordinal > e.ordinal)))) "
        f"SELECT h.source, h.lane, h.object, h.verb, h.utc, h.session, h.file, h.ordinal "
        f"FROM last h WHERE h.verb IN ({', '.join(repr(v) for v in OPEN_VERBS)}) "
        f"AND NOT EXISTS (SELECT 1 FROM last t WHERE t.source = h.source "
        f"AND t.object = h.object AND t.lk <> h.lk AND t.verb = 'TAKEOVER')")
    stmts.append(f"CREATE INDEX IF NOT EXISTS log_lines_by_object ON {ll} (source, object)")
    if dialect == "postgres":
        stmts.append(f"CREATE OR REPLACE VIEW {q('holds')} AS {view}")
    else:
        stmts.append(f"CREATE VIEW IF NOT EXISTS holds AS {view}")
    stmts.append(
        f"INSERT INTO {q('schema_version')} (version, applied_utc) SELECT {SCHEMA_VERSION}, "
        f"'{utc_now()}' WHERE NOT EXISTS (SELECT 1 FROM {q('schema_version')})")
    return stmts


class SqliteStore:
    dialect = "sqlite"

    def __init__(self, cfg: dict):
        self.path = cfg["sqlite"]
        self.label = "sqlite"
        self.where = self.path
        self.conn = None

    def open_read(self):
        import sqlite3
        if not os.path.exists(self.path):
            raise StoreUnusable("missing", f"{self.path} does not exist")
        try:
            self.conn = sqlite3.connect(f"file:{self.path}?mode=ro", uri=True, timeout=10)
            self.conn.execute("SELECT 1 FROM sqlite_master LIMIT 1").fetchall()
        except sqlite3.Error as exc:
            raise StoreUnusable("unreachable", f"{self.path}: {exc}")
        self._check_schema(writing=False)

    def open_write(self):
        import sqlite3
        os.makedirs(os.path.dirname(self.path), mode=0o700, exist_ok=True)
        try:
            self.conn = sqlite3.connect(self.path, timeout=30, isolation_level=None)
            # EVERY WRITE-OPEN, NOT ONLY THE FIRST (Copilot round 2 on #164): a
            # store whose mode drifted to 0644 is made private again before
            # another row goes into it, or nothing more is written.
            try:
                os.chmod(self.path, 0o600)
            except OSError as exc:
                raise StoreUnusable("unreachable", f"{self.path} cannot be made 0600 "
                                    f"({exc.strerror or exc}); nothing written")
            have = {r[0] for r in self.conn.execute(
                "SELECT name FROM sqlite_master WHERE type IN ('table','view')")}
            if "schema_version" in have:
                self._check_schema(writing=True)
            self.conn.execute("BEGIN IMMEDIATE")
            for stmt in ddl("sqlite", ""):
                self.conn.execute(stmt)
            self.conn.execute("COMMIT")
        except sqlite3.Error as exc:
            raise StoreUnusable("unreachable", f"{self.path}: {exc}")
        self._check_schema(writing=True)

    def _check_schema(self, writing: bool):
        import sqlite3
        try:
            rows = self.conn.execute("SELECT version FROM schema_version").fetchall()
        except sqlite3.Error:
            if writing:
                return
            raise StoreUnusable("wiped", f"{self.path} carries no schema_version table")
        versions = {r[0] for r in rows}
        if not versions:
            if writing:
                return
            raise StoreUnusable("wiped", f"{self.path} carries no schema_version row")
        if versions != {SCHEMA_VERSION}:
            raise StoreUnusable("unknown-schema",
                                f"schema {sorted(versions)} in {self.path}; this "
                                f"{PROG} knows {SCHEMA_VERSION}")

    def provenance(self, source: str) -> dict | None:
        import sqlite3
        try:
            row = self.conn.execute(
                "SELECT commit_sha, generation, indexed_utc, schema_version FROM provenance "
                "WHERE source = ?", (source,)).fetchone()
        except sqlite3.Error as exc:
            raise StoreUnusable("wiped", f"{self.path}: {exc}")
        if row is None:
            return None
        return {"commit_sha": row[0], "generation": row[1], "indexed_utc": row[2],
                "schema_version": row[3]}

    def all_provenance(self) -> list:
        import sqlite3
        try:
            return [{"source": r[0], "commit_sha": r[1], "generation": r[2], "indexed_utc": r[3],
                     "schema_version": r[4]} for r in self.conn.execute(
                         "SELECT source, commit_sha, generation, indexed_utc, schema_version "
                         "FROM provenance ORDER BY source")]
        except sqlite3.Error as exc:
            raise StoreUnusable("wiped", f"{self.path}: {exc}")

    def rows(self, table: str, source: str, columns: list[str]) -> list:
        cols = ", ".join(["record_id"] + columns)
        return [dict(zip(["record_id"] + columns, r)) for r in self.conn.execute(
            f"SELECT {cols} FROM {table} WHERE source = ?", (source,))]

    def apply(self, source: str, old: dict | None, new_sha: str, upserts: dict,
              deletes: dict) -> None:
        import sqlite3
        now = utc_now()
        try:
            self.conn.execute("BEGIN IMMEDIATE")
            cur = self.conn.execute("SELECT commit_sha FROM provenance WHERE source = ?",
                                    (source,)).fetchone()
            want = old["commit_sha"] if old else None
            if (cur[0] if cur else None) != want or (cur is None) != (old is None):
                self.conn.execute("ROLLBACK")
                raise CasLost(f"the provenance of {source} moved under this sync "
                              f"(it read {str(want)[:12]}, the store now holds "
                              f"{str(cur[0] if cur else None)[:12]}); nothing was written")
            if cur is None:
                self.conn.execute(
                    "INSERT INTO provenance (source, commit_sha, generation, indexed_utc, "
                    "schema_version) VALUES (?, ?, NULL, ?, ?)",
                    (source, new_sha, now, SCHEMA_VERSION))
            else:
                self.conn.execute(
                    "UPDATE provenance SET commit_sha = ?, indexed_utc = ?, schema_version = ? "
                    "WHERE source = ?", (new_sha, now, SCHEMA_VERSION, source))
            for table, ids in deletes.items():
                for rec_id in ids:
                    self.conn.execute(f"DELETE FROM {table} WHERE source = ? AND record_id = ?",
                                      (source, rec_id))
            for table, recs in upserts.items():
                cols = TABLE_COLUMNS[table]
                allc = ["source", "record_id"] + cols + ["digest", "provenance", "indexed_utc",
                                                         "schema_version"]
                sets = ", ".join(f"{c} = excluded.{c}" for c in allc[2:])
                sql = (f"INSERT INTO {table} ({', '.join(allc)}) VALUES "
                       f"({', '.join('?' for _ in allc)}) ON CONFLICT (source, record_id) "
                       f"DO UPDATE SET {sets}")
                self.conn.executemany(sql, [
                    [source, rec_id] + [rec.get(c) for c in cols] +
                    [rec["digest"], new_sha, now, SCHEMA_VERSION]
                    for rec_id, rec in recs.items()])
            self.conn.execute("COMMIT")
        except sqlite3.Error as exc:
            try:
                self.conn.execute("ROLLBACK")
            except sqlite3.Error:
                pass
            raise StoreUnusable("unreachable", f"{self.path}: {exc}")


def _pg_quote(value) -> str:
    if value is None:
        return "NULL"
    if isinstance(value, int):
        return str(value)
    return "'" + str(value).replace("'", "''") + "'"


def _pg_unescape(field: str):
    """One field of `COPY ... TO STDOUT` in TEXT format: `\\N` is NULL and a
    backslash escapes the rest, exactly as the server wrote it."""
    if field == "\\N":
        return None
    if "\\" not in field:
        return field
    out, i, n = [], 0, len(field)
    simple = {"b": "\b", "f": "\f", "n": "\n", "r": "\r", "t": "\t", "v": "\v", "\\": "\\"}
    while i < n:
        ch = field[i]
        if ch != "\\" or i + 1 >= n:
            out.append(ch)
            i += 1
            continue
        nxt = field[i + 1]
        if nxt in simple:
            out.append(simple[nxt])
            i += 2
        elif nxt in "01234567":
            j = i + 1
            while j < n and j < i + 4 and field[j] in "01234567":
                j += 1
            out.append(chr(int(field[i + 1:j], 8)))
            i = j
        elif nxt == "x":
            j = i + 2
            while j < n and j < i + 4 and field[j] in "0123456789abcdefABCDEF":
                j += 1
            out.append(chr(int(field[i + 2:j], 16)) if j > i + 2 else "x")
            i = j
        else:
            out.append(nxt)
            i += 2
    return "".join(out)


class PostgresStore:
    """QA Postgres, reached ONLY through `psql` and ONLY where `url=` is
    configured. Nothing here imports a driver: `psql` is libpq's own client,
    and the password it needs is in the 0600 file `PGPASSFILE` names - never
    in this process's arguments and never in an environment it hands on."""

    dialect = "postgres"

    def __init__(self, cfg: dict, role: str):
        self.schema = cfg["schema"]
        if role == "reader":
            # NEVER THE WRITER'S CREDENTIAL FOR A READ (Copilot round 1 on #164).
            # The writer is the indexer's and no session's (14(c)), and `export`
            # is run by a session typing `--index`: with no `reader_url=` the
            # read is refused, and the read flags answer from the sources.
            if not cfg.get("reader_url"):
                raise Refusal(
                    "the configuration names a Postgres `url=` and no `reader_url=`: the "
                    "reads (`status`, `--index`) connect only as the SELECT-only reader, "
                    "never with the writer's credential (Amendment 14(c))")
            self.url, self.passfile = cfg["reader_url"], cfg.get("reader_passfile") or cfg["passfile"]
        else:
            self.url, self.passfile = cfg["url"], cfg["passfile"]
        self.label = "postgres"
        self.where = re.sub(r"^[A-Za-z][A-Za-z0-9+.-]*://", "", self.url).split("?", 1)[0]
        self.psql = shutil.which("psql") or ""

    def _env(self) -> dict:
        # THE CONFIGURED PASSWORD FILE OR NONE AT ALL (14(c); Copilot on #164):
        # an inherited `PGPASSWORD` or `PGPASSFILE` is dropped, and with no
        # `passfile=` libpq is handed an EMPTY 0600 file of this command's own -
        # never left to find `~/.pgpass` or a file some other environment named.
        env = {k: v for k, v in os.environ.items() if k not in ("PGPASSWORD", "PGPASSFILE")}
        env["PGPASSFILE"] = self.passfile or _no_password_file()
        env.setdefault("PGCONNECT_TIMEOUT", "5")
        env["PGAPPNAME"] = PROG
        return env

    def _run(self, script: str) -> str:
        if not self.psql:
            raise StoreUnusable("unreachable", "`url=` is configured and there is no `psql` on PATH")
        try:
            proc = subprocess.run(
                [self.psql, "--no-psqlrc", "-X", "-q", "-v", "ON_ERROR_STOP=1", "-d", self.url],
                input=script, capture_output=True, text=True, check=False, env=self._env(),
                timeout=300)
        except subprocess.TimeoutExpired:
            raise StoreUnusable("unreachable", "psql did not answer within 300 s")
        except OSError as exc:
            raise StoreUnusable("unreachable", f"psql could not be run: {exc}")
        if proc.returncode != 0:
            err = (proc.stderr.strip().splitlines() or [f"psql exited {proc.returncode}"])
            if "lanes-index: provenance moved" in proc.stderr:
                raise CasLost(err[-1])
            if proc.returncode == 2:
                raise StoreUnusable("unreachable", err[0])
            raise StoreUnusable("unreachable", err[-1])
        return proc.stdout

    def _query_many(self, queries: list[str]) -> list[list[list]]:
        """Several SELECTs in ONE connection, each answered as TEXT-format COPY
        rows; a marker line no COPY row can be (one field, a control
        character) separates them."""
        marker = "\x1eLANES-INDEX-NEXT"
        parts = [f"SET search_path TO \"{self.schema}\";"]
        for query in queries:
            parts.append(f"COPY ({query}) TO STDOUT;")
            parts.append("\\echo '\\036LANES-INDEX-NEXT'")
        out = self._run("\n".join(parts) + "\n")
        results, current = [], []
        for line in out.split("\n"):
            if line == marker:
                results.append(current)
                current = []
                continue
            if line == "":
                continue
            current.append([_pg_unescape(f) for f in line.split("\t")])
        return results

    def open_read(self):
        try:
            res = self._query_many([
                f"SELECT version FROM \"{self.schema}\".schema_version"])
        except StoreUnusable as exc:
            if "does not exist" in exc.detail:
                raise StoreUnusable("wiped", exc.detail)
            raise
        versions = {int(r[0]) for r in res[0]} if res else set()
        if not versions:
            raise StoreUnusable("wiped", f"schema {self.schema} carries no schema_version row")
        if versions != {SCHEMA_VERSION}:
            raise StoreUnusable("unknown-schema", f"schema {sorted(versions)} in {self.schema}; "
                                f"this {PROG} knows {SCHEMA_VERSION}")

    def open_write(self):
        # THE VERSION FIRST (Copilot round 2 on #164): the DDL includes a
        # `CREATE OR REPLACE VIEW`, so running it against another schema's
        # store would rewrite that store before `open_read` called it
        # `unknown-schema`. Only an ABSENT schema (`wiped`) is bootstrapped.
        try:
            self.open_read()
            return
        except StoreUnusable as exc:
            if exc.kind != "wiped":
                raise
        script = ["SET standard_conforming_strings = on;", "BEGIN;"]
        script += [s + ";" for s in ddl("postgres", self.schema)]
        script.append("COMMIT;")
        self._run("\n".join(script) + "\n")
        self.open_read()

    def provenance(self, source: str) -> dict | None:
        res = self._query_many([
            f"SELECT commit_sha, generation, indexed_utc, schema_version FROM provenance "
            f"WHERE source = {_pg_quote(source)}"])
        if not res or not res[0]:
            return None
        r = res[0][0]
        return {"commit_sha": r[0], "generation": r[1], "indexed_utc": r[2],
                "schema_version": r[3]}

    def all_provenance(self) -> list:
        res = self._query_many([
            "SELECT source, commit_sha, generation, indexed_utc, schema_version "
            "FROM provenance ORDER BY source"])
        return [{"source": r[0], "commit_sha": r[1], "generation": r[2], "indexed_utc": r[3],
                 "schema_version": r[4]} for r in (res[0] if res else [])]

    def rows(self, table: str, source: str, columns: list[str]) -> list:
        res = self._query_many([
            f"SELECT {', '.join(['record_id'] + columns)} FROM {table} "
            f"WHERE source = {_pg_quote(source)}"])
        out = []
        for r in (res[0] if res else []):
            rec = dict(zip(["record_id"] + columns, r))
            for col in columns:
                if col in INTEGER_COLUMNS and rec[col] is not None:
                    rec[col] = int(rec[col])
            out.append(rec)
        return out

    def apply(self, source: str, old: dict | None, new_sha: str, upserts: dict,
              deletes: dict) -> None:
        now = utc_now()
        want = old["commit_sha"] if old else None
        lines = ["SET standard_conforming_strings = on;", "BEGIN;",
                 f"SET LOCAL search_path TO \"{self.schema}\";",
                 # THE COMPARE-AND-SWAP, FIRST AND IN THE SAME TRANSACTION AS THE
                 # ROWS: the UPDATE takes the provenance row's lock, so a second
                 # writer reading the same old commit blocks here and then finds
                 # it moved, and its whole transaction goes (Amendment 14(d)).
                 "DO $lanes_index_cas$ DECLARE n integer; BEGIN",
                 f"  INSERT INTO provenance (source, commit_sha, generation, indexed_utc, "
                 f"schema_version) VALUES ({_pg_quote(source)}, NULL, NULL, {_pg_quote(now)}, "
                 f"{SCHEMA_VERSION}) ON CONFLICT (source) DO NOTHING;",
                 f"  UPDATE provenance SET commit_sha = {_pg_quote(new_sha)}, indexed_utc = "
                 f"{_pg_quote(now)}, schema_version = {SCHEMA_VERSION} WHERE source = "
                 f"{_pg_quote(source)} AND commit_sha IS NOT DISTINCT FROM {_pg_quote(want)};",
                 "  GET DIAGNOSTICS n = ROW_COUNT;",
                 "  IF n <> 1 THEN RAISE EXCEPTION 'lanes-index: provenance moved under this "
                 "sync; nothing was written'; END IF;",
                 "END $lanes_index_cas$;"]
        for table, ids in deletes.items():
            for rec_id in ids:
                lines.append(f"DELETE FROM {table} WHERE source = {_pg_quote(source)} AND "
                             f"record_id = {_pg_quote(rec_id)};")
        for table, recs in upserts.items():
            cols = TABLE_COLUMNS[table]
            allc = ["source", "record_id"] + cols + ["digest", "provenance", "indexed_utc",
                                                     "schema_version"]
            sets = ", ".join(f"{c} = EXCLUDED.{c}" for c in allc[2:])
            for rec_id, rec in recs.items():
                values = [source, rec_id] + [rec.get(c) for c in cols] + \
                    [rec["digest"], new_sha, now, SCHEMA_VERSION]
                lines.append(f"INSERT INTO {table} ({', '.join(allc)}) VALUES "
                             f"({', '.join(_pg_quote(v) for v in values)}) ON CONFLICT "
                             f"(source, record_id) DO UPDATE SET {sets};")
        lines.append("COMMIT;")
        self._run("\n".join(lines) + "\n")


def _no_password_file() -> str:
    """An empty 0600 file for libpq to read where no `passfile=` is configured
    (a passwordless role: peer, trust or certificate authentication)."""
    path = os.path.join(state_dir(), "lanes-index.nopass")
    try:
        os.makedirs(state_dir(), mode=0o700, exist_ok=True)
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        os.close(fd)
        os.chmod(path, 0o600)
    except OSError as exc:
        raise StoreUnusable("unreachable", f"{path} could not be made as the empty password "
                            f"file ({exc.strerror or exc}); nothing was sent to Postgres")
    return path


def open_store(cfg: dict, role: str):
    return SqliteStore(cfg) if cfg["store"] == "sqlite" else PostgresStore(cfg, role)


# ============================================================ local status

def _status_path() -> str:
    return os.path.join(state_dir(), "lanes-index.status.json")


def read_status() -> dict:
    try:
        with open(_status_path(), encoding="utf-8") as handle:
            data = json.load(handle)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def write_status(source: str, **fields) -> None:
    """This workstation's own record of its last attempt, which the store
    cannot hold for an attempt that could not reach it."""
    try:
        os.makedirs(state_dir(), mode=0o700, exist_ok=True)
        data = read_status()
        entry = data.get(source, {})
        entry.update(fields)
        data[source] = entry
        tmp = _status_path() + f".{os.getpid()}"
        with open(tmp, "w", encoding="utf-8") as handle:
            json.dump(data, handle, indent=1, sort_keys=True)
        os.chmod(tmp, 0o600)
        os.replace(tmp, _status_path())
    except OSError:
        pass


class SyncLock:
    """ONE SYNC AT A TIME PER WORKSTATION (14(d)). A second sync that finds the
    lock held leaves a RERUN mark and returns at once - the holder syncs again
    before it lets go - so a burst of writes is one or two syncs, never a
    queue of them, and no nudge ever waits."""

    def __init__(self):
        self.path = os.path.join(state_dir(), "lanes-index.lock")
        self.rerun = os.path.join(state_dir(), "lanes-index.rerun")
        self.handle = None

    def acquire(self, wait_seconds: float) -> bool:
        try:
            import fcntl
        except ImportError:
            return True
        os.makedirs(state_dir(), mode=0o700, exist_ok=True)
        self.handle = open(self.path, "a+")
        try:
            os.chmod(self.path, 0o600)
        except OSError:
            pass
        deadline = time.monotonic() + wait_seconds
        while True:
            try:
                fcntl.flock(self.handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                return True
            except OSError:
                if time.monotonic() >= deadline:
                    self.handle.close()
                    self.handle = None
                    return False
                time.sleep(0.2)

    def mark_rerun(self) -> None:
        try:
            with open(self.rerun, "w", encoding="utf-8") as handle:
                handle.write(utc_now() + "\n")
        except OSError:
            pass

    def take_rerun(self) -> bool:
        try:
            os.unlink(self.rerun)
            return True
        except OSError:
            return False

    def release(self) -> None:
        if self.handle is not None:
            self.handle.close()
            self.handle = None


# ================================================================ the acts

def resolve_source(requested: str | None, root: str) -> str:
    source = source_of(root)
    if requested and requested != source:
        if requested.startswith("ledger:"):
            raise Refusal(f"{requested} is the managed ledger's half, which T058 of the 001 "
                          f"feature writes (Amendment 14(g) act 4); this indexer writes the "
                          f"register half only")
        raise Refusal(f"this workstation's register is {source}, not {requested}")
    return source


def diff_records(store, source: str, records: dict, verify_content: bool) -> tuple:
    """The upserts and deletes that take the stored source to `records`.

    `sync` compares DIGESTS: an upsert bearing the stored digest changes
    nothing. `reconcile` recomputes each stored row's digest from its CONTENT,
    so a row somebody changed by hand - which still carries its old digest - is
    found and put right."""
    upserts, deletes, kept = {}, {}, {}
    for table in REGISTER_TABLES:
        cols = TABLE_COLUMNS[table]
        stored = {r["record_id"]: r for r in store.rows(table, source,
                                                         cols + ["digest"])}
        for rec in records[table].values():
            rec["digest"] = digest_of(table, rec)
        for rec_id, rec in records[table].items():
            old = stored.get(rec_id)
            if old is not None:
                have = digest_of(table, old) if verify_content else old["digest"]
                if have == rec["digest"] and (not verify_content or old["digest"] == rec["digest"]):
                    kept[table] = kept.get(table, 0) + 1
                    continue
            upserts.setdefault(table, {})[rec_id] = rec
        gone = [rec_id for rec_id in stored if rec_id not in records[table]]
        if gone:
            deletes[table] = gone
    return upserts, deletes, kept


def has_unknown_owner(store, source: str) -> bool:
    return any(r["owner"] == "unknown" for r in store.rows("lanes", source, ["owner"]))


def stored_lanes_of(store, source: str) -> dict:
    return {r["record_id"]: r for r in store.rows("lanes", source,
                                                   ["lane", "owner", "row_text"])}


def run_index(mode: str, requested: str | None, dry_run: bool) -> int:
    cfg = load_config()
    root = workspace_root()
    source = resolve_source(requested, root)
    tip = tip_of(root)
    store = open_store(cfg, "writer")
    if dry_run:
        try:
            store.open_read()
        except StoreUnusable as exc:
            if exc.kind not in ("missing", "wiped"):
                raise
            store = None
    else:
        store.open_write()
    old = store.provenance(source) if store is not None else None
    label = f"{source} at register@{tip[:12]} ({cfg['store']})"
    if old and old.get("commit_sha"):
        prev = old["commit_sha"]
        if not has_commit(root, prev):
            say(f"{PROG} {mode}: the index holds register@{prev[:12]}, which this checkout has "
                f"not fetched - another workstation is ahead of it; nothing written")
            write_status(source, last_attempt_utc=utc_now(), last_result="behind (unknown commit)")
            return 0
        # NOT WHILE AN OWNER IS `unknown` (Codex on #164): an `unknown` may be a
        # read that failed, and asking again is how it clears - so a sync at
        # the same commit goes the long way round, asks only those, and writes
        # nothing where nothing has changed.
        if prev == tip and mode == "sync" and not has_unknown_owner(store, source):
            say(f"{PROG} sync: {label} - the index is at the tip; nothing to write")
            write_status(source, last_attempt_utc=utc_now(), last_sync_utc=utc_now(),
                         last_result="current", last_error="")
            return 0
        if not is_ancestor(root, prev, tip):
            behind = is_ancestor(root, tip, prev)
            why = ("this checkout is BEHIND the index" if behind else
                   "the two have diverged - a register history rewritten under the index is "
                   "rebuilt by wiping the index and reconciling")
            say(f"{PROG} {mode}: register@{tip[:12]} does not descend from the indexed "
                f"register@{prev[:12]}: {why}. The provenance only moves forward "
                f"(Amendment 14(d)); nothing written")
            write_status(source, last_attempt_utc=utc_now(),
                         last_result="not a descendant; nothing written")
            return 0 if behind else 1
    snap = read_snapshot(root, tip)
    records = build_records(snap)
    if store is None:
        fill_owners(records, None)
        upserts = {t: dict(r) for t, r in records.items() if r}
        for table, recs in upserts.items():
            for rec in recs.values():
                rec["digest"] = digest_of(table, rec)
        deletes, kept = {}, {}
    else:
        stored = None if mode == "reconcile" else stored_lanes_of(store, source)
        fill_owners(records, stored)
        upserts, deletes, kept = diff_records(store, source, records,
                                              verify_content=(mode == "reconcile"))
    # THE OWNERS ARE ASKED OF `origin/<branch>` AS IT STANDS, and the rows were
    # read at ONE commit (Copilot round 1 on #164): `managed-projection` reads
    # the ref, not a sha. So the ref is asked again once every owner is in, and
    # a ref that moved meanwhile writes NOTHING - not rows of one commit beside
    # owners of another - and the caller starts over at the new tip.
    if not dry_run and tip_of(root) != tip:
        raise SourceMoved(f"origin/{branch()} moved from {tip[:12]} while the owners were "
                          f"read; nothing was written from that read")
    n_up = sum(len(v) for v in upserts.values())
    n_del = sum(len(v) for v in deletes.values())
    if mode == "reconcile":
        say(f"{PROG} reconcile: {label}{' - DRY RUN' if dry_run else ''}")
        for table in REGISTER_TABLES:
            say(f"  {table:<20} {kept.get(table, 0):>6} kept  {len(upserts.get(table, {})):>6} "
                f"upserted  {len(deletes.get(table, [])):>6} removed")
    if dry_run:
        say(f"  total: {n_up} to upsert, {n_del} to remove - nothing written (--dry-run)")
        return 0
    if old and old.get("commit_sha") == tip and not upserts and not deletes:
        if mode == "sync":
            say(f"{PROG} sync: {label} - the index is at the tip; nothing to write")
        else:
            say("  total: nothing differs; nothing written")
        write_status(source, last_attempt_utc=utc_now(), last_sync_utc=utc_now(),
                     last_result="current", last_error="")
        return 0
    store.apply(source, old, tip, upserts, deletes)
    write_status(source, last_attempt_utc=utc_now(), last_sync_utc=utc_now(),
                 last_result=f"{n_up} upserted, {n_del} removed at {tip[:12]}", last_error="")
    if mode == "sync":
        say(f"{PROG} sync: {label} - {n_up} upserted, {n_del} removed")
    else:
        say(f"  total: {n_up} upserted, {n_del} removed")
    return 0


def cmd_sync(requested: str | None) -> int:
    if os.environ.get("LANES_INDEX", "") == "off":
        say(f"{PROG} sync: LANES_INDEX=off - nothing indexed")
        return 0
    lock = SyncLock()
    # THE HANDSHAKE, BOTH HALVES (Codex on #164). A sync that finds the lock
    # held leaves its mark and then tries ONCE MORE: if that fails, somebody
    # holds the lock NOW, after the mark was written, and the holder looks for
    # marks after it lets go. The holder, for its part, looks again AFTER it
    # releases - a mark written between its last look and its release is
    # found there, and it takes the lock back for it. No mark is left with
    # nobody due to read it.
    if not lock.acquire(0):
        lock.mark_rerun()
        if not lock.acquire(0):
            say(f"{PROG} sync: another sync holds {lock.path}; it will sync again before "
                f"it is done")
            return 0
    rc = 0
    try:
        rounds = 0
        while True:
            rounds += 1
            lock.take_rerun()
            rc = _guarded(lambda: run_index("sync", requested, False), requested)
            if rc == MOVED and rounds < 5:
                continue
            if rc == MOVED:
                say(f"{PROG} sync: origin/{branch()} kept moving through {rounds} reads; "
                    f"nothing written - the next write's nudge syncs it")
                return 0
            if rc != 0 or rounds >= 5:
                return rc
            if os.path.exists(lock.rerun):
                continue
            lock.release()
            if not os.path.exists(lock.rerun) or not lock.acquire(0):
                return rc
    finally:
        lock.release()


def cmd_reconcile(requested: str | None, dry_run: bool) -> int:
    if os.environ.get("LANES_INDEX", "") == "off" and not dry_run:
        say(f"{PROG} reconcile: LANES_INDEX=off - nothing indexed")
        return 0
    lock = SyncLock()
    if not dry_run and not lock.acquire(60):
        note(f"another sync has held {lock.path} for 60 s; nothing written")
        return 1
    try:
        for _attempt in range(3):
            rc = _guarded(lambda: run_index("reconcile", requested, dry_run), requested)
            if rc != MOVED:
                return rc
        note(f"origin/{branch()} kept moving through three reads; nothing written")
        return 1
    finally:
        lock.release()


#: `_guarded`'s answer for a read the source moved under: not an exit code
#: anybody sees, a signal to the two drivers above to read again.
MOVED = -1


def _guarded(act, requested) -> int:
    try:
        return act()
    except SourceMoved as exc:
        note(str(exc))
        return MOVED
    except CasLost as exc:
        note(str(exc))
        _record_error(requested, str(exc))
        return 1
    except StoreUnusable as exc:
        note(f"{exc.kind}: {exc.detail} - nothing written")
        _record_error(requested, f"{exc.kind}: {exc.detail}")
        return 1


def _record_error(requested, message: str) -> None:
    try:
        source = requested or source_of(workspace_root())
    except StoreUnusable:
        source = requested or "register:?"
    write_status(source, last_attempt_utc=utc_now(), last_error=f"{utc_now()} {message}")


def cmd_status() -> int:
    cfg = load_config()
    store = open_store(cfg, "reader")
    say(f"store: {cfg['store']} {store.where} (configuration: "
        f"{cfg['path'] if cfg['present'] else 'none - the defaults'})")
    rc = 0
    root = ""
    source = ""
    tip = ""
    try:
        root = workspace_root()
        source = source_of(root)
        tip = tip_of(root)
    except StoreUnusable as exc:
        say(f"workspace: {exc.detail}")
        rc = 1
    provs: list = []
    try:
        store.open_read()
        provs = store.all_provenance()
        say(f"schema: {SCHEMA_VERSION}")
    except StoreUnusable as exc:
        say(f"index: {exc.kind} - {exc.detail}")
        rc = 1
    local = read_status()
    sources = [p["source"] for p in provs]
    if source and source not in sources:
        sources.append(source)
    for name in sorted(set(sources) | set(local)):
        prov = next((p for p in provs if p["source"] == name), None)
        say(f"source {name}")
        if prov is None:
            say("  provenance:  none - this source is not indexed (a wiped or never-synced "
                "index; `lanes-index reconcile` builds it)")
        elif prov.get("commit_sha"):
            say(f"  provenance:  register@{prov['commit_sha'][:12]} (indexed "
                f"{prov['indexed_utc']}, schema {prov['schema_version']})")
        else:
            say(f"  provenance:  generation {prov.get('generation')} (indexed "
                f"{prov['indexed_utc']}, schema {prov['schema_version']})")
        if name == source and tip:
            say(f"  tip:         register@{tip[:12]} (origin/{branch()} in {root})")
            if prov is not None and prov.get("commit_sha"):
                lag = commits_between(root, prov["commit_sha"], tip)
                say(f"  lag:         {'unknown (the indexed commit is not in this checkout)' if lag is None else f'{lag} commit(s)'}")
        entry = local.get(name, {})
        say(f"  last sync:   {entry.get('last_sync_utc') or 'never, from this workstation'}"
            f"{' (' + entry['last_result'] + ')' if entry.get('last_result') else ''}")
        say(f"  last error:  {entry.get('last_error') or 'none'}")
    return rc


def cmd_export(out_dir: str, requested: str | None) -> int:
    """The read flags' reader, and nothing else's: the index's image of this
    workstation's register in the shapes `lanes-edit.sh` reads from origin.

    It writes FILES into `out_dir` and prints nothing a caller parses. On
    success `meta`; on any reason the index cannot answer, `why` - one line,
    which `lanes-edit.sh` prints as `read: sources (index <why>)`."""
    if not os.path.isdir(out_dir):
        note(f"--out {out_dir} is not a directory")
        return 64

    def unusable(kind: str, detail: str) -> int:
        with open(os.path.join(out_dir, "why"), "w", encoding="utf-8") as handle:
            handle.write(f"{kind}: {detail}\n")
        return 3

    try:
        cfg = load_config()
    except Refusal as exc:
        unusable("refused", str(exc))
        return 2
    try:
        root = workspace_root()
        source = resolve_source(requested, root)
        store = open_store(cfg, "reader")
        store.open_read()
        prov = store.provenance(source)
        if prov is None or not prov.get("commit_sha"):
            return unusable("wiped", f"no provenance for {source} in the {cfg['store']} store")
        files = {r["record_id"]: r for r in store.rows("source_files", source,
                                                        TABLE_COLUMNS["source_files"])}
        lanes = store.rows("lanes", source, ["row_file", "row_ordinal", "row_text"])
        reg_lines = store.rows("register_lines", source, ["ordinal", "raw"])
        aliases = store.rows("lane_aliases", source, ["ordinal", "raw"])
        log_rows = store.rows("log_lines", source, [c for c in TABLE_COLUMNS["log_lines"]
                                                     if c not in ("payload_fields", "raw")])
    except Refusal as exc:
        unusable("refused", str(exc))
        return 2
    except StoreUnusable as exc:
        return unusable(exc.kind, exc.detail)

    def write(name: str, lines: list[str]) -> None:
        with open(os.path.join(out_dir, name), "w", encoding="utf-8", newline="") as handle:
            for line in lines:
                handle.write(line + "\n")

    register = [(r["row_ordinal"], r["row_text"]) for r in lanes if r["row_file"] == REGISTER_PATH]
    register += [(r["ordinal"], r["raw"]) for r in reg_lines]
    write("register", [text for _o, text in sorted(register, key=lambda x: x[0])])
    if ARCHIVE_PATH in files:
        write("archive", [r["row_text"] for r in sorted(
            (r for r in lanes if r["row_file"] == ARCHIVE_PATH), key=lambda r: r["row_ordinal"])])
    if ALIASES_PATH in files:
        write("aliases", [r["raw"] for r in sorted(aliases, key=lambda r: r["ordinal"])])
    logs = sorted((f for f in files.values() if f["kind"] == "log"), key=lambda f: f["ls_order"])
    write("logs", [f["record_id"] for f in logs])
    by_file: dict = {}
    for row in log_rows:
        by_file.setdefault(row["file"], []).append(row)
    events, warn = [], []
    for f in logs:
        bad = 0
        for row in sorted(by_file.get(f["record_id"], []), key=lambda r: r["ordinal"]):
            if row["unreadable"]:
                bad += 1
                warn.append(f"unreadable: {row['file']}:{row['ordinal']} ({row['unreadable_why']})")
                continue
            events.append(US.join([row["utc"] or "", row["lane"] or "", row["verb"] or "",
                                   row["session"] or "", row["workstation"] or "",
                                   row["object"] or "", row["ref"] or "", row["payload"] or "",
                                   row["free_text"] or "", row["file"] or "",
                                   str(row["ordinal"])]))
        if bad:
            warn.append(f"{bad} unreadable line(s) above — an append-only log is never "
                        f"rewritten, so a line no parser reads is a hold no tool will mention "
                        f"again")
    write("events", events)
    write("warn", warn)
    write("meta", [f"store={cfg['store']}", f"source={source}",
                   f"sha={prov['commit_sha']}", f"indexed_utc={prov['indexed_utc']}"])
    return 0


USAGE = f"""\
{PROG} sync      [--source <s>]              index what LANDED, behind the source
{PROG} reconcile [--source <s>] [--dry-run]  read the source whole; put the index right
{PROG} status                                 per source: store, provenance, lag, errors
{PROG} export    --out <dir> [--source <s>]   the `--index` read flags' reader

The DERIVED INDEX of the lane register (lane-collision-protocol Amendment 14).
It is written behind the sources by this command alone, read only by tooling
that decides nothing, and never a gate: no lane act reads it or waits on it.

  sync        Reads `origin/<branch>` of the workspace repository as the push
              left it - never the working tree - and upserts each record that
              differs, keyed by (source, record id) and versioned by a digest,
              with the source's provenance compared and swapped in the SAME
              transaction. A sync from a commit that does not descend from the
              indexed one writes nothing. `lanes-edit.sh` starts it DETACHED
              after every write that landed; `LANES_INDEX=off` stops that.
  reconcile   Reads the source whole, compares every stored row by its
              CONTENT, upserts what differs and removes what is gone: on a
              wiped index, the rebuild. `--dry-run` prints the counts only.
  status      The store, each source's provenance against its tip, the lag in
              commits, and this workstation's last sync and last error.
  export      Writes the index's image of the register into <dir> for
              `lanes --index` and `lanes-edit.sh history --index`. Not for people.

  --source <s>  `register:<owner/repo>`, which must be this workstation's own;
                the managed ledger's `ledger:<Workstation>` is T058's to write.

THE STORE: SQLite at ${{XDG_STATE_HOME:-~/.local/state}}/openRepoTools/lanes-index.sqlite,
or QA Postgres through `psql` where the configuration names a `url=`.
THE CONFIGURATION: ${{XDG_CONFIG_HOME:-~/.config}}/openRepoTools/lanes-index.conf, or the
file $LANES_INDEX_CONFIG names - mode 0600, outside every git work tree and
outside ~/.agents/, with no password in any URL:

  store=sqlite|postgres     default: postgres where url= is set, else sqlite
  sqlite=<path>             the SQLite file
  url=<libpq URL>           the WRITER role (sync, reconcile)
  passfile=<path>           the 0600 libpq password file for it
  reader_url=<libpq URL>    the SELECT-only READER role (status, export) -
                            required beside url=; a read never uses the writer
  reader_passfile=<path>    its password file, where it is not the same one
  schema=<name>             the Postgres schema (default lanes_index)

Exit: 0 done · 1 a read or write failed, nothing half-written · 2 refused ·
3 export: the index cannot answer (the reason is in <dir>/why) · 64 usage."""


def main(argv: list[str]) -> int:
    if not argv:
        sys.stderr.write(USAGE + "\n")
        return 64
    if argv[0] in ("-h", "--help", "help"):
        say(USAGE)
        return 0
    if argv[0] == "--version":
        say(f"{PROG} {VERSION} (schema {SCHEMA_VERSION})")
        return 0
    verb, args = argv[0], argv[1:]
    source = None
    dry_run = False
    out_dir = None
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ("-h", "--help"):
            say(USAGE)
            return 0
        if arg == "--source" or arg.startswith("--source="):
            value = arg.split("=", 1)[1] if "=" in arg else (args[i + 1] if i + 1 < len(args) else "")
            if not value:
                note("--source needs a value: register:<owner/repo>")
                return 64
            source = value
            i += 1 if "=" in arg else 2
            continue
        if (arg == "--out" or arg.startswith("--out=")) and verb == "export":
            value = arg.split("=", 1)[1] if "=" in arg else (args[i + 1] if i + 1 < len(args) else "")
            if not value:
                note("--out needs a directory")
                return 64
            out_dir = value
            i += 1 if "=" in arg else 2
            continue
        if arg == "--dry-run" and verb == "reconcile":
            dry_run = True
            i += 1
            continue
        note(f"unknown argument '{arg}' for {verb} - see {PROG} --help")
        return 64
    try:
        if verb == "sync":
            return cmd_sync(source)
        if verb == "reconcile":
            return cmd_reconcile(source, dry_run)
        if verb == "status":
            if source:
                note("status takes no --source; it prints every source the store holds")
                return 64
            return cmd_status()
        if verb == "export":
            if not out_dir:
                note("export needs --out <dir>")
                return 64
            return cmd_export(out_dir, source)
    except Refusal as exc:
        note(f"REFUSED: {exc}")
        return 2
    except StoreUnusable as exc:
        note(f"{exc.kind}: {exc.detail}")
        return 1
    note(f"unknown subcommand '{verb}' (sync|reconcile|status|export) - see {PROG} --help")
    return 64


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
