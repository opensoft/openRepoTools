#: Dependency caches and bytecode: they hold no work and are rebuilt, so they
#: are removed WITHOUT archiving (`--include-caches`) and never counted as a
#: tree's ignored work.
CACHE_NAMES = ("__pycache__", ".pytest_cache", ".mypy_cache", ".ruff_cache",
               "node_modules")
VENV_NAMES = ("venv", ".venv")

#: Ignored BUILD OUTPUT: generated, rebuilt, and often gigabytes. A tree's
#: ignored files are archived before it goes - except caches and these.
BUILD_NAMES = ("target", "build", "dist", ".tox", ".nox", ".gradle", ".next",
               ".turbo", ".cache", "coverage", "htmlcov", ".eggs")

#: A branch with one of these names is never pushed "as is" by a sweep: its
#: unpublished commits go to a rescue branch instead. Pushing a lane's stray
#: commits onto a default branch is not a rescue.
PROTECTED_BRANCHES = ("main", "master")

#: The register words a legacy writer may never write (ruling 2026-10-04).
RESERVED = ("managed owner", "managed binding", "mode=managed", "managed:")

GIT_NET_TIMEOUT = 180
GIT_TIMEOUT = 120

