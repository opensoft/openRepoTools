    "retention_days": 90,
    "aging_days": 14,
    "sandbox_min_age_minutes": 60,
    "foreign_quiet_hours": 24,
    "ignored_report_mb": 50,
    "ignored_archive_mb": 200,
}

UUID_RE = re.compile(r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-"
                     r"[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$")
STAMP_RE = re.compile(r"^(\d{8}T\d{6}Z)")
