# ================================================================ utilities

def utc_now() -> str:
    return _dt.datetime.now(_dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def utc_stamp() -> str:
    return _dt.datetime.now(_dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def say(text: str = "") -> None:
    sys.stdout.write(text + "\n")


def pesc(value) -> str:
    """One porcelain field: a backslash, TAB, newline or carriage return in
    it is written `\\`, `\\t`, `\\n`, `\\r`, so a row is always one line of
    exactly its columns - a path with a TAB in it is still one field (B3)."""
    return (str(value).replace("\\", "\\\\").replace("\t", "\\t")
            .replace("\n", "\\n").replace("\r", "\\r"))


def prow(*fields) -> None:
    say("\t".join(pesc(f) for f in fields))


def note(text: str) -> None:
    sys.stderr.write(f"{PROG}: {text}\n")


def run(argv, cwd=None, env=None, timeout=GIT_TIMEOUT, input_text=None):
    """Run `argv`; NEVER raises for a non-zero exit or a missing program.

    A program that could not be started is exit 127 with the reason on
    stderr, and a timeout is 124 - the two shapes every caller here already
    reads as "the read failed", which is never an answer (Amendment 7(d))."""
    try:
        # SURROGATEESCAPE, NOT STRICT UTF-8: a path is bytes, and a worktree
        # named in Latin-1 is a tree to report, never a traceback (B2).
        return subprocess.run(
            [str(a) for a in argv], cwd=cwd, env=env, capture_output=True,
            encoding="utf-8", errors="surrogateescape", timeout=timeout, input=input_text,
            stdin=None if input_text is not None else subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(argv, 124, "", f"timed out after {timeout}s")
    except OSError as exc:
        return subprocess.CompletedProcess(argv, 127, "", str(exc))


def git_env() -> dict:
    env = dict(os.environ)
    env["GIT_TERMINAL_PROMPT"] = "0"
    env.setdefault("GIT_SSH_COMMAND", "ssh -o BatchMode=yes")
    env["LC_ALL"] = "C"
    # A READ TAKES NO OPTIONAL LOCK: `git status` otherwise refreshes the
    # index's stat cache and writes it back, and a dry run writes nothing.
    env["GIT_OPTIONAL_LOCKS"] = "0"
    return env


def git(path: str, *args: str, timeout: int = GIT_TIMEOUT):
    return run(["git", "-C", path, *args], env=git_env(), timeout=timeout)


def git_out(path: str, *args: str):
    """stdout stripped, or None where git failed."""
    proc = git(path, *args)
    if proc.returncode != 0:
        return None
    return proc.stdout.strip()


def real(path: str) -> str:
    try:
        return os.path.realpath(path)
    except OSError:
        return path


def under(path: str, root: str) -> bool:
    """`path` IS `root` or sits beneath it - compared physically."""
    p, r = real(path), real(root)
    return p == r or p.startswith(r.rstrip(os.sep) + os.sep)


def tilde(path: str) -> str:
    home = os.environ.get("HOME", "")
    if home and (path == home or path.startswith(home.rstrip("/") + "/")):
        return "~" + path[len(home.rstrip("/")):]
    return path


def short(sha: str) -> str:
    return sha[:12] if sha and re.match(r"^[0-9a-f]{12,}$", sha) else (sha or "-")


def dir_size(path: str) -> int:
    total = 0
    for base, dirs, files in os.walk(path, followlinks=False):
        for name in files + dirs:
            try:
                total += os.lstat(os.path.join(base, name)).st_size
            except OSError:
                pass
    return total


def human_size(n: int) -> str:
    size = float(n)
    for unit in ("B", "KB", "MB", "GB"):
        if size < 1024 or unit == "GB":
            return f"{size:.0f} {unit}" if unit == "B" else f"{size:.1f} {unit}"
        size /= 1024
    return f"{n} B"


def rmtree(path: str) -> None:
    """`shutil.rmtree` that also clears git's read-only object files. A path
    that is already gone is already removed."""
    if not os.path.lexists(path):
        return

    def clear(func, target, _exc):
        try:
            os.chmod(target, stat.S_IWRITE | stat.S_IREAD | stat.S_IEXEC)
        except OSError:
            pass
        func(target)
    shutil.rmtree(path, onerror=clear)


def sha256_of(path: str) -> str:
    digest = hashlib.sha256()
    with open(path, "rb") as fh:
        for block in iter(lambda: fh.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def safe_ref_part(text: str) -> str:
    """A path component folded into what a ref name takes."""
    folded = re.sub(r"[^A-Za-z0-9._-]+", "-", text).strip(".-") or "tree"
    folded = re.sub(r"\.\.+", ".", folded)
    if folded.endswith(".lock"):
        folded = folded[:-5] + "-lock"
    return folded[:80]


def register_text(text: str) -> str:
    """A register line's free text, fenced the way `lanes-edit.sh`'s writer
    fences a payload: no ` — ` (the line's own separator), no `, `, no
    newline, and none of the managed-owner vocabulary a legacy writer may
    never write (ruling 2026-10-04)."""
    out = text.replace("\r", " ").replace("\n", " ")
    out = out.replace(" — ", " - ").replace(", ", "; ")
    low = out.lower()
    for word in RESERVED:
        if word in low:
            out = re.sub("managed", "manag.ed", out, flags=re.IGNORECASE)
            break
    while out.startswith(("→", "←")):
        out = out[1:].lstrip()
    return out


# ============================================================ configuration

def _home() -> str:
    return os.environ.get("HOME") or os.path.expanduser("~")


def state_dir() -> str:
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(_home(), ".local", "state")
    return os.path.join(base, "openRepoTools")


def sweeps_dir() -> str:
    return os.path.join(state_dir(), "sweeps")


def conf_path() -> str:
    named = os.environ.get("LANE_WORKTREES_CONF", "")
    if named:
        return named
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(_home(), ".config")
    return os.path.join(base, "openRepoTools", "sweep.conf")


def load_conf() -> dict:
    """`sweep.conf`: `key=value` lines, `#` comments. An unknown key or a
    value that is not a whole number is a note and the default stands."""
    conf = dict(DEFAULT_CONF)
    path = conf_path()
    try:
        with open(path, encoding="utf-8", errors="surrogateescape") as fh:
            lines = fh.read().splitlines()
    except OSError:
        return conf
    for raw in lines:
        line = raw.split("#", 1)[0].strip()
        if not line or "=" not in line:
            continue
        key, value = (part.strip() for part in line.split("=", 1))
        if key not in DEFAULT_CONF:
            note(f"{path}: '{key}' is not a sweep.conf key; ignored")
            continue
        if not value.isdigit():
            note(f"{path}: {key}={value} is not a whole number; the default "
                 f"{DEFAULT_CONF[key]} stands")
            continue
        conf[key] = int(value)
    return conf


# =================================================== the helper (lanes-edit)

def lanes_edit_path() -> str:
    """`$LANES_EDIT`, else the `lanes-edit.sh` beside this file, else PATH -
    the order `lanes` and `lanes-index` already find it in."""
    named = os.environ.get("LANES_EDIT", "")
    if named:
        return named
    here = os.path.join(os.path.dirname(os.path.realpath(__file__)), "lanes-edit.sh")
    if os.access(here, os.X_OK):
        return here
    return shutil.which("lanes-edit.sh") or ""


class LaneFacts:
    """What #97's reconciliation says about one lane, read once."""

    def __init__(self, lane: str):
        self.lane = lane
        self.rc = 0
        self.root = ""
        self.state = "NONE"
        self.holder = "unknown"         # live | none | unknown
        self.holder_uuid = ""
        self.holder_detail = ""
        self.binding = "unknown"        # here | free | gone | elsewhere | unknown
        self.binding_at = ""
        self.managed = ""               # "" | owned | unknown
        self.managed_owner = ""
        self.verdict = ""
        self.verdict_why = ""
        self.dir = ""
        self.inventory: list = []
        self.inventory_rc = 0
        self.why = ""


class Helper:
    def __init__(self):
        self.path = lanes_edit_path()
        self._fetched = False

    def call(self, *args: str, env_extra: dict | None = None, fetch: bool = False,
             timeout: int = 300):
        if not self.path:
            return subprocess.CompletedProcess(args, 127, "", "no lanes-edit.sh beside this "
                                               "command or on PATH")
        env = dict(os.environ)
        env["LANES_INDEX"] = "off"
        if not fetch or self._fetched:
            env["LANES_NO_FETCH"] = "1"
        if env_extra:
            env.update(env_extra)
        proc = run([self.path, *args], env=env, timeout=timeout)
        if fetch:
            self._fetched = True
        return proc

    def canon_lane(self, lane: str):
        """(canonical spelling, refusal) - Amendment 15's resolver, as
        `lane-end` reads it: 0 with the row's spelling; 66 the alias table
        unreadable and 2 with 15(d)'s words a published case pair, both
        refusals; any other answer (a helper predating the subcommand) keeps
        the typed spelling."""
        proc = self.call("canon-lane", lane, fetch=True)
        out = proc.stdout.strip()
        if proc.returncode == 0 and out:
            return out, ""
        if proc.returncode == 66:
            return lane, ("the lane alias table could not be read (exit 66), so a renamed "
                          f"lane's old name cannot be resolved: {_first_line(proc.stderr)}")
        if proc.returncode == 2 and "Amendment 15(d)" in (proc.stderr or ""):
            return lane, ("the published register spells this lane two ways (Amendment "
                          f"15(d)): {_first_line(proc.stderr)}")
        return lane, ""

    def lane_facts(self, lane: str) -> LaneFacts:
        facts = LaneFacts(lane)
        proc = self.call("lane-reconcile", lane, fetch=True)
        facts.rc = proc.returncode
        if proc.returncode == 0:
            self._parse_reconcile(facts, proc.stdout)
        elif proc.returncode == 8:
            # NO CONTROL ROOT: no inventory exists, and the holder and the
            # binding are asked for on their own.
            facts.state = "NONE"
            self._holder_binding(facts)
        else:
            facts.why = (f"`lanes-edit.sh lane-reconcile {lane}` exited {proc.returncode}: "
                         + _first_line(proc.stderr))
            return facts
        dproc = self.call("lane-dir", lane)
        if dproc.returncode == 0:
            facts.dir = dproc.stdout.strip()
        elif dproc.returncode != 8:
            facts.why = (f"`lanes-edit.sh lane-dir {lane}` exited {dproc.returncode}: "
                         + _first_line(dproc.stderr))
            return facts
        tproc = self.call("lane-trees", lane)
        facts.inventory_rc = tproc.returncode
        if tproc.returncode == 0:
            for line in tproc.stdout.splitlines():
                fields = line.split(US)
                if len(fields) < 2 or not fields[0]:
                    continue
                keys = ("id", "path", "branch", "head", "upstream", "dirty", "unpushed",
                        "writer", "observed", "checkout", "generation", "operation",
                        "schema")
                rec = dict(zip(keys, fields + [""] * (len(keys) - len(fields))))
                facts.inventory.append(rec)
        elif tproc.returncode not in (8, 1) or (tproc.returncode == 1 and facts.root):
            facts.why = (f"`lanes-edit.sh lane-trees {lane}` exited {tproc.returncode}: "
                         + _first_line(tproc.stderr))
        return facts

    def _parse_reconcile(self, facts: LaneFacts, text: str) -> None:
        for line in text.splitlines():
            parts = line.split(US)
            tag = parts[0]
            if tag == "MANAGED":
                facts.managed = "unknown" if parts[1:2] == ["unknown"] else "owned"
                facts.managed_owner = parts[1] if len(parts) > 1 else ""
            elif tag == "ROOT" and len(parts) > 1:
                facts.root = parts[1]
            elif tag == "STATE" and len(parts) > 1:
                facts.state = parts[1]
            elif tag == "HOLDER" and len(parts) > 1:
                facts.holder = parts[1]
                facts.holder_detail = parts[2] if len(parts) > 2 else ""
                if facts.holder == "live":
                    facts.holder_uuid = facts.holder_detail.split(" ")[0]
            elif tag == "BINDING" and len(parts) > 1:
                facts.binding = parts[1]
                facts.binding_at = parts[2] if len(parts) > 2 else ""
            elif tag == "VERDICT" and len(parts) > 1:
                facts.verdict = parts[1]
                facts.verdict_why = parts[2] if len(parts) > 2 else ""

    def _holder_binding(self, facts: LaneFacts) -> None:
        bproc = self.call("binding", facts.lane)
        if bproc.returncode == 0:
            cols = bproc.stdout.rstrip("\n").split("\t")
            where = cols[6] if len(cols) > 6 else "elsewhere"
            wstate = cols[7] if len(cols) > 7 else "unknown"
            facts.binding_at = f"{cols[0]}/{cols[1]}" if len(cols) > 1 else ""
            if where == "here":
                facts.binding = "here"
            elif wstate == "gone":
                facts.binding = "gone"
            else:
                facts.binding = "elsewhere"
        elif bproc.returncode == 8:
            facts.binding = "free"
        else:
            facts.binding = "unknown"
        hproc = self.call("live-holder", facts.lane)
        if hproc.returncode == 0:
            facts.holder = "live"
            facts.holder_detail = hproc.stdout.strip().replace(US, " ")
            facts.holder_uuid = facts.holder_detail.split(" ")[0]
        elif hproc.returncode == 8:
            facts.holder = "none"
        else:
            facts.holder = "unknown"
            facts.holder_detail = _first_line(hproc.stderr)
        mproc = self.call("managed-projection", facts.lane)
        if mproc.returncode == 0:
            facts.managed, facts.managed_owner = "owned", mproc.stdout.strip()
        elif mproc.returncode not in (8, 2):
            facts.managed = "unknown"

    def workspace_root(self) -> str:
        proc = self.call("workspace-root")
        return proc.stdout.strip() if proc.returncode == 0 else ""

    def fetch_register(self) -> str:
        """`--yes` ACTS ON A REGISTER READ NOW, or not at all (#170 A1): '' once
        the workspace repository's `origin/<branch>` is fetched, else why not.

        `lanes-edit.sh`'s own `log_sync` answers 0 on every way it can fail to
        fetch, and an inherited `LANES_NO_FETCH=1` skips the fetch outright, so a
        lane rebound on another host after this one's last fetch read as bound
        HERE and its trees were removed (Amendment 18(b)). The fetch is made
        directly, with an explicit refspec, and every later helper call reads
        the ref it left (`LANES_NO_FETCH=1`, set by `call` once `_fetched`)."""
        root = self.workspace_root()
        if not root:
            return ("the workspace repository could not be found (`lanes-edit.sh "
                    "workspace-root` answered nothing)")
        branch = os.environ.get("LANES_BRANCH", "") or "main"
        proc = git(root, "fetch", "--quiet", "--no-tags", "origin",
                   f"+refs/heads/{branch}:refs/remotes/origin/{branch}", timeout=GIT_NET_TIMEOUT)
        if proc.returncode != 0:
            return (f"`git -C {root} fetch origin {branch}` failed: " + _first_line(proc.stderr))
        self._fetched = True
        return ""

    def transcript_live(self, uuid: str, fresh: bool = False) -> str:
        """live | none | unknown - one live process carrying that transcript,
        asked once per session however many trees it recorded (`fresh` asks
        again: at the moment of an act the cached answer is minutes old)."""
        cache = self.__dict__.setdefault("_live", {})
        if fresh or uuid not in cache:
            proc = self.call("transcript-holders", uuid)
            cache[uuid] = {0: "live", 8: "none"}.get(proc.returncode, "unknown")
        return cache[uuid]

    def note_line(self, lane: str, text: str):
        return self.call("log", "NOTED", f"lane:{lane}", register_text(text),
                         env_extra={"LANES_LANE": lane}, fetch=False)


def _first_line(text: str) -> str:
    for line in (text or "").splitlines():
        if line.strip():
            return line.strip()
    return "no answer"


# ============================================================ liveness: who

class ProcScan:
    """Every process this account can see, and the paths it stands in or
    holds open: `/proc` where there is one, `lsof` where there is not
    (macOS), and every tmux pane's current path beside either.

    A scan that could not be made is `available = False`, and a tree whose
    liveness rests on it is never acted on - not "nobody is there"."""

    def __init__(self):
        self.entries: list = []      # (pid, comm, kind, path)
        self.available = False
        self.why = ""
        self._env_loaded = False
        self._scan()

    def _scan(self) -> None:
        me = os.getpid()
        if os.path.isdir("/proc/self/fd"):
            self.available = True
            for name in os.listdir("/proc"):
                if not name.isdigit() or int(name) == me:
                    continue
                base = "/proc/" + name
                try:
                    with open(base + "/comm", encoding="utf-8", errors="replace") as fh:
                        comm = fh.read().strip()
                except OSError:
                    continue
                try:
                    self.entries.append((int(name), comm, "cwd", _proc_path(os.readlink(base + "/cwd"))))
                except OSError:
                    pass
                try:
                    fds = os.listdir(base + "/fd")
                except OSError:
                    fds = []
                for fd in fds:
                    try:
                        target = os.readlink(base + "/fd/" + fd)
                    except OSError:
                        continue
                    if target.startswith("/"):
                        self.entries.append((int(name), comm, "fd", _proc_path(target)))
        elif shutil.which("lsof"):
            proc = run(["lsof", "-nP", "-w", "-F", "pcfn", "-u", str(os.getuid())], timeout=120)
            if proc.stdout:
                self.available = True
                pid, comm, fd = 0, "", ""
                for line in proc.stdout.splitlines():
                    if not line:
                        continue
                    tag, value = line[0], line[1:]
                    if tag == "p":
                        pid, comm, fd = int(value or 0), "", ""
                    elif tag == "c":
                        comm = value
                    elif tag == "f":
                        fd = value
                    elif tag == "n" and pid and pid != me and value.startswith("/"):
                        self.entries.append((pid, comm, "cwd" if fd == "cwd" else "fd", value))
            else:
                self.why = "lsof answered nothing: " + _first_line(proc.stderr)
        else:
            self.why = "this host has no /proc and no lsof, so which process stands in a tree cannot be read"
        if shutil.which("tmux"):
            proc = run(["tmux", "list-panes", "-a", "-F",
                        "#{pane_pid}\t#{session_name}:#{window_index}.#{pane_index}\t#{pane_current_path}"],
                       timeout=30)
            if proc.returncode == 0:
                for line in proc.stdout.splitlines():
                    cols = line.split("\t")
                    if len(cols) == 3 and cols[2].startswith("/"):
                        pid = int(cols[0]) if cols[0].isdigit() else 0
                        # PHYSICAL, like every other path here: `/proc` and `lsof`
                        # answer resolved paths, and a pane keeps the spelling
                        # the shell was given (macOS's `/var` is `/private/var`).
                        self.entries.append((pid, "tmux pane " + cols[1], "pane", real(cols[2])))

    def load_environ(self) -> None:
        """The path-shaped values of every readable process's environment
        (HOME, TMPDIR, a suite's sandbox): Linux only, and only for the
        sandbox sweep, which is where a process's ROOT may be nowhere else."""
        if self._env_loaded:
            return
        self._env_loaded = True
        if not os.path.isdir("/proc/self"):
            return
        me = os.getpid()
        for name in os.listdir("/proc"):
            if not name.isdigit() or int(name) == me:
                continue
            try:
                with open(f"/proc/{name}/environ", "rb") as fh:
                    raw = fh.read()
            except OSError:
                continue
            for item in raw.split(b"\0"):
                if b"=/" not in item:
                    continue
                value = item.split(b"=", 1)[1].decode("utf-8", "replace")
                for piece in value.split(":"):
                    if piece.startswith("/"):
                        self.entries.append((int(name), "", "env", piece))

    def holders(self, path: str) -> list:
        root = real(path)
        out = []
        for pid, comm, kind, where in self.entries:
            if where == root or where.startswith(root.rstrip("/") + "/"):
                out.append((pid, comm, kind, where))
        return out


def _proc_path(target: str) -> str:
    return target[:-10] if target.endswith(" (deleted)") else target


def pid_alive(pid: int) -> bool:
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except OSError:
        return False
    return True


# ========================================================== merge evidence

def slug_of(url: str) -> str:
    u = (url or "").strip()
    if u.endswith(".git"):
        u = u[:-4]
    for prefix in ("https://github.com/", "http://github.com/", "ssh://git@github.com/",
                   "git@github.com:", "git://github.com/"):
        if u.startswith(prefix):
            rest = u[len(prefix):].strip("/")
            return rest if SLUG_RE.match(rest) else ""
    return ""


class MergeEvidence:
    """Whether a branch's work is MERGED, decided by the register's LANDED
    line for its pull request or by `gh`'s state for it - and never by
    `git branch --merged` alone, which a squash merge defeats."""

    def __init__(self, helper: Helper):
        self.helper = helper
        self.gh_ok = (os.environ.get("LANES_NO_GITHUB", "") != "1"
                      and bool(shutil.which("gh")))
        self.gh_why = "" if self.gh_ok else ("LANES_NO_GITHUB=1" if os.environ.get(
            "LANES_NO_GITHUB", "") == "1" else "no gh on PATH")
        self._prs: dict = {}
        self._landed = None
        self.register_why = ""

    def landed(self) -> set:
        if self._landed is not None:
            return self._landed
        self._landed = set()
        root = self.helper.workspace_root()
        if not root:
            self.register_why = "the workspace repository could not be found"
            return self._landed
        branch = os.environ.get("LANES_BRANCH", "main")
        proc = git(root, "grep", "-h", "-E", "-e", "^LANDED", f"origin/{branch}", "--",
                   "lanes/LANES.md", "lanes/log")
        if proc.returncode not in (0, 1):
            self.register_why = "the register could not be read: " + _first_line(proc.stderr)
            return self._landed
        for line in proc.stdout.splitlines():
            m = LANDED_OBJ_RE.match(line)
            if m:
                self._landed.add((m.group(1).lower(), int(m.group(2))))
                continue
            m = LANDED_ROW_RE.match(line)
            if m:
                self._landed.add((m.group(2).lower(), int(m.group(1))))
        return self._landed

    def prs(self, slug: str):
        if not slug or not self.gh_ok:
            return None
        if slug in self._prs:
            return self._prs[slug]
        env = dict(os.environ, GH_PROMPT_DISABLED="1", GH_NO_UPDATE_NOTIFIER="1")
        proc = run(["gh", "pr", "list", "--repo", slug, "--state", "all", "--limit", "1000",
                    "--json", "number,state,mergedAt,headRefName,headRefOid,baseRefName,"
                    "isCrossRepository"],
                   env=env, timeout=120)
        rows = None
        if proc.returncode == 0:
            try:
                rows = json.loads(proc.stdout or "[]")
            except ValueError:
                rows = None
        if rows is None:
            self.gh_why = f"gh pr list --repo {slug} failed: " + _first_line(proc.stderr)
        self._prs[slug] = rows
        return rows

    @staticmethod
    def default_branches(repo: str) -> set:
        """The branch a landing goes into: origin's HEAD where this clone
        knows it, else `main` or `master`."""
        head = git_out(repo, "symbolic-ref", "-q", "--short", "refs/remotes/origin/HEAD") or ""
        if head.startswith("origin/") and len(head) > len("origin/"):
            return {head[len("origin/"):]}
        return set(PROTECTED_BRANCHES)

    def judge(self, repo: str, slug: str, branch: str, tip: str) -> dict:
        """{'state': merged|moved|elsewhere|open|closed|none|unknown, 'pr': n,
        'source': ..., 'why': ...} for `branch` at `tip`."""
        rows = self.prs(slug)
        if rows is None:
            return {"state": "unknown", "pr": 0, "source": "",
                    "why": "no pull request could be read for it (" + (self.gh_why or
                                                                       "not a GitHub origin") + ")"}
        mine = [r for r in rows if r.get("headRefName") == branch
                and not r.get("isCrossRepository")]
        if not mine:
            return {"state": "none", "pr": 0, "source": "gh", "why": "no pull request names it"}
        landed = self.landed()
        # AN OPEN PULL REQUEST PROTECTS ITS BRANCH BEFORE ANYTHING ELSE: an
        # older merged PR on the same branch says nothing about the work the
        # open one still carries - unless the register has LANDED that very PR.
        for row in sorted(mine, key=lambda r: -int(r.get("number", 0))):
            if row.get("state") == "OPEN" and (slug.lower(), int(row.get("number", 0))) not in landed:
                return {"state": "open", "pr": int(row["number"]), "source": "gh",
                        "why": f"PR #{row['number']} is open"}
        defaults = self.default_branches(repo)
        elsewhere = None
        for row in sorted(mine, key=lambda r: -int(r.get("number", 0))):
            number = int(row.get("number", 0))
            by_register = (slug.lower(), number) in landed
            by_gh = row.get("state") == "MERGED"
            if by_register or by_gh:
                # A MERGE INTO A RELEASE OR FEATURE BRANCH IS NOT A LANDING: only
                # a PR whose base is the default branch makes its branch merged.
                base = row.get("baseRefName") or ""
                if base not in defaults:
                    elsewhere = elsewhere or {
                        "state": "elsewhere", "pr": number, "source": "gh",
                        "why": f"PR #{number} was merged into {base or 'a base gh did not name'}, "
                               f"not {'/'.join(sorted(defaults))}: not a landing"}
                    continue
                head = row.get("headRefOid") or ""
                contained = bool(tip) and (tip == head or (bool(head) and git(
                    repo, "merge-base", "--is-ancestor", tip, head).returncode == 0))
                source = "register LANDED" if by_register else "gh MERGED"
                if contained:
                    return {"state": "merged", "pr": number, "source": source, "head": head,
                            "why": f"PR #{number} is merged ({source}) and holds this tip"}
                return {"state": "moved", "pr": number, "source": source, "head": head,
                        "why": f"PR #{number} is merged ({source}) but this branch has moved "
                               f"past its head {short(head)}"}
        if elsewhere:
            return elsewhere
        return {"state": "closed", "pr": int(mine[0].get("number", 0)), "source": "gh",
                "why": f"PR #{mine[0].get('number')} was closed unmerged"}


# ============================================================== the estate

def estate_repos(root: str, max_depth: int = 7) -> list:
    """Every repository under `root`: a walk that descends into a repository
    ONLY through nested checkouts and worktree containers, so the walk is the
    estate's shape and not every source directory in it."""
    found = []
    prune = set(CACHE_NAMES) | set(VENV_NAMES) | {".git", ".lane-state", ".tox"}

    def walk(d: str, depth: int, in_repo: bool) -> None:
        try:
            entries = list(os.scandir(d))
        except OSError:
            return
        is_repo = any(e.name == ".git" for e in entries)
        if is_repo:
            found.append(d)
        if depth >= max_depth:
            return
        for e in entries:
            if e.name in prune:
                continue
            try:
                if e.is_symlink() or not e.is_dir(follow_symlinks=False):
                    continue
            except OSError:
                continue
            if is_repo or in_repo:
                if (e.name in ("worktrees", ".worktrees", ".claude")
                        or os.path.lexists(os.path.join(e.path, ".git"))):
                    walk(e.path, depth + 1, True)
            else:
                walk(e.path, depth + 1, False)

    if root and os.path.isdir(root):
        walk(root, 0, False)
    return found


def git_common_dir(repo: str) -> str:
    dotgit = os.path.join(repo, ".git")
    if os.path.isdir(dotgit):
        return dotgit
    try:
        with open(dotgit, encoding="utf-8", errors="surrogateescape") as fh:
            first = fh.readline().strip()
    except OSError:
        return ""
    if not first.startswith("gitdir:"):
        return ""
    gitdir = first[len("gitdir:"):].strip()
    if not os.path.isabs(gitdir):
        gitdir = os.path.normpath(os.path.join(repo, gitdir))
    try:
        with open(os.path.join(gitdir, "commondir"), encoding="utf-8", errors="surrogateescape") as fh:
            common = fh.readline().strip()
        if not os.path.isabs(common):
            common = os.path.normpath(os.path.join(gitdir, common))
        return common
    except OSError:
        return gitdir


def local_remote_urls(common: str) -> list:
    """(name, url) for every remote in that config whose URL is a local path."""
    out = []
    try:
        with open(os.path.join(common, "config"), encoding="utf-8", errors="replace") as fh:
            text = fh.read()
    except OSError:
        return out
    section = ""
    for raw in text.splitlines():
        line = raw.strip()
        m = re.match(r'^\[remote\s+"([^"]+)"\]$', line)
        if m:
            section = m.group(1)
            continue
        if line.startswith("["):
            section = ""
            continue
        if section and re.match(r"^url\s*=", line):
            url = line.split("=", 1)[1].strip()
            if url.startswith(("/", "./", "../", "~", "file://")):
                out.append((section, url))
    return out


def dependents_map(repos: list) -> dict:
    """{physical path a repository LEANS ON: [(dependent, how)]} - read from
    `objects/info/alternates` and from remotes whose URL is a local path. A
    clone something leans on is LOAD-BEARING and is never removed by a sweep."""
    deps: dict = {}
    for repo in repos:
        common = git_common_dir(repo)
        if not common:
            continue
        try:
            with open(os.path.join(common, "objects", "info", "alternates"),
                      encoding="utf-8", errors="surrogateescape") as fh:
                for raw in fh.read().splitlines():
                    alt = raw.strip()
                    if not alt or alt.startswith("#"):
                        continue
                    if not os.path.isabs(alt):
                        alt = os.path.normpath(os.path.join(common, "objects", alt))
                    target = real(alt)
                    deps.setdefault(target, []).append((repo, "alternates " + alt))
        except OSError:
            pass
        for name, url in local_remote_urls(common):
            path = url[len("file://"):] if url.startswith("file://") else url
            path = os.path.expanduser(path)
            if not os.path.isabs(path):
                path = os.path.normpath(os.path.join(repo, path))
            deps.setdefault(real(path), []).append((repo, f"remote {name} -> {url}"))
    return deps


def leaned_on(path: str, common: str, deps: dict) -> list:
    """Who leans on the tree at `path` (and on its object store, for a clone)."""
    out = []
    targets = [real(path)]
    if common and not under(common, path):
        pass
    elif common:
        targets.append(real(common))
    for target, who in deps.items():
        for t in targets:
            if target == t or target.startswith(t.rstrip("/") + "/"):
                for dependent, how in who:
                    if not under(dependent, path):
                        out.append((dependent, how))
    seen, uniq = set(), []
    for item in out:
        if item not in seen:
            seen.add(item)
            uniq.append(item)
    return uniq


# ================================================================ the trees

class Tree:
    def __init__(self, path: str, owner: str, foreign_kind: str = ""):
        self.path = path
        self.real = real(path)
        self.owner = owner                 # inventory | foreign
        self.foreign_kind = foreign_kind   # registered | lane-root | clone | other-lane
        self.other_lane = ""
        self.sidecar: dict = {}
        self.checkout = ""                 # the repository's main worktree
        self.registered = False
        self.locked = False
        self.exists = os.path.isdir(path)
        self.is_git = False
        self.kind = ""                     # worktree | clone | main
        self.common = ""
        self.branch = ""
        self.detached = False
        self.unborn = False
        self.head = ""
        self.status_lines: list = []
        self.upstream = ""
        self.origin_url = ""
        self.remote_branch = ""            # the name it is (or would be) pushed as
        self.remote_tip = ""
        self.on_origin = None              # bool | None (unknown)
        self.ahead = 0
        self.behind = 0
        self.lane_trailer = ""
        self.merge: dict = {}
        self.live = None                   # (True|None, why) | None = not live
        self.lean: list = []
        self.guard = ""
        self.read_error = ""
        self.disposition = ""
        self.reason = ""
        self.retire = False
        self.result = ""
        self.rescue = ""                   # origin ref a rescue went to
        self.bundle = ""
        self.ignored_archive = ""
        self.register = ""
        self.contested = False             # another lane's inventory names it too

    @property
    def slice(self) -> str:
        return safe_ref_part(os.path.basename(self.path.rstrip("/")))

    def label(self) -> str:
        if not self.exists:
            return "(gone)"
        if not self.is_git:
            return "(not a checkout)"
        if self.detached:
            return f"(detached) {short(self.head)}"
        if self.unborn:
            return f"{self.branch} (unborn)"
        return f"{self.branch} {short(self.head)}"


def worktree_registrations(checkout: str) -> list:
    # `-z` WHERE GIT HAS IT (2.36+): a path with a newline in it is one field,
    # not a registration of half its name and a line of noise (B3).
    proc = git(checkout, "worktree", "list", "--porcelain", "-z")
    if proc.returncode == 0:
        fields = proc.stdout.split("\0")
    else:
        proc = git(checkout, "worktree", "list", "--porcelain")
        if proc.returncode != 0:
            return []
        fields = proc.stdout.splitlines()
    out, cur = [], {}
    for line in fields + [""]:
        if not line:
            if cur:
                out.append(cur)
            cur = {}
            continue
        key, _, value = line.partition(" ")
        if key == "worktree":
            cur = {"path": value}
        elif key in ("HEAD", "branch"):
            cur[key.lower()] = value
        elif key in ("detached", "bare", "locked", "prunable"):
            cur[key] = value or True
    return out


def read_tree(tree: Tree) -> None:
    """Everything git says about one tree, NOW. A read that failed is said,
    never converted into a clean-looking value (R22, Amendment 7(d))."""
    if not tree.exists:
        return
    proc = git(tree.path, "rev-parse", "--show-toplevel", "--git-common-dir")
    if proc.returncode != 0:
        return
    lines = proc.stdout.strip().splitlines()
    if not lines or real(lines[0]) != tree.real:
        return            # a plain directory inside some other checkout
    tree.is_git = True
    common = lines[1] if len(lines) > 1 else ""
    if common and not os.path.isabs(common):
        common = os.path.normpath(os.path.join(tree.path, common))
    tree.common = common
    dotgit = os.path.join(tree.path, ".git")
    tree.kind = "worktree" if os.path.isfile(dotgit) else "clone"
    if tree.common:
        main = os.path.dirname(tree.common.rstrip("/")) if os.path.basename(
            tree.common.rstrip("/")) == ".git" else ""
        tree.checkout = main or tree.checkout
        if tree.kind == "clone" and main and real(main) == tree.real:
            tree.kind = "clone"
    branch = git(tree.path, "symbolic-ref", "-q", "--short", "HEAD")
    if branch.returncode == 0:
        tree.branch = branch.stdout.strip()
    elif branch.returncode == 1:
        tree.detached = True
    else:
        tree.read_error = "HEAD could not be read: " + _first_line(branch.stderr)
        return
    head = git(tree.path, "rev-parse", "--verify", "-q", "HEAD")
    if head.returncode == 0:
        tree.head = head.stdout.strip()
    elif tree.branch:
        tree.unborn = True
    else:
        tree.read_error = "HEAD names no commit"
        return
    status = git(tree.path, "status", "--porcelain=v1", "--ignore-submodules=none",
                 "--untracked-files=normal")
    if status.returncode != 0:
        tree.read_error = "git status failed: " + _first_line(status.stderr)
        return
    tree.status_lines = [ln for ln in status.stdout.splitlines() if ln.strip()]
    tree.origin_url = git_out(tree.path, "config", "--get", "remote.origin.url") or ""
    if tree.branch:
        up = git(tree.path, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
        tree.upstream = up.stdout.strip() if up.returncode == 0 else ""
        # THE BRANCH IS PUSHED UNDER ITS OWN NAME, NEVER ITS UPSTREAM'S. A branch
        # made with `worktree add -b <b> origin/main` TRACKS origin/main, and a
        # push "to its upstream" would put a lane's stray commits on main.
        target = tree.branch
        tree.remote_branch = target
        tip = git_out(tree.path, "rev-parse", "-q", "--verify", f"refs/remotes/origin/{target}")
        tree.remote_tip = tip or ""
    if tree.head:
        if tree.remote_tip:
            counts = git_out(tree.path, "rev-list", "--left-right", "--count",
                             f"{tree.remote_tip}...{tree.head}")
            parts = (counts or "").split()
            if len(parts) != 2 or not all(x.isdigit() for x in parts):
                # NEVER ZERO FOR UNKNOWN: "0 ahead" is what lets a tree go
                # without a rescue.
                tree.read_error = (f"its distance from origin/{tree.remote_branch} could not "
                                   "be read (git rev-list failed)")
                return
            tree.behind, tree.ahead = int(parts[0]), int(parts[1])
        contains = git(tree.path, "for-each-ref", "--count=1", "--contains", tree.head,
                       "--format=%(refname)", "refs/remotes/origin/")
        if contains.returncode == 0:
            tree.on_origin = bool(contains.stdout.strip())
        msg = git_out(tree.path, "log", "-1", "--format=%B", "HEAD") or ""
        trailers = re.findall(r"^Lane:\s*(\S+)\s*$", msg, re.MULTILINE)
        tree.lane_trailer = trailers[-1] if trailers else ""


def snapshot_tree(path: str) -> str:
    """The tree object `git add -A` would commit in `path` NOW, written
    through a COPY of its index so the tree's own index is never touched.
    Empty where it could not be made."""
    index = git_out(path, "rev-parse", "--git-path", "index")
    if index is None:
        return ""
    if not os.path.isabs(index):
        index = os.path.join(path, index)
    fd, tmp = tempfile.mkstemp(prefix="lane-worktrees-index.")
    os.close(fd)
    try:
        if os.path.exists(index):
            shutil.copyfile(index, tmp)
        else:
            os.unlink(tmp)
        env = git_env()
        env["GIT_INDEX_FILE"] = tmp
        if run(["git", "-C", path, "add", "-A"], env=env).returncode != 0:
            return ""
        proc = run(["git", "-C", path, "write-tree"], env=env)
        return proc.stdout.strip() if proc.returncode == 0 else ""
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def tree_guards(tree: Tree) -> str:
    """What makes a tree unsafe to remove whatever its git state says: work a
    commit in it cannot carry (a submodule's own dirt or commits, a clone
    nested inside it) and a registration someone locked."""
    if tree.locked:
        return ("its worktree registration is LOCKED - someone pinned it on purpose; "
                f"`git -C {tree.checkout or tree.path} worktree unlock {tree.path}` is theirs to run")
    if tree.kind == "clone":
        # A CLONE TAKES ITS LINKED WORKTREES' REPOSITORY WITH IT: a worktree
        # elsewhere - perhaps a live writer's - keeps its files and loses its
        # git directory.
        wl = git(tree.path, "worktree", "list", "--porcelain")
        if wl.returncode != 0:
            return "its worktree registrations could not be read"
        linked = [line[len("worktree "):] for line in wl.stdout.splitlines()
                  if line.startswith("worktree ")][1:]
        if linked:
            return (f"it is a CLONE whose git directory {len(linked)} linked worktree(s) share "
                    f"(e.g. {linked[0]}); its removal would take their repository with it - "
                    "remove or move them first")
        # A CLONE TAKES ITS BRANCHES AND ITS STASH WITH IT, which a worktree
        # never does: every one of them must be on origin first.
        heads = git(tree.path, "for-each-ref", "--format=%(refname:short) %(objectname)",
                    "refs/heads/")
        if heads.returncode != 0:
            return "its branches could not be read"
        for line in heads.stdout.splitlines():
            name, _, sha = line.partition(" ")
            on = git(tree.path, "for-each-ref", "--count=1", "--contains", sha,
                     "--format=%(refname)", "refs/remotes/origin/")
            if on.returncode != 0 or not on.stdout.strip():
                return (f"it is a CLONE and its branch {name} holds commits origin lacks; "
                        "a clone's removal takes every branch with it")
        stash = git(tree.path, "stash", "list")
        if stash.returncode != 0 or stash.stdout.strip():
            return "it is a CLONE with a stash, which its removal would take with it"
    sub = git(tree.path, "submodule", "status", "--recursive")
    if sub.returncode == 0:
        for line in sub.stdout.splitlines():
            if not line.strip() or line.startswith("-"):
                continue
            parts = line[1:].split()
            if len(parts) < 2:
                continue
            spath = os.path.join(tree.path, parts[1])
            dirt = git_out(spath, "status", "--porcelain")
            if dirt is None or dirt:
                return (f"submodule {parts[1]} holds uncommitted work (a commit in the tree "
                        "cannot carry it) - commit it there first")
            # ITS IGNORED WORK TOO: an `.env` in a submodule is archived by
            # nobody - the tree's own archive lists the superproject's only.
            extra = ignored_paths(spath)
            if extra is None or extra:
                return (f"submodule {parts[1]} holds ignored files no commit carries "
                        + (f"({extra[0]}{' and more' if len(extra) > 1 else ''})" if extra
                           else "(they could not be listed)")
                        + " - move them out first")
            on = git(spath, "for-each-ref", "--count=1", "--contains", "HEAD",
                     "--format=%(refname)", "refs/remotes/")
            if on.returncode != 0 or not on.stdout.strip():
                return (f"submodule {parts[1]} is at a commit no remote of it holds "
                        "- push it there first")
    subs = set()
    if sub.returncode == 0:
        for line in sub.stdout.splitlines():
            parts = line[1:].split()
            if len(parts) >= 2:
                subs.add(os.path.normpath(os.path.join(tree.path, parts[1])))
    prune = set(CACHE_NAMES) | set(VENV_NAMES)
    for base, dirs, files in os.walk(tree.path):
        if base != tree.path and (".git" in dirs or ".git" in files):
            if os.path.normpath(base) not in subs:
                return (f"a repository is nested inside it at {base} - its work is "
                        "no commit of this tree's; move it out first (a lane creates "
                        "worktrees, never clones)")
        dirs[:] = [d for d in dirs if d != ".git" and d not in prune
                   and os.path.normpath(os.path.join(base, d)) not in subs]
    return ""


def ignored_work(tree: Tree):
    """Ignored paths that are NOT caches: a commit cannot carry them, so they
    are archived beside the bundle before the tree goes. None where git could
    not list them - which is never read as "there are none"."""
    return ignored_paths(tree.path)


def ignored_paths(path: str):
    """`ignored_work` for any checkout path - a submodule's included."""
    proc = git(path, "ls-files", "--others", "--ignored", "--exclude-standard",
               "--directory", "-z")
    if proc.returncode != 0:
        return None
    out = []
    for rel in proc.stdout.split("\0"):
        rel = rel.rstrip("/")
        if not rel:
            continue
        parts = rel.split("/")
        if any(p in CACHE_NAMES for p in parts):
            continue
        full = os.path.join(path, rel)
        if os.path.isdir(full) and (os.path.basename(rel) in VENV_NAMES
                                    or os.path.exists(os.path.join(full, "pyvenv.cfg"))):
            continue
        if any(p in BUILD_NAMES or p.endswith(".egg-info") for p in parts):
            continue
        if rel.endswith((".pyc", ".pyo")):
            continue
        out.append(rel)
    return out


# ============================================================ the sweep

class Options:
    def __init__(self, ns):
        self.yes = bool(ns.yes)
        self.porcelain = bool(ns.porcelain)
        self.bundle = bool(ns.bundle)
        self.branches = bool(ns.branches)
        self.links = bool(ns.links)
        self.scratch = bool(ns.include_scratch)
        self.caches = bool(ns.include_caches)
        self.sandboxes = bool(ns.include_sandboxes)
        self.foreign = bool(ns.include_foreign)
        self.word = ns.word or ""
        self.live = list(ns.live or [])
        self.fetch = bool(ns.fetch) or self.yes
        self.estate = ns.estate or ""


class Item:
    """One row of the table that is not a tree: a branch, a scratch
    directory, a cache, a sandbox, a broken link."""

    def __init__(self, kind: str, path: str, disposition: str, reason: str,
                 retire: bool = False, detail: str = ""):
        self.kind = kind
        self.path = path
        self.disposition = disposition
        self.reason = reason
        self.retire = retire
        self.detail = detail
        self.size = 0
        self.result = ""
        self.extra: dict = {}


class Sweep:
    def __init__(self, lane: str, opts: Options):
        self.lane = lane
        self.opts = opts
        self.conf = load_conf()
        self.helper = Helper()
        self.facts = LaneFacts(lane)
        self.trees: list = []
        self.items: list = []
        self.refusal = ""
        self.notes: list = []
        self.caller = (os.environ.get("LANES_SESSION") or
                       os.environ.get("CLAUDE_CODE_SESSION_ID") or "")
        self.procs = None
        self.evidence = MergeEvidence(self.helper)
        self.stamp = utc_stamp()
        self.archive = ""
        self.failed = 0
        self.deps: dict = {}
        self.estate_root = ""
        self.fetched: dict = {}
        self.rescues: list = []
        self.dispositions: list = []
        self.acting = False

    # ------------------------------------------------------------- reading
    def gather(self) -> None:
        if not self.helper.path:
            self.refusal = ("no lanes-edit.sh beside this command or on PATH: which trees "
                            "are this lane's is #97's inventory, and nothing else answers it")
            return
        # UNDER --yes THE REGISTER IS FETCHED FIRST, AND A FETCH THAT FAILED IS A
        # REFUSAL (#170 A1): a binding read from a ref as it stood here is not
        # where the lane is bound now, and from outside its binding a lane is
        # UNKNOWN, never dead (Amendment 18(b)). An inherited LANES_NO_FETCH=1
        # does not skip it.
        if self.opts.yes:
            why = self.helper.fetch_register()
            if why:
                self.refusal = ("--yes acts only on the register as origin holds it NOW, and it "
                                f"could not be fetched: {why}. Where the lane is bound is then "
                                "unknown, never 'here' (Amendment 18(b)); nothing was changed")
                return
        # THE CANONICAL SPELLING BEFORE ANY PATH IS DERIVED FROM IT: scratch,
        # caches, rescue names and the Lane: trailer comparison all use it.
        canon, why = self.helper.canon_lane(self.lane)
        if why:
            self.refusal = f"lane {self.lane}'s name could not be resolved: {why}"
            return
        if canon != self.lane:
            self.notes.append(f"lane {self.lane} -> {canon} (Amendment 15: the register row's "
                              "spelling is canonical)")
            self.lane = canon
            self.facts = LaneFacts(canon)
        self.facts = self.helper.lane_facts(self.lane)
        f = self.facts
        if f.why:
            self.refusal = f"a read failed, which is never an answer (Amendment 7(d)): {f.why}"
            return
        if f.managed == "owned":
            self.refusal = (f"lane {self.lane} is owned by the managed ledger (owner "
                            f"{f.managed_owner or 'unnamed'}): its worktrees are that ledger's "
                            "(ruling 2026-10-04: \"managed ledger owns enrolled lanes; #97 owns legacy\")")
            return
        if f.managed == "unknown":
            self.refusal = (f"whether the managed ledger owns lane {self.lane} is UNKNOWN; "
                            f"read it: lanes-edit.sh managed-projection {self.lane}")
            return
        self.estate_root = (self.opts.estate or os.environ.get("PROJECTS_ROOT", "")
                            or (os.path.dirname(f.dir.rstrip("/")) if f.dir else ""))
        # THE GATE DECIDES BEFORE ANYTHING IS WRITTEN - the fetch included. A
        # refused lane is still READ, so the table says what a sweep from the
        # right place would do; it is never fetched or touched from here.
        self._lane_gate()
        self.procs = ProcScan()
        self._discover()
        # WHO ELSE CLAIMS THESE TREES is read before anything is written: a
        # claim that cannot be read refuses, and a refusal never fetches.
        self._other_lanes()
        self._lane_claims()
        if self.opts.fetch and not self.refusal:
            self._fetch_all()
        self.deps = dependents_map(estate_repos(self.estate_root)) if self.estate_root else {}
        for tree in self.trees:
            read_tree(tree)
        for tree in self.trees:
            self._liveness(tree)
            if tree.is_git and tree.exists:
                tree.lean = leaned_on(tree.path, tree.common if tree.kind == "clone" else "",
                                      self.deps)
                if tree.branch and not tree.unborn and tree.branch not in PROTECTED_BRANCHES:
                    tree.merge = self.evidence.judge(tree.path, slug_of(tree.origin_url),
                                                     tree.branch, tree.head)

    def _lane_claims(self) -> None:
        """A tree #97's inventory does not name is still THIS LANE'S when it
        stands under the lane's own worktree root (`.lane-worktrees/<lane>/`,
        which only this lane's starts make), or sits in the checkout's
        `.claude/worktrees` on a branch whose OWN commits - those its origin's
        default branch lacks - carry this lane's `Lane:` trailer. Another
        lane's claim still wins. Without this a lane whose trees were never
        recorded read as "nothing to retire", and #163's gate passed it (B1).

        AND A LANE WITH NO SNAPSHOT AT ALL (#97's state NONE) BUT TREES OF ITS
        OWN IS REFUSED: which of them are its is recorded nowhere, so the gate
        does not pass it until a handoff records them or a person retires
        them."""
        roots = self._roots()
        lane_root = roots[-1] if roots else ""
        claude_root = roots[0] if self.facts.dir and roots else ""
        for t in self.trees:
            # A CLONE IS NEVER ADOPTED: a lane creates worktrees, never clones,
            # so a standalone clone under its root stays FOREIGN - a finding for
            # a person's word, as #162's first protocol line has it.
            if t.owner != "foreign" or t.foreign_kind in ("other-lane", "clone"):
                continue
            if lane_root and under(t.path, lane_root) and t.real != real(lane_root):
                t.owner = "lane-root"
            elif claude_root and t.exists and under(t.path, claude_root) \
                    and self.lane.lower() in own_trailers(t.path):
                t.owner = "trailer"
        claimed = [t for t in self.trees if t.owner in ("lane-root", "trailer")]
        if self.facts.state == "NONE" and claimed:
            self.refusal = self.refusal or (
                f"lane {self.lane} has no #97 snapshot (state NONE), yet {len(claimed)} tree(s) "
                f"are its by where they stand or what they carry (e.g. {claimed[0].path}); which "
                "are its is recorded nowhere, so the gate does not pass - record them with a "
                "handoff (lane-handoff takes the inventory), or retire them by hand")

    def _roots(self) -> list:
        roots = []
        if self.facts.dir:
            roots.append(os.path.join(self.facts.dir, ".claude", "worktrees"))
            roots.append(os.path.join(os.path.dirname(self.facts.dir.rstrip("/")),
                                      ".lane-worktrees", self.lane))
        elif os.environ.get("PROJECTS_ROOT"):
            roots.append(os.path.join(os.environ["PROJECTS_ROOT"], ".lane-worktrees", self.lane))
        return roots

    def _discover(self) -> None:
        seen: dict = {}
        lane_dir = real(self.facts.dir) if self.facts.dir else ""
        for rec in self.facts.inventory:
            path = rec.get("path") or ""
            if not path or rec.get("schema") not in ("1",):
                # A RECORD THAT CANNOT BE READ IS A TREE WHOSE OWNER IS UNKNOWN:
                # skipping it would let the table say "nothing to retire", and
                # --include-foreign find the same path as nobody's.
                self.refusal = self.refusal or (
                    f"inventory record {rec.get('id') or '?'} is unreadable or of schema "
                    f"{rec.get('schema') or '?'}, so which trees are this lane's is not known "
                    "(Amendment 7(d)); read it: lanes-edit.sh lane-trees " + self.lane)
                continue
            if lane_dir and real(path) == lane_dir:
                continue
            t = Tree(path, "inventory")
            t.sidecar = rec
            t.checkout = rec.get("checkout") if rec.get("checkout") not in ("", "unknown") else ""
            seen[t.real] = t
        checkouts = []
        if self.facts.dir and os.path.isdir(self.facts.dir):
            checkouts.append(self.facts.dir)
        for t in list(seen.values()):
            if t.checkout and os.path.isdir(t.checkout) and t.checkout not in checkouts:
                checkouts.append(t.checkout)
        regs_by_real: dict = {}
        for co in checkouts:
            regs = worktree_registrations(co)
            for i, reg in enumerate(regs):
                if i == 0 or reg.get("bare"):
                    continue          # the main worktree is the checkout itself
                regs_by_real[real(reg["path"])] = (co, reg)
        for rp, (co, reg) in regs_by_real.items():
            t = seen.get(rp)
            if t is None:
                t = Tree(reg["path"], "foreign", "registered")
                seen[t.real] = t
            t.registered = True
            t.checkout = t.checkout or co
            t.locked = bool(reg.get("locked"))
        for root in self._roots():
            try:
                names = sorted(os.listdir(root))
            except OSError:
                continue
            for name in names:
                full = os.path.join(root, name)
                if not os.path.isdir(full) or os.path.islink(full):
                    continue
                if real(full) in seen:
                    continue
                if not os.path.lexists(os.path.join(full, ".git")):
                    continue
                kind = "clone" if os.path.isdir(os.path.join(full, ".git")) else "lane-root"
                seen[real(full)] = Tree(full, "foreign", kind)
        self.trees = sorted(seen.values(), key=lambda t: (t.owner != "inventory", t.path))

    def _other_lanes(self) -> None:
        """A FOREIGN tree another lane's inventory names is THAT lane's."""
        parents = set()
        if self.facts.root:
            parents.add(os.path.dirname(self.facts.root.rstrip("/")))
        if self.facts.dir:
            parents.add(os.path.join(os.path.dirname(self.facts.dir.rstrip("/")), ".lane-state"))
        if os.environ.get("LANES_LANE_STATE_ROOT"):
            parents.add(os.environ["LANES_LANE_STATE_ROOT"])
        claimed: dict = {}

        def unreadable(what: str) -> None:
            # A CLAIM THAT CANNOT BE READ IS NOT "NO CLAIM" (Amendment 7(d)).
            self.refusal = self.refusal or (
                f"{what} could not be read, so whether another lane claims these trees is "
                "unknown; read it, or move it aside if it is debris")

        for parent in sorted(parents):
            try:
                lanes = os.listdir(parent)
            except FileNotFoundError:
                continue
            except OSError:
                unreadable(f"the lane-state directory {parent}")
                continue
            for other in lanes:
                if other == self.lane:
                    continue
                tdir = os.path.join(parent, other, "trees")
                try:
                    files = os.listdir(tdir)
                except (FileNotFoundError, NotADirectoryError):
                    continue          # that lane has no inventory: no claim
                except OSError:
                    unreadable(f"lane {other}'s inventory {tdir}")
                    continue
                for fname in files:
                    if fname.startswith(".") or not fname.endswith(".yaml"):
                        continue
                    path = ""
                    try:
                        with open(os.path.join(tdir, fname), encoding="utf-8", errors="surrogateescape") as fh:
                            for line in fh:
                                if line.startswith("path: "):
                                    path = line[6:].strip()
                                    break
                    except (OSError, UnicodeDecodeError):
                        unreadable(f"lane {other}'s inventory record {fname}")
                        continue
                    if not path:
                        unreadable(f"lane {other}'s inventory record {fname} (it names no path)")
                        continue
                    claimed[real(path)] = other
        for tree in self.trees:
            if tree.real not in claimed:
                continue
            tree.other_lane = claimed[tree.real]
            if tree.owner == "foreign":
                tree.foreign_kind = "other-lane"
            else:
                # BOTH INVENTORIES NAME IT: records are history and a path can
                # be reused, so which lane owns it now is not this sweep's to
                # decide.
                tree.contested = True

    def _branch_checkouts(self) -> list:
        checkouts = []
        if self.facts.dir and os.path.isdir(self.facts.dir):
            checkouts.append(self.facts.dir)
        for t in self.trees:
            if t.owner == "inventory" and t.checkout and os.path.isdir(t.checkout) \
                    and real(t.checkout) not in [real(c) for c in checkouts]:
                checkouts.append(t.checkout)
        return checkouts

    def _fetch_all(self) -> None:
        commons: dict = {}
        probes = [t.path if t.exists else t.checkout for t in self.trees]
        if self.opts.branches:
            probes += self._branch_checkouts()
        for probe in probes:
            if not probe or not os.path.isdir(probe):
                continue
            common = git_out(probe, "rev-parse", "--git-common-dir")
            if common is None:
                continue
            if not os.path.isabs(common):
                common = os.path.normpath(os.path.join(probe, common))
            commons.setdefault(real(common), probe)
        for common, probe in commons.items():
            if not git_out(probe, "config", "--get", "remote.origin.url"):
                self.fetched[common] = "no origin remote"
                continue
            proc = git(probe, "fetch", "--prune", "--quiet", "origin", timeout=GIT_NET_TIMEOUT)
            self.fetched[common] = "ok" if proc.returncode == 0 else (
                "fetch failed: " + _first_line(proc.stderr))

    def _liveness(self, tree: Tree) -> None:
        if not tree.exists:
            return
        for named in self.opts.live:
            if named != "none" and (under(tree.path, named) or under(named, tree.path)):
                tree.live = (True, "the coordinator's writer count names it (--live)")
                return
        try:
            here = os.getcwd()
        except OSError:
            here = ""
        if here and under(here, tree.path):
            tree.live = (True, "this sweep was started from inside it")
            return
        if self.procs is not None and self.procs.available:
            holders = self.procs.holders(tree.path)
            if holders:
                pid, comm, kind, where = holders[0]
                tree.live = (True, f"process {pid} ({comm or '?'}) has its {kind} there")
                return
        elif self.procs is not None:
            tree.live = (None, "liveness could not be read: " + self.procs.why)
            return
        writer = (tree.sidecar or {}).get("writer", "")
        if writer and UUID_RE.match(writer) and writer != self.caller:
            answer = self.helper.transcript_live(writer)
            if answer == "live":
                tree.live = (True, f"the session that recorded it ({writer[:8]}) is live")
                return
            if answer == "unknown":
                tree.live = (None, f"whether session {writer[:8]} is live could not be read")
                return
        if tree.owner != "inventory" and tree.is_git:
            quiet = self.conf["foreign_quiet_hours"] * 3600
            newest = _gitdir_activity(tree.path)
            if newest and time.time() - newest < quiet:
                tree.live = (True, ("FOREIGN" if tree.owner == "foreign" else
                                    "not in the inventory")
                             + f" and active {int((time.time() - newest) // 60)} min ago "
                                   f"(foreign trees quiet for {self.conf['foreign_quiet_hours']} h only)")

    def _lane_gate(self) -> None:
        f = self.facts
        if f.binding == "elsewhere":
            self.refusal = (f"lane {self.lane} is bound on {f.binding_at or 'another place'}, and "
                            "liveness is pronounced only from inside that binding (Amendment "
                            "18(b)): from here it is UNKNOWN, never dead. Sweep it from there, or "
                            "ask it to hand off: lane-start --request-handoff")
            return
        if f.binding == "unknown":
            self.refusal = (f"where lane {self.lane} is bound could not be read, and a read that "
                            "failed is never an answer (Amendment 7(d))")
            return
        if f.holder == "unknown":
            self.refusal = (f"whether a live session holds lane {self.lane} could not be read "
                            f"({f.holder_detail or 'the session records'}); that is not 'none'")
            return
        if f.holder == "live" and f.holder_uuid != self.caller:
            self.refusal = (f"lane {self.lane} is held by live session {f.holder_uuid or '?'} "
                            f"({f.holder_detail}); sweep it from inside that session, or after "
                            "it hands off")
            return
        if self.opts.yes and f.holder == "live" and f.state == "SWAPPING":
            self.refusal = (f"lane {self.lane} is SWAPPING in a live session: a handoff is in "
                            "flight and a sweep does not compete with it")
            return
        if self.opts.yes and f.holder == "live" and not self.opts.live:
            self.refusal = (f"lane {self.lane} is held by THIS session, and only its coordinator "
                            "knows which writers are live (ListAgents; Amendment 17 Addendum 1 "
                            "(i)). State the count: --live <worktree> for each live writer, or "
                            "--live none")
            return
        if f.verdict == "indeterminate":
            self.refusal = (f"#97's reconciliation of lane {self.lane} is INDETERMINATE: "
                            + (f.verdict_why or "a read it rests on failed"))
            return
        if self.opts.yes and self.opts.foreign and not self.opts.word:
            self.refusal = ("--include-foreign acts on trees #97's inventory does not give to "
                            "this lane, and that takes a word: --word \"<the words, verbatim>\"")
            return

    # ---------------------------------------------------------- deciding
    def decide(self) -> None:
        for tree in self.trees:
            self._decide(tree)
            if tree.owner in ("lane-root", "trailer") and tree.disposition != "foreign":
                tree.reason += ("; not in #97's inventory - the lane's by "
                                + ("its root" if tree.owner == "lane-root" else
                                   "its branch's Lane: trailer"))
        if self.opts.branches:
            self._branches()
        if self.opts.scratch:
            self._scratch()
        if self.opts.caches:
            self._caches()
        if self.opts.sandboxes:
            self.items.extend(sandbox_items(self.procs or ProcScan(), self.conf))
        if self.opts.links and self.estate_root:
            self.items.extend(link_items(self.estate_root))

    def _decide(self, t: Tree) -> None:
        mine = t.owner != "foreign" or (self.opts.foreign and t.foreign_kind != "other-lane")

        def put(disp: str, why: str, retire: bool = True) -> None:
            t.disposition, t.reason, t.retire = disp, why, retire

        if t.owner == "foreign" and not mine:
            where = {"registered": "registered in the lane's checkout",
                     "lane-root": "under this lane's worktree root",
                     "clone": "a standalone CLONE under this lane's root (a lane creates "
                              "worktrees, never clones)",
                     "other-lane": f"lane {t.other_lane}'s inventory names it"}.get(t.foreign_kind, "")
            put("foreign", f"not in lane {self.lane}'s inventory (#97); {where}", False)
            if t.lean:
                t.reason += "; LOAD-BEARING: " + _lean_text(t.lean)
            return
        if t.contested:
            put("keep", f"lane {t.other_lane}'s inventory names it too; which lane owns it "
                        "now is a person's to say")
            return
        if not t.exists:
            if t.registered:
                if t.locked:
                    put("keep", "its directory is gone and the registration is LOCKED; "
                                f"git -C {t.checkout} worktree unlock {t.path} first")
                else:
                    put("prune", "the directory is gone and git still registers it")
            else:
                put("gone", "the directory is gone and nothing registers it; the inventory "
                            "record is history", False)
            return
        if t.live is not None:
            if t.live[0]:
                put("live", "a live writer owns it: " + t.live[1])
            else:
                put("keep", t.live[1])
            return
        if not t.is_git:
            put("keep", "the path exists and is no checkout; it is left exactly as it is")
            return
        if t.read_error:
            put("keep", "git could not be read through it: " + t.read_error)
            return
        t.guard = tree_guards(t)
        if t.guard:
            put("keep", t.guard)
            return
        if t.lean:
            put("load-bearing", "LOAD-BEARING: " + _lean_text(t.lean)
                + "; remedy: in each dependent `git repack -a -d` then drop its "
                  "objects/info/alternates, or re-point the local remote - then sweep again")
            return
        if self.opts.fetch:
            state = self.fetched.get(real(t.common), "")
            if state and state not in ("ok", "no origin remote"):
                put("keep", f"origin could not be read ({state}), so what is published is unknown")
                return
        if not t.origin_url:
            if self.opts.bundle:
                put("bundle+remove", "no origin remote: a bundle is its only rescue")
            else:
                put("keep", "no origin remote, so nothing in it can be published; --bundle "
                            "archives it instead")
            return
        dirty = len(t.status_lines)
        if dirty:
            put("wip-rescue+remove", f"{dirty} dirty or untracked path(s): a WIP commit on "
                                     "a rescue branch, pushed, then removed")
            return
        if t.unborn:
            put("remove", "an unborn branch with nothing in it")
            return
        if t.detached:
            if t.on_origin:
                put("remove", "detached at a commit origin holds")
            elif t.on_origin is None:
                put("keep", "detached, and whether origin holds the commit could not be read")
            else:
                put("rescue+remove", "detached with commits of its own: a rescue branch, pushed, "
                                     "then removed")
            return
        m = t.merge or {}
        if m.get("state") == "merged":
            put("remove+delete-branch", m["why"] + "; the local branch is deleted, and the "
                "remote one where it is this lane's and holds nothing the PR did not")
            return
        if t.remote_tip and t.ahead == 0:
            put("remove", "clean, and every commit is on origin/" + t.remote_branch
                + (f" ({m.get('why')})" if m.get("state") in ("open", "closed", "moved",
                                                                "elsewhere") else ""))
            return
        if not t.remote_tip and t.on_origin:
            put("remove", "clean, and its head is on origin")
            return
        if t.branch in PROTECTED_BRANCHES or (t.remote_tip and t.behind > 0):
            why = ("a default branch is never pushed by a sweep" if t.branch in PROTECTED_BRANCHES
                   else f"origin/{t.remote_branch} has {t.behind} commit(s) it lacks (diverged)")
            put("rescue+remove", f"{t.ahead or 'unpublished'} commit(s) not on origin and {why}: "
                                 "a rescue branch, pushed, then removed")
            return
        put("push+remove", (f"{t.ahead} commit(s) not on origin/{t.remote_branch}"
                            if t.remote_tip else f"origin has no {t.remote_branch}")
            + ": pushed as is, then removed")

    def _branches(self) -> None:
        for co in self._branch_checkouts():
            items = branch_items(co, self.lane, self.evidence)
            if self.opts.fetch:
                common = git_out(co, "rev-parse", "--git-common-dir") or ""
                if common and not os.path.isabs(common):
                    common = os.path.normpath(os.path.join(co, common))
                state = self.fetched.get(real(common), "") if common else ""
                if state != "ok":
                    # A DELETE DECIDED ON STALE REFS IS NO DELETE: what origin
                    # holds now was not read.
                    for it in items:
                        if it.disposition in ("delete", "delete+remote"):
                            it.disposition = "keep"
                            it.reason = (f"origin could not be fetched in {co} "
                                         f"({state or 'not fetched'}); " + it.reason)
            self.items.extend(items)

    def _scratch(self) -> None:
        if not self.facts.dir:
            return
        root = os.path.join(os.path.dirname(self.facts.dir.rstrip("/")), ".lane-worktrees",
                            self.lane)
        try:
            names = sorted(os.listdir(root))
        except OSError:
            return
        for name in names:
            full = os.path.join(root, name)
            if not (name.endswith("-scratch") or name in ("briefs", "bin")):
                continue
            if os.path.islink(full) or not os.path.isdir(full):
                continue
            if os.path.lexists(os.path.join(full, ".git")):
                continue          # a checkout is a tree, and the table above has it
            holders = self.procs.holders(full) if self.procs and self.procs.available else []
            lean = leaned_on(full, "", self.deps)
            if lean:
                it = Item("scratch", full, "load-bearing", "LOAD-BEARING: " + _lean_text(lean)
                          + "; it is never removed until they are re-pointed", True)
            elif holders:
                pid, comm, kind, _w = holders[0]
                it = Item("scratch", full, "live", f"process {pid} ({comm}) has its {kind} there",
                          True)
            elif self.procs is not None and not self.procs.available:
                it = Item("scratch", full, "keep", "liveness could not be read: " + self.procs.why,
                          True)
            else:
                it = Item("scratch", full, "archive+remove",
                          "lane scratch: tar and sha256 under the sweeps directory, then removed",
                          True)
            it.size = dir_size(full)
            self.items.append(it)

    def _caches(self) -> None:
        roots = []
        if self.facts.dir:
            roots.append(os.path.join(os.path.dirname(self.facts.dir.rstrip("/")),
                                      ".lane-worktrees", self.lane))
        for t in self.trees:
            if t.owner == "inventory" and t.exists and t.is_git \
                    and not any(under(t.path, r) for r in roots):
                roots.append(t.path)
        # NEVER FROM A TREE THAT IS NOT THIS LANE'S OR NOT PROVABLY FREE: a
        # FOREIGN tree (whoever's it is, live or not), a live one, one whose
        # liveness could not be read, one another lane also claims, one
        # something leans on. A tree kept for its git state (a locked
        # registration, a submodule's work) still gives up its caches: they
        # hold no work, and its liveness is asked below.
        protected = [t.path for t in self.trees if self._cache_protected(t)]
        # A CACHE INSIDE SCRATCH THAT IS BEING ARCHIVED GOES WITH THE SCRATCH
        # (and the archive leaves caches out): two acts on one path is one too many.
        archived = [i.path for i in self.items if i.kind == "scratch"
                    and i.disposition == "archive+remove"]
        trees = sorted((t.path for t in self.trees if t.exists), key=len, reverse=True)
        for root in roots:
            for path, size in find_caches(root):
                if any(under(path, lp) for lp in protected + archived):
                    continue
                owner = self._cache_owner(path, roots, trees)
                # LIVENESS IS THE OWNER'S, not the cache's: a writer stands in
                # the tree, not in its __pycache__.
                if self.procs is None or not self.procs.available or self.procs.holders(owner):
                    continue
                if tracked(path) is not False:
                    continue          # tracked, or its tracking is unknown
                it = Item("cache", path, "remove", "a dependency cache or bytecode: it holds no "
                          "work and is rebuilt", False)
                it.size = size
                it.extra["owner"] = owner
                self.items.append(it)

    @staticmethod
    def _cache_protected(t: Tree) -> bool:
        return (t.disposition in ("foreign", "live", "load-bearing") or t.live is not None
                or t.contested or t.result.startswith(("FAILED", "left")))

    @staticmethod
    def _cache_owner(path: str, roots: list, trees: list) -> str:
        """The tree a cache is in, else the top directory under the lane's
        root it is in, else the root."""
        for t in trees:
            if under(path, t):
                return t
        for r in roots:
            if under(path, r):
                rel = os.path.relpath(path, r).split(os.sep)
                return os.path.join(r, rel[0]) if rel and rel[0] not in ("", ".") else r
        return path

    # ------------------------------------------------------------ output
    def retire_count(self) -> int:
        return (sum(1 for t in self.trees if t.retire)
                + sum(1 for i in self.items if i.retire))

    def render(self) -> None:
        f = self.facts
        mode = "YES - performing the table" if self.opts.yes else \
            "DRY RUN - nothing is changed; --yes performs it"
        say(f"{PROG} sweep {self.lane} - {mode}")
        holder = f.holder
        if f.holder == "live":
            holder = f"live {f.holder_uuid[:8]}" + (" (this session)" if f.holder_uuid == self.caller else "")
        say(f"  lane: state {f.state} · holder {holder} · binding {f.binding}"
            + (f" ({f.binding_at})" if f.binding_at else "") + (f" · verdict {f.verdict}" if f.verdict else ""))
        say(f"  checkout: {f.dir or '(no recorded directory)'} · inventory "
            f"{len(f.inventory)} tree(s) · origin "
            + ("fetched now" if self.opts.fetch else "as of the last fetch"))
        ev = self.evidence
        say("  merged means: the register's LANDED line for the branch's PR, or gh's MERGED"
            + (f" (gh: {ev.gh_why})" if ev.gh_why else "")
            + (f" (register: {ev.register_why})" if ev.register_why else ""))
        if self.refusal:
            say("")
            say(f"REFUSED: {self.refusal}")
        for line in self.notes:
            say(f"  note: {line}")
        say("")
        say("TREES")
        if not self.trees:
            say("  (none: no inventory tree, no registration, nothing under the lane's roots)")
        for t in self.trees:
            res = f" -> {t.result}" if t.result else ""
            say(f"  {t.disposition:<22} {t.path}")
            say(f"  {'':<22}   {t.label()} · {t.reason}{res}")
        kinds = (("branch", "BRANCHES (--branches)"), ("scratch", "SCRATCH (--include-scratch)"),
                 ("cache", "CACHES (--include-caches)"), ("sandbox", "SANDBOXES (--include-sandboxes)"),
                 ("link", "BROKEN LINKS (--links)"))
        for kind, title in kinds:
            rows = [i for i in self.items if i.kind == kind]
            if not rows:
                continue
            say("")
            say(title)
            for i in rows:
                size = f" · {human_size(i.size)}" if i.size else ""
                res = f" -> {i.result}" if i.result else ""
                say(f"  {i.disposition:<22} {i.path}{size}")
                say(f"  {'':<22}   {i.detail + ' · ' if i.detail else ''}{i.reason}{res}")
        say("")
        foreign = sum(1 for t in self.trees if t.disposition == "foreign")
        live = sum(1 for t in self.trees if t.disposition == "live")
        say(f"SUMMARY: {len(self.trees)} tree(s): {self.retire_count()} to retire · "
            f"{live} live · {foreign} foreign"
            + (f" · archive {tilde(self.archive)}" if self.archive else ""))

    def porcelain(self) -> None:
        f = self.facts
        prow("lane", self.lane, f.state or "-", f.holder or "-",
             f.holder_uuid or "-", f.binding or "-", f.verdict or "-")
        if self.refusal:
            prow("refused", self.refusal)
        for t in self.trees:
            prow("tree", t.disposition, "retire" if t.retire else "-", t.path,
                 t.branch or ("(detached)" if t.detached else "-"), t.head or "-",
                 t.reason + (f" -> {t.result}" if t.result else ""))
        for i in self.items:
            prow(i.kind, i.disposition, "retire" if i.retire else "-", i.path,
                 i.detail or "-", str(i.size), i.reason + (f" -> {i.result}" if i.result else ""))
        prow("summary", self.retire_count(), len(self.trees),
             sum(1 for t in self.trees if t.disposition == "live"),
             sum(1 for t in self.trees if t.disposition == "foreign"))

    # -------------------------------------------------------------- acting
    def act(self) -> None:
        self.acting = True
        os.umask(0o077)
        for t in self.trees:
            if t.disposition in ("live", "foreign", "keep", "gone", "load-bearing", ""):
                continue
            try:
                self._act_tree(t)
            except _ActFailed as exc:
                t.result = "FAILED: " + str(exc)
                self.failed += 1
            except OSError as exc:
                t.result = f"FAILED: {exc}"
                self.failed += 1
            self._record(t)
        for i in self.items:
            try:
                self._act_item(i)
            except (_ActFailed, OSError) as exc:
                i.result = "FAILED: " + str(exc)
                self.failed += 1
        self._register_items()
        if self.archive:
            self._write_disposition()

    def _archive_dir(self) -> str:
        """This invocation's archive, created EXCLUSIVELY: two sweeps started
        in one second never share - and overwrite - one ledger."""
        if not self.archive:
            parent = os.path.join(sweeps_dir(), safe_ref_part(self.lane))
            os.makedirs(parent, mode=0o700, exist_ok=True)
            path, n = os.path.join(parent, self.stamp), 1
            while True:
                try:
                    os.mkdir(path, 0o700)
                    break
                except FileExistsError:
                    n += 1
                    path = os.path.join(parent, f"{self.stamp}-{n}")
            self.archive = path
        return self.archive

    def _rescue_name(self, t: Tree) -> str:
        base = f"rescue/{safe_ref_part(self.lane)}/{t.slice}-{self.stamp}"
        name, n = base, 1
        while git(t.path, "rev-parse", "-q", "--verify", f"refs/heads/{name}").returncode == 0:
            n += 1
            name = f"{base}-{n}"
        return name

    def _occupied(self, path: str, writer: str = "") -> str:
        """Why `path` may NOT be touched now, or '' - asked afresh: processes,
        open files and tmux panes, and the session that recorded it. A scan
        that could not be made is a reason, never a pass."""
        fresh = ProcScan()
        if not fresh.available:
            return "liveness could not be read: " + (fresh.why or "no process scan")
        held = fresh.holders(path)
        if held:
            pid, comm, kind, _w = held[0]
            return f"process {pid} ({comm or '?'}) has its {kind} there"
        if writer and UUID_RE.match(writer) and writer != self.caller:
            answer = self.helper.transcript_live(writer, fresh=True)
            if answer != "none":
                return (f"the session that recorded it ({writer[:8]}) is "
                        + ("live" if answer == "live" else "of unknown liveness"))
        return ""

    def _act_tree(self, t: Tree) -> None:
        # LIVENESS IS ASKED AGAIN AT THE MOMENT OF THE ACT, not trusted from the
        # read: a writer may have started in the tree since the table was made.
        writer = (t.sidecar or {}).get("writer", "")
        if t.exists:
            why = self._occupied(t.path, writer)
            if why:
                t.disposition = "live" if not why.startswith("liveness") else "keep"
                t.result = f"left: {why}"
                return
        if t.disposition == "prune" and os.path.lexists(t.path):
            # IT CAME BACK while the sweep ran (a remount, a restore): it is a
            # tree again, and it is classified afresh by the next sweep, never
            # removed on a reading taken while it was gone.
            t.disposition = "keep"
            t.result = "left: the directory reappeared after it was read as gone; sweep again"
            return
        if t.disposition == "prune":
            # THAT ONE REGISTRATION: `git worktree prune` would unregister every
            # missing tree of the repository - another lane's, a FOREIGN one,
            # one on a disk that is not mounted - and say nothing of it.
            proc = git(t.checkout, "worktree", "remove", t.path)
            if proc.returncode != 0:
                raise _ActFailed("git worktree remove " + t.path + ": " + _first_line(proc.stderr)
                                 + " - a repository-wide prune is never run in its place")
            regs = [r["path"] for r in worktree_registrations(t.checkout)]
            if t.path in regs:
                raise _ActFailed("the registration is still there after the prune")
            t.result = "pruned"
            self._note(t, f"swept {t.path}: stale registration pruned in {t.checkout}")
            return
        guard = tree_guards(t) if t.exists else ""
        if guard:
            t.disposition = "keep"
            t.result = "left: " + guard
            return
        # 1. RESCUE OR PUBLISH FIRST - nothing below removes what is not on
        # origin or in a bundle.
        disp = t.disposition
        ref_to_bundle = ""
        wip_tree = ""
        if disp == "wip-rescue+remove":
            # THE WORK IS COMMITTED BESIDE THE TREE, NOT INTO IT: a temporary
            # index takes `git add -A`, and `commit-tree` + `update-ref` make the
            # rescue branch. The tree's own branch, index and files are never
            # moved, so a push that fails leaves it exactly as it was.
            name = self._rescue_name(t)
            wip_tree = snapshot_tree(t.path)
            if not wip_tree:
                raise _ActFailed("the tree's content could not be snapshotted (git add -A into "
                                 "a temporary index failed); left in place")
            subject = f"WIP({self.lane}): {t.slice} swept {self.stamp}; swept, not reviewed"
            body = (f"Rescued by {PROG} sweep from {t.path} (branch "
                    f"{t.branch or 'detached'} at {short(t.head) if t.head else 'no commit'}). "
                    "The tree held uncommitted or untracked work when its lane was swept; "
                    "this commit is that work as it stood, unreviewed.")
            commit = self._commit_tree(t.path, wip_tree, t.head, subject, body)
            self._git_or_fail(t.path, "update-ref", f"refs/heads/{name}", commit, "")
            self._push(t, name, name)
            ref_to_bundle = name
            t.rescue = f"origin/{name}"
        elif disp == "rescue+remove":
            name = self._rescue_name(t)
            self._git_or_fail(t.path, "update-ref", f"refs/heads/{name}", t.head, "")
            self._push(t, name, name)
            ref_to_bundle = name
            t.rescue = f"origin/{name}"
        elif disp == "push+remove":
            self._push(t, t.branch, t.remote_branch or t.branch)
            ref_to_bundle = t.branch if self.opts.bundle else ""
            t.rescue = f"origin/{t.remote_branch or t.branch}"
        elif disp in ("remove", "remove+delete-branch"):
            ref_to_bundle = (t.branch or "HEAD") if self.opts.bundle and t.head else ""
        elif disp == "bundle+remove":
            ref_to_bundle = t.branch or "HEAD"
        # 2. THE BUNDLE - always for a rescue, and for everything under --bundle.
        if ref_to_bundle:
            t.bundle = self._bundle(t, ref_to_bundle)
        # 3. IGNORED WORK no commit could carry.
        extra = ignored_work(t)
        if extra is None:
            raise _ActFailed("its ignored files could not be listed, so whether it holds an "
                             ".env or local configuration no commit carries is unknown; left "
                             "in place" + (f"; its rescue is at {t.rescue}" if t.rescue else ""))
        # TAKEN BEFORE THE ARCHIVE and compared at removal, so a change made
        # while the tar ran leaves the tree too.
        ignored_before = ignored_print(t.path, extra)
        if extra:
            size = sum(dir_size(os.path.join(t.path, r)) if os.path.isdir(os.path.join(t.path, r))
                       else os.lstat(os.path.join(t.path, r)).st_size for r in extra
                       if os.path.lexists(os.path.join(t.path, r)))
            cap = self.conf["ignored_archive_mb"] * 1024 * 1024
            if size > cap:
                raise _ActFailed(f"{human_size(size)} of ignored files no commit can carry "
                                 f"(over ignored_archive_mb={self.conf['ignored_archive_mb']}): "
                                 "move or delete them by hand, or raise the cap; left in place"
                                 + (f"; its rescue is at {t.rescue}" if t.rescue else ""))
            t.ignored_archive = self._tar(t.path, extra,
                                          f"{t.slice}-ignored.tar.gz")
        # 4. NOTHING MOVED, PROVED AGAIN AT THE MOMENT OF REMOVAL: no writer
        # arrived while the pushes, bundles and archives ran; the head is the
        # one classified; and the content is clean - or, for a WIP rescue, is
        # byte for byte the tree the rescue commit carries.
        why = self._occupied(t.path, writer)
        if why:
            raise _ActFailed(f"{why} - it arrived while the rescue was made; left in place"
                             + (f"; its rescue is at {t.rescue}" if t.rescue else ""))
        # THE IGNORED FILES ARE THE ONES ARCHIVED: none changed, appeared or
        # went since the list was taken - neither `git status` nor the WIP
        # snapshot sees an `.env`.
        again_ignored = ignored_work(t)
        if again_ignored is None or ignored_print(t.path, again_ignored) != ignored_before:
            raise _ActFailed("its ignored files changed after they were archived (or could not "
                             "be listed again); left in place"
                             + (f"; its rescue is at {t.rescue}" if t.rescue else ""))
        head_now = git_out(t.path, "rev-parse", "-q", "--verify", "HEAD") or ""
        if head_now != t.head:
            raise _ActFailed(f"HEAD moved from {short(t.head) or 'none'} to "
                             f"{short(head_now) or 'none'} under the sweep; left in place"
                             + (f"; its rescue is at {t.rescue}" if t.rescue else ""))
        if wip_tree:
            if snapshot_tree(t.path) != wip_tree:
                raise _ActFailed("the tree changed after its rescue was taken; left in place; "
                                 f"the rescue is at {t.rescue}")
        else:
            again = git(t.path, "status", "--porcelain=v1", "--ignore-submodules=none",
                        "--untracked-files=normal")
            if again.returncode != 0 or again.stdout.strip():
                raise _ActFailed("the tree changed under the sweep (git status is not clean); "
                                 "left in place"
                                 + (f"; its rescue is at {t.rescue}" if t.rescue else ""))
        checkout = t.checkout or os.path.dirname(t.common.rstrip("/"))
        if t.kind == "worktree":
            co = t.checkout if t.checkout and os.path.isdir(t.checkout) else t.path
            proc = git(co, "worktree", "remove", "--force", t.path)
            if proc.returncode != 0:
                raise _ActFailed("git worktree remove: " + _first_line(proc.stderr))
        else:
            rmtree(t.path)
        if os.path.exists(t.path):
            raise _ActFailed("the directory is still there after the removal")
        t.result = "removed" + ((f"; pushed to {t.rescue}" if disp == "push+remove" else
                                 f"; rescue {t.rescue}") if t.rescue else "")
        # 5. THE BRANCHES OF A MERGED TREE - each deleted only AT THE SHA THAT
        # WAS JUDGED merged, so a branch that moved under the sweep is kept.
        if disp == "remove+delete-branch" and t.branch:
            co = t.checkout if t.checkout and os.path.isdir(t.checkout) else checkout
            done, why = delete_local_branch(co, t.branch, t.head)
            t.result += "; local branch deleted" if done else "; local branch NOT deleted: " + why
            if not done:
                self.failed += 1
            head = (t.merge or {}).get("head", "")
            ours = t.lane_trailer.lower() == self.lane.lower()
            if t.remote_tip and ours and head and (t.remote_tip == head or git(
                    co, "merge-base", "--is-ancestor", t.remote_tip, head).returncode == 0):
                done, why = delete_remote_branch(co, t.remote_branch, t.remote_tip)
                t.result += "; remote branch deleted" if done else "; remote branch NOT deleted: " + why
                if not done:
                    self.failed += 1
            elif t.remote_tip:
                t.result += ("; remote branch kept (" + ("its Lane: trailer is "
                             + (t.lane_trailer or "absent") if not ours else
                             "it holds commits the PR head does not") + ")")
        self._note(t, f"swept {t.path}: {disp} (was {t.label()})"
                   + ((f"; pushed to {t.rescue}" if disp == "push+remove" else
                       f"; rescue {t.rescue}") if t.rescue else "")
                   + (f"; bundle {tilde(t.bundle)}" if t.bundle else "")
                   + (f"; ignored files {tilde(t.ignored_archive)}" if t.ignored_archive else "")
                   + f"; archive {tilde(self._archive_dir())}")

    def _git_or_fail(self, path: str, *args: str) -> str:
        proc = git(path, *args)
        if proc.returncode != 0:
            raise _ActFailed(f"git {' '.join(args)}: " + _first_line(proc.stderr))
        return proc.stdout

    def _commit_tree(self, path: str, tree: str, parent: str, subject: str, body: str) -> str:
        """A commit of `tree` on `parent`, made without touching any branch,
        index or file - unsigned, because a rescue must not wait on a key."""
        args = []
        if not git_out(path, "config", "--get", "user.email"):
            args += ["-c", "user.email=lane-worktrees@localhost", "-c", "user.name=lane-worktrees"]
        msg = f"{subject}\n\n{body}\n\nLane: {self.lane}\n"
        argv = ["git", "-C", path, *args, "commit-tree", "--no-gpg-sign", tree]
        if parent:
            argv += ["-p", parent]
        proc = run(argv + ["-F", "-"], env=git_env(), input_text=msg)
        if proc.returncode != 0 or not proc.stdout.strip():
            raise _ActFailed("git commit-tree: " + _first_line(proc.stderr + proc.stdout))
        return proc.stdout.strip()

    def _push(self, t: Tree, local: str, remote: str) -> None:
        proc = git(t.path, "push", "--no-verify", "--quiet", "origin",
                   f"refs/heads/{local}:refs/heads/{remote}", timeout=GIT_NET_TIMEOUT)
        if proc.returncode != 0:
            raise _ActFailed(f"git push origin {local}:{remote}: " + _first_line(proc.stderr))
        local_sha = git_out(t.path, "rev-parse", f"refs/heads/{local}") or ""
        seen = git(t.path, "ls-remote", "origin", f"refs/heads/{remote}", timeout=GIT_NET_TIMEOUT)
        got = seen.stdout.split()[0] if seen.returncode == 0 and seen.stdout.split() else ""
        if not local_sha or got != local_sha:
            raise _ActFailed(f"origin does not show refs/heads/{remote} at {short(local_sha)} "
                             f"after the push (it shows {short(got) or 'nothing'}); the tree is left")
        # ONLY A RESCUE BRANCH PINS ITS ARCHIVE (`--expire`): a branch pushed as
        # is is the lane's own, and its later merge and deletion is no loss.
        if remote.startswith("rescue/"):
            self.rescues.append((t.origin_url, remote, local_sha, t.checkout or "", t.path))

    def _bundle(self, t: Tree, ref: str) -> str:
        """A bundle of `ref` holding what origin's default branch lacks (its
        prerequisites are on origin), or the whole history where that would be
        empty or origin has no default branch here."""
        out = os.path.join(self._archive_dir(), f"{t.slice}.bundle")
        n = 1
        while os.path.exists(out):
            n += 1
            out = os.path.join(self._archive_dir(), f"{t.slice}-{n}.bundle")
        base = git_out(t.path, "symbolic-ref", "-q", "refs/remotes/origin/HEAD") or ""
        if not base and git(t.path, "rev-parse", "-q", "--verify",
                            "refs/remotes/origin/main").returncode == 0:
            base = "refs/remotes/origin/main"
        proc = git(t.path, "bundle", "create", out, ref, "--not", base) if base else None
        if proc is None or proc.returncode != 0:
            if os.path.exists(out):
                os.unlink(out)
            proc = git(t.path, "bundle", "create", out, ref)
        if proc.returncode != 0:
            raise _ActFailed("git bundle create: " + _first_line(proc.stderr))
        check = git(t.path, "bundle", "verify", out)
        if check.returncode != 0:
            raise _ActFailed("git bundle verify: " + _first_line(check.stderr))
        return out

    def _tar(self, base: str, rels: list, name: str) -> str:
        out = os.path.join(self._archive_dir(), name)
        n = 1
        while os.path.exists(out):
            n += 1
            out = os.path.join(self._archive_dir(), name.replace(".tar.gz", f"-{n}.tar.gz"))
        try:
            with tarfile.open(out, "w:gz") as tf:
                for rel in rels:
                    tf.add(os.path.join(base, rel), arcname=rel, recursive=True,
                           filter=_no_caches)
            with tarfile.open(out, "r:gz") as tf:
                if not tf.getmembers():
                    raise _ActFailed(f"the archive {out} came back empty")
        except (OSError, tarfile.TarError) as exc:
            raise _ActFailed(f"the archive {out} could not be written: {exc}")
        return out

    def _act_item(self, i: Item) -> None:
        if i.kind == "scratch" and i.disposition == "archive+remove":
            why = self._occupied(i.path)
            if why:
                i.disposition = "live" if not why.startswith("liveness") else "keep"
                i.result = "left: " + why
                return
            before = content_print(i.path)
            parent, name = os.path.dirname(i.path), os.path.basename(i.path)
            i.extra["archive"] = self._tar(parent, [name], f"scratch-{safe_ref_part(name)}.tar.gz")
            # WHAT IS REMOVED IS WHAT WAS ARCHIVED: no writer arrived while the
            # tar ran, and nothing outside the caches changed.
            why = self._occupied(i.path)
            if why:
                raise _ActFailed(f"{why} - it arrived while the archive was made; left in place; "
                                 f"the archive is {tilde(i.extra['archive'])}")
            if content_print(i.path) != before:
                raise _ActFailed("it changed while it was archived; left in place; the archive "
                                 f"{tilde(i.extra['archive'])} is of what it was")
            rmtree(i.path)
            i.result = "archived and removed"
        elif i.kind == "cache" and i.disposition == "remove":
            # (14) THE OWNING TREE IS ASKED AGAIN: a writer may have started
            # there while the rescues ran, or the tree's own act left it live.
            owner = i.extra.get("owner") or i.path
            left = [t for t in self.trees if under(i.path, t.path) and self._cache_protected(t)]
            why = ("its tree was left: " + (left[0].result or left[0].reason)) if left \
                else self._occupied(owner)
            if why:
                i.disposition = "keep"
                i.result = "left: " + why
                return
            rmtree(i.path)
            i.result = "removed"
        elif i.kind == "sandbox" and i.disposition == "remove":
            # ITS OWNER IS ASKED AGAIN: a pytest `.lock` may name a live pid
            # now - a run that works outside the directory holds nothing in it.
            if i.extra.get("kind") == "pytest":
                owner = _lock_pid(os.path.join(i.path, ".lock"))
                if owner and pid_alive(owner):
                    i.disposition, i.result = "live", f"left: its .lock names live pid {owner}"
                    return
            fresh = ProcScan()
            fresh.load_environ()
            if not fresh.available or fresh.holders(i.path):
                i.disposition, i.result = "live", "left: a process arrived in it"
                return
            rmtree(i.path)
            i.result = "removed"
        elif i.kind == "branch" and i.disposition in ("delete", "delete+remote"):
            done, why = delete_local_branch(i.extra["checkout"], i.extra["branch"],
                                            i.extra.get("tip", ""))
            if not done:
                raise _ActFailed("the local branch was not deleted: " + why)
            i.result = "local branch deleted"
            if i.disposition == "delete+remote":
                done, why = delete_remote_branch(i.extra["checkout"], i.extra["branch"],
                                                 i.extra.get("remote_tip", ""))
                i.extra["remote_deleted"] = done
                if done:
                    i.result += "; remote branch deleted"
                else:
                    i.result += "; remote branch NOT deleted: " + why
                    self.failed += 1

    def _register_items(self) -> None:
        done = [i for i in self.items if i.result and not i.result.startswith(("FAILED", "left"))]
        scratch = [i for i in done if i.kind == "scratch"]
        branches = [i for i in done if i.kind == "branch"]
        cleaned = [i for i in done if i.kind in ("cache", "sandbox")]
        if scratch:
            self._note(None, "swept scratch: " + "; ".join(
                f"{os.path.basename(i.path)} archived to {tilde(i.extra.get('archive', ''))}"
                for i in scratch))
        if branches:
            self._note(None, "swept branches merged by PR: " + "; ".join(
                f"{i.extra['branch']} (PR #{i.extra.get('pr')}"
                f"{' + remote' if i.extra.get('remote_deleted') else ''})"
                for i in branches))
        if cleaned:
            total = sum(i.size for i in cleaned)
            self._note(None, f"swept {len(cleaned)} cache or sandbox director(ies) "
                             f"({human_size(total)}): they hold no work and are rebuilt")

    def _note(self, t, text: str) -> None:
        if self.opts.foreign and self.opts.word and t is not None and t.owner == "foreign":
            text += f"; foreign on the word '{self.opts.word}'"
        proc = self.helper.note_line(self.lane, text)
        line = "NOTED " + utc_now() if proc.returncode == 0 else \
            f"NOT WRITTEN (lanes-edit.sh log exited {proc.returncode}: {_first_line(proc.stderr)})"
        if t is not None:
            t.register = line
        if proc.returncode != 0:
            self.failed += 1
            note(f"the register line for {t.path if t else 'this sweep'} was NOT written "
                 f"(exit {proc.returncode}); write it by hand: LANES_LANE={self.lane} "
                 f"lanes-edit.sh log NOTED lane:{self.lane} \"{register_text(text)}\"")
        self.dispositions.append((t.path if t else "-", text, line))

    def _record(self, t: Tree) -> None:
        if not self.archive and (t.rescue or t.bundle or t.result):
            self._archive_dir()
        if self.archive:
            self._write_disposition()

    def _write_disposition(self) -> None:
        d = self._archive_dir()
        lines = [f"# Sweep of lane {self.lane} - {self.stamp}", "",
                 f"Run by `{PROG} sweep {self.lane} --yes` on "
                 f"{os.environ.get('LANES_WORKSTATION') or socket.gethostname()} as "
                 f"{getpass.getuser()}. Nothing here was deleted that was not first on origin "
                 "or in this directory.", ""]
        if self.opts.word:
            lines += [f"Foreign trees were included on the word: \"{self.opts.word}\"", ""]
        lines += ["| tree | was | disposition | why | result | rescue | bundle | register |",
                  "|---|---|---|---|---|---|---|---|"]

        def cell(text: str) -> str:
            return (text or "-").replace("|", "\\|")

        for t in self.trees:
            if not t.result:
                continue
            lines.append("| " + " | ".join(cell(x) for x in (
                t.path, t.label(), t.disposition, t.reason, t.result, t.rescue,
                os.path.basename(t.bundle) if t.bundle else "", t.register)) + " |")
        rows = [i for i in self.items if i.result]
        if rows:
            lines += ["", "| item | kind | disposition | result | size |", "|---|---|---|---|---|"]
            for i in rows:
                lines.append("| " + " | ".join(cell(x) for x in (
                    i.path, i.kind, i.disposition, i.result, human_size(i.size))) + " |")
        lines += ["", "## Register lines", ""]
        for path, text, line in self.dispositions:
            lines.append(f"- `{path}`: {line} - {text}")
        lines.append("")
        with open(os.path.join(d, "DISPOSITION.md"), "w", encoding="utf-8", errors="surrogateescape") as fh:
            fh.write("\n".join(lines))
        with open(os.path.join(d, "rescues.tsv"), "w", encoding="utf-8", errors="surrogateescape") as fh:
            fh.write("# origin\tbranch\tsha\tcheckout\ttree\n")
            for row in self.rescues:
                fh.write("\t".join(row) + "\n")
        write_manifest(d)


class _ActFailed(Exception):
    pass


def delete_local_branch(checkout: str, branch: str, expect: str):
    """(done, why): `refs/heads/<branch>` deleted only while it is still at
    `expect` and no worktree has it checked out - `update-ref -d` with the
    old value, so a branch that moved under the sweep is never lost."""
    if not expect:
        return False, "the SHA it was judged at is not known"
    for reg in worktree_registrations(checkout):
        if reg.get("branch") == f"refs/heads/{branch}":
            return False, f"it is checked out in {reg.get('path')} now"
    proc = git(checkout, "update-ref", "-d", f"refs/heads/{branch}", expect)
    if proc.returncode != 0:
        return False, (f"it is no longer at {short(expect)} (" + _first_line(proc.stderr) + ")")
    return True, ""


def delete_remote_branch(checkout: str, branch: str, expect: str):
    """(done, why): origin's branch deleted only while origin still has it at
    `expect` - a lease, so commits pushed there since are never discarded."""
    if not expect:
        return False, "the SHA it was judged at is not known"
    proc = git(checkout, "push", "--no-verify", "--porcelain",
               f"--force-with-lease=refs/heads/{branch}:{expect}", "origin",
               f":refs/heads/{branch}", timeout=GIT_NET_TIMEOUT)
    if proc.returncode != 0:
        return False, _first_line(proc.stderr or proc.stdout)
    return True, ""


def _lean_text(lean: list) -> str:
    return "; ".join(f"{dep} leans on it ({how})" for dep, how in lean[:5]) + (
        f"; and {len(lean) - 5} more" if len(lean) > 5 else "")


def own_trailers(path: str) -> set:
    """The `Lane:` trailers of the commits HEAD has that origin's default
    branch lacks, lower-cased - empty where there is no such base to tell the
    branch's own commits by."""
    base = git_out(path, "symbolic-ref", "-q", "refs/remotes/origin/HEAD") or ""
    if not base and git(path, "rev-parse", "-q", "--verify",
                        "refs/remotes/origin/main").returncode == 0:
        base = "refs/remotes/origin/main"
    if not base:
        return set()
    text = git_out(path, "log", "--format=%B", f"{base}..HEAD") or ""
    return {v.lower() for v in re.findall(r"^Lane:\s*(\S+)\s*$", text, re.MULTILINE)}


def _gitdir_activity(path: str) -> float:
    gitdir = git_out(path, "rev-parse", "--absolute-git-dir")
    newest = 0.0
    if not gitdir:
        return newest
    for name in ("index", "HEAD", os.path.join("logs", "HEAD")):
        try:
            newest = max(newest, os.stat(os.path.join(gitdir, name)).st_mtime)
        except OSError:
            pass
    return newest


def ignored_print(base: str, rels: list) -> list:
    """The ignored paths `rels` under `base`, every file in them with its size
    and mtime: what the ignored archive carries, compared again at removal."""
    out = []
    for rel in sorted(rels):
        full = os.path.join(base, rel)
        if os.path.isdir(full) and not os.path.islink(full):
            out += [(rel, *row) for row in content_print(full)]
        else:
            try:
                st = os.lstat(full)
                out.append((rel, "", st.st_size, st.st_mtime_ns))
            except OSError:
                out.append((rel, "", -1, -1))
    return out


def content_print(root: str) -> list:
    """Every non-cache file under `root` with its size and mtime - what an
    archive of it carries, so a change made while it was archived shows."""
    out = []
    for base, dirs, files in os.walk(root):
        dirs[:] = sorted(d for d in dirs if d not in CACHE_NAMES and d not in VENV_NAMES)
        for name in sorted(files):
            if name.endswith((".pyc", ".pyo")):
                continue
            full = os.path.join(base, name)
            try:
                st = os.lstat(full)
            except OSError:
                out.append((os.path.relpath(full, root), -1, -1))
                continue
            out.append((os.path.relpath(full, root), st.st_size, st.st_mtime_ns))
    return out


def _no_caches(info):
    """A tar member filter: caches and bytecode hold no work, so an archive
    never carries them."""
    parts = info.name.split("/")
    if any(p in CACHE_NAMES or p in VENV_NAMES for p in parts):
        return None
    if info.name.endswith((".pyc", ".pyo")):
        return None
    return info


def write_manifest(d: str) -> None:
    rows = []
    for base, _dirs, files in os.walk(d):
        for name in files:
            full = os.path.join(base, name)
            rel = os.path.relpath(full, d)
            if rel == "MANIFEST.sha256":
                continue
            rows.append(f"{sha256_of(full)}  {rel}")
    with open(os.path.join(d, "MANIFEST.sha256"), "w", encoding="utf-8", errors="surrogateescape") as fh:
        fh.write("\n".join(sorted(rows, key=lambda r: r.split("  ", 1)[1])) + "\n")


def tracked(path: str):
    """True when git tracks something under `path`, False when it tracks
    nothing there or `path` is in no repository, None when a repository's
    index could not be read - which is never "untracked"."""
    parent = os.path.dirname(path.rstrip("/"))
    inside = git(parent, "rev-parse", "--is-inside-work-tree")
    if inside.returncode != 0 or inside.stdout.strip() != "true":
        return False
    proc = git(parent, "ls-files", "-z", "--", os.path.basename(path.rstrip("/")))
    if proc.returncode != 0:
        return None
    return bool(proc.stdout.strip("\0"))


def find_caches(root: str) -> list:
    out = []
    for base, dirs, _files in os.walk(root, followlinks=False):
        keep = []
        for d in dirs:
            full = os.path.join(base, d)
            if d == ".git" or os.path.islink(full):
                continue
            is_venv = os.path.isfile(os.path.join(full, "pyvenv.cfg")) or (
                d in VENV_NAMES and (os.path.exists(os.path.join(full, "bin", "activate"))
                                     or os.path.exists(os.path.join(full, "Scripts", "activate"))))
            if d in CACHE_NAMES or is_venv:
                out.append((full, dir_size(full)))
            else:
                keep.append(d)
        dirs[:] = keep
    return out


def branch_items(checkout: str, lane: str, evidence: MergeEvidence) -> list:
    """`--branches`: local branches NO worktree has checked out. Merged by
    PR evidence: deleted (and the remote where it is this lane's and holds
    nothing the PR did not). Unmerged with a missing, diverged or behind
    upstream: LISTED with tip, distance and age, never deleted. A branch an
    open PR names is never touched; rescue branches are never touched."""
    out = []
    regs = worktree_registrations(checkout)
    held = {r.get("branch", "")[len("refs/heads/"):] for r in regs if r.get("branch")}
    fmt = "%(refname:short)\t%(objectname)\t%(upstream:short)\t%(committerdate:iso-strict)"
    proc = git(checkout, "for-each-ref", f"--format={fmt}", "refs/heads/")
    if proc.returncode != 0:
        return [Item("branch", checkout, "keep", "the branches could not be read: "
                     + _first_line(proc.stderr), True)]
    origin = git_out(checkout, "config", "--get", "remote.origin.url") or ""
    slug = slug_of(origin)
    default = (git_out(checkout, "symbolic-ref", "-q", "--short", "refs/remotes/origin/HEAD")
               or "origin/main")
    for line in proc.stdout.splitlines():
        cols = line.split("\t")
        if len(cols) < 4:
            continue
        name, tip, upstream, date = cols
        if name in held or name in PROTECTED_BRANCHES or name.startswith("rescue/"):
            continue
        msg = git_out(checkout, "log", "-1", "--format=%B", tip) or ""
        trailers = re.findall(r"^Lane:\s*(\S+)\s*$", msg, re.MULTILINE)
        owner = trailers[-1] if trailers else ""
        ours = owner.lower() == lane.lower()
        counts = git_out(checkout, "rev-list", "--left-right", "--count", f"{default}...{tip}") or ""
        behind_main, ahead_main = (counts.split() + ["?", "?"])[:2]
        age = _age_days(date)
        detail = (f"{short(tip)} · {ahead_main} ahead/{behind_main} behind {default} · last "
                  f"commit {date[:10]} ({age} d) · owner {owner or 'unknown'}")
        judged = evidence.judge(checkout, slug, name, tip) if slug else {
            "state": "unknown", "why": "not a GitHub origin"}
        it = None
        if judged["state"] == "open":
            it = Item("branch", name, "keep", judged["why"] + ": an open PR's branch is never touched",
                      False, detail)
        elif judged["state"] == "merged":
            remote_tip = git_out(checkout, "rev-parse", "-q", "--verify",
                                 f"refs/remotes/origin/{name}") or ""
            head = judged.get("head", "")
            remote_ok = bool(remote_tip) and ours and (remote_tip == head or git(
                checkout, "merge-base", "--is-ancestor", remote_tip, head).returncode == 0)
            it = Item("branch", name, "delete+remote" if remote_ok else "delete",
                      judged["why"] + ("; the remote branch too (this lane's, nothing beyond the PR)"
                                       if remote_ok else ""), ours, detail)
            it.extra.update(pr=judged.get("pr"), tip=tip, remote_tip=remote_tip if remote_ok else "")
        else:
            up_state = "missing"
            if upstream:
                up_tip = git_out(checkout, "rev-parse", "-q", "--verify", f"refs/remotes/{upstream}") \
                    if not upstream.startswith("refs/") else None
                if up_tip:
                    c = (git_out(checkout, "rev-list", "--left-right", "--count",
                                 f"{up_tip}...{tip}") or "").split()
                    if len(c) == 2 and all(x.isdigit() for x in c):
                        b, a = int(c[0]), int(c[1])
                        up_state = ("diverged" if a and b else "ahead" if a else
                                    "behind" if b else "published")
                    else:
                        # NEVER "0 0" FOR UNKNOWN: that would read as published
                        # and drop the branch from the list.
                        up_state = "unreadable (git rev-list failed)"
                else:
                    up_state = "missing"
            if up_state in ("published", "behind"):
                continue
            it = Item("branch", name, "list", f"unmerged ({judged.get('why', '')}); upstream "
                      f"{upstream or 'none'} is {up_state}: a person disposes of it (push it to "
                      f"rescue/{safe_ref_part(lane)}/..., or a word) - never deleted", ours, detail)
        it.extra.update(checkout=checkout, branch=name)
        out.append(it)
    return out


def _age_days(iso: str) -> int:
    try:
        when = _dt.datetime.fromisoformat(iso.replace("Z", "+00:00"))
        return max(0, (_dt.datetime.now(_dt.timezone.utc) - when).days)
    except ValueError:
        return 0


def sandbox_roots() -> list:
    named = os.environ.get("LANE_WORKTREES_SANDBOX_ROOTS", "")
    if named:
        return [p for p in named.split(os.pathsep) if p]
    roots = []
    for cand in ("/tmp", os.environ.get("TMPDIR", ""), tempfile.gettempdir()):
        if cand and os.path.isdir(cand) and real(cand) not in [real(r) for r in roots]:
            roots.append(cand)
    return roots


def sandbox_items(procs: ProcScan, conf: dict) -> list:
    """Killed-suite sandboxes: `tmp.*` and `pytest-of-$USER/pytest-*` whose
    owning process is gone, and `tests/run.sh`'s own run roots. They hold no
    work; one a live process stands in, holds open or names in its
    environment is never touched, and neither is one younger than the
    minimum age (`sandbox_min_age_minutes`)."""
    out = []
    unreadable: list = []
    uid = os.getuid()
    procs.load_environ()
    min_age = conf["sandbox_min_age_minutes"] * 60
    user = getpass.getuser()
    candidates = []
    for root in sandbox_roots():
        try:
            names = os.listdir(root)
        except OSError:
            continue
        for name in names:
            full = os.path.join(root, name)
            if name.startswith("tmp.") and os.path.isdir(full) and not os.path.islink(full):
                candidates.append((full, "mktemp", 0))
            if name == f"pytest-of-{user}" and os.path.isdir(full):
                try:
                    subs = os.listdir(full)
                except OSError as exc:
                    # UNREADABLE IS A ROW, never a traceback and never "empty".
                    it = Item("sandbox", full, "keep", "its pytest sandboxes could not be listed ("
                              + (exc.strerror or str(exc)) + "), so none of them is touched",
                              False)
                    unreadable.append(it)
                    continue
                for sub in subs:
                    sp = os.path.join(full, sub)
                    if sub.startswith("pytest-") and os.path.isdir(sp) and not os.path.islink(sp):
                        candidates.append((sp, "pytest", _lock_pid(os.path.join(sp, ".lock"))))
    runs = os.path.join(state_dir(), "tmp")
    try:
        for name in os.listdir(runs):
            full = os.path.join(runs, name)
            if os.path.isdir(full) and not os.path.islink(full):
                m = re.search(r"-(\d+)$", name)
                candidates.append((full, "run.sh", int(m.group(1)) if m else 0))
    except OSError:
        pass
    now = time.time()
    for path, kind, pid in candidates:
        try:
            st = os.lstat(path)
        except OSError:
            continue
        if st.st_uid != uid:
            continue
        if pid and pid_alive(pid):
            continue
        if procs.available and procs.holders(path):
            continue
        if not procs.available:
            continue
        if kind == "mktemp" and now - st.st_mtime < min_age:
            continue
        it = Item("sandbox", path, "remove", f"a {kind} sandbox whose owning process is gone"
                  + (f" (pid {pid})" if pid else ""), False)
        it.size = dir_size(path)
        it.extra["kind"] = kind
        out.append(it)
    return out + unreadable


def _lock_pid(path: str) -> int:
    try:
        with open(path, encoding="utf-8", errors="surrogateescape") as fh:
            text = fh.read().strip()
        return int(text) if text.isdigit() else 0
    except (OSError, ValueError):
        return 0


def link_items(root: str) -> list:
    """`--links`: every symlink under the estate and every worktree `.git`
    gitdir pointer, checked to resolve; the broken ones, with target and age.

    A `scandir` walk: an entry's kind comes from the directory read itself, so
    only a symlink or a `.git` FILE costs a call of its own - the estate is tens
    of thousands of directories, and `os.walk`'s `lstat` of each was minutes."""
    out = []
    prune = set(CACHE_NAMES) | set(VENV_NAMES) | {".git", ".tox", ".nox"}
    now = time.time()
    stack = [root]
    while stack:
        d = stack.pop()
        try:
            entries = list(os.scandir(d))
        except OSError:
            continue
        for e in entries:
            try:
                if e.is_symlink():
                    if not os.path.exists(e.path):
                        try:
                            target = os.readlink(e.path)
                            age = int((now - os.lstat(e.path).st_mtime) // 86400)
                        except OSError:
                            target, age = "?", 0
                        out.append(Item("link", e.path, "broken", f"symlink to {target} that "
                                        f"does not resolve ({age} d old)", False))
                    continue
                if e.name == ".git":
                    if e.is_file(follow_symlinks=False):
                        _gitdir_pointer(e.path, d, now, out)
                    continue
                if e.name in prune:
                    continue
                if e.is_dir(follow_symlinks=False):
                    stack.append(e.path)
            except OSError:
                continue
    return sorted(out, key=lambda i: i.path)


def _gitdir_pointer(path: str, base: str, now: float, out: list) -> None:
    try:
        with open(path, encoding="utf-8", errors="surrogateescape") as fh:
            first = fh.readline().strip()
    except OSError:
        return
    if not first.startswith("gitdir:"):
        return
    target = first[7:].strip()
    resolved = target if os.path.isabs(target) else os.path.join(base, target)
    if not os.path.isdir(resolved):
        try:
            age = int((now - os.lstat(path).st_mtime) // 86400)
        except OSError:
            age = 0
        out.append(Item("link", path, "broken", f"gitdir pointer to {target} that does "
                        f"not resolve ({age} d old)", False))


# ================================================================== expire

def expiry_rows(conf: dict) -> list:
    """(archive, age in days, keep|expire, why) for every archive under the
    sweeps directory - `sweep --expire`'s table, and the report's. An archive
    past retention is `expire` only while it is whole (`archive_ledger`) and
    every rescue branch it records is on origin at the rescued SHA; one whose
    rescue left or moved is the only copy and is kept."""
    root = sweeps_dir()
    keep_days = conf["retention_days"]
    now = _dt.datetime.now(_dt.timezone.utc)
    rows = []
    try:
        lanes = sorted(os.listdir(root))
    except OSError:
        lanes = []
    for lane in lanes:
        ldir = os.path.join(root, lane)
        if not os.path.isdir(ldir):
            continue
        for stamp in sorted(os.listdir(ldir)):
            adir = os.path.join(ldir, stamp)
            if not os.path.isdir(adir):
                continue
            m = STAMP_RE.match(stamp)
            if m:
                when = _dt.datetime.strptime(m.group(1), "%Y%m%dT%H%M%SZ").replace(
                    tzinfo=_dt.timezone.utc)
            else:
                when = _dt.datetime.fromtimestamp(os.stat(adir).st_mtime, _dt.timezone.utc)
            age = (now - when).days
            if age < keep_days:
                rows.append((adir, age, "keep", f"{age} d old; retention {keep_days} d"))
                continue
            ledger, why = archive_ledger(adir)
            if ledger is None:
                rows.append((adir, age, "keep", why + " - its rescues cannot be checked, so it "
                             "is kept"))
                continue
            missing = []
            for origin, branch, sha in ledger:
                proc = run(["git", "ls-remote", origin, f"refs/heads/{branch}"], env=git_env(),
                           timeout=GIT_NET_TIMEOUT)
                got = proc.stdout.split()[0] if proc.returncode == 0 and proc.stdout.split() else ""
                if proc.returncode != 0:
                    missing.append(f"{branch} (origin could not be read)")
                elif not got:
                    missing.append(f"{branch} (gone from origin)")
                elif got != sha:
                    # THE RESCUED COMMIT, NOT THE NAME: a branch reset or remade
                    # at another commit no longer holds the work.
                    missing.append(f"{branch} (on origin at {short(got)}, not the rescued "
                                   f"{short(sha)})")
            if missing:
                rows.append((adir, age, "keep", "a rescue branch is not on origin: "
                             + "; ".join(missing) + " - this archive is the only copy"))
            else:
                rows.append((adir, age, "expire", f"{age} d old and every rescue branch is on origin"))
    return rows


def expire(opts) -> int:
    conf = load_conf()
    root = sweeps_dir()
    keep_days = conf["retention_days"]
    rows = expiry_rows(conf)
    failed = 0
    for i, (adir, age, disp, why) in enumerate(rows):
        if disp == "expire" and opts.yes:
            try:
                rmtree(adir)
                rows[i] = (adir, age, "expired", why)
                os.makedirs(root, exist_ok=True)
                with open(os.path.join(root, "EXPIRED.log"), "a", encoding="utf-8", errors="surrogateescape") as fh:
                    fh.write(f"{utc_now()}\t{adir}\t{why}\n")
            except OSError as exc:
                rows[i] = (adir, age, "FAILED", str(exc))
                failed += 1
    if opts.porcelain:
        for adir, age, disp, why in rows:
            prow("archive", disp, adir, age, why)
    else:
        say(f"{PROG} sweep --expire - " + ("YES" if opts.yes else "DRY RUN") +
            f" - retention {keep_days} d ({conf_path()})")
        if not rows:
            say("  (no archives under " + tilde(root) + ")")
        for adir, age, disp, why in rows:
            say(f"  {disp:<8} {tilde(adir)} · {why}")
    if failed:
        return 1
    if not opts.yes and any(r[2] == "expire" for r in rows):
        return 3
    return 0


SHA_RE = re.compile(r"^[0-9a-f]{40}([0-9a-f]{24})?$")


def archive_ledger(adir: str):
    """(rescues, why): the archive's rescue ledger, or None with why it cannot
    be trusted. An archive is trusted only when it is WHOLE: `MANIFEST.sha256`
    is there and every file in the archive is in it at its digest (an
    interrupted sweep leaves a bundle the ledger never recorded), and
    `rescues.tsv` is there and every row of it is origin, branch and a full
    SHA. A header-only ledger in a whole archive is a verified "no rescues"."""
    manifest = os.path.join(adir, "MANIFEST.sha256")
    listed: dict = {}
    try:
        with open(manifest, encoding="utf-8", errors="surrogateescape") as fh:
            for line in fh:
                if not line.strip():
                    continue
                digest, sep, rel = line.rstrip("\n").partition("  ")
                if not sep or not re.match(r"^[0-9a-f]{64}$", digest):
                    return None, "its MANIFEST.sha256 is malformed"
                listed[rel] = digest
    except OSError:
        return None, "it has no readable MANIFEST.sha256 (the sweep that made it did not finish)"
    for rel in listed:
        if not os.path.isfile(os.path.join(adir, rel)):
            return None, f"{rel} is in its MANIFEST.sha256 and no longer in it"
    for base, _dirs, files in os.walk(adir):
        for name in files:
            full = os.path.join(base, name)
            rel = os.path.relpath(full, adir)
            if rel == "MANIFEST.sha256":
                continue
            if rel not in listed:
                return None, f"{rel} is in it and not in its MANIFEST.sha256"
            try:
                with open(full, "rb") as fh:
                    if hashlib.sha256(fh.read()).hexdigest() != listed[rel]:
                        return None, f"{rel} does not match its MANIFEST.sha256"
            except OSError:
                return None, f"{rel} could not be read"
    if "rescues.tsv" not in listed:
        return None, "it has no rescues.tsv"
    out = []
    try:
        with open(os.path.join(adir, "rescues.tsv"), encoding="utf-8", errors="surrogateescape") as fh:
            for line in fh:
                if line.startswith("#") or not line.strip():
                    continue
                cols = line.rstrip("\n").split("\t")
                if len(cols) < 3 or not cols[0] or not cols[1] or not SHA_RE.match(cols[2]):
                    return None, "its rescues.tsv has a row that is not origin, branch, sha"
                out.append((cols[0], cols[1], cols[2]))
    except OSError:
        return None, "its rescues.tsv could not be read"
    return out, ""


# ================================================================== report

EVIDENCE_NAME_RE = re.compile(
    r"(^canary-|^deployment-evidence$|-evidence$|^evidence$|-report\.md$|REPORT[^/]*\.md$|"
    r"^junit[^/]*\.xml$|^MANIFEST)", re.IGNORECASE)
HANDOFF_PATHS = ("handoffs/", "lanes/")
#: `rescue/<lane>/<slice>-<UTC>` names its lane; a rescue branch of another
#: convention (`rescue/<slug>`) names none.
LANE_SHAPED_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*-[0-9]+$")


def estate_root_default() -> str:
    for cand in (os.environ.get("PROJECTS_ROOT", ""), os.path.join(_home(), "projects"),
                 os.path.join(_home(), "Projects")):
        if cand and os.path.isdir(cand):
            return cand
    return ""


def _under_container(path: str, root: str) -> str:
    """The worktree container a path sits in - `.lane-worktrees/<lane>`,
    `.claude/worktrees`, `worktrees`, `<x>-worktrees` - or ''."""
    rel = os.path.relpath(path, root)
    parts = rel.split(os.sep)
    for i, p in enumerate(parts[:-1]):
        if p == ".lane-worktrees" and i + 1 < len(parts) - 1:
            return os.sep.join(parts[:i + 2])
        if p in ("worktrees", ".worktrees") or p.endswith("-worktrees"):
            return os.sep.join(parts[:i + 1])
    return ""


def _du(paths: list) -> dict:
    """{path: bytes} through `du -sk`, which walks in C: an estate's ignored
    trees are millions of files, and a Python walk of them is minutes."""
    out: dict = {}
    for i in range(0, len(paths), 64):
        chunk = paths[i:i + 64]
        proc = run(["du", "-sk", "--", *chunk], timeout=600)
        for line in proc.stdout.splitlines():
            size, _, path = line.partition("\t")
            if size.isdigit():
                out[path] = int(size) * 1024
    return out


def _lane_parents(root: str, repos: list) -> list:
    """Every directory a lane's control root and worktree root can sit in.
    #97 puts `.lane-state/<lane>` - and lane-start `.lane-worktrees/<lane>` -
    beside the lane's recorded `dir`, so a lane whose checkout is nested
    (`<estate>/InkRouter/IRRS`) keeps them in `<estate>/InkRouter`, not at
    the estate's top."""
    out = [root] if root else []
    for r in repos:
        parent = os.path.dirname(r.rstrip(os.sep))
        if parent and parent not in out:
            out.append(parent)
    return out


def _lane_state_dirs(parents: list) -> list:
    dirs = []
    cands = [os.environ.get("LANES_LANE_STATE_ROOT", "")]
    cands += [os.path.join(p, ".lane-state") for p in parents]
    for cand in cands:
        if cand and os.path.isdir(cand) and cand not in dirs:
            dirs.append(cand)
    return dirs


def _lane_tree_roots(parents: list) -> list:
    """`<parent>/.lane-worktrees`, each that exists."""
    out = []
    for p in parents:
        cand = os.path.join(p, ".lane-worktrees")
        if os.path.isdir(cand) and cand not in out:
            out.append(cand)
    return out


class Report:
    """`sweep --all --dry-run --report`: the estate's leftovers as one
    document. It reads every lane's #97 inventory, the workspace register and
    the disk; it changes nothing."""

    def __init__(self, opts):
        self.opts = opts
        self.conf = load_conf()
        self.root = opts.estate or estate_root_default()
        self.helper = Helper()
        self.sections: list = []
        self.counts: dict = {}
        self.now = time.time()
        self.unreadable: dict = {}

    def add(self, title: str, rows: list, empty: str, note_text: str = "") -> None:
        self.sections.append((title, rows, empty, note_text))
        self.counts[title] = len(rows)

    # ------------------------------------------------------------- reading
    def build(self) -> None:
        repos = estate_repos(self.root) if self.root else []
        self.deps = dependents_map(repos)
        clones = [r for r in repos if os.path.isdir(os.path.join(r, ".git"))]
        canonical = self._canonical(clones)
        self.canonical = canonical
        parents = _lane_parents(self.root, canonical)
        self.state_dirs = _lane_state_dirs(parents)
        self.tree_roots = _lane_tree_roots(parents)
        self._foreign(clones, canonical)
        closed = self._closed_lanes()
        self._orphans(closed)
        self._branches(canonical)
        self._root_main(canonical)
        self._aging(canonical)
        self._caches_and_sandboxes()
        self._ignored_and_evidence(repos, canonical)
        self._archives()
        self._workspace_hygiene()
        self._status_all()
        self.add("Records the report could not read", [[p, w] for p, w in
                                                      sorted(self.unreadable.items())], "none",
                 "UNKNOWN IS NEVER ABSENT: a lane snapshot, inventory or tree the report "
                 "could not read is one whose findings above may be missing.")

    # A READ THAT FAILED IS A FINDING, never an empty answer (Amendment 7(d)):
    # an inventory the report could not read would otherwise make it clean.
    def _ls(self, d: str) -> list:
        try:
            return sorted(os.listdir(d))
        except (FileNotFoundError, NotADirectoryError):
            return []
        except OSError as exc:
            self.unreadable.setdefault(d, f"could not be listed ({exc.strerror or exc})")
            return []

    def _record(self, path: str, need_path: bool = False) -> dict:
        try:
            with open(path, encoding="utf-8") as fh:
                text = fh.read()
        except FileNotFoundError:
            return {}
        except (OSError, UnicodeDecodeError) as exc:
            self.unreadable.setdefault(path, "could not be read ("
                                       + (getattr(exc, "strerror", "") or str(exc)) + ")")
            return {}
        out = {}
        for line in text.splitlines():
            key, sep, value = line.partition(": ")
            if sep:
                out[key.strip()] = value.strip()
        if need_path and not out.get("path"):
            self.unreadable.setdefault(path, "an inventory record that names no path")
        return out

    def _tree_records(self, tdir: str) -> list:
        return [self._record(os.path.join(tdir, f), need_path=True) for f in self._ls(tdir)
                if f.endswith(".yaml") and not f.startswith(".")]

    def _canonical(self, clones: list) -> list:
        """The estate's own checkouts: a clone outside every worktree
        container. Of several clones of one origin, the one whose folder is
        named for the repository is the checkout and the rest are duplicates."""
        by_origin: dict = {}
        for c in clones:
            if _under_container(c, self.root):
                continue
            url = git_out(c, "config", "--get", "remote.origin.url") or ""
            key = (slug_of(url) or url).lower().rstrip("/")
            by_origin.setdefault(key, []).append(c)
        self.duplicates: dict = {}
        out = []
        for key, group in by_origin.items():
            if not key or len(group) == 1:
                out.extend(group)
                continue
            name = key.rsplit("/", 1)[-1].replace(".git", "")
            named = [g for g in group if os.path.basename(g).lower() == name]
            # ONE CHECKOUT PER ORIGIN, CHOSEN DETERMINISTICALLY: the one named
            # for the repository, the shallowest of several so named, and the
            # shallowest of all where none is. The rest are duplicates - never
            # all of them canonical, which would hide the finding.
            pool = named or group
            keep = sorted(pool, key=lambda g: (g.count(os.sep), g))[0]
            out.append(keep)
            for g in group:
                if g != keep:
                    self.duplicates[g] = (keep, len(named) != 1)
        return sorted(out)

    def _foreign(self, clones: list, canonical: list) -> None:
        rows = []
        for c in clones:
            container = _under_container(c, self.root)
            why = ""
            if container:
                why = f"a CLONE inside {container}, where a lane makes worktrees"
            elif c in self.duplicates:
                first, ambiguous = self.duplicates[c]
                why = f"a second clone of {first}'s origin" + (
                    " (no single clone is named for the repository; the shallowest is "
                    "taken as its checkout)" if ambiguous else "")
            if not why:
                continue
            last = git_out(c, "log", "-1", "--format=%cs") or "?"
            msg = git_out(c, "log", "-1", "--format=%B") or ""
            owner = (re.findall(r"^Lane:\s*(\S+)", msg, re.MULTILINE) or ["-"])[-1]
            lean = leaned_on(c, git_common_dir(c), self.deps)
            rows.append([c, why, human_size(dir_size(c)), last, owner,
                         ("LOAD-BEARING: " + _lean_text(lean)) if lean else ""])
        self.add("FOREIGN repositories", rows, "none: every clone is the estate's own checkout",
                 "A lane creates worktrees, never clones. Each is a person's to dispose of.")

    def _closed_lanes(self) -> dict:
        """{lane: why} for every lane whose snapshot is CLOSED or whose log's
        last lane-kind line is ENDED or RETIRED."""
        closed: dict = {}
        for d in self.state_dirs:
            for lane in self._ls(d):
                if self._record(os.path.join(d, lane, "lane-state.yaml")).get("state") == "CLOSED":
                    closed[lane] = "its snapshot is CLOSED"
        wroot = self.helper.workspace_root() if self.helper.path else ""
        if wroot:
            branch = os.environ.get("LANES_BRANCH", "main")
            proc = git(wroot, "grep", "-E", "-e",
                       "^(STARTED|RESUMED|PAUSED|ENDED|RETIRED) — lane ",
                       f"origin/{branch}", "--", "lanes/log")
            last: dict = {}
            for line in proc.stdout.splitlines():
                _ref, _, rest = line.partition(":")
                fname, _, text = rest.partition(":")
                last[os.path.basename(fname)[:-3]] = text.split(" ", 1)[0]
            for lane, verb in last.items():
                if verb in ("ENDED", "RETIRED"):
                    closed.setdefault(lane, f"its log ends {verb}")
        return closed

    def _orphans(self, closed: dict) -> None:
        rows = []
        seen = set()
        for d in self.state_dirs:
            for lane in sorted(closed):
                for rec in self._tree_records(os.path.join(d, lane, "trees")):
                    path = rec.get("path", "")
                    if path and os.path.isdir(path) and real(path) not in seen:
                        seen.add(real(path))
                        rows.append([path, lane, closed[lane], "lane-worktrees sweep " + lane])
        for lane, lroot in [(ln, r) for ln in sorted(closed) for r in self.tree_roots]:
            ldir = os.path.join(lroot, lane)
            for n in self._ls(ldir):
                full = os.path.join(ldir, n)
                if os.path.isdir(full) and real(full) not in seen:
                    seen.add(real(full))
                    rows.append([full, lane, closed[lane], f"lane-worktrees sweep {lane} "
                                 "--include-scratch --include-foreign --word \"<yours>\""])
        self.add("Orphaned worktrees of ENDED lanes", rows, "none")

    def _branches(self, canonical: list) -> None:
        rows = []
        fmt = ("%(refname:short)%1f%(objectname:short=12)%1f%(upstream:short)%1f"
               "%(upstream:track)%1f%(committerdate:iso-strict)%1f%(contents:trailers)%00")
        for c in canonical:
            proc = git(c, "for-each-ref", f"--format={fmt}", "refs/heads/")
            if proc.returncode != 0:
                continue
            held = {r.get("branch", "")[len("refs/heads/"):]
                    for r in worktree_registrations(c) if r.get("branch")}
            for rec in proc.stdout.split("\0"):
                cols = rec.strip("\n").split("\x1f")
                if len(cols) < 6:
                    continue
                name, tip, up, track, date, trailers = cols[:6]
                if name in PROTECTED_BRANCHES or name.startswith("rescue/"):
                    continue
                if not up:
                    state = "no upstream"
                elif "gone" in track:
                    state = f"upstream {up} gone"
                elif "ahead" in track and "behind" in track:
                    state = f"diverged from {up} {track}"
                elif "ahead" in track:
                    state = f"unpushed {track}"
                else:
                    continue
                owner = (re.findall(r"^Lane:\s*(\S+)", trailers, re.MULTILINE) or ["-"])[-1]
                rows.append([f"{c} {name}", tip, state, f"{_age_days(date)} d",
                             owner, "held by a worktree" if name in held else ""])
        rows.sort(key=lambda r: -int(r[3].split()[0]))
        self.add("Unmerged branches with a missing, diverged or unpushed upstream", rows,
                 "none", "Listed, never deleted: a person pushes each to rescue/<lane>/... "
                 "or gives a word.")

    def _root_main(self, canonical: list) -> None:
        rows = []
        for c in canonical:
            if git(c, "rev-parse", "-q", "--verify", "refs/heads/main").returncode != 0 or \
                    git(c, "rev-parse", "-q", "--verify", "refs/remotes/origin/main").returncode != 0:
                continue
            n = git_out(c, "rev-list", "--count", "refs/remotes/origin/main..refs/heads/main") or "0"
            if not n.isdigit() or int(n) == 0:
                continue
            paths = (git_out(c, "diff", "--name-only", "refs/remotes/origin/main...refs/heads/main")
                     or "").splitlines()
            only = bool(paths) and all(p.startswith(HANDOFF_PATHS) for p in paths)
            rows.append([c, f"local main ahead of origin by {n}",
                         "only handoff/register paths" if only else f"{len(paths)} path(s)",
                         "Amendment 4: handoffs and the register live in the workspace "
                         "repository and are pushed per write" if only else
                         "push it through a pull request, or a person's word"])
        self.add("Root main divergence", rows, "none")

    def _aging(self, canonical: list) -> None:
        aging = self.conf["aging_days"]
        rows = []
        rescue_count = 0
        seen = set()
        for c in canonical:
            proc = git(c, "for-each-ref", "--format=%(refname)\t%(committerdate:iso-strict)",
                       "refs/heads/rescue/", "refs/remotes/origin/rescue/")
            for line in proc.stdout.splitlines():
                ref, _, date = line.partition("\t")
                name = ref.split("/rescue/", 1)[1]
                if (c, name) in seen:
                    continue
                seen.add((c, name))
                rescue_count += 1
                age = _age_days(date)
                if age >= aging:
                    first = name.split("/", 1)[0] if "/" in name else ""
                    owner = first if LANE_SHAPED_RE.match(first) else "-"
                    rows.append([f"{c} rescue/{name}", f"rescue branch, {age} d",
                                 owner, "awaiting disposition"])
        for d in self.state_dirs:
            for lane in self._ls(d):
                for rec in self._tree_records(os.path.join(d, lane, "trees")):
                    path = rec.get("path", "")
                    if not path or not os.path.isdir(path):
                        continue
                    dirt = git_out(path, "status", "--porcelain")
                    if dirt is None:
                        self.unreadable.setdefault(path, f"lane {lane}'s inventory tree; git "
                                                         "status could not be read in it")
                        continue
                    if not dirt:
                        continue
                    newest = _gitdir_activity(path)
                    age = int((self.now - newest) // 86400) if newest else 0
                    if age >= aging:
                        rows.append([path, f"dirty inventory tree, {age} d", lane,
                                     "awaiting disposition"])
        self.rescue_count = rescue_count
        self.add(f"Awaiting disposition (older than {aging} days)", rows, "none")

    def _caches_and_sandboxes(self) -> None:
        rows = []
        roots = []
        for lroot in getattr(self, "tree_roots", []):
            try:
                roots += [os.path.join(lroot, n) for n in sorted(os.listdir(lroot))]
            except OSError:
                pass
        for c in getattr(self, "canonical", []):
            wt = os.path.join(c, ".claude", "worktrees")
            if os.path.isdir(wt):
                roots.append(wt)
        for root in roots:
            for path, size in find_caches(root):
                rows.append([path, "cache", size])
        for it in sandbox_items(ProcScan(), self.conf):
            rows.append([it.path, "sandbox", it.size])
        rows.sort(key=lambda r: -r[2])
        total = sum(r[2] for r in rows)
        self.add(f"Caches and sandboxes ({human_size(total)} in all)",
                 [[p, k, human_size(s)] for p, k, s in rows], "none",
                 "Removed without archiving by `--include-caches` / `--include-sandboxes`.")

    def _ignored_and_evidence(self, repos: list, canonical: list) -> None:
        threshold = self.conf["ignored_report_mb"] * 1024 * 1024
        big, evidence = [], []
        for r in repos:
            proc = git(r, "ls-files", "--others", "--ignored", "--exclude-standard",
                       "--directory", "-z")
            ignored = [p.rstrip("/") for p in proc.stdout.split("\0") if p.endswith("/")]
            sizes = _du([os.path.join(r, p) for p in ignored]) if ignored else {}
            for path, size in sizes.items():
                if size >= threshold:
                    big.append([path, human_size(size)])
            unt = git(r, "ls-files", "--others", "--exclude-standard", "--directory", "-z")
            for p in (unt.stdout.split("\0") + [i + "/" for i in ignored]):
                name = p.rstrip("/").rsplit("/", 1)[-1]
                if p and EVIDENCE_NAME_RE.search(name):
                    evidence.append([os.path.join(r, p.rstrip("/")), "untracked or ignored in "
                                     + os.path.basename(r)])
        if self.root:
            repo_set = set(repos)
            for n in sorted(os.listdir(self.root)):
                full = os.path.join(self.root, n)
                if full in repo_set or not os.path.isdir(full) or n.startswith(".lane-") \
                        or n.endswith("-worktrees"):
                    continue
                if EVIDENCE_NAME_RE.search(n) or self._holds_reports(full):
                    evidence.append([full, "a directory of reports beside the repositories"])
        big.sort(key=lambda r: r[0])
        self.add(f"Ignored directories over {self.conf['ignored_report_mb']} MB", big, "none")
        self.add("Evidence-shaped paths inside the estate", evidence, "none",
                 "One evidence root per repository: ${XDG_STATE_HOME:-$HOME/.local/state}/"
                 "openRepoTools/evidence/<repo>/<UTC>-<slug>/. Each is a finding to move.")

    @staticmethod
    def _holds_reports(d: str) -> bool:
        try:
            for e in os.scandir(d):
                if e.is_file() and EVIDENCE_NAME_RE.search(e.name):
                    return True
                if e.is_dir(follow_symlinks=False) and not e.name.startswith("."):
                    for f in os.scandir(e.path):
                        if f.is_file() and EVIDENCE_NAME_RE.search(f.name):
                            return True
        except OSError:
            return False
        return False

    def _archives(self) -> None:
        """`sweep --expire`'s dry run, folded in: what WOULD expire, and what
        is past retention but kept because its rescue left origin. Expiring
        stays an act (`sweep --expire --yes`); the report changes nothing."""
        root = sweeps_dir()
        keep = self.conf["retention_days"]
        rows = []
        for adir, age, disp, why in expiry_rows(self.conf):
            if disp == "expire":
                rows.append([adir, f"{age} d", "would expire: lane-worktrees sweep --expire --yes"])
            elif age >= keep:
                rows.append([adir, f"{age} d", "kept past retention: " + why])
        self.sweeps_size = dir_size(root) if os.path.isdir(root) else 0
        self.add(f"Sweep archives past retention ({keep} days)", rows, "none")

    def _workspace_hygiene(self) -> None:
        rows = []
        wroot = self.helper.workspace_root() if self.helper.path else ""
        if wroot:
            try:
                with open(os.path.join(wroot, ".gitignore"), encoding="utf-8") as fh:
                    have = set(fh.read().splitlines())
            except OSError:
                have = set()
            want = ["__pycache__/", "*.pyc", "*.pyo", ".pytest_cache/", ".mypy_cache/",
                    ".ruff_cache/", "node_modules/", ".venv/", "venv/", "site-packages/"]
            missing = [w for w in want if w not in have]
            if missing:
                rows.append([os.path.join(wroot, ".gitignore"), "lacks " + " ".join(missing),
                             "printf '%s\\n' " + " ".join(f"'{m}'" for m in missing)
                             + f" >> {wroot}/.gitignore"])
            hist = git(wroot, "log", "--all", "--format=", "--name-only", "--",
                       "*.pyc", "*__pycache__*")
            paths = sorted({p for p in hist.stdout.splitlines() if p})
            if paths:
                rows.append([wroot, f"{len(paths)} bytecode path(s) in history, e.g. {paths[0]}",
                             "a person's word: history is rewritten only on one"])
        self.add("Workspace repository hygiene", rows, "none")

    def _status_all(self) -> None:
        # `LANE_WORKTREES_STATUS` names the estate command when it is not
        # beside this one (a test names a fake; a person, their own build).
        exe = os.environ.get("LANE_WORKTREES_STATUS", "")
        if not exe:
            exe = os.path.join(os.path.dirname(os.path.realpath(__file__)), "status")
            if not os.access(exe, os.X_OK):
                exe = shutil.which("status") or ""
        rows = []
        why = ""
        if not exe:
            why = "no `status` beside this command or on PATH"
        else:
            env = dict(os.environ)
            if self.root:
                # THE ESTATE THIS REPORT READ, however it was resolved: from
                # `--estate`, `$PROJECTS_ROOT` or the home default.
                env["PROJECTS_DIR"] = self.root
            proc = run([exe, "--all"], env=env, timeout=600)
            if proc.returncode not in (0, 1):
                why = f"`status --all` exited {proc.returncode}: " + _first_line(proc.stderr)
            context = ""
            for line in proc.stdout.splitlines():
                s = line.strip()
                if line.startswith("=== "):
                    context = s.strip("= ").replace("status ", "")
                elif s.startswith("- "):
                    rows.append([context, s[2:]])
        self.add("`status --all` findings (pin drift and tracking are reported as what they "
                 "are, never counted as dirt)", rows, "none", why)

    # ------------------------------------------------------------ writing
    def markdown(self) -> str:
        host = os.environ.get("LANES_WORKSTATION") or socket.gethostname()
        out = [f"# Estate report - {host} - {utc_now()}", "",
               f"`{PROG} sweep --all --dry-run --report` over `{self.root or '(no estate)'}`. "
               "It changed nothing.", "",
               "| finding | count |", "|---|---|"]
        for title, rows, _e, _n in self.sections:
            out.append(f"| {title} | {len(rows)} |")
        out.append(f"| rescue branches (all ages) | {getattr(self, 'rescue_count', 0)} |")
        out.append(f"| the sweeps directory | {human_size(getattr(self, 'sweeps_size', 0))} |")
        for title, rows, empty, note_text in self.sections:
            out += ["", f"## {title}", ""]
            if note_text:
                out += [note_text, ""]
            if not rows:
                out.append(f"_{empty}_")
                continue
            for r in rows[:500]:
                out.append("- " + " · ".join(str(c).replace("\n", " ") for c in r if c != ""))
            if len(rows) > 500:
                out.append(f"- ... and {len(rows) - 500} more")
        return "\n".join(out) + "\n"


def report_all(opts) -> int:
    rep = Report(opts)
    rep.build()
    text = rep.markdown()
    post = opts.post or ""
    if not post:
        sys.stdout.write(text)
        return 0
    m = re.match(r"^([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)#(\d+)$", post)
    if m:
        fd, tmp = tempfile.mkstemp(prefix="lane-worktrees-report.", suffix=".md")
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(text)
        try:
            proc = run(["gh", "issue", "comment", m.group(2), "--repo", m.group(1),
                        "--body-file", tmp], timeout=120)
        finally:
            os.unlink(tmp)
        if proc.returncode != 0:
            note(f"the report could not be posted to {post}: " + _first_line(proc.stderr))
            sys.stdout.write(text)
            return 1
        say(f"{PROG}: the report was posted to {post}: {proc.stdout.strip()}")
        return 0
    try:
        os.makedirs(os.path.dirname(os.path.abspath(post)), exist_ok=True)
        with open(post, "w", encoding="utf-8") as fh:
            fh.write(text)
    except OSError as exc:
        note(f"the report could not be written to {post}: {exc}")
        sys.stdout.write(text)
        return 1
    say(f"{PROG}: the report is at {post}")
    return 0


# ==================================================================== main

class _Parser(argparse.ArgumentParser):
    def error(self, message):
        raise Usage(message)


def parse(argv: list):
    parser = _Parser(prog=PROG, add_help=False)
    parser.add_argument("verb", nargs="?")
    parser.add_argument("lane", nargs="?")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--dry-run", action="store_true")
    mode.add_argument("--yes", action="store_true")
    parser.add_argument("--porcelain", action="store_true")
    parser.add_argument("--bundle", action="store_true")
    parser.add_argument("--branches", action="store_true")
    parser.add_argument("--links", action="store_true")
    parser.add_argument("--include-scratch", action="store_true")
    parser.add_argument("--include-caches", action="store_true")
    parser.add_argument("--include-sandboxes", action="store_true")
    parser.add_argument("--include-foreign", action="store_true")
    parser.add_argument("--word")
    parser.add_argument("--live", action="append")
    parser.add_argument("--fetch", action="store_true")
    parser.add_argument("--estate")
    parser.add_argument("--expire", action="store_true")
    parser.add_argument("--all", action="store_true")
    parser.add_argument("--report", action="store_true")
    parser.add_argument("--post")
    parser.add_argument("-h", "--help", action="store_true")
    parser.add_argument("--version", action="store_true")
    return parser.parse_args(argv)


YES_SWITCH = "LANE_WORKTREES_ENABLE_YES"
_ACTIVE: dict = {}


def main(argv: list) -> int:
    """The exit contract, whatever happens inside: an error no read caught is
    exit 2 on a dry run (nothing was changed), and under `--yes` the archive's
    DISPOSITION.md is written first and the exit is 1 (B2)."""
    for stream in (sys.stdout, sys.stderr):
        if hasattr(stream, "reconfigure"):
            stream.reconfigure(errors="surrogateescape")
    try:
        return _main(argv)
    except Exception as exc:  # pylint: disable=broad-except
        import traceback
        frames = [f for f in traceback.extract_tb(exc.__traceback__)
                  if os.path.basename(f.filename) == os.path.basename(__file__)]
        where = f" at {PROG} line {frames[-1].lineno}" if frames else ""
        detail = f"{type(exc).__name__}: {exc}{where}"
        sweep = _ACTIVE.get("sweep")
        acted = bool(sweep is not None and sweep.acting)
        if sweep is not None and sweep.opts.porcelain:
            prow("refused", "internal error, outside the table: " + detail)
        if acted:
            try:
                if sweep.archive:
                    sweep._write_disposition()
            except Exception:  # pylint: disable=broad-except
                pass
            note(f"INTERNAL ERROR part-way through --yes: {detail}; what was done is in "
                 f"{tilde(sweep.archive) if sweep.archive else 'the table above'}")
            return 1
        note(f"INTERNAL ERROR, nothing was changed: {detail}")
        return 2


def _main(argv: list) -> int:
    try:
        ns = parse(argv)
    except Usage as exc:
        note(f"usage: {exc} (see {PROG} --help)")
        return 64
    if ns.help:
        sys.stdout.write(__doc__)
        return 0
    if ns.version:
        say(f"{PROG} {VERSION}")
        return 0
    if ns.verb != "sweep":
        note("usage: lane-worktrees sweep <lane> [--dry-run | --yes] ... (see --help)")
        return 64
    if ns.all or ns.report or ns.post is not None:
        if not (ns.all and ns.report) or ns.lane or ns.yes or ns.expire:
            note("usage: the estate-wide sweep only reports: lane-worktrees sweep --all "
                 "--dry-run --report [--post <path|owner/repo#n>]")
            return 64
        return report_all(ns)
    # `--yes` IS SWITCHED OFF until the data-loss paths the reviews found are
    # closed (opensoft/openRepoTools#170). The dry run, the porcelain #163's
    # gate reads and the report stay whole; acting takes the switch, which the
    # suite sets and a real estate does not.
    if ns.yes and os.environ.get(YES_SWITCH, "") != "1":
        why = (f"--yes is disabled until opensoft/openRepoTools#170 lands; the dry run is "
               f"unaffected ({YES_SWITCH}=1 enables it, and is not for a real estate until #170)")
        if ns.porcelain:
            prow("refused", why)
        note("REFUSED: " + why)
        return 2
    if ns.expire:
        if ns.lane:
            note("usage: sweep --expire takes no lane: it reads every lane's archives")
            return 64
        return expire(ns)
    if not ns.lane:
        note("usage: lane-worktrees sweep <lane> [--dry-run | --yes] ... (see --help)")
        return 64
    if not re.match(r"^[A-Za-z0-9][A-Za-z0-9._-]*$", ns.lane):
        note(f"usage: '{ns.lane}' is not a lane name")
        return 64
    if ns.word is not None and not ns.include_foreign:
        note("usage: --word is the word --include-foreign acts on, and nothing else takes it")
        return 64
    opts = Options(ns)
    sweep = Sweep(ns.lane, opts)
    _ACTIVE["sweep"] = sweep
    sweep.gather()
    if sweep.refusal and not sweep.trees:
        sweep.decide()
        (sweep.porcelain if opts.porcelain else sweep.render)()
        if not opts.porcelain:
            note("REFUSED: " + sweep.refusal)
        return 2
    sweep.decide()
    if opts.yes and not sweep.refusal:
        sweep.act()
    (sweep.porcelain if opts.porcelain else sweep.render)()
    if sweep.refusal:
        return 2
    if opts.yes:
        return 1 if sweep.failed else 0
    return 3 if sweep.retire_count() else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
