#!/usr/bin/env bash
#
# link-estates — place the symlinks that let every path a lane already uses
# resolve into this repository. Idempotent; rehearses with --dry-run; never
# deletes a real file.
#
# What it links:
#   ~/projects/<estate>/handoffs   -> <repo>/handoffs/<estate>
#                                     for every handoffs/<estate>/ here whose
#                                     ~/projects/<estate> exists on this
#                                     workstation. The rest are reported and
#                                     skipped: an estate this machine has not
#                                     cloned gets no link.
#   ~/projects/xFactory/LANES.md   -> <repo>/lanes/LANES.md
#   ~/projects/xFactory/lanes-edit.sh -> <repo>/lanes/lanes-edit.sh
#   ~/.local/bin/lane-start        -> <repo>/lanes/lane-start
#   ~/.local/bin/lane-end          -> <repo>/lanes/lane-end
#                                     the two ends of a lane are typed as
#                                     commands, so they go on PATH.
#
# Why: lane-collision-protocol Rule 4 / Amendment 4 (handoffs live in the
# person's workspace repository, reached through the estate-folder path) and
# Rule 9 / Amendment 5 (the lane register lives there too). Every existing
# path in every protocol, memory and habit keeps working because of these
# links — nothing else has to be rewritten.
#
# Adopting this repository on a new workstation is: clone, then run this.
#
# Environment: PROJECTS_ROOT overrides ~/projects, BIN_DIR overrides
# ~/.local/bin (both used by tests).
set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
projects_root="${PROJECTS_ROOT:-$HOME/projects}"
bin_dir="${BIN_DIR:-$HOME/.local/bin}"
dry_run=0

case "${1:-}" in
  "") ;;
  --dry-run) dry_run=1 ;;
  -h|--help)
    echo "Usage: ./scripts/link-estates [--dry-run]"
    exit 0
    ;;
  *) echo "Unknown option: $1" >&2; exit 2 ;;
esac

[[ -d "$repo_dir/handoffs" ]] || { echo "Error: no handoffs/ in $repo_dir" >&2; exit 1; }
[[ -d "$repo_dir/lanes" ]]    || { echo "Error: no lanes/ in $repo_dir" >&2; exit 1; }
[[ -d "$projects_root" ]]     || { echo "Error: no projects root: $projects_root" >&2; exit 1; }

stamp="$(date -u +%Y%m%dT%H%M%SZ)"
linked=0; kept=0; skipped=0; aside=0

# Never delete a real file, a real directory, or anything whose bytes differ
# from what is tracked here. Move it out of the way with a stamped suffix so
# the previous state stays recoverable by hand — the habit scripts/link-home
# established in brettheap/new-workstation, and the one Amendment 4(f) names.
move_aside() {
  local live=$1
  local target="$live.pre-link-estates-$stamp"
  if (( dry_run )); then
    printf 'PLAN  move aside  %s -> %s\n' "$live" "$target"
  else
    mv -- "$live" "$target"
    printf 'ASIDE %s -> %s\n' "$live" "$target"
  fi
  aside=$((aside + 1))
}

link() {
  local target=$1 live=$2
  if [[ -L "$live" ]]; then
    if [[ -e "$live" && "$(readlink -f -- "$live")" == "$(readlink -f -- "$target")" ]]; then
      printf 'KEEP  %s -> %s\n' "$live" "$target"
      kept=$((kept + 1))
      return
    fi
    # A symlink pointing somewhere else, or a dangling one. Relinking loses
    # nothing: the bytes are wherever it pointed, and this prints where.
    printf 'RELINK %s (was -> %s)\n' "$live" "$(readlink -- "$live")"
    if (( dry_run )); then
      printf 'PLAN  relink     %s -> %s\n' "$live" "$target"
      return
    fi
    rm -- "$live"
  elif [[ -e "$live" ]]; then
    if [[ -f "$live" && -f "$target" ]] && cmp -s -- "$live" "$target"; then
      if (( dry_run )); then
        printf 'PLAN  replace identical file with link  %s\n' "$live"
        return
      fi
      rm -- "$live"
    else
      move_aside "$live"
      (( dry_run )) && { printf 'PLAN  link       %s -> %s\n' "$live" "$target"; return; }
    fi
  elif (( dry_run )); then
    printf 'PLAN  link       %s -> %s\n' "$live" "$target"
    return
  fi
  ln -s -- "$target" "$live"
  printf 'LINK  %s -> %s\n' "$live" "$target"
  linked=$((linked + 1))
}

# ---- handoffs: one link per estate this workstation actually has ----------
while IFS= read -r -d '' estate_dir; do
  estate="$(basename -- "$estate_dir")"
  if [[ ! -d "$projects_root/$estate" ]]; then
    printf 'SKIP  %s — no %s on this workstation\n' "$estate" "$projects_root/$estate"
    skipped=$((skipped + 1))
    continue
  fi
  link "$estate_dir" "$projects_root/$estate/handoffs"
done < <(find "$repo_dir/handoffs" -mindepth 1 -maxdepth 1 -type d -print0 | sort -z)

# ---- the lane register, reached from the aggregation folder ---------------
# Rule 9's paths, unchanged since 2026-09-09 and unchanged by Amendment 5 —
# only what they point AT changed.
if [[ -d "$projects_root/xFactory" ]]; then
  link "$repo_dir/lanes/LANES.md"     "$projects_root/xFactory/LANES.md"
  link "$repo_dir/lanes/lanes-edit.sh" "$projects_root/xFactory/lanes-edit.sh"
else
  printf 'SKIP  the lane register — no %s on this workstation\n' "$projects_root/xFactory"
  skipped=$((skipped + 1))
fi

# ---- the two ends of a lane, on PATH --------------------------------------
# `lane-start` names the tmux window after the lane, registers the row and
# launches the session under the same name; `lane-end` closes the row. They
# are typed by a person at the boundary of a lane, so they belong on PATH —
# and they resolve the register from their own REAL path, so the symlink is
# all they need.
if [[ ! -d "$bin_dir" ]]; then
  if (( dry_run )); then
    printf 'PLAN  mkdir -p   %s\n' "$bin_dir"
  else
    mkdir -p -- "$bin_dir"
    printf 'MKDIR %s\n' "$bin_dir"
  fi
fi
if [[ -d "$bin_dir" ]]; then
  link "$repo_dir/lanes/lane-start" "$bin_dir/lane-start"
  link "$repo_dir/lanes/lane-end"   "$bin_dir/lane-end"
  case ":${PATH:-}:" in
    *":$bin_dir:"*) : ;;
    *) printf 'NOTE  %s is not on this shell'"'"'s PATH — add it, or call the helpers by path\n' "$bin_dir" ;;
  esac
else
  printf 'PLAN  link       %s -> %s\n' "$bin_dir/lane-start" "$repo_dir/lanes/lane-start"
  printf 'PLAN  link       %s -> %s\n' "$bin_dir/lane-end" "$repo_dir/lanes/lane-end"
fi

printf -- '----\n%s linked, %s already right, %s skipped, %s moved aside%s\n' \
  "$linked" "$kept" "$skipped" "$aside" "$( (( dry_run )) && printf ' (PLAN only — nothing was written)' )"
